          </div>

          <!-- Old Rate Selection -->
          <div class="md:col-span-6 space-y-2">
            <label for="old-rate" class="text-sm font-semibold text-base">Previous / Old GST Rate</label>
            <div class="grid grid-cols-3 gap-2">

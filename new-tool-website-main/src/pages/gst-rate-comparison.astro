---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Old vs New GST Rate Comparison Tool — Calculate Price & Tax Impact';
const description = 'Compare old vs new GST rates to calculate price impact, tax variance, and consumer savings. Free browser calculator for GST rate changes, MRP revisions, and anti-profiteering compliance.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/gst-rate-comparison`;

const faqs = [
  {
    q: 'What is the difference between legacy GST slabs and rationalized GST rates?',
    a: 'Under the legacy GST framework, goods and services were classified into five primary slabs: 0% (exempt), 5%, 12%, 18%, and 28% (plus applicable compensation cess). Ongoing rate rationalization simplifies this multi-tier structure by phasing out the 12% slab—moving essential goods to 5% and standard goods to 18%—while introducing consolidated luxury brackets (such as 40%) to eliminate separate cess calculations.',
  },
  {
    q: 'How do I calculate the price and tax impact of a GST rate change on a product?',
    a: 'To calculate the exact price impact: (1) Determine the base price excluding tax. If you only have an MRP, reverse-calculate the base price using: Base Price = Old MRP ÷ (1 + Old Rate / 100). (2) Calculate old tax = Base Price × Old Rate / 100. (3) Calculate new tax = Base Price × New Rate / 100. (4) The price impact equals New Tax minus Old Tax. If negative, the consumer saves money; if positive, retail prices increase.',
  },
  {
    q: 'Is a business legally required to reduce prices if the GST rate drops on its products?',
    a: 'Yes. Under Section 171 of the CGST Act (Anti-Profiteering), any reduction in the rate of tax on any supply of goods or services, or the benefit of input tax credit, must be passed on to the recipient by way of a commensurate reduction in prices. Failure to pass on tax reductions can trigger investigations by the Competition Commission of India (CCI), mandatory refunds to consumers, and statutory penalties.',
  },
  {
    q: 'Does a reduction in GST rate require a business to reverse Input Tax Credit (ITC)?',
    a: 'A reduction between taxable brackets (e.g. from 18% down to 12% or 5%) does NOT require any reversal of ITC already availed on previously purchased inputs or capital goods. However, if a product is reclassified from taxable to wholly exempt (0%), the taxpayer must reverse proportionate ITC on raw materials and semi-finished/finished goods held in stock under Section 18(4) and Rule 42 of the CGST Rules.',
  },
  {
    q: 'Which GST rate applies to invoices issued during a rate transition period (Section 14)?',
    a: 'Under Section 14 of the CGST Act (Determination of rate of tax in change of rate), applicability depends on three dates: supply of goods/services, issue of invoice, and receipt of payment. If the supply occurs before the rate change but both the invoice and payment occur after the change, the new rate applies. If the supply and invoice occur before the change, the old rate applies regardless of payment date.',
  },
  {
    q: 'How does a GST rate change affect Inverted Duty Structure (IDS) refund claims?',
    a: 'An Inverted Duty Structure occurs when the GST rate on inward inputs is higher than the rate on outward supplies. If an outward rate is reduced (e.g., from 18% to 5%), it may create an inverted duty structure, entitling the manufacturer to claim a refund of accumulated unutilized ITC under Section 54(3)(ii) of the CGST Act (subject to statutory exclusions for input services).',
  },
  {
    q: 'What is the 40% GST slab and which commodities does it cover?',
    a: 'The 40% GST slab is a unified demerit and luxury tax bracket designed to replace the complex mechanism of a 28% base GST rate plus variable Compensation Cess. It covers sin goods, high-end motor vehicles, aerated sugary beverages, tobacco products, and pan masala, ensuring revenue neutrality while streamlining the invoicing and reporting process.',
  },
  {
    q: 'How does a GST rate change impact B2B buyers compared to B2C retail consumers?',
    a: 'For registered B2B buyers who claim full Input Tax Credit, a GST rate change is generally cashflow-neutral because any tax paid on purchases is set off against output tax liabilities. For unregistered end consumers (B2C), any change in GST directly impacts total out-of-pocket expenditure, altering market demand and product affordability.',
  },
  {
    q: 'Can a seller issue Credit Notes or Debit Notes for rate adjustments after delivery?',
    a: 'Yes. Under Section 34 of the CGST Act, if an invoice was raised at an old rate and the statutory effective date mandates a revised rate, the supplier can issue a Debit Note (if the rate was increased) to recover the tax differential, or a Credit Note (if the rate was reduced) to pass on the tax saving to the recipient.',
  },
  {
    q: 'Do retailers need to print new MRP stickers on existing inventory after a rate change?',
    a: 'Under the Legal Metrology (Packaged Commodities) Rules and ministry advisories issued during GST rate revisions, manufacturers, packers, and retailers are permitted to affix revised price stickers on existing unsold inventory showing the lower revised MRP alongside the original MRP, ensuring consumers are not overcharged.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Old vs New GST Rate Comparison Tool',
    url: canonical,
    description: description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'INR',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];

const lastUpdated = '2026-09-17';
const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/#tools-heading' },
  { name: 'GST Rate Comparison', href: '/gst-rate-comparison' },
];
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-base bg-surface px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-muted mb-4 shadow-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        Rate Migration &amp; Pricing Impact Calculator
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-base mb-4">
        Old vs New GST Rate Comparison Tool
      </h1>
      <p class="text-[16px] text-muted max-w-2xl mx-auto leading-relaxed">
        Instantly analyze price variance, tax incidence shifts, and consumer savings resulting from GST rate revisions and slab rationalizations.
      </p>
    </div>

    <!-- Quick Presets Bar -->
    <div class="max-w-4xl mx-auto mb-6">
      <div class="rounded-xl border border-base bg-surface p-4 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
          <span class="text-xs font-semibold uppercase tracking-wider text-muted">Common Rate Migration Presets</span>
          <span class="text-[11px] font-mono text-muted">Click to auto-populate rates</span>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-base bg-subtle hover:border-accent hover:text-accent transition-colors" data-old="12" data-new="5">
            12% → 5% (Textiles, Food, Essentials)
          </button>
          <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-base bg-subtle hover:border-accent hover:text-accent transition-colors" data-old="12" data-new="18">
            12% → 18% (Standard Services)
          </button>
          <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-base bg-subtle hover:border-accent hover:text-accent transition-colors" data-old="28" data-new="18">
            28% → 18% (Automotive Parts &amp; Appliances)
          </button>
          <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-base bg-subtle hover:border-accent hover:text-accent transition-colors" data-old="18" data-new="5">
            18% → 5% (Medical Equipment &amp; Green Tech)
          </button>
          <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-base bg-subtle hover:border-accent hover:text-accent transition-colors" data-old="28" data-new="40">
            28% → 40% (Luxury &amp; Sin Goods Slab)
          </button>
        </div>
      </div>
    </div>

    <div class="max-w-4xl mx-auto space-y-8">
      <!-- Inputs Card -->
      <div class="rounded-2xl border border-base bg-surface p-6 sm:p-8 shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          
          <!-- Price Input Mode & Value -->
          <div class="md:col-span-6 space-y-2">

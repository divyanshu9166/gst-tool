              <!-- Pricing Mode Radio Toggle -->
              <div class="inline-flex rounded-lg border border-base bg-subtle p-0.5 text-xs">
                <button type="button" id="mode-base" class="px-2.5 py-1 rounded-md font-medium bg-surface text-base shadow-sm transition-all">Base Price</button>
                <button type="button" id="mode-mrp" class="px-2.5 py-1 rounded-md font-medium text-muted hover:text-base transition-all">Tax-Inclusive MRP</button>
              </div>
            </div>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-muted font-medium select-none font-mono" aria-hidden="true">₹</span>
              <input 
                id="price-input" 
                type="number" 
                min="0" 
                step="any"
                placeholder="1000" 
                value="1000" 
                class="w-full rounded-xl border border-base bg-subtle pl-9 pr-4 py-3 text-[16px] font-mono focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-all" 
              />
            </div>
            <p class="text-[11px] text-muted" id="price-hint">Base price before any GST is added.</p>
          </div>

          <!-- Supply Nature (Intra vs Inter) -->
          <div class="md:col-span-6 space-y-2">
            <label for="supply-type" class="text-sm font-semibold text-base">Supply Location &amp; Tax Type</label>
            <select id="supply-type" class="w-full rounded-xl border border-base bg-subtle px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-all cursor-pointer">

                <option value="0">0% (Nil / Exempt)</option>
                <option value="3">3% (Precious Metals / Gold)</option>
                <option value="5" selected>5% (Essential Goods)</option>
                <option value="12">12% (Standard Lower)</option>
                <option value="18">18% (Standard Higher)</option>
                <option value="28">28% (Automobiles / Peak)</option>
                <option value="40">40% (Consolidated Luxury/Sin)</option>
                <option value="custom">Custom Rate...</option>
              </select>
              <input 
                id="new-custom-rate" 
                type="number" 
                min="0" 
                max="100" 
                step="0.01" 
                placeholder="%" 
                disabled 
                class="rounded-xl border border-base bg-subtle px-3 py-2.5 text-sm font-mono opacity-50 focus:border-accent focus:outline-none transition-all" 
              />
            </div>
          </div>

        </div>
      </div>

      <!-- Comparison Cards: Side by Side -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Old Rate Card -->
        <div class="rounded-2xl border border-base bg-surface p-6 shadow-sm">
          <div class="flex items-center justify-between border-b border-base pb-3 mb-4">
            <h2 class="text-base font-bold text-base">Old Tax Scenario</h2>
            <span class="inline-flex items-center rounded-full bg-subtle px-2.5 py-0.5 text-xs font-mono font-medium text-muted" id="old-rate-badge">12% GST</span>
          </div>

          <div class="space-y-3 text-sm">
            <div class="flex justify-between items-center">
              <span class="text-muted">Net Base Taxable Value</span>
              <span class="font-mono font-semibold text-base" id="old-base">₹1,000.00</span>
            </div>
            
            <div id="old-split-container" class="space-y-1.5 pl-2 border-l-2 border-base text-xs text-muted">
              <div class="flex justify-between items-center" id="old-cgst-row">
                <span>Central GST (CGST @ <span id="old-cgst-pct">6%</span>)</span>
                <span class="font-mono" id="old-cgst-val">₹60.00</span>
              </div>
              <div class="flex justify-between items-center" id="old-sgst-row">
                <span>State/UT GST (SGST @ <span id="old-sgst-pct">6%</span>)</span>
                <span class="font-mono" id="old-sgst-val">₹60.00</span>
              </div>
              <div class="flex justify-between items-center hidden" id="old-igst-row">
                <span>Integrated GST (IGST @ <span id="old-igst-pct">12%</span>)</span>
                <span class="font-mono" id="old-igst-val">₹120.00</span>
              </div>
            </div>

            <div class="flex justify-between items-center pt-2 border-t border-base">
              <span class="font-medium text-muted">Total Old Tax Amount</span>
              <span class="font-mono font-semibold text-base" id="old-tax-total">₹120.00</span>
            </div>

            <div class="flex justify-between items-center pt-3 border-t border-base">
              <span class="text-base font-bold">Total Customer Price (MRP)</span>
              <span class="font-mono text-xl font-bold text-base" id="old-total">₹1,120.00</span>
            </div>
          </div>
        </div>

        <!-- New Rate Card -->
        <div class="rounded-2xl border-2 border-accent/40 bg-accent/5 p-6 shadow-sm">
          <div class="flex items-center justify-between border-b border-accent/20 pb-3 mb-4">
            <h2 class="text-base font-bold text-accent">New Tax Scenario (Revised)</h2>
            <span class="inline-flex items-center rounded-full bg-accent/10 px-2.5 py-0.5 text-xs font-mono font-semibold text-accent" id="new-rate-badge">5% GST</span>
          </div>

          <div class="space-y-3 text-sm">
            <div class="flex justify-between items-center">
              <span class="text-muted">Net Base Taxable Value</span>
              <span class="font-mono font-semibold text-base" id="new-base">₹1,000.00</span>
            </div>

            <div id="new-split-container" class="space-y-1.5 pl-2 border-l-2 border-accent/30 text-xs text-muted">
              <div class="flex justify-between items-center" id="new-cgst-row">
                <span>Central GST (CGST @ <span id="new-cgst-pct">2.5%</span>)</span>
                <span class="font-mono" id="new-cgst-val">₹25.00</span>
              </div>
              <div class="flex justify-between items-center" id="new-sgst-row">
                <span>State/UT GST (SGST @ <span id="new-sgst-pct">2.5%</span>)</span>
                <span class="font-mono" id="new-sgst-val">₹25.00</span>
              </div>
              <div class="flex justify-between items-center hidden" id="new-igst-row">
                <span>Integrated GST (IGST @ <span id="new-igst-pct">5%</span>)</span>
                <span class="font-mono" id="new-igst-val">₹50.00</span>
              </div>
            </div>

            <div class="flex justify-between items-center pt-2 border-t border-accent/20">
              <span class="font-medium text-muted">Total New Tax Amount</span>
              <span class="font-mono font-semibold text-accent" id="new-tax-total">₹50.00</span>
            </div>

            <div class="flex justify-between items-center pt-3 border-t border-accent/20">
              <span class="text-base font-bold text-accent">Total Customer Price (MRP)</span>
              <span class="font-mono text-xl font-bold text-accent" id="new-total">₹1,050.00</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Net Impact Summary Card -->
      <div class="rounded-2xl border border-base bg-surface p-6 sm:p-8 text-center shadow-sm" id="impact-card">
        <div class="inline-flex items-center gap-1.5 rounded-full border border-base bg-subtle px-3 py-1 text-[11px] font-mono text-muted uppercase tracking-wider mb-3">
          Price Variance &amp; Tax Incidence
        </div>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';

const title = 'GST Refund Tracker & Timeline Calculator (RFD-02 to RFD-06) | Taxzentic';
const description = 'Track timeline milestones for your GST refund application (ARN): RFD-02 (15 days), RFD-04 (7 days), RFD-06 (60 days), and Section 56 interest.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/gst-refund-tracker`;

const faqs = [
  {
    q: 'What is the maximum statutory time limit for the GST department to sanction a refund?',
    a: 'Under Section 54(7) of the CGST Act, the proper officer must issue the final sanction order in Form GST RFD-06 within 60 days from the date of receipt of the complete refund application (ARN date).',
  },
  {
    q: 'What happens if the proper officer does not issue Form RFD-02 within 15 days?',
    a: 'Under Rule 90(2) of the CGST Rules, if no deficiency memo (RFD-03) is issued within 15 days of ARN receipt, an acknowledgement in Form GST RFD-02 is deemed to be issued, establishing application completeness.',
  },
  {
    q: 'When does statutory interest start under Section 56 of the CGST Act?',
    a: 'Under Section 56 of the CGST Act, if a refund is not sanctioned within 60 days from the date of receipt of the application, interest at the rate of 6% per annum is payable from the 61st day until the actual date of credit.',
  },
  {
    q: 'What is a deficiency memo (Form GST RFD-03) and how does it affect the timeline?',
    a: 'Under Rule 90(3), if the application has omissions or missing documents, the officer issues RFD-03. A deficiency memo requires submitting a fresh refund application with a new ARN, resetting the 60-day statutory clock.',
  },
  {
    q: 'Which refund categories are eligible for provisional 90% sanction under RFD-04?',
    a: 'Under Section 54(6), only zero-rated export supplies of goods and services under Letter of Undertaking (LUT) are eligible for provisional sanction of 90% within 7 days of RFD-02. Inverted duty and cash ledger refunds are not eligible for provisional sanction.',
  },
  {
    q: 'What should you do if you receive a Show Cause Notice in Form GST RFD-08?',
    a: 'If the tax officer proposes to reject your refund in full or in part, they issue RFD-08. You must submit a written reply in Form GST RFD-09 within 15 days of notice receipt, along with supporting reconciliations and invoices.',
  },
  {
    q: 'How is the sanctioned refund disbursed to the taxpayer bank account?',
    a: 'Upon issuing RFD-06, the officer generates a payment order advice in Form GST RFD-05. The amount is directly credited via PFMS to the validated primary bank account registered on the GST portal.',
  },
  {
    q: 'Can GST refund interest be claimed if delay occurred due to portal technical errors?',
    a: 'Yes. Multiple High Court rulings have held that statutory interest under Section 56 is mandatory once 60 days expire from the original complete application date, regardless of internal administrative or technical delays.',
  },
  {
    q: 'What is the timeline difference between LUT export refund and IGST payment refund?',
    a: 'Refund under LUT requires filing Form RFD-01 on the GST portal followed by officer scrutiny. Export with payment of IGST is automated: your shipping bill acts as refund claim, and ICEGATE processes payment automatically upon GSTR-1 and GSTR-3B matching.',
  },
  {
    q: 'Does this refund tracker access GST portal credentials or store ARN information?',
    a: 'No. This timeline tracker is an offline client-side calculator based strictly on statutory dates under Section 54 and Section 56. No taxpayer data, ARN, or GSTIN information is transmitted or stored.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'GST Refund Tracker and Statutory Timeline Calculator',
    url: canonical,
    description: 'Track statutory milestone dates for GST refund applications from ARN generation to final order.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'INR',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/#tools-heading' },
  { name: 'GST Refund Tracker', href: '/gst-refund-tracker' },
];

const lastUpdated = '2026-09-15';
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <!-- Header -->
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-50/50 dark:bg-blue-950/40 px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-accent mb-4">
        <span class="h-2 w-2 rounded-full bg-accent animate-pulse"></span>
        Section 54(7) & Section 56 Interest Clock
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-base mb-4">
        GST Refund Timeline Tracker
      </h1>
      <p class="text-[17px] text-muted max-w-2xl mx-auto leading-relaxed">
        Enter your ARN date to compute the statutory deadlines for acknowledgement, provisional sanction, final order, and statutory 6% delay interest.
      </p>
    </div>

    <!-- Input Card -->
    <div class="rounded-2xl border border-base bg-surface p-6 sm:p-8 shadow-sm mb-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
        <div>
          <label for="arn-date" class="block text-sm font-semibold text-base mb-2">
            ARN Generation Date (Application Date)
          </label>
          <input
            type="date"
            id="arn-date"
            class="w-full rounded-xl border border-base bg-subtle px-4 py-3 font-mono text-sm focus:border-accent focus:outline-none"
          />
        </div>

        <div>
          <label for="refund-type" class="block text-sm font-semibold text-base mb-2">
            Refund Category
          </label>
          <select id="refund-type" class="w-full rounded-xl border border-base bg-subtle px-4 py-3 text-sm focus:border-accent focus:outline-none">
            <option value="export-lut">Export of Goods / Services (under LUT)</option>
            <option value="inverted">Inverted Duty Structure (Rule 89(5))</option>
            <option value="cash-ledger">Excess Balance in Electronic Cash Ledger</option>
            <option value="deemed-export">Deemed Export Supplies</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Interactive Milestone Timeline -->
    <div class="rounded-2xl border border-base bg-surface p-6 sm:p-8 shadow-sm mb-12">
      <h2 class="text-xl font-bold text-base mb-6 flex items-center gap-2">
        <ToolIcon name="clock" class="w-5 h-5 text-accent" />
        Statutory Progress Milestones
      </h2>

      <div class="space-y-6 relative before:absolute before:inset-0 before:left-4 before:h-full before:w-0.5 before:bg-base">
        <!-- Milestone 1 -->
        <div class="relative flex items-start gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white flex items-center justify-center text-xs font-bold font-mono z-10">
            01
          </div>
          <div class="flex-1 p-4 rounded-xl border border-base bg-subtle/50">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
              <h3 class="font-bold text-base text-sm">RFD-02 Acknowledgement / RFD-03 Deficiency Memo</h3>
              <span class="text-xs font-mono font-bold text-accent" id="date-rfd02">Within 15 Days</span>
            </div>
            <p class="text-xs text-muted">
              The proper officer must verify completeness and either issue an acknowledgement (RFD-02) or a deficiency memo (RFD-03) within 15 days of ARN receipt (Rule 90(2)).
            </p>
          </div>
        </div>

        <!-- Milestone 2 -->
        <div class="relative flex items-start gap-4" id="row-provisional">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs font-bold font-mono z-10">
            02
          </div>
          <div class="flex-1 p-4 rounded-xl border border-base bg-subtle/50">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
              <h3 class="font-bold text-base text-sm">RFD-04 Provisional Refund (90% Claim)</h3>
              <span class="text-xs font-mono font-bold text-emerald-600" id="date-rfd04">Within 7 Days of RFD-02</span>
            </div>
            <p class="text-xs text-muted">
              For zero-rated exports, 90% of the claimed amount must be provisionally sanctioned within 7 days of acknowledgement under Section 54(6).
            </p>
          </div>
        </div>

        <!-- Milestone 3 -->
        <div class="relative flex items-start gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-bold font-mono z-10">
            03
          </div>
          <div class="flex-1 p-4 rounded-xl border border-base bg-subtle/50">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
              <h3 class="font-bold text-base text-sm">RFD-06 Final Sanction Order & RFD-05 Payment Advice</h3>
              <span class="text-xs font-mono font-bold text-rose-600" id="date-rfd06">Within 60 Days (Strict Deadline)</span>
            </div>
            <p class="text-xs text-muted">
              Statutory deadline under Section 54(7) for issuing final sanction order and payment disbursement advice to your validated bank account.
            </p>
          </div>
        </div>

        <!-- Milestone 4 -->
        <div class="relative flex items-start gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-rose-600 text-white flex items-center justify-center text-xs font-bold font-mono z-10">
            04
          </div>
          <div class="flex-1 p-4 rounded-xl border border-rose-500/30 bg-rose-50/40 dark:bg-rose-950/20">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
              <h3 class="font-bold text-rose-700 dark:text-rose-400 text-sm">Section 56 Statutory 6% Interest Starts</h3>
              <span class="text-xs font-mono font-bold text-rose-700 dark:text-rose-400" id="date-interest">Day 61 Onward</span>
            </div>
            <p class="text-xs text-muted">
              If the department fails to credit your refund within 60 days of the ARN date, interest automatically accrues at 6% p.a. until the payment is credited.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <section class="mt-16 pt-12 border-t border-base" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-base mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="group rounded-xl border border-base bg-surface overflow-hidden" id={`faq-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span>{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[15px] text-muted leading-relaxed border-t border-base pt-4">{faq.a}</div>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script is:inline>
    const today = new Date();
    const defaultDate = new Date(today.getTime() - 20 * 24 * 60 * 60 * 1000); // 20 days ago
    document.getElementById('arn-date').value = defaultDate.toISOString().slice(0, 10);

    function updateTimeline() {
      const val = document.getElementById('arn-date').value;
      if (!val) return;

      const arn = new Date(val);
      if (isNaN(arn.getTime())) return;
      const isExport = document.getElementById('refund-type').value === 'export-lut';

      // 15 days for RFD-02
      const d15 = new Date(arn.getTime() + 15 * 24 * 60 * 60 * 1000);
      // 7 days after acknowledgement = 22 days from ARN
      const d22 = new Date(arn.getTime() + 22 * 24 * 60 * 60 * 1000);
      // 60 days for final sanction
      const d60 = new Date(arn.getTime() + 60 * 24 * 60 * 60 * 1000);
      // 61 days for interest
      const d61 = new Date(arn.getTime() + 61 * 24 * 60 * 60 * 1000);

      const fmt = (d) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

      document.getElementById('date-rfd02').textContent = `Due by ${fmt(d15)}`;
      document.getElementById('date-rfd04').textContent = isExport ? `Due by ${fmt(d22)}` : 'Not applicable (Exports only)';
      document.getElementById('date-rfd06').textContent = `Final Deadline: ${fmt(d60)}`;
      document.getElementById('date-interest').textContent = `Interest Accrues From: ${fmt(d61)}`;

      const provRow = document.getElementById('row-provisional');
      if (provRow) {
        provRow.style.opacity = isExport ? '1' : '0.4';
      }
    }

    document.getElementById('arn-date')?.addEventListener('input', updateTimeline);
    document.getElementById('refund-type')?.addEventListener('change', updateTimeline);

    updateTimeline();
  </script>
</BaseLayout>

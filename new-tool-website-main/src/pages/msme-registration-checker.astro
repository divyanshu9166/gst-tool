---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';

const title = 'Udyam/MSME Registration Eligibility Checker';
const description = 'Check if your business is eligible for Udyam/MSME registration in India. Simple interactive tool based on the latest investment and turnover thresholds.';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/msme-registration-checker`;

const faqs = [
  {
    q: 'How are Micro, Small, and Medium Enterprises classified in India?',
    a: 'Under the composite criteria notification (effective July 1, 2020), Micro: Investment ≤ ₹1 Crore and Turnover ≤ ₹5 Crore; Small: Investment ≤ ₹10 Crore and Turnover ≤ ₹50 Crore; Medium: Investment ≤ ₹50 Crore and Turnover ≤ ₹250 Crore.',
  },
  {
    q: 'Must both investment and turnover criteria be satisfied together?',
    a: 'Yes. If an enterprise crosses the ceiling limit specified for its present category in EITHER investment or turnover, it moves up to the next higher category. Both limits must be satisfied to remain in a lower tier.',
  },
  {
    q: 'Is MSME turnover calculated PAN-wide or GSTIN-wide?',
    a: 'PAN-wide. All GSTINs and business divisions registered under the same Permanent Account Number (PAN) are collectively aggregated as a single enterprise for turnover and investment calculations.',
  },
  {
    q: 'Are exports of goods and services included in MSME turnover?',
    a: 'No. Under Section 7(5) of the MSMED Act, export of goods or services or both is strictly excluded when computing the turnover of any enterprise for MSME classification.',
  },
  {
    q: 'Is this tool a live Udyam portal verification check?',
    a: 'No. This is an eligibility checker based on statutory investment and turnover thresholds. Live Udyam certificate verification or registration must be completed on udyamregistration.gov.in.',
  },
  {
    q: 'Can retail and wholesale traders register on the Udyam portal?',
    a: 'Yes. Retail and wholesale traders (NIC codes 45, 46, and 47) can register on Udyam, but their eligibility is restricted strictly to Priority Sector Lending (PSL) benefits. They cannot claim Chapter V delayed payment interest under Section 16.',
  },
  {
    q: 'Does Udyam registration cost money on the official portal?',
    a: 'No. Udyam registration on the official Ministry of MSME portal (udyamregistration.gov.in) is 100% free of cost. No government fees or charges exist.',
  },
  {
    q: 'Is a GSTIN mandatory for Udyam Registration?',
    a: 'PAN and GSTIN are linked for Udyam registration. However, enterprises exempt from mandatory GST registration under the CGST Act (e.g. turnover below statutory threshold) can register without a GSTIN.',
  },
  {
    q: 'How is the value of plant, machinery, and equipment calculated?',
    a: 'Investment is calculated based on the Written Down Value (WDV) at the end of the preceding financial year as reported in the Income Tax Return, excluding the cost of land, buildings, and pollution control devices.',
  },
  {
    q: 'What happens if an enterprise crosses the threshold limits?',
    a: 'In case of upward graduation to a higher category, the enterprise continues to enjoy its existing category benefits for a transitional period of one year from the close of the year of breach.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Udyam MSME Eligibility Checker',
    url: canonical,
    description: 'Check if your business classifies as a Micro, Small, or Medium Enterprise (MSME) under the latest Indian government guidelines.',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  }
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Lookups & Tools', href: '/#tools-heading' },
  { name: 'MSME Checker', href: '/msme-registration-checker' },
];

const lastUpdated = '2026-07-25';
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Hero Section -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-accent/10 to-indigo-500/10 mb-6 tool-icon-wrap shadow-sm">
        <ToolIcon name="building-office" class="w-8 h-8 text-accent" />
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-base mb-4">
        <span class="text-accent">Udyam/MSME</span> Checker
      </h1>
      <p class="text-[18px] text-muted max-w-2xl mx-auto leading-relaxed">
        Check your business eligibility for MSME (Udyam) registration and find out your exact classification (Micro, Small, or Medium) based on the revised guidelines.
      </p>
    </div>

    <!-- Interactive Checker -->
    <div class="rounded-2xl border border-base bg-surface p-6 sm:p-8 mb-12 shadow-sm relative overflow-hidden">
      <!-- Input Section -->
      <div class="space-y-6 relative z-10">
        <div>
          <label class="block text-sm font-medium text-base mb-3">What is your business type?</label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <label class="cursor-pointer">
              <input type="radio" name="biz-type" value="mfg" class="peer sr-only" checked />
              <div class="rounded-lg border border-base bg-white dark:bg-[#111] p-3 text-center text-sm font-medium hover:border-accent peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent transition-all">Manufacturing</div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="biz-type" value="service" class="peer sr-only" />
              <div class="rounded-lg border border-base bg-white dark:bg-[#111] p-3 text-center text-sm font-medium hover:border-accent peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent transition-all">Service Provider</div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="biz-type" value="trader" class="peer sr-only" />
              <div class="rounded-lg border border-base bg-white dark:bg-[#111] p-3 text-center text-sm font-medium hover:border-accent peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent transition-all">Trading (Retail/Wholesale)</div>
            </label>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-base mb-2">Investment in Plant, Machinery or Equipment (₹ In Crores)</label>
          <input type="number" id="investment" class="w-full rounded-lg border border-base bg-white dark:bg-[#111] px-4 py-3 text-base focus:border-accent focus:ring-1 focus:ring-accent outline-none" placeholder="e.g. 0.5" value="0.5" step="0.1" min="0" />
          <p class="text-[12px] text-muted mt-2">Exclude cost of pollution control, research and development, and industrial safety devices.</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-base mb-2">Annual Turnover (₹ In Crores)</label>
          <input type="number" id="turnover" class="w-full rounded-lg border border-base bg-white dark:bg-[#111] px-4 py-3 text-base focus:border-accent focus:ring-1 focus:ring-accent outline-none" placeholder="e.g. 2.5" value="2.5" step="0.1" min="0" />
          <p class="text-[12px] text-muted mt-2">Exclude exports turnover.</p>
        </div>
      </div>

      <!-- Result Banner -->
      <div class="mt-8 pt-8 border-t border-base relative z-10">
        <div id="result-banner" class="rounded-xl p-6 border transition-colors border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400">
          <div class="text-sm font-semibold uppercase tracking-wider mb-2">Your Classification</div>
          <div id="result-title" class="text-3xl font-extrabold mb-2">Micro Enterprise</div>
          <p id="result-desc" class="text-[15px] opacity-90">Both your investment (≤ ₹1 Cr) and turnover (≤ ₹5 Cr) meet the Micro criteria.</p>
          <a id="result-link" href="https://udyamregistration.gov.in" target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-[13px] font-semibold underline underline-offset-2">Register on Udyam Portal →</a>
        </div>
      </div>
    </div>

    <!-- SEO Content / FAQs -->
    <div class="prose prose-neutral dark:prose-invert max-w-none text-[15px] leading-[1.7] border-t border-base pt-12">
      <h2 class="text-[24px] font-semibold text-base mb-6 tracking-[-0.6px]">MSME Classification Rules (Revised)</h2>
      <p>The Government of India revised the MSME classification criteria to a composite formula considering both <strong>Investment</strong> and <strong>Annual Turnover</strong>. The distinction between manufacturing and service sectors has been eliminated.</p>

      <div class="overflow-x-auto my-6">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-subtle text-[13px] uppercase tracking-wider text-muted">
              <th class="p-3 border-b border-base font-semibold">Classification</th>
              <th class="p-3 border-b border-base font-semibold">Investment Limit</th>
              <th class="p-3 border-b border-base font-semibold">Turnover Limit</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            <tr>
              <td class="p-3 border-b border-base font-medium">Micro</td>
              <td class="p-3 border-b border-base">Up to ₹1 Crore</td>
              <td class="p-3 border-b border-base">Up to ₹5 Crore</td>
            </tr>
            <tr>
              <td class="p-3 border-b border-base font-medium">Small</td>
              <td class="p-3 border-b border-base">Up to ₹10 Crore</td>
              <td class="p-3 border-b border-base">Up to ₹50 Crore</td>
            </tr>
            <tr>
              <td class="p-3 border-b border-base font-medium">Medium</td>
              <td class="p-3 border-b border-base">Up to ₹50 Crore</td>
              <td class="p-3 border-b border-base">Up to ₹250 Crore</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-[20px] font-semibold text-base mt-10 mb-4 tracking-[-0.6px]">Frequently Asked Questions</h3>
      
      <div class="space-y-3 not-prose">
        {faqs.map((faq, i) => (
          <details class="group rounded-[8px] border border-base bg-surface overflow-hidden" id={`faq-msme-reg-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span class="text-[15px]">{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function checkEligibility() {
    const bizType = document.querySelector('input[name="biz-type"]:checked').value;
    const inv = parseFloat(document.getElementById('investment').value) || 0;
    const to = parseFloat(document.getElementById('turnover').value) || 0;
    
    const banner = document.getElementById('result-banner');
    const title = document.getElementById('result-title');
    const desc = document.getElementById('result-desc');
    const link = document.getElementById('result-link');

    let classification = '';
    let isEligible = false;
    let reason = '';

    // Edge case: no inputs entered yet
    if (inv === 0 && to === 0) {
      title.textContent = 'Enter your details above';
      desc.textContent = 'Fill in your Investment and Annual Turnover values to see your MSME classification.';
      banner.className = 'rounded-xl p-6 border transition-colors border-base bg-subtle text-muted';
      if (link) link.style.display = 'none';
      return;
    }

    // Classification: if EITHER criterion exceeds the lower category, it moves to the higher one
    if (inv <= 1 && to <= 5) {
      classification = 'Micro Enterprise';
      isEligible = true;
      reason = `Your Investment (₹${inv} Cr) and Turnover (₹${to} Cr) both fall within the Micro limits (Investment ≤ ₹1 Cr AND Turnover ≤ ₹5 Cr).`;
    } else if (inv <= 10 && to <= 50) {
      classification = 'Small Enterprise';
      isEligible = true;
      const exceedsMicro = inv > 1 ? `Investment (₹${inv} Cr > ₹1 Cr)` : `Turnover (₹${to} Cr > ₹5 Cr)`;
      reason = `${exceedsMicro} exceeds the Micro threshold, placing you in the Small category (Investment ≤ ₹10 Cr AND Turnover ≤ ₹50 Cr).`;
    } else if (inv <= 50 && to <= 250) {
      classification = 'Medium Enterprise';
      isEligible = true;
      const exceedsSmall = inv > 10 ? `Investment (₹${inv} Cr > ₹10 Cr)` : `Turnover (₹${to} Cr > ₹50 Cr)`;
      reason = `${exceedsSmall} exceeds the Small threshold, placing you in the Medium category (Investment ≤ ₹50 Cr AND Turnover ≤ ₹250 Cr).`;
    } else {
      classification = 'Large Enterprise (Not Eligible)';
      isEligible = false;
      const overLimit = inv > 50 ? `Investment (₹${inv} Cr) exceeds ₹50 Cr` : `Turnover (₹${to} Cr) exceeds ₹250 Cr`;
      reason = `${overLimit}. Your enterprise does not qualify for MSME/Udyam registration under current limits.`;
    }

    if (bizType === 'trader' && isEligible) {
      reason += ' Note: As a Retail/Wholesale Trader, your Udyam registration benefits are currently limited to Priority Sector Lending (PSL) from banks only.';
    }

    title.textContent = classification;
    desc.textContent = reason;

    if (isEligible) {
      banner.className = 'rounded-xl p-6 border transition-colors border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400';
      if (link) link.style.display = 'inline-block';
    } else {
      banner.className = 'rounded-xl p-6 border transition-colors border-red-500/30 bg-red-500/10 text-red-700 dark:text-red-400';
      if (link) link.style.display = 'none';
    }
  }

  // Attach listeners
  document.querySelectorAll('input[name="biz-type"]').forEach(r => r.addEventListener('change', checkEligibility));
  document.getElementById('investment').addEventListener('input', checkEligibility);
  document.getElementById('turnover').addEventListener('input', checkEligibility);

  // Init
  checkEligibility();
</script>

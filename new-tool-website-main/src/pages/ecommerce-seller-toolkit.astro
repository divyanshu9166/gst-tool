---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';

const title = 'E-commerce Seller Toolkit — Amazon/Flipkart Net Payout Calculator';
const description = 'Estimate marketplace payout after fees, 0.5% GST TCS, and 0.1% e-commerce income-tax TDS under Section 194-O or its 2026 successor.';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/ecommerce-seller-toolkit`;

const faqs = [
  {
    q: 'How is GST calculated for Amazon, Flipkart, and Meesho sellers?',
    a: 'Sellers should separate GST charged on the product from GST shown on marketplace fee invoices. This estimate assumes 18% GST on the commission, fixed fee, and shipping fee entered here; confirm each actual fee and tax rate against the operator invoice.',
  },
  {
    q: 'What is GST TCS under Section 52 for e-commerce operators?',
    a: 'Where Section 52 applies, an e-commerce operator collects GST TCS on the net value of taxable supplies made through it. The operator statement and applicable statutory conditions determine the amount.',
  },
  {
    q: 'What is the current notified rate of GST TCS for e-commerce?',
    a: 'The notified GST TCS rate is 0.5% (0.25% CGST + 0.25% SGST for intra-state supplies, or 0.5% IGST for inter-state supplies) calculated on the net taxable supply value.',
  },
  {
    q: 'What is the difference between GST TCS and Income Tax TDS under Section 194-O?',
    a: 'GST TCS (Section 52) is collected on the net value of taxable supplies and credited to your GST Electronic Cash Ledger. Income-tax TDS is 0.1% on the gross sale amount under Section 194-O for periods governed by the Income-tax Act, 1961; for Tax Year 2026-27 onwards, the corresponding provision is Section 393(1), Table Sl. No. 8(v) of the Income-tax Act, 2025. The TDS treatment of separately stated GST depends on the applicable law, guidance, and timing of deduction.',
  },
  {
    q: 'How do customer returns and refunds affect GST TCS calculation?',
    a: 'Under Section 52, TCS is computed on the "net value of taxable supplies", which is gross taxable sales minus the value of taxable supplies returned by customers during the calendar month.',
  },
  {
    q: 'Can e-commerce sellers claim Input Tax Credit (ITC) on marketplace fees?',
    a: 'GST on marketplace fees may qualify for ITC if the seller is registered and the applicable Section 16 conditions are met, subject to any blocked-credit rule. Check the operator tax invoice and GSTR-2B; the fee deduction alone does not establish eligibility.',
  },
  {
    q: 'Do all online marketplace sellers need mandatory GST registration?',
    a: 'Notification 34/2023-Central Tax waives compulsory registration for eligible goods suppliers through e-commerce operators when turnover stays below the applicable registration threshold in the preceding and current financial years and its other conditions are met. The exemption excludes inter-State goods supplies and requires PAN declaration and portal enrolment.',
  },
  {
    q: 'Why is net bank settlement payout lower than the product selling price?',
    a: 'This estimate subtracts the marketplace fees and shipping you enter, GST on those fees, estimated 0.5% GST TCS, and estimated 0.1% e-commerce income-tax TDS. The TDS base can depend on how GST is shown and when tax is deducted; check the marketplace statement.',
  },
  {
    q: 'How do sellers claim the deducted GST TCS on the GST portal?',
    a: 'After the operator files GSTR-8, review the TCS entries in the TDS/TCS Credit Received facility on the GST portal and accept eligible entries according to the current portal workflow. Accepted credit is reflected in the electronic cash ledger; reconcile it with the operator statement.',
  },
  {
    q: 'Which financial reports must be reconciled before filing monthly GST returns?',
    a: 'Compare marketplace settlement and tax reports with sales invoices, returns, credit notes, GSTR-1 and GSTR-3B. Check the relevant tables for your actual B2B/B2C supplies and place of supply; no single table fits every transaction.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'E-commerce Net Payout Calculator',
    url: canonical,
    description: 'Calculate net payout for e-commerce sellers including TCS and GST on marketplace fees.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/#tools-heading' },
  { name: 'E-commerce Seller Toolkit', href: '/ecommerce-seller-toolkit' },
];

const lastUpdated = '2026-09-25';
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Hero Section -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-accent/10 to-indigo-500/10 mb-6 tool-icon-wrap shadow-sm">
        <ToolIcon name="chart-pie" class="w-8 h-8 text-accent" />
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-base mb-4">
        E-commerce <span class="text-accent">Seller Toolkit</span>
      </h1>
      <p class="text-[18px] text-muted max-w-2xl mx-auto leading-relaxed">
        Estimate your net payout for Amazon, Flipkart, and Meesho sales after commission, shipping, GST on fees, 0.5% GST TCS, and 0.1% Income Tax TDS.
      </p>
    </div>

    <!-- Main Calculator Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <!-- Input Column -->
      <div class="rounded-2xl border border-base bg-surface p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-base mb-6 border-b border-base pb-4">Sale Details</h2>
        
        <div class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-base mb-2">Selling Price (incl. GST) ₹</label>
            <input type="number" id="selling-price" class="w-full rounded-lg border border-base bg-white dark:bg-[#111] px-4 py-2.5 text-base focus:border-accent focus:ring-1 focus:ring-accent outline-none" placeholder="e.g. 1000" value="1000" />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-base mb-2">Marketplace Commission (%)</label>
              <input type="number" id="commission-rate" class="w-full rounded-lg border border-base bg-white dark:bg-[#111] px-4 py-2.5 text-base focus:border-accent focus:ring-1 focus:ring-accent outline-none" placeholder="e.g. 10" value="10" />
            </div>
            <div>
              <label class="block text-sm font-medium text-base mb-2">Fixed Fee (₹)</label>
              <input type="number" id="fixed-fee" class="w-full rounded-lg border border-base bg-white dark:bg-[#111] px-4 py-2.5 text-base focus:border-accent focus:ring-1 focus:ring-accent outline-none" placeholder="e.g. 20" value="20" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-base mb-2">Shipping / Fulfillment Fee (₹)</label>
            <input type="number" id="shipping-fee" class="w-full rounded-lg border border-base bg-white dark:bg-[#111] px-4 py-2.5 text-base focus:border-accent focus:ring-1 focus:ring-accent outline-none" placeholder="e.g. 60" value="60" />
          </div>

          <div class="pt-4 mt-4 border-t border-base">
            <div class="flex items-center justify-between">
              <label class="text-sm font-medium text-base">GST Rate on Product</label>
              <select id="product-gst-rate" class="rounded-lg border border-base bg-white dark:bg-[#111] px-3 py-1.5 text-sm outline-none">
                <option value="5">5%</option>
                <option value="12">12%</option>
                <option value="18" selected>18%</option>
                <option value="28">28%</option>
                <option value="40">40%</option>
              </select>
            </div>
            <p class="text-[12px] text-muted mt-2">Needed to estimate GST TCS on the product value before GST.</p>
          </div>

          <div>
            <label for="tds-gst-treatment" class="block text-sm font-medium text-base mb-2">Income-tax TDS basis</label>
            <select id="tds-gst-treatment" class="w-full rounded-lg border border-base bg-white dark:bg-[#111] px-3 py-2.5 text-sm outline-none">
              <option value="gross" selected>Full order value, including GST</option>
              <option value="excluding-gst">Exclude separately shown GST when deducted at credit</option>
            </select>
            <p class="text-[12px] text-muted mt-2">Choose the basis that matches your marketplace statement. Applicable annual exclusions are not assessed by this order-level estimate.</p>
          </div>
        </div>
      </div>

      <!-- Output Column -->
      <div class="rounded-2xl border border-accent bg-accent/5 p-6 shadow-sm flex flex-col">
        <h2 class="text-xl font-semibold text-base mb-6 border-b border-accent/20 pb-4">Net Payout Breakdown</h2>
        
        <div class="flex-1 space-y-4 text-[15px]">
          <div class="flex justify-between items-center text-muted">
            <span>Selling Price</span>
            <span class="font-medium text-base" id="out-selling-price">₹0.00</span>
          </div>

          <div class="flex justify-between items-center text-red-500/80">
            <span>Commission & Fixed Fee</span>
            <span id="out-commission">- ₹0.00</span>
          </div>

          <div class="flex justify-between items-center text-red-500/80">
            <span>Shipping Fee</span>
            <span id="out-shipping">- ₹0.00</span>
          </div>

          <div class="flex justify-between items-center text-red-500/80 pb-3 border-b border-accent/10">
            <span>GST on Fees (18%) <span class="text-[11px] text-muted">(check ITC eligibility)</span></span>
            <span id="out-fee-gst">- ₹0.00</span>
          </div>

          <div class="flex justify-between items-center text-amber-600 dark:text-amber-500/90 pt-1">
            <span>0.5% GST TCS <span class="text-[11px] text-muted">(on base price)</span></span>
            <span id="out-tcs">- ₹0.00</span>
          </div>

          <div class="flex justify-between items-center text-amber-600 dark:text-amber-500/90 pt-1">
            <span>0.1% Income Tax TDS <span class="text-[11px] text-muted" id="out-tds-basis">(on full order value)</span></span>
            <span id="out-tds">- ₹0.00</span>
          </div>
        </div>

        <div class="mt-6 pt-6 border-t border-accent/20">
          <div class="text-sm font-medium text-muted uppercase tracking-wider mb-1">Bank Account Payout</div>
          <div class="text-4xl font-extrabold text-accent" id="out-net-payout">₹0.00</div>
          
          <div class="mt-4 flex justify-between items-center text-[13px] bg-white/50 dark:bg-black/20 p-3 rounded-lg border border-accent/10">
            <span class="text-muted">Total Profit Margin:</span>
            <span class="font-bold text-base" id="out-margin">0%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Content / FAQs -->
    <div class="prose prose-neutral dark:prose-invert max-w-none text-[15px] leading-[1.7] border-t border-base pt-12">
      <h2 class="text-[24px] font-semibold text-base mb-6 tracking-[-0.6px]">Understanding Amazon & Flipkart Seller Taxes</h2>
      
      <p>Selling on e-commerce platforms like Amazon, Flipkart, or Meesho in India involves multiple layers of deductions before the money reaches your bank account. This estimate models GST TCS under Section 52 and e-commerce income-tax TDS: Section 194-O for periods governed by the Income-tax Act, 1961, and the corresponding Section 393(1), Table Sl. No. 8(v), under the Income-tax Act, 2025 from Tax Year 2026-27.</p>

      <h3 class="text-[20px] font-semibold text-base mt-10 mb-4 tracking-[-0.6px]">TCS (GST) vs TDS (Income Tax)</h3>
      <p>For supplies to which both provisions apply, the current rates used in this estimate are:</p>
      <ul>
        <li><strong>0.5% GST TCS (Section 52):</strong> Calculated on the <em>net value of taxable supplies</em> made through the operator, excluding the GST amount. The credit is reflected in the seller's GST electronic cash ledger.</li>
        <li><strong>0.1% e-commerce income-tax TDS:</strong> The gross sale amount is the starting point. For applicable periods, CBDT guidance says separately shown GST may be excluded when tax is deducted at credit; if deduction is made at payment before credit, the whole amount may be used. The corresponding Income-tax Act, 2025 provision is Section 393(1), Table Sl. No. 8(v), from Tax Year 2026-27.</li>
      </ul>
      <p><em>Illustration:</em> If a marketplace sale is ₹1,180 including 18% GST, the base taxable value is ₹1,000. Estimated GST TCS is ₹5 (0.5% of ₹1,000). Estimated e-commerce TDS is ₹1.18 on the full order value, or ₹1 when separately shown GST is excluded on the selected basis. This tool does not check the annual ₹5 lakh exclusion available to qualifying individuals/HUFs who provide PAN or Aadhaar. Marketplace statements, deduction timing, and applicable law determine the actual settlement.</p>
      <p>For a focused calculation of GST TCS on net taxable sales and returns, use the <a href="/tcs-gst-calculator" class="text-accent hover:underline">GST TCS calculator</a>.</p>
      <p class="text-sm text-muted">Official references: <a href="https://gstcouncil.gov.in/node/5015" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">GST Notification 15/2024-Central Tax</a> for the Section 52 CGST rate; <a href="https://www.incometaxindia.gov.in/w/section-194-o-6" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Section 194-O</a> for periods under the Income-tax Act, 1961; <a href="https://www.incometaxindia.gov.in/w/section-393-5" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Section 393(1), Table Sl. No. 8(v)</a> for the successor provision; and <a href="https://incometaxindia.gov.in/news/ciruclar-20-2023.pdf" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">CBDT Circular No. 20/2023</a> on GST treatment under Section 194-O.</p>

      <h3 class="text-[20px] font-semibold text-base mt-10 mb-4 tracking-[-0.6px]">Frequently Asked Questions</h3>
      
      <div class="space-y-3 not-prose">
        {faqs.map((faq, i) => (
          <details class="group rounded-[8px] border border-base bg-surface overflow-hidden" id={`faq-ecom-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span class="text-[15px]">{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function updateCalc() {
    const sp = parseFloat(document.getElementById('selling-price').value) || 0;
    const commRate = parseFloat(document.getElementById('commission-rate').value) || 0;
    const fixed = parseFloat(document.getElementById('fixed-fee').value) || 0;
    const shipping = parseFloat(document.getElementById('shipping-fee').value) || 0;
    const prodGst = parseFloat(document.getElementById('product-gst-rate').value) || 18;

    // 1. Base Marketplace Fees
    const commAmt = (sp * commRate) / 100;
    const totalMarketplaceFees = commAmt + fixed;
    
    // 2. GST on Fees (18%)
    const gstOnFees = (totalMarketplaceFees + shipping) * 0.18;

    // 3. GST TCS estimate (0.5% on the product value before GST)
    const exclusivePrice = sp / (1 + (prodGst / 100));
    const tcs = exclusivePrice * 0.005;

    // 4. Income-tax TDS estimate. GST treatment depends on the applicable
    // guidance and deduction timing; let sellers match their marketplace basis.
    const tdsBasis = document.getElementById('tds-gst-treatment')?.value || 'gross';
    const tdsBase = tdsBasis === 'excluding-gst' ? exclusivePrice : sp;
    const tds = tdsBase * 0.001;

    // 5. Net Payout
    const netPayout = sp - totalMarketplaceFees - shipping - gstOnFees - tcs - tds;
    const margin = sp > 0 ? (netPayout / sp) * 100 : 0;

    // Render
    document.getElementById('out-selling-price').textContent = '\u20b9' + sp.toFixed(2);
    document.getElementById('out-commission').textContent = '- \u20b9' + totalMarketplaceFees.toFixed(2);
    document.getElementById('out-shipping').textContent = '- \u20b9' + shipping.toFixed(2);
    document.getElementById('out-fee-gst').textContent = '- \u20b9' + gstOnFees.toFixed(2);
    document.getElementById('out-tcs').textContent = '- \u20b9' + tcs.toFixed(2);
    document.getElementById('out-tds').textContent = '- \u20b9' + tds.toFixed(2);
    document.getElementById('out-tds-basis').textContent = tdsBasis === 'excluding-gst' ? '(excluding separately shown GST)' : '(on full order value)';
    
    const payoutEl = document.getElementById('out-net-payout');
    payoutEl.textContent = '\u20b9' + netPayout.toFixed(2);
    payoutEl.style.color = netPayout < 0 ? '#ef4444' : '';

    const marginEl = document.getElementById('out-margin');
    marginEl.textContent = (sp > 0 ? margin.toFixed(1) : '0.0') + '%';
    marginEl.style.color = margin < 0 ? '#ef4444' : margin < 15 ? '#f59e0b' : '#22c55e';

    // Show warning if payout is negative
    let warning = document.getElementById('payout-warning');
    if (sp > 0 && netPayout < 0) {
      if (!warning) {
        warning = document.createElement('p');
        warning.id = 'payout-warning';
        warning.style.cssText = 'margin-top:12px;padding:10px 14px;border-radius:8px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#ef4444;font-size:13px;font-weight:500;';
        warning.textContent = '\u26a0\ufe0f Warning: Your costs exceed your selling price. You are selling at a loss. Consider raising the price or negotiating lower fees.';
        payoutEl.parentNode.appendChild(warning);
      }
    } else {
      if (warning) warning.remove();
    }
  }

  // Attach listeners
  const inputs = ['selling-price', 'commission-rate', 'fixed-fee', 'shipping-fee', 'product-gst-rate', 'tds-gst-treatment'];
  inputs.forEach(id => {
    document.getElementById(id)?.addEventListener('input', updateCalc);
  });

  // Init
  updateCalc();
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'MRP Revision Calculator — Calculate New MRP After GST Rate Change';
const description = 'Calculate revised product MRP after GST rate changes to preserve profit margins. Free reverse GST calculator for manufacturers, distributors, and retailers.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/mrp-revision-calculator`;

const faqs = [
  {
    q: 'What is the MRP Revision Calculator used for?',
    a: 'The MRP Revision Calculator helps manufacturers, distributors, and retailers recalculate the Maximum Retail Price (MRP) of their pre-packaged goods when the statutory GST rate changes. It reverse-engineers the base taxable value from the existing tax-inclusive MRP and applies the revised rate to establish a legally compliant new MRP that preserves the exact rupee margin.',
  },
  {
    q: 'How do I calculate a revised MRP after a GST rate change?',
    a: 'Step 1: Extract the net base price from the old MRP using: Base Price = Old MRP ÷ (1 + Old GST Rate / 100). Step 2: Apply the revised GST rate: New MRP = Base Price × (1 + New GST Rate / 100). For example, if an item has an old MRP of ₹1,120 at 12% GST, the base price is ₹1,000. Under a revised 5% rate, the new mandatory MRP is ₹1,050.',
  },
  {
    q: 'Is it mandatory to revise MRP stickers after a GST rate reduction?',
    a: 'Yes. Under the Legal Metrology (Packaged Commodities) Rules and Section 171 of the CGST Act (Anti-Profiteering), manufacturers and retailers are legally prohibited from selling goods at the old, higher price following a tax reduction. Retailers must affix revised price stickers or clearly display the lower GST-inclusive price at checkout.',
  },
  {
    q: 'Can existing retail inventory be sold at the old MRP after a GST rate drop?',
    a: 'No. From the effective date of the official CBIC rate notification, all retail sales to consumers must reflect the revised lower price. To avoid repacking, the Ministry of Consumer Affairs permits affixing a revised price sticker on unsold packaged inventory alongside the original printed MRP.',
  },
  {
    q: 'What is the reverse GST calculation formula for extracting base price from MRP?',
    a: 'The reverse GST calculation formula is: Base Price = MRP ÷ (1 + GST Rate / 100). For example, if a product has an MRP of ₹1,180 at 18% GST, the base price equals ₹1,180 ÷ 1.18 = ₹1,000.00, and the embedded tax amount is ₹180.00.',
  },
  {
    q: 'What happens to my profit margin when MRP is recalculated using this tool?',
    a: 'When you recalculate MRP using this tool, your base taxable price and profit margin in rupees remain 100% preserved. The price shift reflects only the reduction or increase in government tax, protecting your gross profit.',
  },
  {
    q: 'How do I revise MRP if the GST rate drops from 28% to 18%?',
    a: 'Enter the current MRP, select 28% as the old rate, and 18% as the new rate. The tool reverse-calculates the base price and applies the 18% rate. For instance, an appliance with an MRP of ₹1,280 at 28% will have a base price of ₹1,000, resulting in a revised MRP of ₹1,180—a direct consumer saving of ₹100.',
  },
  {
    q: 'What happens if a product is reclassified from taxable to 0% (wholly exempt)?',
    a: 'If a product is made exempt (0% GST), the revised MRP equals the extracted base price because no GST is added. However, businesses must note that moving to exempt status requires reversing proportional Input Tax Credit (ITC) under Rule 42 of the CGST Rules.',
  },
  {
    q: 'Does this calculator support composite GST rates with split CGST and SGST?',
    a: 'Yes. In GST pricing, the applicable tax percentage is the aggregate of Central GST (CGST) and State GST (SGST), or Integrated GST (IGST). For example, a 9% CGST + 9% SGST supply represents an 18% total GST rate.',
  },
  {
    q: 'What are the legal penalties for failing to revise MRP after a rate reduction?',
    a: 'Failing to pass on tax reductions can trigger investigations by the Competition Commission of India under Section 171 of the CGST Act, leading to orders for consumer refunds with 18% interest, statutory penalties, and prosecution under the Legal Metrology Act for overcharging above declared prices.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'MRP Revision Calculator',
    url: canonical,
    description: description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];

const lastUpdated = '2026-09-17';
const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/#tools-heading' },
  { name: 'MRP Revision Calculator', href: '/mrp-revision-calculator' },
];
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-12 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-base bg-surface px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-muted mb-4 shadow-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        Retail Relabeling &amp; Packaging Pricing Engine
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-base mb-4">
        MRP Revision Calculator After GST Rate Change
      </h1>
      <p class="text-[16px] text-muted max-w-2xl mx-auto leading-relaxed">
        Relabeling your stock for revised GST slabs? Enter your old MRP and the new tax rate. We'll automatically reverse-calculate your base price and generate the exact revised MRP you need to print to keep your margins identical.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-5xl mx-auto">
      
      <!-- Inputs (Left Column) -->
      <div class="lg:col-span-5 rounded-2xl border border-base bg-surface p-6 sm:p-8 shadow-sm space-y-6">
        <div>
          <label for="old-mrp" class="block text-sm font-semibold text-base mb-2">Old MRP (Inclusive of Tax)</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-muted font-medium select-none font-mono" aria-hidden="true">₹</span>
            <input id="old-mrp" type="number" min="0" step="any" placeholder="1180" class="w-full rounded-xl border border-base bg-subtle pl-9 pr-4 py-3 text-[16px] font-mono focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-all shadow-inner" />
          </div>
          <p class="text-[11px] text-muted mt-1.5">Existing printed sticker price on your packaging.</p>
        </div>
        
        <div>
          <label for="old-rate" class="block text-sm font-semibold text-base mb-2">Previous GST Rate</label>
          <select id="old-rate" class="w-full rounded-xl border border-base bg-subtle px-4 py-3 text-sm focus:border-accent focus:outline-none transition-all cursor-pointer">
            <option value="3">3% (Precious Metals / Jewellery)</option>
            <option value="5">5% (Essential Commodities)</option>
            <option value="12">12% (Standard Lower)</option>
            <option value="18" selected>18% (Standard Higher)</option>
            <option value="28">28% (Peak / Automobiles)</option>
          </select>
        </div>
        
        <div>
          <label for="new-rate" class="block text-sm font-semibold text-base mb-2">Revised / New GST Rate</label>
          <select id="new-rate" class="w-full rounded-xl border border-accent/40 bg-accent/5 px-4 py-3 text-sm text-accent focus:border-accent focus:outline-none transition-all cursor-pointer font-medium">
            <option value="0">0% (Nil / Exempt)</option>
            <option value="3">3% (Precious Metals / Jewellery)</option>
            <option value="5" selected>5% (Essential Commodities)</option>
            <option value="12">12% (Standard Lower)</option>
            <option value="18">18% (Standard Higher)</option>
            <option value="28">28% (Peak / Automobiles)</option>
            <option value="40">40% (Consolidated Luxury/Sin)</option>
          </select>
        </div>

        <button id="btn-reset" type="button" class="w-full rounded-xl border border-base py-3 text-xs font-semibold text-muted hover:text-base hover:bg-subtle transition-all cursor-pointer">
          Reset Fields
        </button>
      </div>

      <!-- Outputs (Right Column) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="rounded-2xl border border-base bg-subtle p-8 flex flex-col justify-center items-center text-center h-full min-h-[260px] shadow-sm">
          <p class="text-xs font-mono uppercase tracking-wider text-muted mb-2 font-medium">Revised Mandatory MRP to Print</p>
          <p class="text-5xl sm:text-6xl font-bold text-accent font-mono tracking-tight leading-none mb-4" id="new-mrp">₹0.00</p>
          
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface border border-base text-sm font-medium shadow-sm">
            <span class="text-muted">Price Variance:</span>
            <span id="mrp-diff" class="font-mono text-base">₹0.00</span>
          </div>
        </div>

        <!-- Breakdown Details -->
        <div class="rounded-2xl border border-base bg-surface p-6 shadow-sm">
          <h2 class="text-sm font-bold text-base mb-4 uppercase tracking-wider text-muted">Calculation Breakdown</h2>
          <div class="space-y-3 text-sm">
            <div class="flex justify-between items-center border-b border-base pb-2.5">
              <span class="text-muted">Extracted Base Price (Margin Preserved)</span>
              <span class="font-mono font-semibold text-base" id="base-price">₹0.00</span>
            </div>
            <div class="flex justify-between items-center border-b border-base pb-2.5">
              <span class="text-muted">Old Tax Amount (<span id="lbl-old-rate">18%</span>)</span>
              <span class="font-mono font-medium text-rose-500" id="old-tax">₹0.00</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-muted">New Tax Amount (<span id="lbl-new-rate">5%</span>)</span>
              <span class="font-mono font-medium text-emerald-500" id="new-tax">₹0.00</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- In-Depth Regulatory Guide -->
    <article class="prose prose-neutral dark:prose-invert max-w-none text-[15px] leading-relaxed mt-16 pt-12 border-t border-base">
      <h2 class="text-2xl sm:text-3xl font-bold text-base mb-6">Legal Metrology &amp; Anti-Profiteering Rules for MRP Revisions</h2>
      
      <p>
        When the GST Council notifies tax rate amendments under the CGST Act, consumer-facing packaged goods governed by the <strong>Legal Metrology Act, 2009</strong> and the <strong>Legal Metrology (Packaged Commodities) Rules, 2011</strong> require prompt pricing recalibrations. Before adjusting packaging labels, always <a href="/gst-rate-finder/" class="text-accent hover:underline font-medium">check the applicable GST rate</a> and official CBIC notification to confirm the exact effective date of the rate transition.
      </p>

      <h3 class="text-xl font-semibold text-base mt-6 mb-3">1. Reverse Calculation of Base Taxable Price</h3>
      <p>
        Because retail MRP is universally tax-inclusive in India, manufacturers cannot simply subtract or add percentages directly to the retail price. The fundamental formula to determine the base manufacturer realisation is:
      </p>
      <div class="my-3 p-3 bg-subtle rounded-lg font-mono text-xs">
        Base Realisation = Old Printed MRP ÷ (1 + Old GST Rate ÷ 100)
      </div>
      <p>
        By preserving this base realisation and applying the new rate, your enterprise ensures that dealer commissions, distribution margins, and company profits remain untouched, while passing on the exact tax differential mandated by law. If you need to evaluate different supply valuations or tax splits, you can <a href="/gst-calculator/" class="text-accent hover:underline font-medium">calculate GST on the revised price</a> using our general calculator.
      </p>

      <h3 class="text-xl font-semibold text-base mt-6 mb-3">2. Section 171 Anti-Profiteering Compliance</h3>
      <p>
        Under Section 171 of the CGST Act, any reduction in GST rates must be immediately passed on to the buyer. Maintaining the previous MRP when the GST rate drops constitutes illegal profiteering. The National Anti-Profiteering mechanism (now monitored by the Competition Commission of India) can impose penalties and mandate refunds with statutory interest if prices are not commensurate with tax cuts.
      </p>

      <h3 class="text-xl font-semibold text-base mt-6 mb-3">3. Permissible Methods for Relabeling Stock</h3>
      <p>
        Following tax rate revisions, the Department of Consumer Affairs permits manufacturers, packers, and importers to declare revised lower MRPs on unsold inventory via:
      </p>
      <ul>
        <li>Affixing an additional sticker with the revised lower MRP alongside the original price.</li>
        <li>Ensuring that the original MRP remains visible to the customer for transparency.</li>
        <li>Updating the barcode/POS billing database so cash registers automatically bill at the revised price even if physical stickering is in progress.</li>
      </ul>
    </article>

    <!-- Related Tools Cluster -->
    <div class="border-t border-base pt-12 mt-12">
      <h2 class="text-2xl font-bold text-base mb-6">Related GST Rate &amp; Pricing Tools</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/gst-rate-comparison" class="p-4 rounded-xl border border-base bg-surface hover:border-accent hover:shadow-sm transition-all group">
          <div class="font-semibold text-base group-hover:text-accent flex items-center gap-1.5">
            GST Rate Comparison Tool →
          </div>
          <p class="text-xs text-muted mt-1">Compare tax impact, consumer savings, and anti-profiteering mandates side-by-side.</p>
        </a>
        <a href="/gst-rate-finder" class="p-4 rounded-xl border border-base bg-surface hover:border-accent hover:shadow-sm transition-all group">
          <div class="font-semibold text-base group-hover:text-accent flex items-center gap-1.5">
            GST Rate Finder →
          </div>
          <p class="text-xs text-muted mt-1">Search HSN and SAC codes with verified current GST rates across all commodities.</p>
        </a>
        <a href="/gst-calculator" class="p-4 rounded-xl border border-base bg-surface hover:border-accent hover:shadow-sm transition-all group">
          <div class="font-semibold text-base group-hover:text-accent flex items-center gap-1.5">
            GST Inclusive/Exclusive Calculator →
          </div>
          <p class="text-xs text-muted mt-1">Add or remove GST with split CGST, SGST, and IGST breakdowns.</p>
        </a>
      </div>
    </div>

    <!-- FAQ Section -->
    <section class="border-t border-base pt-12 pb-20 mt-16" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-base mb-2">Frequently Asked Questions</h2>
      <p class="text-muted text-[15px] mb-8">Everything you need to know about revising MRP labels after GST rate revisions.</p>
      
      <div class="space-y-3">
        {faqs.map((faq, i) => (
          <details class="group rounded-xl border border-base bg-surface overflow-hidden" id={`faq-mrp-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span class="text-[15px]">{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  const inOldMrp = document.getElementById("old-mrp") as HTMLInputElement;
  const inOldRate = document.getElementById("old-rate") as HTMLSelectElement;
  const inNewRate = document.getElementById("new-rate") as HTMLSelectElement;
  const btnReset = document.getElementById("btn-reset") as HTMLButtonElement;
  const outNewMrp = document.getElementById("new-mrp")!;
  const outMrpDiff = document.getElementById("mrp-diff")!;
  const outBasePrice = document.getElementById("base-price")!;
  const outOldTax = document.getElementById("old-tax")!;
  const outNewTax = document.getElementById("new-tax")!;
  const lblOldRate = document.getElementById("lbl-old-rate")!;
  const lblNewRate = document.getElementById("lbl-new-rate")!;

  function formatINR(val: number) {
    const rounded = Math.round(val * 100) / 100;
    return "₹" + rounded.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function calculate() {
    const oldMrp = parseFloat(inOldMrp.value) || 0;
    const oldRate = parseFloat(inOldRate.value) || 0;
    const newRate = parseFloat(inNewRate.value) || 0;

    lblOldRate.textContent = `${oldRate}%`;
    lblNewRate.textContent = `${newRate}%`;

    if (oldMrp === 0) {
      outNewMrp.textContent = "₹0.00";
      outBasePrice.textContent = "₹0.00";
      outOldTax.textContent = "₹0.00";
      outNewTax.textContent = "₹0.00";
      outMrpDiff.textContent = "Enter MRP above";
      outMrpDiff.className = "text-muted font-semibold font-mono";
      return;
    }

    const basePrice = oldMrp / (1 + oldRate / 100);
    const oldTax = oldMrp - basePrice;
    const newTax = basePrice * (newRate / 100);
    const newMrp = basePrice + newTax;
    const diff = newMrp - oldMrp;

    outNewMrp.textContent = formatINR(newMrp);
    outBasePrice.textContent = formatINR(basePrice);
    outOldTax.textContent = formatINR(oldTax);
    outNewTax.textContent = formatINR(newTax);

    if (diff > 0.005) {
      outMrpDiff.textContent = `+ ${formatINR(Math.abs(diff))}`;
      outMrpDiff.className = "text-rose-600 dark:text-rose-400 font-semibold font-mono";
    } else if (diff < -0.005) {
      outMrpDiff.textContent = `- ${formatINR(Math.abs(diff))}`;
      outMrpDiff.className = "text-emerald-600 dark:text-emerald-400 font-semibold font-mono";
    } else {
      outMrpDiff.textContent = "No Change";
      outMrpDiff.className = "text-base font-semibold font-mono";
    }
  }

  inOldMrp.addEventListener("input", calculate);
  inOldRate.addEventListener("change", calculate);
  inNewRate.addEventListener("change", calculate);

  btnReset.addEventListener("click", () => {
    inOldMrp.value = "";
    inOldRate.value = "18";
    inNewRate.value = "5";
    calculate();
  });

  calculate();
</script>

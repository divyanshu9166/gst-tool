---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalSources from '../components/LegalSources.astro';
import CalculatorMethodology from '../components/CalculatorMethodology.astro';
import TaxDisclaimer from '../components/TaxDisclaimer.astro';

const title = 'GST Composition Scheme Calculator 2026';
const description = 'Check your eligibility for the GST Composition Scheme and instantly calculate your flat tax liability (1%, 5%, 6%) for small businesses in India.';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Composition Scheme Calculator',
    url: Astro.site?.toString() ? `${Astro.site}composition-scheme-calculator` : 'https://example.com/composition-scheme-calculator',
    description: 'Calculate GST Composition Scheme eligibility and flat tax liability.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: "What is the GST composition scheme limit for 2026?", acceptedAnswer: { '@type': 'Answer', text: "For most states, the turnover limit for the GST composition scheme is ₹1.5 crore. For North-Eastern and special category states, it is ₹75 lakhs." } },
      { '@type': 'Question', name: "Can a composition dealer collect GST from customers?", acceptedAnswer: { '@type': 'Answer', text: "No. A composition dealer cannot charge GST on their invoices (they issue a 'Bill of Supply') and cannot claim Input Tax Credit." } },
      {
        '@type': 'Question',
        name: 'What is the turnover limit for the GST Composition Scheme in 2026?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'For normal states, the turnover limit is ₹1.5 Crore for manufacturers and traders. For special category states (North Eastern states and hill states), the limit is ₹75 Lakhs. For pure service providers across India, the limit is strictly ₹50 Lakhs.',
        }
      },
      {
        '@type': 'Question',
        name: 'What are the GST rates under the Composition Scheme?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The flat tax rates are: 1% for Manufacturers and Traders, 5% for Restaurants not serving alcohol, and 6% for Service Providers.',
        }
      },
      {
        '@type': 'Question',
        name: 'Can a composition dealer issue a Tax Invoice?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. A composition dealer cannot issue a Tax Invoice or collect GST from customers. They must issue a "Bill of Supply" and pay the flat tax out of their own pocket.',
        }
      },
      {
        '@type': 'Question',
        name: 'Can a Composition Dealer claim Input Tax Credit (ITC)?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. A dealer registered under the composition scheme is strictly prohibited from claiming any Input Tax Credit (ITC) on the purchases they make.',
        }
      },
      {
        '@type': 'Question',
        name: 'Can a composition dealer make inter-state sales?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. A composition dealer can purchase goods from other states (inter-state purchases), but they are strictly prohibited from selling goods to other states (inter-state sales).',
        }
      },
      {
        '@type': 'Question',
        name: 'Can I sell on Amazon/Flipkart under the Composition Scheme?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Businesses that supply goods through an e-commerce operator who is required to collect Tax Collected at Source (TCS) cannot opt for the Composition Scheme.',
        }
      },
      {
        '@type': 'Question',
        name: 'What returns does a composition dealer need to file?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Unlike normal taxpayers who file monthly returns, a composition dealer must file a quarterly statement called CMP-08 to pay the tax, and an annual return called GSTR-4.',
        }
      },
      {
        '@type': 'Question',
        name: 'What happens if my turnover crosses ₹1.5 Crore mid-year?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The moment your turnover crosses the ₹1.5 Crore limit (or ₹75 Lakh limit in special states) during the financial year, you must immediately transition to the normal GST scheme and start issuing Tax Invoices.',
        }
      }
    ]
  }
];

const businessTypes = [
  { id: 'trader', name: 'Trader / Retailer', rate: 1, limit: 15000000, splLimit: 7500000 },
  { id: 'manufacturer', name: 'Manufacturer', rate: 1, limit: 15000000, splLimit: 7500000 },
  { id: 'restaurant', name: 'Restaurant (Non-Alcoholic)', rate: 5, limit: 15000000, splLimit: 7500000 },
  { id: 'service', name: 'Service Provider / Freelancer', rate: 6, limit: 5000000, splLimit: 5000000 },
];

const lastUpdated = '2026-07-25';
const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/#tools-heading' },
  { name: 'Composition Scheme Calculator', href: '/composition-scheme-calculator' },
];
---

<BaseLayout {title} {description} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-12 lg:py-24">
    <!-- Header -->
    <div class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-base bg-surface px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-muted mb-4 shadow-[0_1px_1px_#00000005]">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        100% Offline Tool
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-base mb-4">
        Composition Scheme Calculator
      </h1>
      <p class="text-[16px] text-muted max-w-xl mx-auto leading-relaxed mb-6">
        Instantly check your eligibility for the GST Composition Scheme and calculate your flat quarterly tax liability.
      </p>
      <div class="bg-blue-50 dark:bg-blue-950/20 border-l-4 border-blue-500 p-4 text-left rounded-r-lg text-sm text-base leading-relaxed max-w-xl mx-auto">
        <strong>Quick Answer (Composition Rates 2026):</strong> The GST composition rate is 1% for traders/manufacturers, 5% for restaurants, and 6% for service providers. Turnover limit is ₹1.5 Crore (₹75 Lakh for special states) or ₹50 Lakh for services. No ITC is allowed, and taxes are filed quarterly via CMP-08.
      </div>
    </div>

    <!-- Main Tool Container -->
    <div class="rounded-[12px] border border-base bg-surface p-6 sm:p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] mb-12">
      <div class="flex flex-col gap-6">
        
        <div class="grid grid-cols-1 gap-6">
          <div class="flex flex-col gap-2">
            <label for="biz-type" class="text-sm font-semibold text-base">Business Category</label>
            <select 
              id="biz-type" 
              class="w-full rounded-md border border-base bg-surface px-4 py-3 text-[16px] font-medium focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
            >
              <option value="" disabled selected>Select Business Type...</option>
              {businessTypes.map(b => <option value={b.id}>{b.name} ({b.rate}%)</option>)}
            </select>
          </div>

          <div class="flex items-center gap-3">
            <input type="checkbox" id="spl-category" class="w-5 h-5 rounded border-base text-accent focus:ring-accent" />
            <label for="spl-category" class="text-sm font-medium text-base cursor-pointer">
              My business is located in a Special Category State (e.g. North East, Uttarakhand, etc.)
            </label>
          </div>

          <div class="flex flex-col gap-2">
            <label for="turnover" class="text-sm font-semibold text-base">Annual Aggregate Turnover (₹)</label>
            <input 
              type="number" 
              id="turnover" 
              class="w-full rounded-md border border-base bg-surface px-4 py-3 text-[16px] font-mono focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
              placeholder="e.g. 4500000"
              min="0"
            />
          </div>
        </div>

      </div>

      <!-- Result Card -->
      <div id="result-card" class="mt-8 hidden overflow-hidden rounded-[8px] border border-base bg-subtle transition-all duration-300">
        
        <div id="status-eligible" class="hidden">
          <div class="p-6">
            <div class="flex items-center gap-3 mb-4">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-green-100 text-green-600 dark:bg-green-900/30 dark:text-green-400">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </span>
              <h3 class="text-lg font-bold text-green-700 dark:text-green-400">You are Eligible!</h3>
            </div>
            
            <p class="text-sm text-muted mb-6">Based on your turnover, you are eligible to opt for the Composition Scheme.</p>
            
            <div class="space-y-4">
              <div class="flex justify-between items-center text-muted">
                <span>Applicable Flat Rate:</span>
                <span class="text-lg font-bold text-base" id="res-rate">0%</span>
              </div>
              <div class="flex justify-between items-center pt-4 border-t border-base/50">
                <span class="text-lg font-bold text-accent">Total Flat Tax Payable:</span>
                <span class="text-3xl font-mono font-bold text-accent" id="res-tax">₹0</span>
              </div>
            </div>
          </div>
          
          <div class="border-t border-green-200/50 bg-green-50 dark:bg-green-900/10 dark:border-green-900/30 p-4">
            <p class="text-sm text-green-700 dark:text-green-400 font-medium">
              💡 You must pay this out of your own pocket. You cannot collect this tax from your customers or claim any Input Tax Credit (ITC).
            </p>
          </div>
        </div>

        <div id="status-ineligible" class="hidden">
          <div class="p-6 bg-red-50 dark:bg-red-900/10">
            <div class="flex items-center gap-3 mb-4">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-400">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
              </span>
              <h3 class="text-lg font-bold text-red-700 dark:text-red-400">Not Eligible</h3>
            </div>
            <p class="text-sm text-red-700 dark:text-red-400 font-medium leading-relaxed" id="ineligible-reason"></p>
          </div>
        </div>

      </div>
    </div>

    <!-- SEO Content -->
    <article class="prose prose-neutral dark:prose-invert max-w-none text-[15px] leading-relaxed">
      <h2 class="text-2xl font-semibold mb-4">Understanding the GST Composition Scheme</h2>
      <p>
        The GST Composition Scheme is a simplified, alternate tax payment mechanism designed by the Central Board of Indirect Taxes and Customs (CBIC) specifically for small taxpayers. The primary objective of the scheme is to bring simplicity and reduce the compliance cost for small businesses, startups, and local retailers in India. 
      </p>
      <p>
        Under the normal GST scheme, a business must maintain meticulous records of every purchase and sale, calculate Input Tax Credit (ITC) for hundreds of invoices, and file complex monthly returns (GSTR-1, GSTR-3B). By opting into the Composition Scheme, small businesses can bypass all of this. Instead, they simply calculate their total aggregate turnover for the quarter and pay a small, flat percentage of it directly to the government. Use our <strong>GST Composition Scheme Calculator</strong> to find your exact liability instantly.
      </p>
      
      <h3>Who is Eligible for the Composition Scheme?</h3>
      <p>
        Eligibility is determined by your aggregate annual turnover from the preceding financial year, your business activity, and the state in which your principal place of business is registered under Section 10 of the CGST Act.
      </p>
      <ul>
        <li><strong>Section 10 Goods Suppliers (Manufacturers and Traders):</strong> Eligible if aggregate turnover in the preceding financial year was up to ₹1.5 Crore. For businesses in Special Category States (Arunachal Pradesh, Manipur, Meghalaya, Mizoram, Nagaland, Sikkim, Tripura, and Uttarakhand), the statutory limit is ₹75 Lakhs.</li>
        <li><strong>Section 10(1)(b) Restaurant Services:</strong> Eligible if annual aggregate turnover is up to ₹1.5 Crore. Note that restaurants serving alcoholic beverages cannot opt for composition, as alcohol is non-GST.</li>
        <li><strong>6% Service Supplier Scheme:</strong> Pure service providers (or mixed suppliers not covered under Section 10) are governed by Section 10(2A) and <strong>Notification No. 2/2019-Central Tax (Rate)</strong>, which establishes a distinct ₹50 Lakhs turnover ceiling.</li>
      </ul>

      <h3>The Tax Rates (1%, 5%, 6%)</h3>
      <p>Under the composition framework, tax rates are lower than standard GST rates (which range from 5% to 28%). However, the taxpayer must pay this flat tax directly without collecting it from customers:</p>
      <ul>
        <li><strong>Manufacturers (Goods):</strong> 1% (0.5% CGST + 0.5% SGST) on total turnover.</li>
        <li><strong>Traders &amp; Retailers:</strong> 1% (0.5% CGST + 0.5% SGST) on the turnover of <em>taxable supplies</em> only.</li>
        <li><strong>Restaurants:</strong> 5% (2.5% CGST + 2.5% SGST) on total turnover.</li>
        <li><strong>Service Providers (Notification 2/2019):</strong> 6% (3% CGST + 3% SGST) on total turnover.</li>
      </ul>

      <h3>Statutory Limitations and Operational Conditions</h3>
      <p>
        While it reduces return filing complexity, the Composition Scheme comes with defined statutory constraints. Review these factors before deciding to opt in:
      </p>
      <ol>
        <li><strong>No Input Tax Credit (ITC):</strong> You cannot claim ITC on purchases or capital goods. Any tax paid to your suppliers becomes an operational cost.</li>
        <li><strong>No Tax Collection:</strong> You cannot charge GST on customer invoices. You must issue a "Bill of Supply" endorsed with the words <em>"Composition taxable person, not eligible to collect tax on supplies"</em>.</li>
        <li><strong>No Inter-State Outward Sales:</strong> You are restricted to making intra-state outward supplies of goods and services. Inter-state inward purchases are permitted.</li>
        <li><strong>E-Commerce Supplies (Notification 36/2023):</strong> Composition dealers cannot make inter-state supplies through e-commerce operators. However, under <strong>Notification No. 36/2023-Central Tax</strong>, composition dealers are permitted to make intra-state supplies of goods through e-commerce operators (ECOs) subject to obtaining an enrollment number on the GST portal and meeting specified inventory conditions.</li>
        <li><strong>Non-Taxable &amp; Excluded Goods:</strong> You cannot supply goods outside GST (such as motor spirits or alcohol). Furthermore, manufacturers of notified products (such as pan masala, tobacco, ice cream, and aerated waters) are ineligible for the scheme.</li>
      </ol>

      <h3>Quarterly Return Filing &amp; Due Dates</h3>
      <p>
        Composition dealers file statement <strong>CMP-08</strong> quarterly by the 18th of the month following each quarter, and submit the annual return <strong>GSTR-4</strong> by 30th April following the financial year. You can track all upcoming quarterly deadlines with our <a href="/gst-due-dates/" class="text-accent hover:underline font-medium">GST due dates calendar</a>, or use our <a href="/gst-calculator/" class="text-accent hover:underline font-medium">general GST calculator</a> to model regular regime tax splits.
      </p>

      <!-- Methodology & Legal Sources -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 not-prose">
        <CalculatorMethodology
          calculates="Estimated quarterly and annual composition tax liability based on chosen business category rate (1%, 5%, or 6%) and aggregate turnover."
          doesNotDetermine="Statutory eligibility to opt in, presence of inter-state supplies, manufacture of excluded commodities, or formal portal approval."
          inputs="Business Category, Special Category State flag, Annual Aggregate Turnover (₹)"
          formula="Composition Tax = Turnover × Category Rate (1% Goods, 5% Restaurant, 6% Services)"
          applicablePeriod="FY 2025-26 &amp; FY 2026-27"
          primarySource="Section 10 of CGST Act, 2017 &amp; Notification No. 2/2019-Central Tax (Rate)"
          formulaLastReviewed="19 September 2026"
        />

        <LegalSources
          sources={[
            { title: "Section 10, CGST Act, 2017", description: "composition levy framework for goods and restaurants" },
            { title: "Notification No. 2/2019-Central Tax (Rate)", url: "https://www.cbic.gov.in", description: "6% presumptive scheme for service suppliers up to ₹50 Lakh" },
            { title: "Notification No. 36/2023-Central Tax", url: "https://www.cbic.gov.in", description: "conditions for intra-state supply of goods through ECOs" },
            { title: "Rule 3 to 7, CGST Rules, 2017", description: "intimation, validity, and conditions for composition levy" }
          ]}
          reviewedDate="19 September 2026"
        />
      </div>

      <div class="mt-6 not-prose">
        <TaxDisclaimer />
      </div>
    </article>

    
  <!-- Related Guides -->
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-12">
    <div class="border-t border-base pt-12">
      <h2 class="text-[24px] font-semibold text-base mb-4">Related Guides</h2>
      <ul class="list-disc pl-5 space-y-2">
        <li><a href="/blog/gst-composition-scheme-2026" class="text-primary hover:underline font-medium">GST Composition Scheme 2026: Eligibility, Rates (1%/5%/6%) &amp; How to Opt In</a></li>
        <li><a href="/blog/cmp08-due-dates-composition-scheme" class="text-primary hover:underline font-medium">CMP-08 Due Dates, Filing Calendar &amp; 18% Penalties for Composition Taxpayers</a></li>
        <li><a href="/blog/gst-late-fee-calculator" class="text-primary hover:underline">GSTR-3B Late Fee &amp; Interest: How Much a Delayed Filing Really Costs</a></li>
      </ul>
    </div>
  </div>
<script>
const bizData = {
  trader: { rate: 1, limit: 15e6, splLimit: 75e5 },
  manufacturer: { rate: 1, limit: 15e6, splLimit: 75e5 },
  restaurant: { rate: 5, limit: 15e6, splLimit: 75e5 },
  service: { rate: 6, limit: 5e6, splLimit: 5e6 }
};
const typeSelect = document.getElementById("biz-type");
const splCheck = document.getElementById("spl-category");
const toInput = document.getElementById("turnover");
const resultCard = document.getElementById("result-card");
const statusEligible = document.getElementById("status-eligible");
const statusIneligible = document.getElementById("status-ineligible");
const resRate = document.getElementById("res-rate");
const resTax = document.getElementById("res-tax");
const ineligibleReason = document.getElementById("ineligible-reason");
function formatCur(num) {
  return "\u20B9" + num.toLocaleString("en-IN", { maximumFractionDigits: 0 });
}
function calculate() {
  const type = typeSelect.value;
  const to = parseFloat(toInput.value) || 0;
  const isSpl = splCheck.checked;
  if (!type || to === 0) {
    resultCard.classList.add("hidden");
    return;
  }
  resultCard.classList.remove("hidden");
  const config = bizData[type];
  const maxLimit = isSpl ? config.splLimit : config.limit;
  if (to > maxLimit) {
    statusEligible.classList.add("hidden");
    statusIneligible.classList.remove("hidden");
    ineligibleReason.innerHTML = `Your aggregate turnover of <strong>${formatCur(to)}</strong> exceeds the legally permissible limit of <strong>${formatCur(maxLimit)}</strong> for your business category and state classification. You must register under the normal GST scheme.`;
  } else {
    statusIneligible.classList.add("hidden");
    statusEligible.classList.remove("hidden");
    resRate.textContent = `${config.rate}%`;
    const flatTax = to * (config.rate / 100);
    resTax.textContent = formatCur(flatTax);
  }
}
[typeSelect, splCheck, toInput].forEach((el) => el.addEventListener("input", calculate));
</script>

    <!-- FAQ Section -->
    <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-20 mt-16 pt-12 border-t border-base" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-base mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {structuredData[1].mainEntity.map((faq, i) => (
          <details class="group rounded-xl border border-base bg-surface overflow-hidden" id={`faq-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span>{faq.name}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[15px] text-muted leading-relaxed border-t border-base pt-4">{faq.acceptedAnswer.text}</div>
          </details>
        ))}
      </div>
    </section>
</BaseLayout>

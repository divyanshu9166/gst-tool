---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';

const title = 'TDS Section Finder & Rate Chart 2025-26 & 2026-27 | Taxzentic';
const description = 'Searchable TDS Section Finder for India. Find exact TDS rates, thresholds, and sections (194C, 194J, 194I, 194H, 194Q, 194IA). Free interactive TDS calculator.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/tds-section-finder`;

const faqs = [
  {
    q: 'What is the TDS rate under Section 194C for contractors and subcontractors?',
    a: 'Under Section 194C, TDS is deducted at 1% if the contractor is an Individual or HUF, and at 2% for Companies, Partnership Firms, or LLPs. Deduction applies if a single invoice exceeds ₹30,000 or aggregate annual payments exceed ₹1,00,000.',
  },
  {
    q: 'What is the difference between Section 194J technical services and professional fees?',
    a: 'Under Section 194J, Fees for Technical Services (FTS), royalty, and call centre operations attract a reduced TDS rate of 2%. In contrast, professional fees (lawyers, CAs, doctors, architects, consultants) and director remuneration attract 10% TDS. The annual threshold is ₹30,000.',
  },
  {
    q: 'What is the TDS rate on rent under Section 194-I versus Section 194-IB?',
    a: 'Section 194-I applies to entities under tax audit: 10% on land, building, or furniture (threshold ₹2,40,000/year) and 2% on plant and machinery. Section 194-IB applies to non-audit individuals/HUFs paying rent exceeding ₹50,000 per month (concessional rate of 2%).',
  },
  {
    q: 'What is the statutory due date to deposit TDS with the Central Government?',
    a: 'TDS deducted in any month from April to February must be deposited via challan ITNS 281 by the 7th of the following month. For March deductions, the statutory payment deadline is extended to 30th April.',
  },
  {
    q: 'What is the penal TDS rate under Section 206AA if PAN is not provided?',
    a: 'Under Section 206AA, if the deductee fails to provide a valid PAN, TDS must be deducted at the higher of: the rate specified in the Act, or 20% (subject to specific 5% caps in sections like 194-IB/194M/194Q).',
  },
  {
    q: 'How does Section 194Q apply to purchase of goods over ₹50 Lakhs?',
    a: 'Under Section 194Q, a buyer whose business turnover exceeded ₹10 Crores in the preceding financial year must deduct 0.1% TDS on aggregate purchase of goods from a resident seller exceeding ₹50 Lakhs in the current financial year.',
  },
  {
    q: 'How is TDS deducted and deposited for immovable property purchase under Section 194-IA?',
    a: 'A buyer purchasing immovable property (other than agricultural land) valued at ₹50 Lakhs or more must deduct 1% TDS. The buyer must file challan-cum-statement Form 26QB within 30 days from the end of the month in which deduction was made.',
  },
  {
    q: 'What is the deadline for issuing Form 16A quarterly TDS certificates?',
    a: 'Deductors must issue Form 16A within 15 days from the due date of filing quarterly TDS returns: 15th August (Q1), 15th November (Q2), 15th February (Q3), and 15th June (Q4).',
  },
  {
    q: 'What interest penalty applies for late deduction versus late deposit of TDS?',
    a: 'Under Section 201(1A), delay in deducting TDS attracts simple interest of 1% per month or part of a month from the date tax was deductible. Delay in depositing deducted tax attracts 1.5% per month until deposited.',
  },
  {
    q: 'Does this TDS directory calculator save or transmit any payment data?',
    a: 'No. The search engine, rate directory, and instant tax calculator execute 100% locally in your client browser session. No transaction values or PAN statuses are stored or transmitted.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'TDS Section Finder and Calculator India',
    url: canonical,
    description: 'Lookup TDS rates, statutory exemption limits, and compute exact tax deducted at source.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'INR',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Income Tax Tools', href: '/income-tax-tools' },
  { name: 'TDS Section Finder', href: '/tds-section-finder' },
];

const lastUpdated = '2026-09-15';
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <!-- Header -->
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-50/50 dark:bg-blue-950/40 px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-accent mb-4">
        <span class="h-2 w-2 rounded-full bg-accent animate-pulse"></span>
        TDS Master Directory · FY 2025-26 & 2026-27
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-base mb-4">
        TDS Section Finder & Rate Chart
      </h1>
      <p class="text-[17px] text-muted max-w-2xl mx-auto leading-relaxed">
        Search any TDS section by payment type (Contractor, Rent, Professional, Salary) or section code. Calculate exact deduction amount and net payout instantly.
      </p>
    </div>

    <!-- Quick Interactive Calculator Widget -->
    <div class="rounded-2xl border border-base bg-surface p-6 sm:p-8 shadow-sm mb-12">
      <h2 class="text-xl font-bold text-base mb-6 flex items-center gap-2">
        <ToolIcon name="calculator" class="w-5 h-5 text-accent" />
        Instant TDS Deduction Calculator
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-6">
        <div>
          <label for="calc-section" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-2">Select Section</label>
          <select id="calc-section" class="w-full rounded-xl border border-base bg-subtle px-4 py-3 text-sm focus:border-accent focus:outline-none">
            <option value="194C-ind">194C — Contractor (Individual/HUF) — 1%</option>
            <option value="194C-co">194C — Contractor (Company/Firm) — 2%</option>
            <option value="194J-prof">194J — Professional Fees — 10%</option>
            <option value="194J-tech">194J — Technical Services (FTS) — 2%</option>
            <option value="194I-rent-land">194I — Rent on Land/Building — 10%</option>
            <option value="194I-rent-plant">194I — Rent on Plant/Machinery — 2%</option>
            <option value="194IB-rent">194IB — Rent by Ind/HUF (&gt;₹50k/mo) — 2%</option>
            <option value="194H-comm">194H — Commission / Brokerage — 2%</option>
            <option value="194Q-goods">194Q — Purchase of Goods (&gt;₹50L) — 0.1%</option>
            <option value="194IA-prop">194IA — Purchase of Property (&gt;₹50L) — 1%</option>
            <option value="194A-int">194A — Interest other than Securities — 10%</option>
            <option value="194S-crypto">194S — Virtual Digital Asset / Crypto — 1%</option>
          </select>
        </div>

        <div>
          <label for="calc-amount" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-2">Invoice / Payment (₹)</label>
          <input type="number" id="calc-amount" value="100000" min="0" step="5000" class="w-full rounded-xl border border-base bg-subtle px-4 py-3 font-mono text-sm focus:border-accent focus:outline-none" />
        </div>

        <div>
          <label for="calc-pan" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-2">PAN Provided?</label>
          <select id="calc-pan" class="w-full rounded-xl border border-base bg-subtle px-4 py-3 text-sm focus:border-accent focus:outline-none">
            <option value="yes">Yes (Normal Statutory Rate)</option>
            <option value="no">No (Sec 206AA Penal Rate — 20%)</option>
          </select>
        </div>
      </div>

      <!-- Quick Result Bar -->
      <div class="p-5 rounded-xl border border-accent/20 bg-accent/5 flex flex-wrap items-center justify-between gap-4">
        <div>
          <span class="text-xs text-muted uppercase font-mono block">Applicable TDS Rate:</span>
          <span class="text-xl font-bold text-accent font-mono" id="res-rate">1.0%</span>
        </div>
        <div>
          <span class="text-xs text-muted uppercase font-mono block">TDS to Deduct:</span>
          <span class="text-xl font-bold text-rose-600 font-mono" id="res-tds">₹1,000</span>
        </div>
        <div>
          <span class="text-xs text-muted uppercase font-mono block">Net Payable to Payee:</span>
          <span class="text-xl font-bold text-emerald-600 font-mono" id="res-net">₹99,000</span>
        </div>
      </div>
    </div>

    <!-- Searchable Directory -->
    <div class="mb-12">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-base">Complete TDS Section Rate Chart</h2>
          <p class="text-sm text-muted">Filter by section code, payment category, or threshold.</p>
        </div>

        <div class="w-full sm:w-72 relative">
          <input
            type="text"
            id="search-box"
            placeholder="Search e.g. 194C, Rent, Director..."
            class="w-full rounded-xl border border-base bg-surface px-4 py-2.5 text-sm focus:border-accent focus:outline-none"
          />
        </div>
      </div>

      <!-- Sections Table -->
      <div class="rounded-2xl border border-base bg-surface overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm" id="tds-table">
            <thead>
              <tr class="border-b border-base bg-subtle text-xs font-mono uppercase text-muted">
                <th class="py-3.5 px-4">Section</th>
                <th class="py-3.5 px-4">Nature of Payment</th>
                <th class="py-3.5 px-4">TDS Rate</th>
                <th class="py-3.5 px-4">Threshold Limit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base/50 text-[14px]" id="tds-tbody">
              <!-- Rendered via script for search filterability -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <section class="mt-16 pt-12 border-t border-base" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-base mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="group rounded-xl border border-base bg-surface overflow-hidden" id={`faq-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span>{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[15px] text-muted leading-relaxed border-t border-base pt-4">{faq.a}</div>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script is:inline>
    const tdsData = [
      { section: '194C', name: 'Payments to Contractors & Sub-contractors (Individual/HUF)', rate: '1%', threshold: '₹30,000 single / ₹1,00,000 aggregate', rateNum: 1 },
      { section: '194C', name: 'Payments to Contractors & Sub-contractors (Company/Firm)', rate: '2%', threshold: '₹30,000 single / ₹1,00,000 aggregate', rateNum: 2 },
      { section: '194J', name: 'Fees for Professional Services & Director Remuneration', rate: '10%', threshold: '₹30,000 per financial year', rateNum: 10 },
      { section: '194J', name: 'Fees for Technical Services (FTS) & Call Centre Operations', rate: '2%', threshold: '₹30,000 per financial year', rateNum: 2 },
      { section: '194I', name: 'Rent on Land, Building, or Furniture', rate: '10%', threshold: '₹2,40,000 per financial year', rateNum: 10 },
      { section: '194I', name: 'Rent on Plant, Machinery, or Equipment', rate: '2%', threshold: '₹2,40,000 per financial year', rateNum: 2 },
      { section: '194IB', name: 'Rent by Individuals/HUFs not liable for Tax Audit', rate: '2%', threshold: 'Exceeding ₹50,000 per month', rateNum: 2 },
      { section: '194H', name: 'Commission or Brokerage', rate: '2%', threshold: '₹15,000 per financial year', rateNum: 2 },
      { section: '194Q', name: 'Purchase of Goods (Buyer Turnover > ₹10 Cr)', rate: '0.1%', threshold: 'Purchase value > ₹50,00,000', rateNum: 0.1 },
      { section: '194IA', name: 'Purchase of Immovable Property (other than agricultural)', rate: '1%', threshold: 'Property value ≥ ₹50,00,000', rateNum: 1 },
      { section: '194A', name: 'Interest other than Interest on Securities (Banks)', rate: '10%', threshold: '₹40,000 (₹50,000 for Senior Citizens)', rateNum: 10 },
      { section: '194DA', name: 'Maturity Payout of Life Insurance Policy', rate: '5%', threshold: 'Taxable profit > ₹1,00,000', rateNum: 5 },
      { section: '194M', name: 'Contract / Commission payments by Individuals/HUFs', rate: '2%', threshold: 'Aggregate payments > ₹50,00,000', rateNum: 2 },
      { section: '194S', name: 'Transfer of Virtual Digital Assets (VDA / Crypto)', rate: '1%', threshold: '₹50,000 (₹10,000 for specified persons)', rateNum: 1 },
      { section: '192', name: 'Salaries', rate: 'Average Slab Rate', threshold: 'Basic exemption limit', rateNum: 0 },
    ];

    function renderTable(filterText = '') {
      const tbody = document.getElementById('tds-tbody');
      if (!tbody) return;

      const q = filterText.toLowerCase().trim();
      const filtered = tdsData.filter((item) =>
        item.section.toLowerCase().includes(q) ||
        item.name.toLowerCase().includes(q) ||
        item.threshold.toLowerCase().includes(q)
      );

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" class="text-center py-8 text-muted">No matching TDS sections found for "${filterText}".</td></tr>`;
        return;
      }

      tbody.innerHTML = filtered.map((row) => `
        <tr class="hover:bg-subtle/50 transition-colors">
          <td class="py-3.5 px-4 font-mono font-bold text-accent">${row.section}</td>
          <td class="py-3.5 px-4 font-medium text-base">${row.name}</td>
          <td class="py-3.5 px-4 font-mono font-bold">${row.rate}</td>
          <td class="py-3.5 px-4 text-xs font-mono text-muted">${row.threshold}</td>
        </tr>
      `).join('');
    }

    document.getElementById('search-box')?.addEventListener('input', (e) => {
      renderTable(e.target.value);
    });

    renderTable();

    // Calculator engine
    function calcTDS() {
      const secKey = document.getElementById('calc-section').value;
      const amount = Math.max(0, parseFloat(document.getElementById('calc-amount').value) || 0);
      const hasPan = document.getElementById('calc-pan').value === 'yes';

      const rates = {
        '194C-ind': 1,
        '194C-co': 2,
        '194J-prof': 10,
        '194J-tech': 2,
        '194I-rent-land': 10,
        '194I-rent-plant': 2,
        '194IB-rent': 2,
        '194H-comm': 2,
        '194Q-goods': 0.1,
        '194IA-prop': 1,
        '194A-int': 10,
        '194S-crypto': 1,
      };

      const baseRate = rates[secKey] || 1;
      const finalRate = hasPan ? baseRate : Math.max(20, baseRate);

      const tds = (amount * finalRate) / 100;
      const net = amount - tds;

      const inr = (num) => '₹' + Math.round(num).toLocaleString('en-IN');

      document.getElementById('res-rate').textContent = finalRate + '% ' + (!hasPan ? '(Sec 206AA Penal Rate)' : '');
      document.getElementById('res-tds').textContent = inr(tds);
      document.getElementById('res-net').textContent = inr(net);
    }

    ['calc-section', 'calc-amount', 'calc-pan'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', calcTDS);
      document.getElementById(id)?.addEventListener('change', calcTDS);
    });

    calcTDS();
  </script>
</BaseLayout>

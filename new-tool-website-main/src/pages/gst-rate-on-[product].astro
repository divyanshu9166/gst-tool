---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';

export async function getStaticPaths() {
  const popularProducts = [
    { slug: 'mobile-phones', name: 'Mobile Phones', rate: '18%', hsn: '8517', desc: 'Smartphones and mobile phones' },
    { slug: 'laptops-computers', name: 'Laptops & Computers', rate: '18%', hsn: '8471', desc: 'Laptops, desktops, and computer hardware' },
    { slug: 'cement', name: 'Cement', rate: '18%', hsn: '2523', desc: 'Portland cement, aluminous cement, slag cement' },
    { slug: 'restaurant-food', name: 'Restaurant Food', rate: '5%', hsn: '9963', desc: 'Food and beverages served in restaurants (non-AC or AC without ITC)' },
    { slug: 'gold-jewellery', name: 'Gold & Jewellery', rate: '3%', hsn: '7113', desc: 'Articles of jewellery and parts thereof, of precious metal' },
    { slug: 'cars', name: 'Cars', rate: '18% / 28% / 40%', hsn: '8703', desc: 'Motor cars and other motor vehicles principally designed for the transport of persons' },
    { slug: 'commercial-rent', name: 'Commercial Rent', rate: '18%', hsn: '9972', desc: 'Rental or leasing services involving own or leased non-residential property' },
    { slug: 'software-services', name: 'Software Services', rate: '18%', hsn: '9987', desc: 'IT software services, consulting, and development' },
    { slug: 'medicines', name: 'Medicines', rate: '5% / 12%', hsn: '3004', desc: 'Medicaments consisting of mixed or unmixed products for therapeutic uses' },
    { slug: 'insurance', name: 'Insurance Services', rate: '18%', hsn: '9971', desc: 'Life insurance and general insurance services' },
    { slug: 'solar-panels', name: 'Solar Panels', rate: '12%', hsn: '8541', desc: 'Solar photovoltaic modules and panels' },
    { slug: 'clothing-garments', name: 'Clothing & Garments', rate: '5% / 12%', hsn: '6101', desc: 'Apparel and clothing accessories' },
    { slug: 'shoes-footwear', name: 'Shoes & Footwear', rate: '18%', hsn: '6401', desc: 'Footwear, gaiters and the like; parts of such articles' },
    { slug: 'furniture', name: 'Furniture', rate: '18%', hsn: '9403', desc: 'Other furniture and parts thereof' },
    { slug: 'electric-vehicles', name: 'Electric Vehicles (EV)', rate: '5%', hsn: '8703', desc: 'Electrically operated vehicles, including two and three wheeled electric motor vehicles' },
    { slug: 'books', name: 'Books', rate: '0%', hsn: '4901', desc: 'Printed books, including braille books' },
    { slug: 'freelance-services', name: 'Freelance Services', rate: '18%', hsn: '9983', desc: 'Other professional, technical and business services' },
    { slug: 'hotel-rooms', name: 'Hotel Rooms', rate: '12% / 18%', hsn: '9963', desc: 'Accommodation, food and beverage services' },
    { slug: 'gym-memberships', name: 'Gym Memberships', rate: '18%', hsn: '9997', desc: 'Other services (Physical well-being services)' },
    { slug: 'coaching-classes', name: 'Coaching Classes', rate: '18%', hsn: '9992', desc: 'Tuition and coaching services by unrecognised institutes (e.g. IIT-JEE coaching, CA coaching). Recognised educational institutions are exempt.' },
    { slug: 'air-tickets', name: 'Air Tickets', rate: '5% / 12%', hsn: '9964', desc: 'Passenger transport services by air' },
    { slug: 'interior-designing', name: 'Interior Designing', rate: '18%', hsn: '9983', desc: 'Other professional, technical and business services' },
    { slug: 'event-management', name: 'Event Management', rate: '18%', hsn: '9985', desc: 'Support services (Event management)' },
    { slug: 'beauty-parlour', name: 'Beauty Parlour Services', rate: '18%', hsn: '9997', desc: 'Other services (Beauty and physical well-being services)' },
    { slug: 'diamonds', name: 'Diamonds', rate: '1.5%', hsn: '7102', desc: 'Diamonds, whether or not worked, but not mounted or set' },
  ];

  return popularProducts.map((product) => {
    return {
      params: { product: product.slug },
      props: { product },
    };
  });
}

const { product } = Astro.props;

const title = `GST Rate on ${product.name} (2026) | HSN Code ${product.hsn}`;
const description = `Find the exact GST rate for ${product.name} in India. Applicable HSN/SAC code is ${product.hsn}. Check CGST/SGST split and calculate tax amount instantly.`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/gst-rate-on-${product.slug}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `What is the GST rate on ${product.name}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `The GST rate on ${product.name} is ${product.rate}. This falls under the classification for ${product.desc}.`,
        },
      },
      {
        '@type': 'Question',
        name: `What is the HSN code for ${product.name}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `The HSN/SAC code for ${product.name} is ${product.hsn}.`,
        },
      }
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `GST Calculator for ${product.name}`,
    url: canonical,
    description: `Calculate GST on ${product.name} using the official ${product.rate} rate.`,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  }
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'GST Rates', href: '/gst-rate-finder' },
  { name: `Rate on ${product.name}`, href: `/gst-rate-on-${product.slug}` },
];

const lastUpdated = '2026-07-25';
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Hero Section -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-accent/10 to-indigo-500/10 mb-6 tool-icon-wrap shadow-sm">
        <ToolIcon name="receipt" class="w-8 h-8 text-accent" />
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-base mb-4">
        GST Rate on <span class="text-accent">{product.name}</span>
      </h1>
      <p class="text-[18px] text-muted max-w-2xl mx-auto leading-relaxed">
        Everything you need to know about the GST taxation for {product.name} in India, including HSN code {product.hsn} and the exact tax breakdown.
      </p>
    </div>

    <!-- Rate Card -->
    <div class="rounded-2xl border border-base bg-surface p-6 sm:p-8 mb-10 shadow-sm relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent pointer-events-none"></div>
      
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6 relative z-10">
        <div>
          <h2 class="text-xl font-semibold text-base mb-1">Applicable GST Rate</h2>
          <p class="text-muted text-sm">{product.desc}</p>
        </div>
        <div class="text-5xl font-extrabold text-accent">
          {product.rate}
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mt-8 pt-6 border-t border-base">
        <div>
          <div class="text-[13px] text-muted uppercase tracking-wider font-semibold mb-1">HSN/SAC Code</div>
          <div class="text-xl font-mono text-base font-medium">{product.hsn}</div>
        </div>
        <div>
          <div class="text-[13px] text-muted uppercase tracking-wider font-semibold mb-1">Tax Split (Intra-State)</div>
          <div class="text-sm text-base font-medium">
            {product.rate.includes('/') ? 'Variable — see conditions below' : `CGST: ${(parseFloat(product.rate)/2).toFixed(2).replace(/\.?0+$/, '')}% + SGST: ${(parseFloat(product.rate)/2).toFixed(2).replace(/\.?0+$/, '')}%`}
          </div>
        </div>
      </div>
    </div>

    <!-- Mini Calculator -->
    <div class="rounded-2xl border border-base bg-white dark:bg-[#111] p-6 sm:p-8 mb-12 shadow-sm">
      <h3 class="text-xl font-semibold text-base mb-6">Calculate GST on {product.name}</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-base mb-2">Base Price (₹)</label>
          <input type="number" id="base-price" class="w-full rounded-lg border border-base bg-surface px-4 py-3 text-base focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all" placeholder="e.g. 10000" />
        </div>
        <div class="pt-4">
          <div class="flex justify-between items-center py-2 border-b border-base/50">
            <span class="text-muted text-sm">Tax Amount:</span>
            <span class="font-medium text-base" id="tax-amount">₹0.00</span>
          </div>
          <div class="flex justify-between items-center py-3">
            <span class="font-semibold text-base">Total Inclusive Price:</span>
            <span class="font-bold text-xl text-accent" id="total-price">₹0.00</span>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Content / FAQs -->
    <div class="prose prose-neutral dark:prose-invert max-w-none text-[15px] leading-[1.7] mb-12">
      <h2 class="text-[24px] font-semibold text-base mb-6 tracking-[-0.6px]">Understanding {product.name} GST & HSN Code {product.hsn}</h2>
      <p>
        If you are dealing in <strong>{product.name}</strong>, it is mandatory to apply the correct GST rate of <strong>{product.rate}</strong> on your invoices. 
        The government classifies this under the HSN/SAC code <strong>{product.hsn}</strong>.
      </p>
      <p>
        When selling intra-state (within the same state), this tax is split equally into CGST and SGST. For inter-state sales, the full rate is charged as IGST.
      </p>

      <h3 class="text-[20px] font-semibold text-base mt-10 mb-4 tracking-[-0.6px]">Frequently Asked Questions</h3>
      
      <div class="space-y-3 not-prose">
        <details class="group rounded-[8px] border border-base bg-surface overflow-hidden" open>
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
            <span class="text-[15px]">What is the exact GST rate on {product.name}?</span>
            <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">
            The applicable GST rate for {product.name} is {product.rate}.
          </div>
        </details>

        <details class="group rounded-[8px] border border-base bg-surface overflow-hidden">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
            <span class="text-[15px]">What is the HSN code for {product.name}?</span>
            <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">
            The harmonized system code (HSN/SAC) for {product.name} is {product.hsn}. It is mandatory to mention this code on tax invoices for B2B transactions.
          </div>
        </details>
      </div>
    </div>

    <!-- Related tools -->
    <div class="border-t border-base pt-10">
      <h3 class="text-[18px] font-semibold text-base mb-4">Related Tools</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="/gst-rate-finder" class="group rounded-lg border border-base bg-surface p-4 hover:border-accent transition-all">
          <div class="font-semibold text-[14px] text-base group-hover:text-accent transition-colors">GST Rate Finder</div>
          <div class="text-[12px] text-muted mt-1">Search rates for any other product</div>
        </a>
        <a href="/gst-calculator" class="group rounded-lg border border-base bg-surface p-4 hover:border-accent transition-all">
          <div class="font-semibold text-[14px] text-base group-hover:text-accent transition-colors">Advanced GST Calculator</div>
          <div class="text-[12px] text-muted mt-1">Add or remove GST with detailed splits</div>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ productRate: product.rate }}>
  const input = document.getElementById('base-price');
  const taxOut = document.getElementById('tax-amount');
  const totalOut = document.getElementById('total-price');

  // For variable rates (e.g. '5% / 12%'), default to the LOWEST rate as the most common scenario
  const rates = productRate.match(/\d+(\.\d+)?/g);
  const rateNum = rates ? parseFloat(rates[0]) : 18;

  input?.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value) || 0;
    const tax = (val * rateNum) / 100;
    const total = val + tax;

    taxOut.textContent = '₹' + tax.toFixed(2);
    totalOut.textContent = '₹' + total.toFixed(2);
  });
</script>

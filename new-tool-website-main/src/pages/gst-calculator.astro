---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalSources from '../components/LegalSources.astro';
import CalculatorMethodology from '../components/CalculatorMethodology.astro';
import TaxDisclaimer from '../components/TaxDisclaimer.astro';

const title = 'Free GST Calculator India — Add & Remove GST';
const description = 'Estimate GST on an amount with add or remove mode, intra-state CGST/SGST or inter-state IGST breakdown, and a custom rate.';

const gstCalculatorFaqs = [
  {
    q: 'How do I add GST to a price?',
    a: 'Multiply the base price by the selected rate and divide by 100 to get the tax. Add the tax to the base price for the total. For example, ₹1,000 at 18% gives ₹180 GST and a total of ₹1,180.',
  },
  {
    q: 'How do I remove GST from an inclusive price?',
    a: 'Divide the GST-inclusive amount by 1 plus the selected rate divided by 100. For example, ₹1,180 ÷ 1.18 = ₹1,000 before tax, with ₹180 GST. This is an arithmetic extraction and is different from statutory reverse charge.',
  },
  {
    q: 'How are CGST, SGST, and IGST displayed?',
    a: 'For the intra-state option, the calculator splits the selected total rate equally into CGST and SGST. For the inter-state option, it displays the full selected rate as IGST. The tool does not determine the legally correct place-of-supply treatment for your transaction.',
  },
  {
    q: 'Does the calculator tell me which GST rate applies?',
    a: 'No. You choose the rate. Confirm the classification and current rate from the applicable official schedules and notifications; an HSN or SAC search result is only a reference.',
  },
  {
    q: 'Can I use the result to file a return or invoice?',
    a: 'Treat the result as an estimate based on the amount and rate you entered. Verify the underlying facts, rate, classification, and current requirements with official sources or a qualified tax professional before using it for compliance.',
  },
  {
    q: 'Can this GST calculator handle an invoice with multiple products?',
    a: 'It calculates one amount and one selected rate at a time. If an invoice has items with different rates, calculate each taxable line separately using a rate you have verified, then reconcile the invoice totals and applicable adjustments.',
  },
  {
    q: 'Does the intra-state or inter-state option decide my place of supply?',
    a: 'No. The option only changes how the selected GST amount is displayed: as a CGST/SGST split or as IGST. Determine the legally applicable place of supply from the transaction facts and current GST rules before choosing a display.',
  },
  {
    q: 'Are discounts, freight, or cess included in the calculation?',
    a: 'The calculator applies the rate you select to the amount you enter. It does not separately assess discounts, freight, cess, or other invoice adjustments; confirm how those affect taxable value for your transaction.',
  },
  {
    q: 'Why might the calculator result differ from an invoice total?',
    a: 'The invoice may use a different taxable value or rate, include multiple line items, apply transaction-specific valuation or discount rules, add cess, or use a different rounding method. Compare the inputs and invoice treatment before relying on the estimate.',
  },
  {
    q: 'Can I use the GST calculator on a mobile phone?',
    a: 'Yes. The calculator is available in a mobile browser. Enter the amount, select a rate and display option, then review the estimate on the same page; no app installation is required.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'GST Calculator',
    url: `${Astro.site?.toString() ?? 'https://example.com'}/gst-calculator`,
    description: 'Calculator for GST arithmetic using a user-selected rate, with an intra-state or inter-state display option.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'INR',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: gstCalculatorFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to Use the GST Calculator',
    description: 'Steps to instantly add or remove GST using our free online tool.',
    step: [
      {
        '@type': 'HowToStep',
        name: 'Select Mode',
        text: 'Choose whether you want to Add GST to a base price or Remove GST from an inclusive price.'
      },
      {
        '@type': 'HowToStep',
        name: 'Enter Amount',
        text: 'Input your base amount or total amount in rupees.'
      },
      {
        '@type': 'HowToStep',
        name: 'Choose Rate',
        text: 'Select a preset rate or enter a custom rate that you have independently confirmed.'
      }
    ]
  }
];

const lastUpdated = '2026-09-24';
---

<BaseLayout {title} {description} {structuredData} {lastUpdated}>
  <div class="mx-auto max-w-[1200px] px-4 py-7 sm:px-6 sm:py-10 lg:px-0">
    <!-- Page header -->
    <div class="mb-6 sm:mb-8">
      <nav aria-label="Breadcrumb" class="mb-5">
        <ol class="flex flex-wrap items-center gap-2 text-[12px] text-muted">
          <li><a href="/" class="hover:text-accent">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/#tools-heading" class="hover:text-accent">Calculators</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-base" aria-current="page">GST Calculator</li>
        </ol>
      </nav>
      <p class="text-[10px] font-bold tracking-[0.1em] text-[#0f9f8c]">GST CALCULATOR</p>
      <h1 class="mt-2 text-[30px] font-bold leading-tight tracking-[-1px] text-[#10264a] dark:text-slate-100 sm:text-[38px]">GST calculator for India</h1>
      <p class="mt-3 max-w-[760px] text-[14px] leading-[22px] text-muted sm:text-[15px] sm:leading-[24px]">
        Estimate tax on a base price or remove GST from an inclusive amount. Choose the supply type to view a CGST/SGST or IGST breakdown.
      </p>
    </div>

    <!-- Calculator container -->
    <div class="overflow-hidden rounded-[20px] border border-[#e3eaf3] bg-white shadow-[0_12px_32px_rgba(10,41,87,0.08)] dark:border-slate-700 dark:bg-slate-900">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_0.92fr]">
        <!-- Left Column: Inputs -->
        <div class="space-y-5 p-5 sm:space-y-6 sm:p-7 lg:p-9">
          <!-- Mode toggle -->
          <div class="grid grid-cols-2 gap-1 rounded-xl bg-[#f2f5f9] p-1 dark:bg-slate-800" role="group" aria-label="Calculation mode">
            <button
              id="btn-add"
              type="button"
              class="min-h-11 rounded-[9px] px-3 py-2.5 text-[13px] font-semibold transition-colors bg-accent text-white active:scale-[0.99]"
              aria-pressed="true"
            >
              Add GST
            </button>
            <button
              id="btn-remove"
              type="button"
              class="min-h-11 rounded-[9px] px-3 py-2.5 text-[13px] font-medium transition-colors text-muted hover:text-base active:scale-[0.99]"
              aria-pressed="false"
            >
              Remove GST (Reverse)
            </button>
          </div>

          <!-- Amount input -->
          <div>
            <label for="amount" class="block text-sm font-medium text-base mb-1.5">
              <span id="amount-label">Base Amount (₹)</span>
            </label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-muted font-medium select-none" aria-hidden="true">₹</span>
              <input
                id="amount"
                type="number"
                inputmode="decimal"
                min="0"
                step="0.01"
                placeholder="0.00"
                class="w-full rounded-xl border border-[#dce4ef] bg-white pl-9 pr-4 py-3.5 text-[16px] font-medium shadow-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 dark:border-slate-600 dark:bg-slate-950"
                aria-describedby="amount-hint"
              />
            </div>
            <p id="amount-hint" class="mt-2 text-xs text-muted">
              <span id="amount-hint-text">Enter the price before GST</span>
            </p>
          </div>

          <!-- GST Rate selector -->
          <div>
            <div class="mb-1.5 flex flex-wrap items-center justify-between gap-2">
              <label class="block text-sm font-medium text-base">GST Rate</label>
              <a href="/gst-rate-finder/" class="text-xs text-accent hover:underline font-medium">Find rate by product / service →</a>
            </div>
            <p class="mb-3 text-[12px] leading-[19px] text-muted">
              The calculator performs arithmetic using the rate you select. It does not determine the correct GST classification or rate for a particular supply. Confirm the applicable HSN/SAC classification and notified rate before using the result for compliance.
            </p>
            <div class="mb-3 grid grid-cols-4 gap-2" role="group" aria-label="GST rate selection">
              {['0', '5', '18', '40'].map((rate) => (
                <button
                  type="button"
                  data-rate={rate}
                  class={`rate-btn min-h-11 rounded-[10px] border py-2.5 text-[13px] font-semibold transition-colors active:scale-[0.99] ${rate === '18' ? 'border-accent bg-accent text-white shadow-sm' : 'border-base bg-subtle text-muted hover:border-accent/50 hover:text-base'}`}
                  aria-pressed={rate === '18' ? 'true' : 'false'}
                >
                  {rate}%
                </button>
              ))}
            </div>
            <!-- Custom rate -->
            <div class="flex items-center gap-3">
              <label for="custom-rate" class="text-sm text-muted whitespace-nowrap">Custom rate:</label>
              <div class="relative flex-1">
                <input
                  id="custom-rate"
                  type="number"
                  inputmode="decimal"
                  min="0"
                  max="100"
                  step="0.01"
                  placeholder="e.g. 3"
                  class="w-full rounded-lg border border-[#dce4ef] bg-white px-4 py-2.5 text-[16px] shadow-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 dark:border-slate-600 dark:bg-slate-950"
                  aria-label="Custom GST rate percentage"
                />
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-muted text-sm select-none" aria-hidden="true">%</span>
              </div>
            </div>
          </div>

          <div>
            <p class="mb-2 text-sm font-medium text-base">Supply type</p>
            <div class="grid grid-cols-2 gap-2" role="group" aria-label="Supply type">
              <button id="btn-intra" type="button" class="min-h-11 rounded-[10px] border border-accent bg-[#eef4ff] px-3 py-2 text-[12px] font-semibold text-accent dark:bg-slate-800" aria-pressed="true">Intra-state</button>
              <button id="btn-inter" type="button" class="min-h-11 rounded-[10px] border border-base bg-white px-3 py-2 text-[12px] font-medium text-muted hover:text-base dark:bg-slate-900" aria-pressed="false">Inter-state</button>
            </div>
            <p class="mt-2 text-[11px] leading-[16px] text-muted">Select based on the place of supply and location of the supplier.</p>
          </div>

          <button id="btn-calculate" type="button" class="min-h-12 w-full rounded-xl bg-[#10264a] px-5 py-3 text-[14px] font-semibold text-white transition-colors hover:bg-[#173762] focus-visible:outline-offset-4 dark:bg-blue-600 dark:hover:bg-blue-500">
            Calculate GST <span class="ml-1" aria-hidden="true">→</span>
          </button>
        </div>

        <!-- Right Column: Results -->
        <div class="flex flex-col gap-4 bg-[#10264a] p-5 text-white sm:gap-5 sm:p-7 lg:p-9">
          <div>
            <p class="text-[10px] font-bold tracking-[0.1em] text-[#75e0cc]">YOUR ESTIMATE</p>
            <h2 class="mt-1 text-[20px] font-semibold tracking-[-0.4px] text-white">GST breakdown</h2>
            <p id="result-supply-label" class="mt-1 text-[12px] text-blue-100">Intra-state supply · CGST + SGST</p>
          </div>
          <div
            id="results"
            class="space-y-4 rounded-[14px] border border-white/15 bg-white/[0.06] p-5 sm:p-6"
            aria-live="polite"
            aria-label="Calculation results"
          >
            <div class="flex justify-between items-center text-sm">
              <span class="text-blue-100" id="label-base">Base Amount</span>
              <span class="text-[15px] font-medium text-white" id="result-base">₹0.00</span>
            </div>
            <div class="flex justify-between items-center text-sm">
              <span class="text-blue-100">GST Amount (<span id="result-rate-label">18%</span>)</span>
              <span class="text-[15px] font-medium text-white" id="result-gst">₹0.00</span>
            </div>
            <!-- CGST / SGST split -->
            <div id="split-section" class="space-y-2 border-l-2 border-white/20 pl-4">
              <div class="flex justify-between items-center text-[13px]">
                <span class="text-blue-100">CGST (<span id="result-cgst-rate">9%</span>)</span>
                <span class="text-blue-50" id="result-cgst">₹0.00</span>
              </div>
              <div class="flex justify-between items-center text-[13px]">
                <span class="text-blue-100">SGST (<span id="result-sgst-rate">9%</span>)</span>
                <span class="text-blue-50" id="result-sgst">₹0.00</span>
              </div>
            </div>
            <div id="igst-section" class="hidden border-l-2 border-white/20 pl-4">
              <div class="flex items-center justify-between text-[13px]">
                <span class="text-blue-100">IGST (<span id="result-igst-rate">18%</span>)</span>
                <span class="text-blue-50" id="result-igst">₹0.00</span>
              </div>
            </div>
            <div class="mt-2 flex items-center justify-between border-t border-white/15 pt-4">
              <span class="font-semibold text-white" id="label-total">Total Amount</span>
              <span class="text-[24px] font-bold tracking-tight text-white sm:text-[28px]" id="result-total">₹0.00</span>
            </div>
          </div>

          <div class="rounded-[13px] border border-white/15 bg-white/[0.04] p-4 text-[12px] leading-[19px] text-blue-100">
            <h3 class="mb-2 font-semibold text-white">How it works</h3>
            <p><strong class="text-white">Add GST:</strong> Base × Rate ÷ 100</p>
            <p><strong class="text-white">Remove GST:</strong> Total ÷ (1 + Rate ÷ 100)</p>
          </div>

          <button id="btn-reset" type="button" class="self-start rounded-lg px-2 py-1 text-[12px] font-medium text-blue-100 underline decoration-white/30 underline-offset-4 hover:text-white">
            Reset calculation
          </button>
        </div>
      </div>
    </div>

    <!-- Semantic Content Guide -->
    <div class="mx-auto max-w-5xl mt-16 border-t border-base pt-12">
      <h2 class="text-[28px] tracking-[-1px] font-semibold text-base mb-6">How to use the GST Calculator</h2>
      
      <div class="prose prose-neutral dark:prose-invert max-w-none text-[16px] leading-[24px]">
        <p>
          This calculator performs GST arithmetic in your browser using the amount and rate you enter. It does not identify the legally correct rate, classify a supply, or determine your filing position.
        </p>

        <h3 class="text-[20px] font-semibold text-base mt-8 mb-4 tracking-[-0.6px]">1. Adding GST to a Base Price</h3>
        <p>
          To add a selected rate to an amount, choose <strong>"Add GST"</strong>, enter the base price, and choose a preset or custom rate. The calculator multiplies the amount by that rate to show the GST component and total.
        </p>

        <h3 class="text-[20px] font-semibold text-base mt-8 mb-4 tracking-[-0.6px]">2. Removing GST (Reverse Calculation)</h3>
        <p>
          To extract the pre-tax amount from a GST-inclusive total, select <strong>"Remove GST"</strong>, enter the total, and choose the rate. The tool divides the total by <code>(1 + (GST Rate / 100))</code>. This arithmetic extraction is different from statutory Reverse Charge Mechanism (RCM).
        </p>

        <h3 class="text-[20px] font-semibold text-base mt-8 mb-4 tracking-[-0.6px]">3. Understanding CGST, SGST, and IGST</h3>
        <p>
          The display option controls how the selected tax amount is presented. Confirm the correct supply treatment, applicable rate, and HSN or SAC classification from current official sources before relying on a result:
        </p>
        <ul class="list-disc pl-5 mt-2 space-y-1">
          <li><strong>Intra-State Supply (Within the same state):</strong> The total GST is divided equally into Central GST (CGST) and State GST (SGST). For example, an 18% rate becomes 9% CGST and 9% SGST.</li>
          <li><strong>Inter-State Supply (Between two different states):</strong> The entire tax amount is collected as Integrated GST (IGST) at the full rate.</li>
        </ul>

      </div>

      <!-- Methodology & Legal Sources -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
        <CalculatorMethodology
          calculates="Base amount, CGST/SGST split (for intra-state), and total inclusive invoice value from exclusive or inclusive input amounts."
          doesNotDetermine="Legal tax eligibility, HSN/SAC classification, input tax credit entitlement, or whether Reverse Charge Mechanism applies."
          inputs="Base Amount or Total Amount (₹), Selected GST Rate (%)"
          formula="Add GST: Base × Rate ÷ 100 | Remove GST: Inclusive Total ÷ (1 + Rate ÷ 100)"
          applicablePeriod="FY 2025-26 &amp; FY 2026-27"
          primarySource="Sections 9 &amp; 15 of the Central Goods and Services Tax (CGST) Act, 2017"
          formulaLastReviewed="19 September 2026"
        />

        <LegalSources
          sources={[
            { title: "Section 9, CGST Act, 2017", url: "https://taxinformation.cbic.gov.in/content-page/explore-act/1000278/1000001", description: "levy and collection of Central Goods and Services Tax" },
            { title: "Section 15, CGST Act, 2017", url: "https://taxinformation.cbic.gov.in/content-page/explore-act/1000284/1000001", description: "statutory value of taxable supply" },
            { title: "CBIC GST goods and services rates", url: "https://cbic-gst.gov.in/hindi/gst-goods-services-rates.html", description: "official rate schedule reference" }
          ]}
          reviewedDate="19 September 2026"
        />
      </div>

      <div class="mt-6">
        <TaxDisclaimer />
      </div>
    </div>
  </div>

  
  <!-- Related Guides -->
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-12">
    <div class="border-t border-base pt-12">
      <h2 class="text-[24px] font-semibold text-base mb-4">Related Guides</h2>
      <ul class="list-disc pl-5 space-y-2">
        <li><a href="/blog/gst-offline-tool-guide-errors-json-to-excel" class="text-primary hover:underline">The Ultimate GST Offline Tool Guide: Fix Errors, JSON to Excel & Chrome Issues</a></li>
        <li><a href="/blog/gst-late-fee-waivers" class="text-primary hover:underline">GST Late Fee Waivers and Amnesty Schemes Explained</a></li>
      </ul>
    </div>
  </div>
<!-- FAQ Section -->
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-20 mt-16">
    <div class="border-t border-base pt-12">
      <h2 class="text-[28px] tracking-[-1px] font-semibold text-base mb-2">Frequently Asked Questions</h2>
      <p class="text-muted text-[15px] mb-8">Common questions about calculating GST in India.</p>
      <div class="space-y-3">
        {gstCalculatorFaqs.map((faq, i) => (
          <details class="group rounded-[8px] border border-base bg-surface overflow-hidden" id={`faq-calc-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span class="text-[15px]">{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>


<script>
let mode = "add";
let selectedRate = 18;
let supplyType = "intra";
const amountInput = document.getElementById("amount");
const customRateInput = document.getElementById("custom-rate");
const btnAdd = document.getElementById("btn-add");
const btnRemove = document.getElementById("btn-remove");
const btnIntra = document.getElementById("btn-intra");
const btnInter = document.getElementById("btn-inter");
const btnCalculate = document.getElementById("btn-calculate");
const btnReset = document.getElementById("btn-reset");
const rateBtns = document.querySelectorAll(".rate-btn");
const resultBase = document.getElementById("result-base");
const resultGst = document.getElementById("result-gst");
const resultCgst = document.getElementById("result-cgst");
const resultSgst = document.getElementById("result-sgst");
const resultIgst = document.getElementById("result-igst");
const resultTotal = document.getElementById("result-total");
const resultRateLabel = document.getElementById("result-rate-label");
const resultCgstRate = document.getElementById("result-cgst-rate");
const resultSgstRate = document.getElementById("result-sgst-rate");
const resultIgstRate = document.getElementById("result-igst-rate");
const splitSection = document.getElementById("split-section");
const igstSection = document.getElementById("igst-section");
const resultSupplyLabel = document.getElementById("result-supply-label");
const amountLabel = document.getElementById("amount-label");
const amountHintText = document.getElementById("amount-hint-text");
const labelBase = document.getElementById("label-base");
const labelTotal = document.getElementById("label-total");
function formatINR(value) {
  return "\u20B9" + value.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function calculate() {
  const raw = parseFloat(amountInput.value);
  const amount = isNaN(raw) || raw < 0 ? 0 : raw;
  const rate = selectedRate;
  const halfRate = rate / 2;
  let base, gstAmount, total;
  if (mode === "add") {
    base = amount;
    gstAmount = base * rate / 100;
    total = base + gstAmount;
  } else {
    total = amount;
    base = total / (1 + rate / 100);
    gstAmount = total - base;
  }
  const cgst = gstAmount / 2;
  const sgst = gstAmount / 2;
  const isIntraState = supplyType === "intra";
  resultBase.textContent = formatINR(base);
  resultGst.textContent = formatINR(gstAmount);
  resultCgst.textContent = formatINR(cgst);
  resultSgst.textContent = formatINR(sgst);
  resultIgst.textContent = formatINR(gstAmount);
  resultTotal.textContent = formatINR(total);
  resultRateLabel.textContent = `${rate}%`;
  resultCgstRate.textContent = `${halfRate}%`;
  resultSgstRate.textContent = `${halfRate}%`;
  resultIgstRate.textContent = `${rate}%`;
  splitSection.classList.toggle("hidden", !isIntraState);
  igstSection.classList.toggle("hidden", isIntraState);
  resultSupplyLabel.textContent = isIntraState ? "Intra-state supply · CGST + SGST" : "Inter-state supply · IGST";
}
function setMode(newMode) {
  mode = newMode;
  const isAdd = mode === "add";
  btnAdd.classList.toggle("bg-accent", isAdd);
  btnAdd.classList.toggle("text-white", isAdd);
  btnAdd.classList.toggle("text-muted", !isAdd);
  btnAdd.setAttribute("aria-pressed", String(isAdd));
  btnRemove.classList.toggle("bg-accent", !isAdd);
  btnRemove.classList.toggle("text-white", !isAdd);
  btnRemove.classList.toggle("text-muted", isAdd);
  btnRemove.setAttribute("aria-pressed", String(!isAdd));
  if (isAdd) {
    amountLabel.textContent = "Base Amount (\u20B9)";
    amountHintText.textContent = "Enter the price before GST";
    labelBase.textContent = "Base Amount";
    labelTotal.textContent = "Total Amount (incl. GST)";
  } else {
    amountLabel.textContent = "GST-Inclusive Amount (\u20B9)";
    amountHintText.textContent = "Enter the total price including GST";
    labelBase.textContent = "Base Amount (excl. GST)";
    labelTotal.textContent = "GST-Inclusive Amount";
  }
  calculate();
}
function setRate(rate) {
  selectedRate = rate;
  rateBtns.forEach((btn) => {
    const isSelected = parseFloat(btn.dataset.rate ?? "") === rate;
    btn.classList.toggle("border-accent", isSelected);
    btn.classList.toggle("bg-accent", isSelected);
    btn.classList.toggle("text-white", isSelected);
    btn.classList.toggle("border-base", !isSelected);
    btn.classList.toggle("bg-subtle", !isSelected);
    btn.classList.toggle("text-muted", !isSelected);
    btn.setAttribute("aria-pressed", String(isSelected));
  });
  if ([0, 5, 18, 40].includes(rate)) {
    customRateInput.value = "";
  }
  calculate();
}
function setSupplyType(newSupplyType) {
  supplyType = newSupplyType;
  const isIntra = supplyType === "intra";
  btnIntra.classList.toggle("border-accent", isIntra);
  btnIntra.classList.toggle("bg-[#eef4ff]", isIntra);
  btnIntra.classList.toggle("text-accent", isIntra);
  btnIntra.classList.toggle("font-semibold", isIntra);
  btnIntra.classList.toggle("border-base", !isIntra);
  btnIntra.classList.toggle("bg-white", !isIntra);
  btnIntra.classList.toggle("text-muted", !isIntra);
  btnIntra.classList.toggle("dark:bg-slate-800", isIntra);
  btnIntra.classList.toggle("dark:bg-slate-900", !isIntra);
  btnInter.classList.toggle("border-accent", !isIntra);
  btnInter.classList.toggle("bg-[#eef4ff]", !isIntra);
  btnInter.classList.toggle("text-accent", !isIntra);
  btnInter.classList.toggle("font-semibold", !isIntra);
  btnInter.classList.toggle("border-base", isIntra);
  btnInter.classList.toggle("bg-white", isIntra);
  btnInter.classList.toggle("text-muted", isIntra);
  btnInter.classList.toggle("dark:bg-slate-800", !isIntra);
  btnInter.classList.toggle("dark:bg-slate-900", isIntra);
  btnIntra.setAttribute("aria-pressed", String(isIntra));
  btnInter.setAttribute("aria-pressed", String(!isIntra));
  calculate();
}
btnAdd.addEventListener("click", () => setMode("add"));
btnRemove.addEventListener("click", () => setMode("remove"));
btnIntra.addEventListener("click", () => setSupplyType("intra"));
btnInter.addEventListener("click", () => setSupplyType("inter"));
btnCalculate.addEventListener("click", () => {
  calculate();
  document.getElementById("results").scrollIntoView({ behavior: "smooth", block: "nearest" });
});
rateBtns.forEach((btn) => {
  btn.addEventListener("click", () => {
    setRate(parseFloat(btn.dataset.rate ?? "18"));
  });
});
customRateInput.addEventListener("input", () => {
  const val = parseFloat(customRateInput.value);
  if (!isNaN(val) && val >= 0 && val <= 100) {
    rateBtns.forEach((btn) => {
      btn.classList.remove("border-accent", "bg-accent", "text-white");
      btn.classList.add("border-base", "bg-subtle", "text-muted");
      btn.setAttribute("aria-pressed", "false");
    });
    selectedRate = val;
    calculate();
  }
});
amountInput.addEventListener("input", calculate);
btnReset.addEventListener("click", () => {
  amountInput.value = "";
  customRateInput.value = "";
  setMode("add");
  setSupplyType("intra");
  setRate(18);
});
calculate();
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIcon from '../../components/ToolIcon.astro';

const title = 'Taxzentic Editorial Team — Our Editorial Standards';
const description = 'Learn how the Taxzentic editorial team researches tax content and calculation tools using primary sources.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/authors/editorial-team`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    name: 'Taxzentic Editorial Team',
    url: canonical,
    mainEntity: {
      '@type': 'Organization',
      name: 'Taxzentic Editorial Team',
      url: siteUrl,
      description: 'A team of tax compliance researchers and analysts dedicated to simplifying GST and Income Tax for Indian businesses.',
    },
  },
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Editorial Team', href: '/authors/editorial-team' },
];

const lastUpdated = '2026-09-15';
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/5 px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-accent mb-4">
        <span class="h-2 w-2 rounded-full bg-accent"></span>
        Educational &amp; Calculation Standards
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-base mb-6">
        Taxzentic Editorial Team
      </h1>
      <p class="text-[18px] text-muted max-w-2xl mx-auto leading-relaxed">
        The Taxzentic Editorial Team maintains Taxzentic's educational tax content and calculation tools.
      </p>
    </div>

    <!-- Team Profile -->
    <div class="rounded-2xl border border-base bg-surface p-8 sm:p-10 shadow-sm mb-12">
      <div class="flex flex-col sm:flex-row gap-6 items-start">
        <div class="h-24 w-24 rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-600 text-white flex items-center justify-center text-3xl font-bold flex-shrink-0 shadow-md">
          TZ
        </div>
        <div class="flex-1">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <div>
              <h2 class="text-2xl font-bold text-base tracking-tight">About the Taxzentic Editorial Team</h2>
              <p class="text-sm font-medium text-accent">Educational Content &amp; Tool Research</p>
            </div>
          </div>

          <div class="space-y-3 text-muted text-[15px] leading-relaxed mb-4">
            <p>
              The Taxzentic Editorial Team maintains Taxzentic's educational tax content and calculation tools.
            </p>
            <p>
              For material tax claims, we check the applicable period and compare the content against primary sources published by the Government of India, CBIC, the GST Council, and the Income Tax Department.
            </p>
            <p>
              Taxzentic is an independent informational website and is not affiliated with or endorsed by the Government of India, CBIC, the GST Council, or the Income Tax Department.
            </p>
            <p>
              Where a page has been substantively reviewed, the page displays the actual review date and the primary sources used.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-base text-xs font-mono text-muted">
            <div>
              <span class="block text-base font-bold text-base">Focus Areas</span>
              GST Calculators, HSN Lookup, Due Dates &amp; Compliance
            </div>
            <div>
              <span class="block text-base font-bold text-base">Primary Sources</span>
              CBIC, GST Council, Income Tax Department
            </div>
            <div>
              <span class="block text-base font-bold text-base">Review Policy</span>
              Dated Primary Statutory Cross-Referencing
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Editorial Policy & Standards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <div class="rounded-2xl border border-base bg-surface p-6">
        <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-accent mb-4">
          <ToolIcon name="scale" class="w-5 h-5" />
        </div>
        <h3 class="text-lg font-bold text-base mb-2">Statutory Accuracy</h3>
        <p class="text-sm text-muted leading-relaxed">
          Tool pages describe the formulas, inputs, and assumptions used for their estimates where applicable. A calculator result does not determine eligibility or replace a review of the relevant statute, rules, and facts.
        </p>
      </div>

      <div class="rounded-2xl border border-base bg-surface p-6">
        <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-600 mb-4">
          <ToolIcon name="refresh" class="w-5 h-5" />
        </div>
        <h3 class="text-lg font-bold text-base mb-2">Prompt Regulatory Updates</h3>
        <p class="text-sm text-muted leading-relaxed">
          We monitor material changes and reader reports and aim to review affected pages. Updates are not automatic; check each page's dated review note and the primary source for current requirements.
        </p>
      </div>
    </div>

    <!-- Important Disclaimer -->
    <div class="rounded-2xl border border-amber-500/30 bg-amber-50/40 dark:bg-amber-950/20 p-6 mb-12">
      <h3 class="text-lg font-bold text-base mb-2">⚠️ Important Disclaimer</h3>
      <p class="text-sm text-muted leading-relaxed">
        Taxzentic provides informational tools and educational content only. Our calculators and guides are not a substitute for professional tax advice. For specific tax decisions, GST registration matters, or Income Tax filing, please consult a qualified Chartered Accountant or GST practitioner.
      </p>
    </div>

    <!-- Official Verification Sources -->
    <div class="rounded-2xl border border-base bg-subtle p-8 text-center">
      <h3 class="text-lg font-bold text-base mb-3">Primary Legal Sources We Reference</h3>
      <p class="text-sm text-muted max-w-xl mx-auto mb-6">
        We cite and cross-verify with official statutory portals for all published thresholds, circulars, and notifications.
      </p>
      <div class="flex flex-wrap justify-center gap-4 text-xs font-semibold">
        <a href="https://www.gst.gov.in" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl border border-base bg-surface hover:border-accent hover:text-accent transition-colors">
          GST Common Portal (gst.gov.in) ↗
        </a>
        <a href="https://www.cbic.gov.in" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl border border-base bg-surface hover:border-accent hover:text-accent transition-colors">
          CBIC Portal (cbic.gov.in) ↗
        </a>
        <a href="https://www.incometax.gov.in" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl border border-base bg-surface hover:border-accent hover:text-accent transition-colors">
          Income Tax e-Filing (incometax.gov.in) ↗
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

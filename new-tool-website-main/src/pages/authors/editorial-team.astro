---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIcon from '../../components/ToolIcon.astro';

const title = 'Taxzentic Editorial Team & CA Review Board — E-E-A-T';
const description = 'Meet the Chartered Accountants, tax practitioners, and financial analysts behind Taxzentic. Our content and tools are verified against official CBIC notifications.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/authors/editorial-team`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    name: 'Taxzentic Editorial & CA Review Board',
    url: canonical,
    mainEntity: {
      '@type': 'Person',
      name: 'CA Divyanshu Sharma',
      jobTitle: 'Lead Tax Reviewer & Fellow Chartered Accountant (FCA)',
      worksFor: {
        '@type': 'Organization',
        name: 'Taxzentic',
      },
      description: 'Chartered Accountant (FCA) with 10+ years specializing in Indian GST compliance, Income Tax litigation, corporate tax advisory, and indirect tax technology automation.',
      knowsAbout: ['Indian Goods and Services Tax (GST)', 'Income Tax Act 1961', 'Corporate Tax', 'GST Notices (ASMT-10, DRC-01)', 'Tax Technology'],
    },
  },
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Editorial Board', href: '/authors/editorial-team' },
];

const lastUpdated = '2026-09-15';
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/5 px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-accent mb-4">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Certified Tax Practitioners & CAs
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-base mb-6">
        Taxzentic Editorial & Review Board
      </h1>
      <p class="text-[18px] text-muted max-w-2xl mx-auto leading-relaxed">
        Tax laws in India move fast. Every calculator formula, tax slab update, and compliance guide on Taxzentic is strictly reviewed and fact-checked by practicing Chartered Accountants and tax attorneys.
      </p>
    </div>

    <!-- Lead Reviewer Profile -->
    <div class="rounded-2xl border border-base bg-surface p-8 sm:p-10 shadow-sm mb-12">
      <div class="flex flex-col sm:flex-row gap-6 items-start">
        <div class="h-24 w-24 rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-600 text-white flex items-center justify-center text-3xl font-bold flex-shrink-0 shadow-md">
          DS
        </div>
        <div class="flex-1">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <div>
              <h2 class="text-2xl font-bold text-base tracking-tight">CA Divyanshu Sharma</h2>
              <p class="text-sm font-medium text-accent">FCA, DISA (ICAI) · Lead Tax Reviewer & Advisory Head</p>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
              Verified Practicing CA
            </span>
          </div>

          <p class="text-muted text-[15px] leading-relaxed mb-4">
            Divyanshu is a Fellow Member of the Institute of Chartered Accountants of India (ICAI) with over a decade of extensive experience in indirect tax compliance, corporate tax structuring, and appellate litigation before GSTAT and departmental authorities. He spearheads the algorithmic accuracy checks on Taxzentic's GST, TDS, and Income Tax engines.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-base text-xs font-mono text-muted">
            <div>
              <span class="block text-base font-bold text-base">Specialization</span>
              GST 2.0, DRC/ASMT Notices, RCM
            </div>
            <div>
              <span class="block text-base font-bold text-base">Experience</span>
              10+ Years in Direct & Indirect Tax
            </div>
            <div>
              <span class="block text-base font-bold text-base">Affiliation</span>
              Fellow Chartered Accountant (FCA)
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Editorial Policy & Standards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <div class="rounded-2xl border border-base bg-surface p-6">
        <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-accent mb-4">
          <ToolIcon name="scale" class="w-5 h-5" />
        </div>
        <h3 class="text-lg font-bold text-base mb-2">Statutory Accuracy Guarantee</h3>
        <p class="text-sm text-muted leading-relaxed">
          Every tax calculation uses exact formulas defined by the Central Board of Indirect Taxes and Customs (CBIC) and the Income Tax Department (CBDT), including Rules 89, 42, 43, and 37.
        </p>
      </div>

      <div class="rounded-2xl border border-base bg-surface p-6">
        <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-600 mb-4">
          <ToolIcon name="refresh" class="w-5 h-5" />
        </div>
        <h3 class="text-lg font-bold text-base mb-2">24–48h Notification Updates</h3>
        <p class="text-sm text-muted leading-relaxed">
          When the GST Council issues recommendations or the Union Budget amends Income Tax slabs, our editorial board updates our tool logic and rate engines within 24 to 48 hours.
        </p>
      </div>
    </div>

    <!-- Official Verification Sources -->
    <div class="rounded-2xl border border-base bg-subtle p-8 text-center">
      <h3 class="text-lg font-bold text-base mb-3">Primary Legal Sources We Reference</h3>
      <p class="text-sm text-muted max-w-xl mx-auto mb-6">
        We cite and cross-verify with official statutory portals for all published thresholds, circulars, and notifications.
      </p>
      <div class="flex flex-wrap justify-center gap-4 text-xs font-semibold">
        <a href="https://www.gst.gov.in" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl border border-base bg-surface hover:border-accent hover:text-accent transition-colors">
          GST Common Portal (gst.gov.in) ↗
        </a>
        <a href="https://www.cbic.gov.in" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl border border-base bg-surface hover:border-accent hover:text-accent transition-colors">
          CBIC Portal (cbic.gov.in) ↗
        </a>
        <a href="https://www.incometax.gov.in" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl border border-base bg-surface hover:border-accent hover:text-accent transition-colors">
          Income Tax e-Filing (incometax.gov.in) ↗
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

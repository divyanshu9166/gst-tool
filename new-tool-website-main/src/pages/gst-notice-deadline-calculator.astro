---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'GST Notice Date Estimator | Taxzentic';
const description = 'Add the number of calendar days stated on a GST notice to a date. This tool does not determine or verify a legal response deadline.';
const faqs = [
  {
    q: 'What does this date estimator calculate?',
    a: 'It adds the number of calendar days you enter to the date you select. It does not check the notice, applicable law, extensions, excluded days, holidays, or the GST portal.',
  },
  {
    q: 'Does this tool determine my legal response deadline?',
    a: 'No. Enter a day count only after checking the complete notice and current official sources. Confirm the calculation and any applicable counting rules with a qualified professional.',
  },
  {
    q: 'Does the estimate account for weekends or public holidays?',
    a: 'No. It performs simple calendar-day arithmetic and does not apply a legal rule for weekends, public holidays, office closures, or extensions.',
  },
  {
    q: 'Can this tool tell me which form to file?',
    a: 'No. Check the notice and official GST portal for the applicable response form and filing route. The estimator does not submit anything.',
  },
];
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'GST Notice Date Estimator',
    url: Astro.site?.toString() ? `${Astro.site}gst-notice-deadline-calculator` : 'https://taxzentic.com/gst-notice-deadline-calculator',
    description: 'Simple calendar-day arithmetic using dates and a day count entered by the user; does not determine a legal deadline.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
const lastUpdated = '2026-09-24';
const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/#tools-heading' },
  { name: 'GST Notice Date Estimator', href: '/gst-notice-deadline-calculator' },
];
---

<BaseLayout title={title} description={description} structuredData={structuredData} breadcrumb={breadcrumb} lastUpdated={lastUpdated}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center mb-10">
      <h1 class="text-[32px] sm:text-[40px] tracking-[-1.5px] font-semibold text-base mb-4 leading-tight">
        GST Notice Date Estimator
      </h1>
      <p class="text-[16px] text-muted max-w-2xl mx-auto leading-relaxed">
        Estimate a calendar date by adding a day count from your notice or verified source. This tool does not determine a legal deadline.
      </p>
    </div>

    <!-- Main Card -->
    <div class="bg-surface border border-base rounded-[16px] shadow-sm overflow-hidden mb-8">
      <div class="p-6 sm:p-8">
        <form id="deadline-form" class="space-y-6">
          
          <div>
            <label for="allowedDays" class="block text-[14px] font-medium text-base mb-2">Number of calendar days to add</label>
            <input
              type="number"
              id="allowedDays"
              name="allowedDays"
              class="block w-full rounded-[8px] border-0 py-2.5 px-3 text-base ring-1 ring-inset ring-base focus:ring-2 focus:ring-inset focus:ring-primary sm:text-sm sm:leading-6 bg-surface transition-all"
              placeholder="Enter the day count stated in your notice or verified source"
              min="1"
              step="1"
              required
            >
            <p class="mt-2 text-[12px] text-muted">No notice type is assigned a default number of days. Confirm the correct count and how days are calculated before using this estimate.</p>
          </div>
          <!-- Date of Receipt -->
          <div>
            <label for="receiptDate" class="block text-[14px] font-medium text-base mb-2">Date to count from</label>
            <input 
              type="date" 
              id="receiptDate" 
              name="receiptDate"
              class="block w-full rounded-[8px] border-0 py-2.5 px-3 text-base ring-1 ring-inset ring-base focus:ring-2 focus:ring-inset focus:ring-primary sm:text-sm sm:leading-6 bg-surface transition-all"
              required
            >
            <p class="mt-2 text-[12px] text-muted">Choose a date only after checking the applicable notice and rule. The correct starting event may depend on the procedure.</p>
          </div>

        </form>
      </div>

      <!-- Results Section -->
      <div id="results-section" class="bg-subtle border-t border-base p-6 sm:p-8 hidden">
        <div class="mb-6">
          <h3 class="text-[14px] font-medium text-muted uppercase tracking-wider mb-3">Calendar Date Estimate</h3>
          <div class="flex items-center gap-3">
            <div id="status-icon" class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center">
              <!-- Icon injected via JS -->
            </div>
            <div>
              <div id="deadline-date" class="text-[24px] font-bold text-base leading-none">--</div>
              <div id="days-remaining" class="text-[14px] font-medium mt-1">--</div>
            </div>
          </div>
        </div>

        <div class="bg-surface border border-base rounded-[8px] p-4 text-[14px] text-base leading-relaxed">
          <p id="consequence-text">
            This is simple calendar-day arithmetic, not a verified legal deadline. Check the notice and current official sources for the applicable counting rule, extensions, and filing route.
          </p>
        </div>
      </div>
    </div>
  </div>

  
  <!-- Related Guides -->
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-12">
    <div class="border-t border-base pt-12">
      <h2 class="text-[24px] font-semibold text-base mb-4">Related Guides</h2>
      <ul class="list-disc pl-5 space-y-2">
        <li><a href="/gst-notices" class="text-primary hover:underline">GST notices resource hub</a></li>
        <li><a href="/gst-notice-reply-generator" class="text-primary hover:underline">GST notice draft outline tool</a></li>
      </ul>
    </div>
  </div>
<!-- FAQ Section -->
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-20 mt-8">
    <div class="border-t border-base pt-12">
      <h2 class="text-[28px] tracking-[-1px] font-semibold text-base mb-2">Frequently Asked Questions</h2>
      <p class="text-muted text-[15px] mb-8">Understanding GST notices and deadlines.</p>
      <div class="space-y-3">
        {faqs.map((faq, i) => (
          <details class="group rounded-[8px] border border-base bg-surface overflow-hidden" id={`faq-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span class="text-[15px]">{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
const form = document.getElementById('deadline-form');
const allowedDaysInput = document.getElementById('allowedDays');
const dateInput = document.getElementById('receiptDate');
const resultsSection = document.getElementById('results-section');
const estimateDate = document.getElementById('deadline-date');
const estimateStatus = document.getElementById('days-remaining');
const statusIcon = document.getElementById('status-icon');
const note = document.getElementById('consequence-text');

function calculateDateEstimate() {
  const days = Number(allowedDaysInput.value);
  if (!dateInput.value || !Number.isInteger(days) || days < 1) {
    resultsSection.classList.add('hidden');
    return;
  }

  const [year, month, day] = dateInput.value.split('-').map(Number);
  const result = new Date(year, month - 1, day);
  result.setDate(result.getDate() + days);
  estimateDate.textContent = result.toLocaleDateString('en-IN', {
    weekday: 'short', year: 'numeric', month: 'long', day: 'numeric',
  });

  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const resultDay = new Date(result);
  resultDay.setHours(0, 0, 0, 0);
  const difference = Math.round((resultDay.getTime() - today.getTime()) / 86400000);

  if (difference < 0) {
    estimateStatus.textContent = 'Estimated date passed ' + Math.abs(difference) + ' days ago';
    estimateStatus.className = 'text-[14px] font-medium mt-1 text-red-600';
    statusIcon.className = 'flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center bg-red-100 text-red-600';
    statusIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';
  } else if (difference === 0) {
    estimateStatus.textContent = 'Estimated date is today';
    estimateStatus.className = 'text-[14px] font-bold mt-1 text-amber-600';
    statusIcon.className = 'flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center bg-amber-100 text-amber-600';
    statusIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>';
  } else {
    estimateStatus.textContent = difference + ' calendar days from today';
    estimateStatus.className = 'text-[14px] font-medium mt-1 text-green-600';
    statusIcon.className = 'flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center bg-green-100 text-green-600';
    statusIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>';
  }

  note.textContent = 'Simple calendar-day estimate only. Verify the legal starting point, counting rule, holidays, extensions, and filing instructions from the notice and current official sources.';
  resultsSection.classList.remove('hidden');
}

form.addEventListener('input', calculateDateEstimate);
form.addEventListener('change', calculateDateEstimate);
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { regulatoryRates } from '../data/regulatory-rates';

const title = 'MSME Delayed Payment Interest Calculator (Section 16 Rules)';
const description = 'Calculate statutory compound interest on delayed payments to Micro & Small Enterprises (MSEs) under Section 16 of the MSMED Act. Free 3x RBI bank rate monthly compounding calculator.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/msme-delayed-payment-calculator`;

const faqs = [
  {
    q: 'What is the statutory interest rate on delayed payments to MSMEs under Section 16?',
    a: 'Under Section 16 of the MSMED Act, 2006, the interest rate is strictly three times the RBI Bank Rate (currently 5.50%), amounting to 16.50% per annum. It is compounded with monthly rests and is mandatory by law.',
  },
  {
    q: 'Who is eligible to claim interest under Section 16 of the MSMED Act?',
    a: 'Delayed payment protections under Chapter V (Sections 15-24) apply strictly to Micro and Small Enterprises (MSEs) holding a valid Udyam registration on or before the invoice date. Medium enterprises and trading entities are excluded.',
  },
  {
    q: 'What is the maximum statutory credit period for paying MSE suppliers?',
    a: 'Under Section 15, the agreed payment period cannot exceed 45 days from the date of acceptance. If there is no written contract, payment must be released within 15 days. Any contract clause attempting to enforce longer terms (e.g. 60 or 90 days) is void ab initio.',
  },
  {
    q: 'What does "monthly rests" mean in Section 16 compound interest calculation?',
    a: 'Monthly rests means that at the end of each calendar month, accrued statutory interest is added to the principal balance, and subsequent interest is calculated on this cumulative amount. This prevents debtors from treating unpaid balances as cheap credit.',
  },
  {
    q: 'Can a buyer contractually agree with an MSE supplier to waive delayed payment interest?',
    a: 'No. Section 16 contains an overriding non-obstante clause ("Notwithstanding anything contained in any agreement..."). Statutory interest is mandatory by operation of law and cannot be waived, reduced, or modified by contract.',
  },
  {
    q: 'Is interest paid on delayed MSE payments tax-deductible for the buyer?',
    a: 'No. Under Section 23 of the MSMED Act, interest paid or payable on delayed payments to Micro and Small enterprises is strictly non-deductible when computing taxable business profits under the Income-tax Act, 1961.',
  },
  {
    q: 'How does Section 43B(h) of the Income Tax Act enforce timely payments to MSEs?',
    a: 'Section 43B(h) disallows any payment due to a Micro or Small enterprise remaining unpaid beyond the Section 15 deadline (15/45 days) as a business deduction in that financial year, adding the overdue principal back to taxable income unless discharged before the financial year ends.',
  },
  {
    q: 'Are retail and wholesale traders registered under Udyam eligible for Section 16 interest?',
    a: 'No. As clarified by the Ministry of MSME (Office Memorandum No. 5/2(2)/2021-E/P&G/Policy), retail and wholesale traders (NIC codes 45, 46, and 47) registered under Udyam are eligible solely for Priority Sector Lending (PSL) benefits and cannot claim Section 16 remedies or Section 43B(h) protections.',
  },
  {
    q: 'Where and how can an MSE supplier file a claim for delayed payment recovery?',
    a: 'MSE suppliers can file an online reference against defaulting buyers on the MSME Samadhaan portal (samadhaan.msme.gov.in) before the Micro and Small Enterprise Facilitation Council (MSEFC) of their state, which conducts statutory conciliation and arbitration.',
  },
  {
    q: 'Does this calculator output represent a formal legal decree?',
    a: 'No. This calculator provides an accurate statutory estimate based on the current RBI Bank Rate (5.50%) and Section 16 compounding rules for financial planning and reconciliation. Official recovery requires reference to the MSEFC or appropriate legal forum.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'MSME Delayed Payment Interest Calculator',
    url: `${siteUrl}/msme-delayed-payment-calculator`,
    description: 'Calculate interest on delayed payments to Micro and Small Enterprises under Section 16 of MSME Development Act.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];

const lastUpdated = '2026-09-16';
const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/#tools-heading' },
  { name: 'MSME Delayed Payment', href: '/msme-delayed-payment-calculator' },
];
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-base mb-3 tracking-[-1.28px]">
        MSME Delayed Payment Interest Calculator
      </h1>
      <p class="text-[16px] text-muted max-w-2xl mx-auto leading-relaxed">
        Calculate statutory compound interest payable on delayed payments to <strong>Micro &amp; Small Enterprises (MSEs)</strong> under <strong>Section 16</strong> of the MSMED Act, 2006. Interest rate = 3× RBI bank rate.
      </p>
      <p class="text-[13px] text-muted mt-2">Last verified: 16 September 2026 · RBI Bank Rate: 5.50% · Penalty Rate: 16.50% p.a. (Monthly Rests)</p>
    </div>

    <!-- Calculator -->
    <div class="mx-auto max-w-2xl rounded-2xl border border-base bg-surface p-6 sm:p-8 shadow-sm">
      <div class="space-y-5">
        <!-- Invoice Amount -->
        <div>
          <label for="invoice-amount" class="block text-sm font-medium text-base mb-1.5">Invoice Amount (₹)</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-muted font-medium select-none" aria-hidden="true">₹</span>
            <input id="invoice-amount" type="number" inputmode="decimal" min="0" step="0.01" placeholder="0.00"
              class="w-full rounded-xl border border-base bg-subtle pl-9 pr-4 py-3.5 text-[16px] font-medium focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-all" />
          </div>
        </div>

        <!-- Due Date -->
        <div>
          <label for="due-date" class="block text-sm font-medium text-base mb-1.5">Payment Due Date (Max 45 days from supply)</label>
          <input id="due-date" type="date"
            class="w-full rounded-xl border border-base bg-subtle px-4 py-3.5 text-[16px] font-medium focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-all" />
        </div>

        <!-- Actual Payment Date -->
        <div>
          <label for="payment-date" class="block text-sm font-medium text-base mb-1.5">Actual Payment Date</label>
          <input id="payment-date" type="date"
            class="w-full rounded-xl border border-base bg-subtle px-4 py-3.5 text-[16px] font-medium focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-all" />
        </div>

        <!-- Bank Rate -->
        <div>
          <label for="bank-rate" class="block text-sm font-medium text-base mb-1.5">RBI Bank Rate (%)</label>
          <input id="bank-rate" type="number" inputmode="decimal" value="5.5" min="0" max="25" step="0.25"
            class="w-full rounded-xl border border-base bg-subtle px-4 py-3.5 text-[16px] font-medium focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-all" />
          <p class="mt-1 text-xs text-muted">Current RBI bank rate is 5.50%. Statutory Interest = 3 × bank rate = 16.50% p.a. (compounded with monthly rests).</p>
        </div>
      </div>

      <!-- Results -->
      <div class="mt-8 rounded-xl border border-base bg-subtle p-6 space-y-4">
        <div class="flex justify-between items-center py-2 border-b border-base">
          <span class="text-sm text-muted">Days Delayed</span>
          <span id="result-days" class="text-lg font-bold text-base">0 days</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-base">
          <span class="text-sm text-muted">Applicable Rate (3× RBI bank rate)</span>
          <span id="result-rate" class="text-lg font-bold text-base">16.50% p.a.</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-base">
          <div>
            <span class="text-sm text-muted block">Estimated Statutory Interest</span>
            <span class="text-[11px] text-muted">Compounded with monthly rests</span>
          </div>
          <span id="result-interest" class="text-lg font-bold text-accent">₹0.00</span>
        </div>
        <div class="flex justify-between items-center py-2">
          <span class="text-sm font-medium text-base">Total Estimated Payable (Principal + Interest)</span>
          <span id="result-total" class="text-xl font-bold text-accent">₹0.00</span>
        </div>
      </div>

      <div class="mt-3 p-3 rounded-lg bg-surface border border-base text-[12px] text-muted leading-relaxed">
        <span class="font-semibold text-base">Statutory Scope:</span> Applicable strictly to registered <strong>Micro and Small Enterprises (MSEs)</strong>. Medium enterprises and retail/wholesale trading entities (NIC 45/46/47) are not covered under Chapter V Section 16 recovery.
      </div>

      <button id="btn-reset" type="button" class="mt-4 w-full rounded-xl border border-base bg-surface py-2.5 text-[14px] font-medium text-muted hover:text-base hover:bg-subtle transition-colors">
        Reset
      </button>
    </div>

    <!-- SEO Content -->
    <div class="mt-16 border-t border-base pt-12">
      <h2 class="text-[24px] font-semibold text-base mb-6 tracking-[-0.6px]">MSME Delayed Payment Rules — Section 16 Explained</h2>
      <div class="prose prose-neutral dark:prose-invert max-w-none text-[15px] leading-[1.7]">
        <p>
          Under Chapter V (Sections 15–24) of the <strong>Micro, Small and Medium Enterprises Development (MSMED) Act, 2006</strong>, delayed payment protections apply strictly to <strong>Micro and Small Enterprises (MSEs)</strong>. Under <strong>Section 15</strong>, any buyer purchasing goods or services from an MSE supplier must make payment within 45 days from the date of acceptance (where agreed in writing) or within 15 days if there is no written contract.
        </p>
        <p>
          If payment is not released on time, <strong>Section 16</strong> mandates that the buyer pays compound interest at <strong>three times the bank rate</strong> notified by the Reserve Bank of India (RBI). As of September 2026, the RBI bank rate is 5.50%, making the applicable statutory interest rate <strong>16.50% per annum</strong>, compounded with monthly rests.
        </p>

        <h3>Key Eligibility &amp; Compliance Rules for MSE Suppliers</h3>
        <ul>
          <li><strong>Restricted to Micro &amp; Small Enterprises:</strong> Statutory delayed payment interest and MSEFC reference apply exclusively to Micro and Small enterprises. Medium enterprises are excluded from Section 16 recovery.</li>
          <li><strong>Traders Excluded (NIC 45/46/47):</strong> Retail and wholesale traders registered under Udyam are eligible solely for Priority Sector Lending (PSL) benefits and are not eligible for Section 16 interest or Section 43B(h) protection.</li>
          <li><strong>Mandatory timeline:</strong> Maximum 45 days under contract, or 15 days without agreement. Any contract clause stipulating 60, 90, or 120 days is void under law.</li>
          <li><strong>Statutory interest rate:</strong> 3× RBI bank rate (currently 16.50% p.a.), compounded with monthly rests.</li>
          <li><strong>No contractual waiver:</strong> Section 16 contains an overriding non-obstante clause; buyers cannot contractually waive this liability.</li>
          <li><strong>Tax disallowance (Double Penalty):</strong> Under Section 23 of the MSMED Act, interest paid is <strong>not deductible</strong> as a business expense. Under Section 43B(h) of the Income Tax Act, overdue principal amounts are disallowed and added back to taxable profit.</li>
          <li><strong>Udyam registration prerequisite:</strong> The supplier must possess a valid Udyam registration on or before the invoice date to enforce statutory remedies.</li>
        </ul>

        <!-- Statutory Reference Box -->
        <div class="rounded-xl border border-base bg-subtle p-5 my-6 text-[14px] not-prose">
          <div class="font-semibold text-base mb-2 flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-accent"></span>
            Primary Statutory Sources &amp; Regulatory References
          </div>
          <ul class="space-y-1.5 text-muted text-[13px]">
            <li>• <strong>Reserve Bank of India:</strong> Current Policy Rates &amp; Bank Rate (5.50%) · <a href="https://www.rbi.org.in/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">RBI Official Portal ↗</a></li>
            <li>• <strong>MSME Samadhaan:</strong> Delayed Payment Dispute Filing &amp; Facilitation Council Rules · <a href="https://samadhaan.msme.gov.in/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">samadhaan.msme.gov.in ↗</a></li>
            <li>• <strong>Statutory Provisions:</strong> Sections 15, 16, and 23 of the MSMED Act, 2006; Section 43B(h) of the Income Tax Act, 1961.</li>
          </ul>
        </div>

        <p>
          Read our in-depth legal analysis: <a href="/blog/msme-delayed-payment-interest-rate-rbi-rules-2026" class="text-accent hover:underline font-medium">MSME Delayed Payment Interest Rate: 3x RBI Bank Rate Rules &amp; Section 16 Calculation (2026)</a>. For small business tax planning, also check our <a href="/msme-registration-checker" class="text-accent hover:underline">MSME Registration Checker</a>, our <a href="/blog/gst-for-freelancers-india-2026" class="text-accent hover:underline">GST for freelancers guide</a>, and our <a href="/aggregate-turnover-calculator" class="text-accent hover:underline">GST Aggregate Turnover Calculator</a>.
        </p>
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-12 border-t border-base pt-10">
      <h2 class="text-[24px] font-semibold text-base mb-6 tracking-[-0.6px]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq, i) => (
          <details class="group rounded-[8px] border border-base bg-surface overflow-hidden" id={`faq-msme-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span class="text-[15px]">{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const invoiceInput = document.getElementById('invoice-amount') as HTMLInputElement;
  const dueDateInput = document.getElementById('due-date') as HTMLInputElement;
  const paymentDateInput = document.getElementById('payment-date') as HTMLInputElement;
  const bankRateInput = document.getElementById('bank-rate') as HTMLInputElement;
  const resultDays = document.getElementById('result-days')!;
  const resultRate = document.getElementById('result-rate')!;
  const resultInterest = document.getElementById('result-interest')!;
  const resultTotal = document.getElementById('result-total')!;

  function formatINR(value: number) {
    return '₹' + value.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function calculate() {
    const principal = parseFloat(invoiceInput.value) || 0;
    const bankRate = parseFloat(bankRateInput.value) || 5.5;
    const annualRate = bankRate * 3; // 3× bank rate
    const monthlyRate = annualRate / 100 / 12;

    const dueDate = dueDateInput.value ? new Date(dueDateInput.value) : null;
    const paymentDate = paymentDateInput.value ? new Date(paymentDateInput.value) : null;

    resultRate.textContent = `${annualRate.toFixed(2)}% p.a.`;

    if (!dueDate || !paymentDate || !principal) {
      resultDays.textContent = '0 days';
      resultInterest.textContent = '₹0.00';
      resultTotal.textContent = formatINR(principal);
      return;
    }

    const diffMs = paymentDate.getTime() - dueDate.getTime();
    const delayDays = Math.max(0, Math.floor(diffMs / (1000 * 60 * 60 * 24)));

    resultDays.textContent = `${delayDays} day${delayDays === 1 ? '' : 's'}`;

    if (delayDays <= 0) {
      resultInterest.textContent = '₹0.00';
      resultTotal.textContent = formatINR(principal);
      return;
    }

    // Statutory compound interest with monthly rests (Section 16 MSMED Act):
    // Full 30-day rests compound: P_accumulated = P * (1 + monthlyRate)^fullMonths
    // Remaining days accrue simple prorated interest on the compounded balance
    const fullMonths = Math.floor(delayDays / 30);
    const remainingDays = delayDays % 30;

    let accumulated = principal;
    for (let i = 0; i < fullMonths; i++) {
      accumulated *= (1 + monthlyRate);
    }

    if (remainingDays > 0) {
      const dailyRate = annualRate / 100 / 365;
      accumulated += accumulated * dailyRate * remainingDays;
    }

    const interest = accumulated - principal;

    resultInterest.textContent = formatINR(interest);
    resultTotal.textContent = formatINR(accumulated);
  }

  // Set default dates
  const today = new Date();
  const dueDefault = new Date(today);
  dueDefault.setDate(dueDefault.getDate() - 30);
  dueDateInput.value = dueDefault.toISOString().split('T')[0];
  paymentDateInput.value = today.toISOString().split('T')[0];

  [invoiceInput, dueDateInput, paymentDateInput, bankRateInput].forEach(el => {
    el.addEventListener('input', calculate);
  });

  document.getElementById('btn-reset')?.addEventListener('click', () => {
    invoiceInput.value = '';
    bankRateInput.value = '5.5';
    dueDateInput.value = dueDefault.toISOString().split('T')[0];
    paymentDateInput.value = today.toISOString().split('T')[0];
    calculate();
  });

  calculate();
</script>

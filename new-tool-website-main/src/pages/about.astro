---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About Taxzentic — Free GST Tools for India';
const description = 'Learn about Taxzentic, our tax tools, research process, editorial standards, and how to contact the team.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Taxzentic',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/taxzentic-logo.png`,
  },
  description: 'Free, instant GST tools for Indian businesses and taxpayers.',
};

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about' },
];
---

<BaseLayout {title} {description} {structuredData} {breadcrumb}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-base mb-3 tracking-[-1.28px]">About Taxzentic</h1>
      <p class="text-muted text-lg leading-relaxed">
        Practical tax calculators and reference tools for Indian businesses, taxpayers, and professionals.
      </p>
    </div>

    <div class="space-y-10 text-base leading-relaxed text-muted">

      <section>
        <h2 class="text-xl font-semibold text-base mb-3 tracking-[-0.6px]">Our Mission</h2>
        <p>
          Taxzentic provides online tools and educational references to help people work through common tax and compliance calculations. Most tools can be used without creating an account. Results depend on the information and assumptions entered, and should be checked against current official requirements.
        </p>
        <p class="mt-3">
          India's GST system, while transformative, can be complex. With multiple tax slabs, thousands of HSN/SAC codes, and strict GSTIN format requirements, even experienced professionals sometimes need a quick reference. We built these tools to be that reference.
        </p>
      </section>

      <!-- E-E-A-T: Editorial Process (important for YMYL content) -->
      <section class="rounded-xl border border-base bg-subtle p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
          <h2 class="text-xl font-semibold text-base tracking-[-0.6px]">Our Editorial & Verification Process</h2>
          <a href="/authors/editorial-team" class="text-xs font-semibold text-accent hover:underline flex items-center gap-1">
            Meet our Editorial & Research Team →
          </a>
        </div>
        <p class="mb-4">
          We research our tools and educational pages using primary government materials where relevant. The method, scope, and references vary by page; pages with a dated legal review show that date alongside their sources.
        </p>
        <div class="space-y-4">
          <div class="flex gap-3">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">1</div>
            <div>
              <span class="font-medium text-base">Research & Source Verification</span>
              <p class="text-sm mt-0.5">All GST rates, thresholds, and rules are cross-referenced against official CBIC notifications, GST Council press releases, and the Finance Act text.</p>
            </div>
          </div>
          <div class="flex gap-3">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">2</div>
            <div>
              <span class="font-medium text-base">Source-Led Research</span>
              <p class="text-sm mt-0.5">We use official legislation, notifications, circulars, and department guidance as primary references where applicable. A source citation does not mean that a tool determines your legal position.</p>
            </div>
          </div>
          <div class="flex gap-3">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">3</div>
            <div>
              <span class="font-medium text-base">Review and Corrections</span>
              <p class="text-sm mt-0.5">We review content when changes or reader reports come to our attention. A review date is shown only where one has been recorded for that page.</p>
            </div>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-base mb-3 tracking-[-0.6px]">What We Offer</h2>
        <p class="mb-4">The site includes a growing set of GST, income-tax, and business compliance tools, from basic calculations to reference and reconciliation utilities.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
          {[
            {
              title: 'GST Calculator',
              desc: 'Add or remove GST with CGST/SGST split. Supports all slabs and custom rates.',
              href: '/gst-calculator',
            },
            {
              title: 'HSN Code Lookup',
              desc: 'Search the available HSN and SAC reference data. Confirm classification and rates against current official schedules.',
              href: '/hsn-code-lookup',
            },
            {
              title: 'GSTIN Validator',
              desc: 'Check GSTIN format and checksum and view encoded state and PAN portions. This does not check live registration status.',
              href: '/gstin-validator',
            },
          ].map((tool) => (
            <a
              href={tool.href}
              class="group rounded-xl border border-base bg-surface p-5 hover:border-accent/50 hover:shadow-md transition-all"
            >
              <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-accent/10 flex items-center justify-center mb-3">
                <svg class="w-[18px] h-[18px] text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4h16v16H4V4zm4 4h2v2H8V8zm0 4h2v2H8v-2zm4-8h4v2h-4V8z" />
                </svg>
              </div>
              <h3 class="font-semibold text-base mb-1 group-hover:text-accent transition-colors">{tool.title}</h3>
              <p class="text-sm text-muted">{tool.desc}</p>
            </a>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-base mb-3 tracking-[-0.6px]">Our Principles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            { title: 'Clear Data Practices', desc: 'Many tools process inputs in your browser. The AI notice feature sends submitted fields to our server and Groq; see the Privacy Policy.' },
            { title: 'Practical Tools', desc: 'Calculators are designed to show an estimate based on selected inputs; reference lookups may use local data files.' },
            { title: 'Mobile Friendly', desc: 'The site is designed to adapt to phone, tablet, and desktop screens.' },
            { title: 'Accessibility Improvements', desc: 'We aim for readable interfaces, keyboard support, and clear labels, and welcome reports about barriers.' },
            { title: 'No Account Required', desc: 'The available tools can be used without creating a Taxzentic account.' },
            { title: 'Open & Transparent', desc: 'Tool pages show methods, limitations, source references, and dated legal reviews where available.' },
          ].map(({ title, desc }) => (
            <div class="flex gap-3 p-4 rounded-lg border border-base bg-surface">
              <div class="flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <span class="font-medium text-base">{title}</span>
                <p class="text-sm text-muted mt-0.5">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-base mb-3 tracking-[-0.6px]">Disclaimer</h2>
        <p>
          Taxzentic is an independent informational website and is not affiliated with or endorsed by the Government of India, CBIC, GSTN, or the GST Council. Calculations and content are for reference only; rates and legal requirements may change.
        </p>
        <p class="mt-3">
          Read our full <a href="/disclaimer" class="text-accent hover:underline">tax and tool disclaimer</a>. For official GST information, refer to <a href="https://www.gst.gov.in" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">gst.gov.in</a> and <a href="https://www.cbic.gov.in" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">cbic.gov.in</a>.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-base mb-3 tracking-[-0.6px]">Get in Touch</h2>
        <p>
          Have a suggestion, found an error, or want to contribute to our HSN dataset? We'd love to hear from you. <a href="/contact" class="text-accent hover:underline font-medium">Contact us here</a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';

const title = 'Freelancer GST Invoice Generator (USD, EUR, INR & LUT Export) | Taxzentic';
const description = 'Free GST invoice generator designed for Indian freelancers, consultants, and developers. Supports USD/EUR currencies, 0% export under LUT, and SAC 9983.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/freelancer-invoice-generator`;

const faqs = [
  {
    q: 'Do Indian freelancers need to register for GST?',
    a: 'GST registration is mandatory if your aggregate annual turnover exceeds ₹20 Lakhs (₹10 Lakhs in Special Category States). However, if you provide cross-border services or export services under LUT, having GST registration is necessary to claim zero-rated benefits.',
  },
  {
    q: 'What SAC code do freelancers use for IT and software consulting?',
    a: 'Most freelance software engineers, UI/UX designers, digital marketers, and tech consultants use SAC 9983 (Other professional, technical, and business services) or SAC 998314 for IT design and development services.',
  },
  {
    q: 'Do Indian freelancers need to charge GST to foreign clients?',
    a: 'No. Services provided to overseas clients qualify as "Export of Services" under Section 2(6) of the IGST Act, which is zero-rated. You can issue export invoices at 0% GST by filing a free annual Letter of Undertaking (LUT) in Form GST RFD-11.',
  },
  {
    q: 'What is a Letter of Undertaking (LUT) and how often must it be filed?',
    a: 'An LUT is a statutory declaration filed on the official GST portal before making export supplies in a financial year. It remains valid for one entire financial year (April 1 to March 31) and must be renewed annually before April.',
  },
  {
    q: 'What mandatory endorsement must appear on an export invoice under LUT?',
    a: 'Under Rule 96A(1) of the CGST Rules, the invoice must state: "SUPPLY MEANT FOR EXPORT OF SERVICES UNDER LETTER OF UNDERTAKING WITHOUT PAYMENT OF INTEGRATED TAX". This tool automatically adds this statutory endorsement.',
  },
  {
    q: 'Can freelancers invoice in foreign currencies like USD, EUR, or GBP?',
    a: 'Yes. Under GST rules, you may bill foreign clients in USD, EUR, GBP, or other convertible currencies. For filing GSTR-1 and GSTR-3B, the taxable value must be converted into Indian Rupees (INR) using the applicable CBIC exchange rate on the invoice date.',
  },
  {
    q: 'Is payment through PayPal, Stripe, or Wise considered valid foreign realization?',
    a: 'Yes, provided the inward remittance is received in convertible foreign currency (or INR under permitted RBI mechanisms) and supported by a Foreign Inward Remittance Statement (FIRS/FIRA) from the processing bank.',
  },
  {
    q: 'What is the GST rate for domestic freelance services within India?',
    a: 'Domestic commercial consulting and IT services are taxed at 18% GST (9% CGST + 9% SGST for clients in your home state, or 18% IGST for interstate clients).',
  },
  {
    q: 'Is invoice data created on this tool stored or sent to a server?',
    a: 'No. All calculations, currency conversions, and printable layouts execute 100% locally in your web browser. No financial data, client names, or amounts are ever sent to our servers.',
  },
  {
    q: 'Does this tool generate an electronic invoice (IRN) on the GST portal?',
    a: 'No. E-invoicing through an IRP is mandatory only for businesses with aggregate turnover exceeding ₹5 Crore. For individual professionals and agencies below this threshold, this tool produces a fully compliant printable GST tax invoice.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Freelancer GST Invoice Generator India',
    url: canonical,
    description: 'Create compliant GST invoices for domestic clients and zero-rated international clients under LUT.',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'INR',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/#tools-heading' },
  { name: 'Freelancer Invoice Generator', href: '/freelancer-invoice-generator' },
];

const lastUpdated = '2026-09-15';
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <!-- Header -->
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-50/50 dark:bg-blue-950/40 px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-accent mb-4">
        <span class="h-2 w-2 rounded-full bg-accent animate-pulse"></span>
        Built for Developers, Designers & Consultants
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-base mb-4">
        Freelancer GST Invoice Generator
      </h1>
      <p class="text-[17px] text-muted max-w-2xl mx-auto leading-relaxed">
        Generate compliant tax invoices for Indian domestic clients (18% GST) or foreign clients (0% Export of Services under LUT). Supports USD, EUR, GBP, and INR.
      </p>
    </div>

    <!-- Generator Interface -->
    <div class="rounded-3xl border border-base bg-surface p-6 sm:p-10 shadow-lg mb-12">
      <!-- Top Settings -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 pb-6 border-b border-base">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Supply Type</label>
          <select id="inv-supply-type" class="w-full rounded-xl border border-base bg-subtle px-4 py-2.5 text-sm focus:border-accent focus:outline-none">
            <option value="export-lut">Export of Services (0% IGST under LUT)</option>
            <option value="domestic-igst">Domestic Client (Inter-State 18% IGST)</option>
            <option value="domestic-cgst">Domestic Client (Intra-State 9% CGST + 9% SGST)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Currency</label>
          <select id="inv-currency" class="w-full rounded-xl border border-base bg-subtle px-4 py-2.5 text-sm focus:border-accent focus:outline-none">
            <option value="USD">USD ($)</option>
            <option value="EUR">EUR (€)</option>
            <option value="GBP">GBP (£)</option>
            <option value="INR">INR (₹)</option>
          </select>
        </div>

        <div id="wrap-lut">
          <label class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">LUT ARN Number</label>
          <input type="text" id="inv-lut-arn" value="AD270325012345Z" class="w-full rounded-xl border border-base bg-subtle px-4 py-2.5 text-sm font-mono focus:border-accent focus:outline-none" />
        </div>
      </div>

      <!-- Printable Invoice Preview Container -->
      <div id="printable-invoice" class="p-6 sm:p-10 rounded-2xl border border-base bg-surface space-y-8">
        <!-- Invoice Header -->
        <div class="flex flex-col sm:flex-row justify-between gap-6 pb-6 border-b border-base">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-accent font-bold block mb-1">Tax Invoice</span>
            <input type="text" id="inv-sender-name" value="Alex Rivera (Freelance Full-Stack Developer)" class="text-xl font-bold text-base bg-transparent border-b border-transparent hover:border-base focus:border-accent focus:outline-none w-full mb-1" />
            <input type="text" id="inv-sender-gstin" value="GSTIN: 27AABCU9603R1ZM" class="text-xs font-mono text-muted bg-transparent border-b border-transparent hover:border-base focus:border-accent focus:outline-none w-full mb-1" />
            <input type="text" id="inv-sender-address" value="Bengaluru, Karnataka, India" class="text-xs text-muted bg-transparent border-b border-transparent hover:border-base focus:border-accent focus:outline-none w-full" />
          </div>

          <div class="text-left sm:text-right space-y-1 font-mono text-xs">
            <div>
              <span class="text-muted">Invoice No: </span>
              <input type="text" id="inv-no" value="INV-2026-081" class="font-bold text-base bg-transparent border-b border-transparent hover:border-base focus:border-accent focus:outline-none text-right w-32" />
            </div>
            <div>
              <span class="text-muted">Date: </span>
              <input type="date" id="inv-date" value="2026-09-15" class="text-base bg-transparent border-b border-transparent hover:border-base focus:border-accent focus:outline-none" />
            </div>
          </div>
        </div>

        <!-- Bill To -->
        <div class="pb-6 border-b border-base">
          <span class="text-xs font-mono uppercase tracking-wider text-muted font-semibold block mb-2">Billed To (Client Details):</span>
          <input type="text" id="inv-client-name" value="Acme Technologies Inc." class="text-base font-bold text-base bg-transparent border-b border-transparent hover:border-base focus:border-accent focus:outline-none w-full mb-1" />
          <input type="text" id="inv-client-address" value="101 Silicon Valley Blvd, San Francisco, CA, USA" class="text-xs text-muted bg-transparent border-b border-transparent hover:border-base focus:border-accent focus:outline-none w-full mb-1" />
          <input type="text" id="inv-client-taxid" value="Client Tax ID: US-EIN-98765432" class="text-xs font-mono text-muted bg-transparent border-b border-transparent hover:border-base focus:border-accent focus:outline-none w-full" />
        </div>

        <!-- Export Declaration Banner -->
        <div id="export-banner" class="p-3 rounded-xl bg-accent/5 border border-accent/20 text-xs font-mono text-accent text-center font-bold">
          SUPPLY MEANT FOR EXPORT UNDER LETTER OF UNDERTAKING WITHOUT PAYMENT OF INTEGRATED TAX
        </div>

        <!-- Line Items -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono">
            <thead>
              <tr class="border-b border-base text-muted uppercase">
                <th class="py-2.5 px-2">Description</th>
                <th class="py-2.5 px-2">SAC Code</th>
                <th class="py-2.5 px-2">Hours/Qty</th>
                <th class="py-2.5 px-2">Rate</th>
                <th class="py-2.5 px-2 text-right">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base/50">
              <tr>
                <td class="py-3 px-2">
                  <input type="text" value="React Frontend Architecture & Next.js API Integration" class="w-full bg-transparent font-sans text-sm font-medium focus:outline-none" />
                </td>
                <td class="py-3 px-2">
                  <input type="text" value="998314" class="w-20 bg-transparent focus:outline-none" />
                </td>
                <td class="py-3 px-2">
                  <input type="number" id="item-qty" value="40" min="1" class="w-16 bg-transparent focus:outline-none" />
                </td>
                <td class="py-3 px-2">
                  <input type="number" id="item-rate" value="50" min="0" class="w-20 bg-transparent focus:outline-none" />
                </td>
                <td class="py-3 px-2 text-right font-bold text-sm" id="item-total">$2,000.00</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Totals & Bank Details -->
        <div class="flex flex-col sm:flex-row justify-between gap-6 pt-6 border-t border-base">
          <div class="text-xs text-muted space-y-1 font-mono">
            <strong class="text-base block mb-1">Bank Payment Details:</strong>
            <p>Beneficiary: Alex Rivera</p>
            <p>Bank: HDFC Bank Limited</p>
            <p>Account No: 50100123456789</p>
            <p>IFSC: HDFC0001234 · SWIFT: HDFCINBBXXX</p>
          </div>

          <div class="w-full sm:w-64 space-y-2 font-mono text-xs text-right">
            <div class="flex justify-between text-muted">
              <span>Subtotal:</span>
              <span id="tot-subtotal">$2,000.00</span>
            </div>
            <div class="flex justify-between text-muted">
              <span id="tot-tax-label">IGST (0% LUT):</span>
              <span id="tot-tax">$0.00</span>
            </div>
            <div class="flex justify-between border-t border-base pt-2 text-base font-bold text-accent">
              <span>Total Payable:</span>
              <span id="tot-final">$2,000.00</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <button
          id="btn-print"
          type="button"
          class="rounded-full bg-accent text-white px-8 py-3 text-sm font-bold shadow-md hover:opacity-90 transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
          Print / Save as PDF
        </button>
      </div>
    </div>

    <!-- FAQ Section -->
    <section class="mt-16 pt-12 border-t border-base" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-base mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="group rounded-xl border border-base bg-surface overflow-hidden" id={`faq-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span>{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[15px] text-muted leading-relaxed border-t border-base pt-4">{faq.a}</div>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script is:inline>
    const syms = { USD: '$', EUR: '€', GBP: '£', INR: '₹' };

    function calculateInvoice() {
      const supplyType = document.getElementById('inv-supply-type').value;
      const currency = document.getElementById('inv-currency').value;
      const sym = syms[currency] || '$';

      const qty = Math.max(0, parseFloat(document.getElementById('item-qty').value) || 0);
      const rate = Math.max(0, parseFloat(document.getElementById('item-rate').value) || 0);
      const subtotal = qty * rate;

      let taxRate = 0;
      let taxLabel = 'IGST (0% LUT):';
      const expBanner = document.getElementById('export-banner');
      const wrapLut = document.getElementById('wrap-lut');

      if (supplyType === 'export-lut') {
        taxRate = 0;
        taxLabel = 'IGST (0% LUT):';
        expBanner?.classList.remove('hidden');
        wrapLut?.classList.remove('hidden');
      } else if (supplyType === 'domestic-igst') {
        taxRate = 18;
        taxLabel = 'IGST (18%):';
        expBanner?.classList.add('hidden');
        wrapLut?.classList.add('hidden');
      } else {
        taxRate = 18;
        taxLabel = 'CGST (9%) + SGST (9%):';
        expBanner?.classList.add('hidden');
        wrapLut?.classList.add('hidden');
      }

      const tax = (subtotal * taxRate) / 100;
      const finalTotal = subtotal + tax;

      const fmt = (num) => sym + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      document.getElementById('item-total').textContent = fmt(subtotal);
      document.getElementById('tot-subtotal').textContent = fmt(subtotal);
      document.getElementById('tot-tax-label').textContent = taxLabel;
      document.getElementById('tot-tax').textContent = fmt(tax);
      document.getElementById('tot-final').textContent = fmt(finalTotal);
    }

    ['inv-supply-type', 'inv-currency', 'item-qty', 'item-rate'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', calculateInvoice);
      document.getElementById(id)?.addEventListener('change', calculateInvoice);
    });

    document.getElementById('btn-print')?.addEventListener('click', () => {
      window.print();
    });

    calculateInvoice();
  </script>

  <style>
    @media print {
      :global(header), :global(footer), :global(nav), #btn-print, select, label, .mb-14 {
        display: none !important;
      }
      body {
        background: #fff !important;
        color: #000 !important;
      }
      #printable-invoice {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
      }
      input {
        border: none !important;
      }
    }
  </style>
</BaseLayout>

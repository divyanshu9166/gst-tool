---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Pin to Pin Distance Calculator (Instant & Free) — E-Way Bill';
const description = 'Calculate exact motorable road distance between Indian PIN codes for E-Way Bill generation. Includes official +10% NIC tolerance & validity days. 100% free.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/pin-to-pin-distance-calculator`;

const faqsList = [
  { q: 'Why is pincode-to-pincode distance important for GST?', a: 'Distance between supplier and recipient pincodes determines the validity period of an E-Way Bill. Shorter distances get shorter validity (1 day for up to 200 km), while longer distances allow more time. Knowing the exact distance helps you plan your logistics to avoid e-way bill expiry during transit.' },
  { q: 'E-way bill me pin to pin distance galat ho jaye toh kya kare?', a: 'Agar E-way bill me distance actual se kam ya jyada generate ho gaya hai, to GST rules ke mutabik ±10% variation allowed hai. Agar discrepancy 10% se jyada hai aur transport abhi start nahi hua, to 24 ghante ke andar E-way bill cancel karke naya generate karein. Transit start ho chuka hai toh Part-B me vehicle details update karein aur actual route record maintain karein.' },
  { q: 'How is e-way bill validity calculated based on distance?', a: 'Under GST Rule 138(10): For normal cargo, 1 day for every 200 km or part thereof. For Over-Dimensional Cargo (ODC) or multimodal shipments involving ship, 1 day for every 20 km or part thereof.' },
  { q: 'What is the 10% distance variation rule on the NIC E-Way Bill portal?', a: 'Taxpayers are permitted to increase the distance auto-populated by the NIC portal by up to +10% to account for highway bypasses, ring roads, and alternative transit routes without attracting scrutiny.' },
  { q: 'Is an e-way bill required for distances under 50 km?', a: 'Yes. If the consignment value exceeds ₹50,000 (or state-specific intra-state threshold), generating an E-Way Bill (Part A) is mandatory regardless of distance—even for 1 km. The 50-km rule under Rule 138(3) and Rule 138(5) is strictly an exemption from updating Part B (conveyance/vehicle details) when goods are moved intra-state between the consignor/consignee and the transporter\'s premises for further transit.' },
  { q: 'Can I extend an e-way bill if my vehicle is delayed?', a: 'Yes. You can extend the validity of an e-way bill on the NIC portal within 8 hours before or 8 hours after the exact time of expiry by updating Part-B with the current vehicle location and reason for delay.' },
  { q: 'What happens if goods are transported after e-way bill expiry?', a: 'Transporting goods with an expired e-way bill is treated as movement without documents, attracting detention under Section 129 and mandatory penalties equal to 200% of the applicable tax.' },
  { q: 'How accurate are pincode distance calculations?', a: 'Pincode-to-pincode distance calculations estimate motorable road distance based on NHAI highways and postal centroid coordinates. Discrepancies within 10% are legally tolerated.' },
  { q: 'What should I do if distance shows 0 km on the E-Way Bill portal?', a: 'If distance shows 0 km, the PIN code pair is unmapped in the NIC database. You are legally allowed to manually enter the actual road distance from Google Maps or our calculator.' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pin to Pin Distance Calculator for E-Way Bill',
    url: canonical,
    description: description,
    applicationCategory: 'LogisticsApplication',
    operatingSystem: 'All',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'INR',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqsList.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];

const lastUpdated = '2026-09-16';
const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/#tools-heading' },
  { name: 'Pin To Pin Distance Calculator', href: '/pin-to-pin-distance-calculator' },
];

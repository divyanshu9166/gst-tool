  function calculateHaversineKm(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 6371; // Earth's mean radius in km
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon / 2) * Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  function estimateMotorableDistance(pin1: string, pin2: string): number {
    if (pin1 === pin2) return 5;

    const prefix1 = pin1.substring(0, 2);
    const prefix2 = pin2.substring(0, 2);

    // If both belong to the exact same postal 2-digit circle
    if (prefix1 === prefix2) {
      if (pin1.substring(0, 3) === pin2.substring(0, 3)) {
        // Same sorting district: local transit (approx 10 - 30 km)
        return Math.max(8, Math.min(32, 12 + Math.abs(parseInt(pin1) - parseInt(pin2)) % 20));
      }
      // Different sorting districts within same circle: intra-circle transit (approx 35 - 95 km)
      return Math.max(35, Math.min(110, 40 + Math.abs(parseInt(pin1) - parseInt(pin2)) % 70));
    }

    const c1 = PIN_CENTROIDS[prefix1];
    const c2 = PIN_CENTROIDS[prefix2];

    if (c1 && c2) {
      const greatCircleKm = calculateHaversineKm(c1.lat, c1.lon, c2.lat, c2.lon);
      // NHAI motorable road tortuosity factor: roads wind 22% - 28% longer than straight lines
      const highwayFactor = greatCircleKm > 800 ? 1.22 : 1.25;
      return Math.round(greatCircleKm * highwayFactor);
    }

    // Fallback: approximate based on 1st digit regional distance if 2-digit prefix is unmapped
    const zone1 = parseInt(pin1[0]);
    const zone2 = parseInt(pin2[0]);
    const zoneDiff = Math.abs(zone1 - zone2);
    return Math.max(60, zoneDiff * 320 + 80);
  }

  const form = document.getElementById("distance-form") as HTMLFormElement;
  const fromPin = document.getElementById("from-pin") as HTMLInputElement;
  const toPin = document.getElementById("to-pin") as HTMLInputElement;
  const loading = document.getElementById("loading") as HTMLElement;
  const resultCard = document.getElementById("result-card") as HTMLElement;
  const resDistance = document.getElementById("res-distance") as HTMLElement;
  const resFrom = document.getElementById("res-from") as HTMLElement;
  const resTo = document.getElementById("res-to") as HTMLElement;
  const resValidity = document.getElementById("res-validity") as HTMLElement;
  const resTolerance = document.getElementById("res-tolerance") as HTMLElement;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const p1 = fromPin.value.trim();
    const p2 = toPin.value.trim();

    if (!/^\d{6}$/.test(p1) || !/^\d{6}$/.test(p2)) {
      alert("Please enter valid 6-digit numeric Indian PIN codes.");
      return;
    }

    resultCard.classList.add("hidden");
    loading.classList.remove("hidden");

    setTimeout(() => {
      loading.classList.add("hidden");
      const dist = estimateMotorableDistance(p1, p2);
      const validityDays = Math.max(1, Math.ceil(dist / 200));
      const toleranceMax = Math.round(dist * 1.10);

      resFrom.textContent = p1;
      resTo.textContent = p2;
      resDistance.innerHTML = `~${dist} <span class="text-2xl text-muted">KM</span>`;
      resValidity.textContent = `${validityDays} Day${validityDays > 1 ? 's' : ''} (${validityDays * 200} km limit)`;
      resTolerance.textContent = `${dist} km to ${toleranceMax} km`;

      resultCard.classList.remove("hidden");
      resultCard.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }, 500);
  });
  </script>

  

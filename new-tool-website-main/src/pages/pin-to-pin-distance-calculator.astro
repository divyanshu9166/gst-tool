---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Pin to Pin Distance Calculator (Instant & Free) — E-Way Bill';
const description = 'Get a rough PIN-to-PIN distance estimate for planning. Use the distance shown by the official NIC portal for an e-way bill.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/pin-to-pin-distance-calculator`;

const faqs = [
  { q: 'Why is pincode-to-pincode distance important for GST?', a: 'The distance recorded for a consignment affects the e-way bill validity period under Rule 138(10). This page gives only a rough estimate; use the distance shown by the official NIC portal when generating an e-way bill.' },
  { q: 'E-way bill me portal aur is estimate ki distance alag ho toh kya karein?', a: 'E-way bill banate waqt official portal ki distance aur current validation messages follow karein. Portal ki published help material apni estimate ke upar up to 10% input limit describe karti hai; yeh general statutory tolerance nahi hai. Taxzentic ka estimate NIC database se nahi aata aur us limit ko check nahi karta.' },
  { q: 'How is e-way bill validity calculated based on distance?', a: 'Under GST Rule 138(10): For normal cargo, 1 day for every 200 km or part thereof. For Over-Dimensional Cargo (ODC) or multimodal shipments involving ship, 1 day for every 20 km or part thereof.' },
  { q: 'Does this calculator show the distance stored by the NIC portal?', a: 'No. It uses a rough PIN-circle heuristic and does not access the NIC portal database or a live road-routing service. Use the official portal value for e-way bill generation.' },
  { q: 'Is an e-way bill required for distances under 50 km?', a: 'Yes. If the consignment value exceeds ₹50,000 (or state-specific intra-state threshold), generating an E-Way Bill (Part A) is mandatory regardless of distance—even for 1 km. The 50-km rule under Rule 138(3) and Rule 138(5) is strictly an exemption from updating Part B (conveyance/vehicle details) when goods are moved intra-state between the consignor/consignee and the transporter\'s premises for further transit.' },
  { q: 'Can I extend an e-way bill if my vehicle is delayed?', a: 'Yes. You can extend the validity of an e-way bill on the NIC portal within 8 hours before or 8 hours after the exact time of expiry by updating Part-B with the current vehicle location and reason for delay.' },
  { q: 'What happens if goods are transported after e-way bill expiry?', a: 'An expired e-way bill can lead to enforcement action under the GST law. The outcome depends on the facts and applicable provisions, so check current official guidance and get professional advice for a specific case.' },
  { q: 'How accurate are PIN-to-PIN distance calculations here?', a: 'This is a rough estimate based on PIN-circle approximations, not a mapped driving route. The actual route distance can differ substantially; do not use this estimate to generate an e-way bill.' },
  { q: 'What should I do if the E-Way Bill portal shows 0 km?', a: 'Follow the current instructions shown on the official portal or contact its helpdesk. This estimator does not verify portal records, and its output should not be used as a substitute for the portal value.' },
  { q: 'Should I use Taxzentic distance as the official number on an E-Way Bill?', a: 'No. This is a rough planning estimate, not the official NIC distance. Use the distance and instructions provided by the official E-Way Bill portal when preparing the bill.' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pin to Pin Distance Calculator for E-Way Bill',
    url: canonical,
    description: description,
    applicationCategory: 'LogisticsApplication',
    operatingSystem: 'All',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'INR',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];

const lastUpdated = '2026-09-25';
const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/#tools-heading' },
  { name: 'Pin To Pin Distance Calculator', href: '/pin-to-pin-distance-calculator' },
];
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-12 lg:py-24">
    <div class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-base bg-surface px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-muted mb-4 shadow-[0_1px_1px_#00000005]">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        Free Distance Tool
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-base mb-4">
        Pin to Pin Distance Calculator
      </h1>
      <p class="text-[16px] text-muted max-w-xl mx-auto leading-relaxed">
        Get a rough PIN-to-PIN estimate for preliminary planning. This page does not access the NIC distance database or calculate an official e-way bill distance.
      </p>
    </div>

    <!-- Main Tool Container -->
    <div class="rounded-[12px] border border-base bg-surface p-6 sm:p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] mb-12">
      <form id="distance-form" class="flex flex-col gap-6">
        

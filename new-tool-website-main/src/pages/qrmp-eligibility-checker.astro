---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'QRMP Scheme Eligibility Checker 2026';
const description = 'Check if you qualify for the QRMP scheme (Quarterly Return, Monthly Payment) under GST. Instant eligibility check based on turnover and registration type.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'QRMP Eligibility Checker',
    url: `${siteUrl}/qrmp-eligibility-checker`,
    description: 'Check eligibility for QRMP scheme — quarterly GST return filing with monthly payments.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the QRMP scheme under GST?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'QRMP (Quarterly Return Monthly Payment) is a scheme that allows eligible GST taxpayers with aggregate turnover up to ₹5 crore to file GSTR-1 and GSTR-3B quarterly instead of monthly, while making monthly tax payments using PMT-06 challan.',
        },
      },
      {
        '@type': 'Question',
        name: 'Who is eligible for QRMP scheme?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Regular GST-registered taxpayers with aggregate annual turnover up to ₹5 crore in the preceding financial year are eligible. Composition dealers, ISD, casual taxable persons, and NRIs are NOT eligible.',
        },
      },
      {
        '@type': 'Question',
        name: 'How to opt for QRMP scheme?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Login to the GST portal → Dashboard → Services → Returns → Opt-in for Quarterly Return. You can opt in from the 1st to the last day of the month preceding a quarter. For example, opt in by 31 March for April-June quarter.',
        },
      },
    ],
  },
];

const lastUpdated = '2026-07-25';
const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Lookups & Tools', href: '/#tools-heading' },
  { name: 'QRMP Eligibility Checker', href: '/qrmp-eligibility-checker' },
];
---

<BaseLayout {title} {description} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-base mb-3 tracking-[-1.28px]">
        QRMP Eligibility Checker
      </h1>
      <p class="text-[16px] text-muted max-w-2xl mx-auto leading-relaxed">
        Check if your business qualifies for the <strong>QRMP scheme</strong> — file GST returns quarterly instead of monthly, while making monthly tax payments.
      </p>
      <p class="text-[13px] text-muted mt-2">Last updated: July 2026</p>
    </div>

    <!-- Checker Form -->
    <div class="mx-auto max-w-2xl rounded-2xl border border-base bg-surface p-6 sm:p-8 shadow-sm">
      <div class="space-y-6">
        <!-- Q1: Registration Type -->
        <div>
          <label class="block text-sm font-medium text-base mb-2">1. What is your GST registration type?</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="reg-type-group">
            <button data-value="regular" class="reg-btn rounded-xl border-2 border-base bg-subtle px-4 py-3 text-[14px] font-medium text-base hover:border-accent transition-all text-left">
              <div class="font-semibold">Regular Taxpayer</div>
              <div class="text-xs text-muted mt-0.5">Files GSTR-1 & GSTR-3B</div>
            </button>
            <button data-value="composition" class="reg-btn rounded-xl border-2 border-base bg-subtle px-4 py-3 text-[14px] font-medium text-base hover:border-accent transition-all text-left">
              <div class="font-semibold">Composition Dealer</div>
              <div class="text-xs text-muted mt-0.5">Files CMP-08</div>
            </button>
            <button data-value="isd" class="reg-btn rounded-xl border-2 border-base bg-subtle px-4 py-3 text-[14px] font-medium text-base hover:border-accent transition-all text-left">
              <div class="font-semibold">Input Service Distributor</div>
              <div class="text-xs text-muted mt-0.5">Files GSTR-6</div>
            </button>
            <button data-value="other" class="reg-btn rounded-xl border-2 border-base bg-subtle px-4 py-3 text-[14px] font-medium text-base hover:border-accent transition-all text-left">
              <div class="font-semibold">Casual / NRTP / UIN</div>
              <div class="text-xs text-muted mt-0.5">Temporary registration</div>
            </button>
          </div>
        </div>

        <!-- Q2: Turnover -->
        <div>
          <label for="turnover" class="block text-sm font-medium text-base mb-1.5">2. Aggregate turnover in preceding FY (₹)</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-muted font-medium select-none" aria-hidden="true">₹</span>
            <input id="turnover" type="number" inputmode="decimal" min="0" placeholder="e.g., 2,50,00,000" step="100000"
              class="w-full rounded-xl border border-base bg-subtle pl-9 pr-4 py-3.5 text-[16px] font-medium focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-all" />
          </div>
          <p class="mt-1 text-xs text-muted">Include turnover of all GSTINs under the same PAN across all states</p>
        </div>

        <!-- Q3: Returns filed on time? -->
        <div>
          <label class="block text-sm font-medium text-base mb-2">3. Have you filed all pending GST returns?</label>
          <div class="flex gap-3" id="returns-group">
            <button data-value="yes" class="returns-btn flex-1 rounded-xl border-2 border-base bg-subtle px-4 py-3 text-[14px] font-medium text-base hover:border-accent transition-all">
              ✓ Yes, all filed
            </button>
            <button data-value="no" class="returns-btn flex-1 rounded-xl border-2 border-base bg-subtle px-4 py-3 text-[14px] font-medium text-base hover:border-accent transition-all">
              ✗ No, some pending
            </button>
          </div>
        </div>
      </div>

      <!-- Result -->
      <div id="result-card" class="mt-8 rounded-xl border-2 p-6 hidden transition-all">
        <div class="flex items-start gap-4">
          <div id="result-icon" class="flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center text-2xl"></div>
          <div>
            <h3 id="result-title" class="text-lg font-bold text-base"></h3>
            <p id="result-desc" class="text-sm text-muted mt-1 leading-relaxed"></p>
          </div>
        </div>
        <div id="result-steps" class="mt-4 hidden">
          <h4 class="text-sm font-semibold text-base mb-2">How to opt in:</h4>
          <ol class="text-sm text-muted space-y-1 list-decimal list-inside">
            <li>Login to <a href="https://www.gst.gov.in" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">gst.gov.in</a></li>
            <li>Go to Services → Returns → Opt-in for Quarterly Return</li>
            <li>Select the quarter you want to start with</li>
            <li>Submit before the last day of the month preceding the quarter</li>
          </ol>
        </div>
      </div>

      <button id="btn-check" type="button" class="mt-6 w-full rounded-xl bg-accent px-6 py-3 text-[16px] font-medium text-white hover:opacity-90 active:scale-[0.98] transition-all">
        Check Eligibility
      </button>
    </div>

    <!-- SEO Content -->
    <div class="mt-16 border-t border-base pt-12">
      <h2 class="text-[24px] font-semibold text-base mb-6 tracking-[-0.6px]">What is the QRMP Scheme?</h2>
      <div class="prose prose-neutral dark:prose-invert max-w-none text-[15px] leading-[1.7]">
        <p>
          The <strong>QRMP (Quarterly Return Monthly Payment)</strong> scheme was introduced in January 2021 to reduce the compliance burden for small taxpayers. Under this scheme, eligible taxpayers file GSTR-1 and GSTR-3B <strong>quarterly</strong> (every 3 months) instead of monthly, but make <strong>monthly tax payments</strong> using the PMT-06 challan.
        </p>

        <h3>Eligibility Criteria</h3>
        <table>
          <thead>
            <tr><th>Criteria</th><th>Requirement</th></tr>
          </thead>
          <tbody>
            <tr><td>Aggregate Turnover</td><td>Up to ₹5 crore in preceding FY</td></tr>
            <tr><td>Registration Type</td><td>Regular taxpayer only</td></tr>
            <tr><td>Return Status</td><td>All pending returns must be filed</td></tr>
            <tr><td>Not Eligible</td><td>Composition, ISD, Casual, NRTP, UIN holders</td></tr>
          </tbody>
        </table>

        <h3>Monthly Payment Methods</h3>
        <p>Under QRMP, you must make monthly tax payments by the 25th of each month using one of two methods:</p>
        <ul>
          <li><strong>Fixed Sum Method (FSM):</strong> Pay an amount equal to 35% of the tax paid in the last quarter (for turnover up to ₹1.5 Cr) or equal to the tax liability of the corresponding month in the last quarter</li>
          <li><strong>Self-Assessment Method (SAM):</strong> Calculate actual tax liability and pay through PMT-06 challan</li>
        </ul>

        <p>
          For more GST compliance tools, check our <a href="/gst-due-dates" class="text-accent hover:underline">GST Due Dates Calendar</a> and <a href="/late-fee-calculator" class="text-accent hover:underline">Late Fee Calculator</a>.
        </p>
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-12 border-t border-base pt-10">
      <h2 class="text-[24px] font-semibold text-base mb-6 tracking-[-0.6px]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {[
          { q: 'Can I switch back to monthly filing after opting for QRMP?', a: 'Yes. You can opt out of the QRMP scheme and switch back to monthly filing at the beginning of any quarter. The opt-out window is the month preceding each quarter.' },
          { q: 'Do I still need to pay GST monthly under QRMP?', a: 'Yes. Even though you file returns quarterly, you must make monthly tax payments by the 25th of each month using the PMT-06 challan. Only the last month of the quarter is covered by GSTR-3B filing.' },
          { q: 'How does IFF work under QRMP scheme?', a: 'IFF (Invoice Furnishing Facility) allows QRMP taxpayers to upload B2B invoices in the first two months of a quarter. This helps your B2B buyers claim ITC without waiting for your quarterly GSTR-1.' },
          { q: 'What happens if I cross ₹5 crore turnover during the year?', a: 'If your aggregate turnover crosses ₹5 crore during a financial year, you will automatically be moved to monthly filing from the next quarter. You do not need to do anything manually.' },
        ].map((faq, i) => (
          <details class="group rounded-[8px] border border-base bg-surface overflow-hidden" id={`faq-qrmp-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span class="text-[15px]">{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  let regType = '';
  let returnsFiled = '';

  // Registration type selection
  document.querySelectorAll('.reg-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      regType = (btn as HTMLElement).dataset.value || '';
      document.querySelectorAll('.reg-btn').forEach(b => {
        b.classList.remove('border-accent', 'bg-accent/5');
        b.classList.add('border-base', 'bg-subtle');
      });
      btn.classList.remove('border-base', 'bg-subtle');
      btn.classList.add('border-accent', 'bg-accent/5');
    });
  });

  // Returns filed selection
  document.querySelectorAll('.returns-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      returnsFiled = (btn as HTMLElement).dataset.value || '';
      document.querySelectorAll('.returns-btn').forEach(b => {
        b.classList.remove('border-accent', 'bg-accent/5');
        b.classList.add('border-base', 'bg-subtle');
      });
      btn.classList.remove('border-base', 'bg-subtle');
      btn.classList.add('border-accent', 'bg-accent/5');
    });
  });

  document.getElementById('btn-check')?.addEventListener('click', () => {
    const turnover = parseFloat((document.getElementById('turnover') as HTMLInputElement).value) || 0;
    const card = document.getElementById('result-card')!;
    const icon = document.getElementById('result-icon')!;
    const title = document.getElementById('result-title')!;
    const desc = document.getElementById('result-desc')!;
    const steps = document.getElementById('result-steps')!;

    card.classList.remove('hidden');

    // Validation
    if (!regType) {
      card.className = 'mt-8 rounded-xl border-2 border-amber-300 bg-amber-50 dark:bg-amber-900/20 dark:border-amber-800 p-6 transition-all';
      icon.className = 'flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center text-2xl bg-amber-100 dark:bg-amber-900/30';
      icon.textContent = '⚠';
      title.textContent = 'Please select your registration type';
      desc.textContent = 'Select one of the four registration types above to check eligibility.';
      steps.classList.add('hidden');
      return;
    }

    // Check eligibility
    const isRegular = regType === 'regular';
    const under5Cr = turnover <= 50000000; // 5 crore
    const allFiled = returnsFiled === 'yes';

    if (!isRegular) {
      card.className = 'mt-8 rounded-xl border-2 border-red-300 bg-red-50 dark:bg-red-900/20 dark:border-red-800 p-6 transition-all';
      icon.className = 'flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center text-2xl bg-red-100 dark:bg-red-900/30';
      icon.textContent = '✗';
      title.textContent = 'Not Eligible for QRMP';
      desc.textContent = `The QRMP scheme is only available for Regular Taxpayers. ${regType === 'composition' ? 'Composition dealers already file quarterly (CMP-08).' : 'Your registration type is not eligible for the QRMP scheme.'}`;
      steps.classList.add('hidden');
    } else if (!under5Cr) {
      card.className = 'mt-8 rounded-xl border-2 border-red-300 bg-red-50 dark:bg-red-900/20 dark:border-red-800 p-6 transition-all';
      icon.className = 'flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center text-2xl bg-red-100 dark:bg-red-900/30';
      icon.textContent = '✗';
      title.textContent = 'Not Eligible — Turnover Exceeds ₹5 Crore';
      desc.textContent = `Your aggregate turnover of ₹${(turnover/10000000).toFixed(2)} Cr exceeds the ₹5 Cr limit. You must file monthly GSTR-1 and GSTR-3B returns.`;
      steps.classList.add('hidden');
    } else if (!allFiled) {
      card.className = 'mt-8 rounded-xl border-2 border-amber-300 bg-amber-50 dark:bg-amber-900/20 dark:border-amber-800 p-6 transition-all';
      icon.className = 'flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center text-2xl bg-amber-100 dark:bg-amber-900/30';
      icon.textContent = '⚠';
      title.textContent = 'Conditionally Eligible — Pending Returns';
      desc.textContent = 'You meet the turnover and registration criteria, but you must file all pending GST returns before opting in. File your pending returns first, then opt for QRMP.';
      steps.classList.add('hidden');
    } else {
      card.className = 'mt-8 rounded-xl border-2 border-green-300 bg-green-50 dark:bg-green-900/20 dark:border-green-800 p-6 transition-all';
      icon.className = 'flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center text-2xl bg-green-100 dark:bg-green-900/30';
      icon.textContent = '✓';
      title.textContent = 'Eligible for QRMP Scheme! ✅';
      desc.textContent = `With turnover of ₹${(turnover/100000).toFixed(0)}L and regular registration, you qualify for quarterly GSTR-1/3B filing with monthly tax payments.`;
      steps.classList.remove('hidden');
    }
  });
</script>

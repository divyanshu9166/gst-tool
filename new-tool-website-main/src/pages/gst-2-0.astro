---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';
import LegalSources from '../components/LegalSources.astro';
import TaxDisclaimer from '../components/TaxDisclaimer.astro';

const title = 'GST 2.0 (2026) — Complete Guide, New Rates & Tools';
const description = 'Understand India’s GST rate rationalisation, including the broad 5%, 18% and special 40% rates. Check official references and use free GST calculators.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/gst-2-0`;

const gst20Faqs = [
  {
    q: 'What does GST 2.0 mean?',
    a: '“GST 2.0” is a commonly used label for the GST rate rationalisation recommended by the 56th GST Council. The broad structure uses 5% and 18% rates, with a special 40% rate for specified goods and services. The exact legal rate comes from the applicable notification and tariff entry.',
  },
  {
    q: 'What are the GST 2.0 rates?',
    a: 'The broad rate structure includes a 5% merit rate, an 18% standard rate and a special 40% rate for specified goods and services. Some supplies may be nil-rated, exempt or subject to other specific treatment, so do not assume every item fits one of these three rates.',
  },
  {
    q: 'When did the GST 2.0 rate changes take effect?',
    a: 'Most revised rates for goods and services took effect on 22 September 2025. The GST Council initially phased certain pan masala and tobacco-related products separately; related revised rates were notified from 1 February 2026. Check the current notification for the exact product and transaction date.',
  },
  {
    q: 'How can I find the GST rate for a product?',
    a: 'Identify the product’s correct HSN classification, then check the corresponding entry, description, conditions and effective date in the latest Central and applicable State rate notifications. A product name alone may not be enough to determine its classification or rate.',
  },
  {
    q: 'Does the 40% rate apply to every luxury product?',
    a: 'No. The 40% rate applies to goods and services specified in the relevant rate entries. A product being described as “luxury” in ordinary or marketing language does not by itself establish its GST rate; verify its classification and notification.',
  },
  {
    q: 'Are 5%, 18% and 40% the only GST treatments?',
    a: 'No. Depending on the supply, the schedule may provide nil rates, exemptions or specific conditions and other treatments. Check the current rate schedule for the exact HSN or service classification rather than relying only on a summary of the broad structure.',
  },
  {
    q: 'Can the GST 2.0 calculator determine my product’s legal rate?',
    a: 'The calculator helps with tax arithmetic after you enter a rate; it does not make a binding HSN classification or legal rate determination. Confirm the applicable rate from the current notification or with a qualified tax professional before invoicing.',
  },
  {
    q: 'How do I compare an old GST rate with a revised rate?',
    a: 'Use the rate comparison tool to compare the arithmetic using the old and revised rates that apply to your product. First verify both rates and their effective dates against the applicable notifications; the comparison is an estimate, not a classification decision.',
  },
  {
    q: 'Which GST rate applies when supply, invoice and payment dates cross a rate change?',
    a: 'The applicable rate in a transition case can depend on the time-of-supply rules, including when supply occurred and when the invoice or payment was made. Review section 14 of the CGST Act and the official guidance for your exact facts; a single date rule does not cover every transaction.',
  },
  {
    q: 'Are Taxzentic’s GST 2.0 tools official government tools?',
    a: 'No. Taxzentic provides independent calculators and educational references. They are intended to help with estimates and research, not replace GST notifications, portal records, professional advice or a determination by the tax authorities.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'GST 2.0 Resource Center',
    url: canonical,
    description,
    publisher: {
      '@type': 'Organization',
      name: 'Taxzentic',
      url: siteUrl,
    },
    hasPart: [
      { '@type': 'WebApplication', name: 'GST 2.0 Calculator', url: `${siteUrl}/gst-calculator` },
      { '@type': 'WebApplication', name: 'Old vs New Rate Checker', url: `${siteUrl}/gst-rate-comparison` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: gst20Faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'GST 2.0 Hub', href: '/gst-2-0' },
];

const lastUpdated = '2026-09-24';
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <!-- Hub Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-3 py-1 text-xs font-semibold bg-accent/10 text-accent rounded-full mb-4 border border-accent/20">Taxzentic Hub</span>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-base mb-6">
        The <span class="text-accent">GST 2.0</span> Resource Center
      </h1>
      <p class="text-[18px] text-muted max-w-2xl mx-auto leading-relaxed mb-4">
        India’s GST rate rationalisation introduced broad 5% and 18% rates, plus a special 40% rate for specified goods and services. Find practical tools, official references and guides to understand the changes.
      </p>
      <div class="inline-block text-left rounded-xl border border-blue-500/20 bg-blue-50/50 dark:bg-blue-950/20 p-4 text-xs text-muted max-w-2xl mx-auto leading-relaxed">
        <strong class="text-base font-medium">Editorial Note:</strong> "GST 2.0" is an editorial term describing the rate rationalization recommendations of the GST Council. While Council recommendations establish policy direction, rate amendments take legal effect only upon publication of implementing statutory notifications by the Central Government and respective State Governments.
      </div>
    </div>

    <!-- Featured Tools -->
    <div class="mb-16">
      <div class="flex items-center gap-3 mb-8 border-b border-base pb-4">
        <ToolIcon name="receipt" class="w-6 h-6 text-accent" />
        <h2 class="text-2xl font-bold text-base">Essential GST 2.0 Tools</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a href="/gst-calculator" class="group relative rounded-2xl border border-base bg-surface p-6 overflow-hidden hover:border-accent transition-all shadow-sm">
          <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-semibold text-base group-hover:text-accent transition-colors">GST 2.0 Calculator</h3>
            <span class="text-xs font-semibold bg-accent text-white px-2 py-1 rounded-full">Updated</span>
          </div>
          <p class="text-muted text-[15px] leading-relaxed">Estimate GST using a rate you have verified. Split CGST/SGST or reverse-calculate tax from an inclusive amount.</p>
        </a>

        <a href="/gst-rate-comparison" class="group relative rounded-2xl border border-base bg-surface p-6 overflow-hidden hover:border-accent transition-all shadow-sm">
          <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-semibold text-base group-hover:text-accent transition-colors">Old vs New Rate Checker</h3>
          </div>
          <p class="text-muted text-[15px] leading-relaxed">Compare tax amounts using the old and revised rates that apply to your product, after checking their effective dates.</p>
        </a>

        <a href="/mrp-revision-calculator/" class="group relative rounded-2xl border border-base bg-surface p-6 overflow-hidden hover:border-accent transition-all shadow-sm">
          <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-semibold text-base group-hover:text-accent transition-colors">MRP Revision Calculator</h3>
          </div>
          <p class="text-muted text-[15px] leading-relaxed">Reverse-calculate your new MRP after a GST rate change. Automatically preserves your exact profit margin.</p>
        </a>

        <a href="/itc-reversal-checker/" class="group relative rounded-2xl border border-base bg-surface p-6 overflow-hidden hover:border-accent transition-all shadow-sm">
          <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-semibold text-base group-hover:text-accent transition-colors">ITC Reversal Checker</h3>
          </div>
          <p class="text-muted text-[15px] leading-relaxed">A decision-tree tool to determine if a GST rate drop on your product legally requires you to surrender Input Tax Credit.</p>
        </a>
      </div>
    </div>

    <!-- Core Guides -->
    <div class="mb-16">
      <div class="flex items-center gap-3 mb-8 border-b border-base pb-4">
        <ToolIcon name="book" class="w-6 h-6 text-accent" />
        <h2 class="text-2xl font-bold text-base">In-Depth Guides & Analysis</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
        <a href="/blog/gst-2-0-rate-changes-product-list" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">GST 2.0 New Rates (Complete List)</h3>
          <p class="text-sm text-muted">A comprehensive breakdown of which items moved to 5%, 18%, and the new 40% luxury slab.</p>
        </a>
        <a href="/blog/gst-40-percent-luxury-slab" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">Understanding the 40% Luxury Slab</h3>
          <p class="text-sm text-muted">What qualifies as "luxury"? How the 40% rate impacts automobiles, high-end electronics, and real estate.</p>
        </a>
        <a href="/blog/mrp-revision-gst-rate-change" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">How to Handle MRP Revisions</h3>
          <p class="text-sm text-muted">Legal requirements for restickering inventory and declaring new MRPs after rate changes.</p>
        </a>
        <a href="/blog/itc-reversal-gst-rate-drop" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">ITC Reversals on Rate Drops</h3>
          <p class="text-sm text-muted">Step-by-step guide on how to handle Input Tax Credit when your product's GST rate decreases.</p>
        </a>
        <a href="/blog/gst-2-0-rate-changes-product-list" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">Product-wise Rate Changes</h3>
          <p class="text-sm text-muted">A product-by-product listing of all items affected by the GST 2.0 rate revision.</p>
        </a>
        <a href="/blog/post-sale-discount-gst-2026" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">Post-Sale Discounts Under GST 2.0</h3>
          <p class="text-sm text-muted">How trade discounts, rebates, and dealer incentives are treated after a rate change under GST.</p>
        </a>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="mb-16 border-t border-base pt-12">
      <h2 class="text-2xl font-bold text-base mb-8">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {gst20Faqs.map((faq, index) => (
          <details class="group rounded-[8px] border border-base bg-surface overflow-hidden" open={index === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span class="text-[15px]">{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- Legal Sources & Disclaimer -->
    <div class="mb-16 space-y-4">
      <LegalSources
        sources={[
          { title: "GST Council: 56th Meeting Recommendations", url: "https://gstcouncil.gov.in/recommendations-56th-meeting-gst-council-held-new-delhi", description: "official rate tables and phased implementation recommendations" },
          { title: "GST Council: Central Tax (Rate) Notifications", url: "https://gstcouncil.gov.in/cgst-rate-notification", description: "official Central rate notifications and amendments" },
          { title: "GST Council: 56th Meeting FAQs", url: "https://gstcouncil.gov.in/frequently-asked-questions-faqs-decisions-56th-gst-council-held-new-delhi-0", description: "official clarifications, including effective dates and transition cases" }
        ]}
        councilRecommendation="GST Council Tariff Rationalization Recommendations"
        implementingNotification="Respective Implementing Central Tax (Rate) Notifications"
        reviewedDate="24 September 2026"
      />

      <TaxDisclaimer />
    </div>
  </div>
</BaseLayout>

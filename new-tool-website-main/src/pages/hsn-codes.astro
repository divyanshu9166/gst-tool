---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';
import LegalSources from '../components/LegalSources.astro';
import TaxDisclaimer from '../components/TaxDisclaimer.astro';

const title = 'HSN & SAC Codes India — Search, Finder Tools & Complete Guide';
const description = 'Resource for HSN and SAC codes in India. Search by product name, find codes, and learn 4-digit vs 6-digit HSN rules for GST B2B invoices.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/hsn-codes`;

const hsnHubFaqs = [
  {
    q: 'What is an HSN code?',
    a: 'HSN means Harmonized System of Nomenclature. It is a structured classification system for goods used in customs and tax schedules. The correct code depends on the item’s detailed characteristics and the applicable tariff description.',
  },
  {
    q: 'What is the difference between HSN and SAC?',
    a: 'HSN codes classify goods, while SAC codes classify services for GST purposes. Choose the classification that matches the actual supply, and verify the relevant description in the current schedule.',
  },
  {
    q: 'How many digits of an HSN code do I need?',
    a: 'The required number of digits can depend on current invoice rules, taxpayer details and the type of supply. Check the latest CGST Rules and notifications for your case; the lookup result alone does not decide the reporting requirement.',
  },
  {
    q: 'How do I find an HSN code for a product?',
    a: 'Search using a specific product description, then compare the candidate code’s full tariff wording with the item’s material, composition, function and other relevant characteristics. A broad product name may return more than one possible classification.',
  },
  {
    q: 'Does an HSN code determine the GST rate?',
    a: 'The HSN classification helps locate the relevant GST rate entry, but you also need to read its description, conditions, exceptions and effective date in the current rate notifications.',
  },
  {
    q: 'Can similar products have different HSN codes?',
    a: 'Yes. Products that look similar can differ in composition, design, processing or intended use, which may affect their tariff classification. Compare the exact product with the relevant tariff headings and notes.',
  },
  {
    q: 'What should I do if the HSN search shows several possible codes?',
    a: 'Compare each result with the complete tariff description and applicable section or chapter notes. If the classification remains unclear, consult a qualified customs or GST professional before using a code on invoices or filings.',
  },
  {
    q: 'What can happen if I use the wrong HSN code?',
    a: 'A mismatch may lead to an incorrect rate, return-reporting discrepancies or questions from a buyer or tax authority. The consequences depend on the facts and applicable law, so correct the classification and seek professional guidance when needed.',
  },
  {
    q: 'Are HSN codes and GST rates permanent?',
    a: 'Tariff classifications, rate entries and reporting requirements can be amended. Check the latest official tariff and rate notifications for the period in which the supply takes place.',
  },
  {
    q: 'Is this HSN and SAC lookup an official government service?',
    a: 'No. Taxzentic is an independent reference tool. Use official tariff documents and GST notifications to confirm a classification or rate, and get professional advice for uncertain cases.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'HSN & SAC Codes Resource Center',
    url: canonical,
    description,
    publisher: {
      '@type': 'Organization',
      name: 'Taxzentic',
      url: siteUrl,
    },
    hasPart: [
      { '@type': 'WebApplication', name: 'GST Rate Finder by Product Name', url: `${siteUrl}/gst-rate-finder` },
      { '@type': 'WebApplication', name: 'HSN / SAC Code Lookup', url: `${siteUrl}/hsn-code-lookup` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: hsnHubFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'HSN Codes Hub', href: '/hsn-codes' },
];

const lastUpdated = '2026-07-25';

// All 25 programmatic product pages
const allProducts = [
  { name: 'Mobile Phones', url: '/gst-rate-on-mobile-phones' },
  { name: 'Laptops', url: '/gst-rate-on-laptops-computers' },
  { name: 'Cement', url: '/gst-rate-on-cement' },
  { name: 'Restaurant Food', url: '/gst-rate-on-restaurant-food' },
  { name: 'Gold & Jewellery', url: '/gst-rate-on-gold-jewellery' },
  { name: 'Cars', url: '/gst-rate-on-cars' },
  { name: 'Commercial Rent', url: '/gst-rate-on-commercial-rent' },
  { name: 'Software Services', url: '/gst-rate-on-software-services' },
  { name: 'Medicines', url: '/gst-rate-on-medicines' },
  { name: 'Insurance', url: '/gst-rate-on-insurance' },
  { name: 'Solar Panels', url: '/gst-rate-on-solar-panels' },
  { name: 'Clothing & Garments', url: '/gst-rate-on-clothing-garments' },
  { name: 'Shoes & Footwear', url: '/gst-rate-on-shoes-footwear' },
  { name: 'Furniture', url: '/gst-rate-on-furniture' },
  { name: 'Electric Vehicles', url: '/gst-rate-on-electric-vehicles' },
  { name: 'Books', url: '/gst-rate-on-books' },
  { name: 'Freelance Services', url: '/gst-rate-on-freelance-services' },
  { name: 'Hotel Rooms', url: '/gst-rate-on-hotel-rooms' },
  { name: 'Gym Memberships', url: '/gst-rate-on-gym-memberships' },
  { name: 'Coaching Classes', url: '/gst-rate-on-coaching-classes' },
  { name: 'Air Tickets', url: '/gst-rate-on-air-tickets' },
  { name: 'Interior Designing', url: '/gst-rate-on-interior-designing' },
  { name: 'Event Management', url: '/gst-rate-on-event-management' },
  { name: 'Beauty Parlour', url: '/gst-rate-on-beauty-parlour' },
  { name: 'Diamonds', url: '/gst-rate-on-diamonds' },
];
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <!-- Hub Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-3 py-1 text-xs font-semibold bg-accent/10 text-accent rounded-full mb-4 border border-accent/20">Taxzentic Hub</span>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-base mb-6">
        The <span class="text-accent">HSN & SAC</span> Resource Center
      </h1>
      <p class="text-[18px] text-muted max-w-2xl mx-auto leading-relaxed">
        Harmonized System of Nomenclature (HSN) and Services Accounting Code (SAC) are mandatory for Indian GST compliance. Use our tools to find the exact code and rate for your business.
      </p>
    </div>

    <!-- Featured Tools -->
    <div class="mb-16">
      <div class="flex items-center gap-3 mb-8 border-b border-base pb-4">
        <ToolIcon name="search" class="w-6 h-6 text-accent" />
        <h2 class="text-2xl font-bold text-base">HSN & Rate Finder Tools</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a href="/gst-rate-finder" class="group relative rounded-2xl border border-base bg-surface p-6 overflow-hidden hover:border-accent transition-all shadow-sm">
          <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-semibold text-base group-hover:text-accent transition-colors">Search by Product Name</h3>
            <span class="text-xs font-semibold bg-accent text-white px-2 py-1 rounded-full">Popular</span>
          </div>
          <p class="text-muted text-[15px] leading-relaxed">Don't know your HSN code? Just type "laptop" or "restaurant" and our fuzzy search will find the correct code and GST rate instantly.</p>
        </a>

        <a href="/hsn-code-lookup" class="group relative rounded-2xl border border-base bg-surface p-6 overflow-hidden hover:border-accent transition-all shadow-sm">
          <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-semibold text-base group-hover:text-accent transition-colors">HSN / SAC Code Lookup</h3>
          </div>
          <p class="text-muted text-[15px] leading-relaxed">Already have a code? Enter a 4, 6, or 8-digit HSN code to verify its description and current GST tax slab.</p>
        </a>
      </div>
    </div>

    <!-- ALL Product Rates -->
    <div class="mb-16">
      <div class="flex items-center gap-3 mb-8 border-b border-base pb-4">
        <ToolIcon name="tag" class="w-6 h-6 text-accent" />
        <h2 class="text-2xl font-bold text-base">GST Rates by Product — Quick Look</h2>
      </div>
      <p class="text-[14px] text-muted mb-5">Browse GST rates for 25+ popular products. Each page has the HSN code, tax split, a mini-calculator, and FAQs.</p>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {allProducts.map((item) => (
          <a href={item.url} class="group p-3 rounded-xl border border-base bg-surface hover:border-accent hover:bg-accent/5 transition-all text-center">
            <span class="text-[13px] font-medium text-base group-hover:text-accent transition-colors leading-tight">{item.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- HSN Mandate Quick Reference -->
    <div class="mb-16 rounded-2xl border border-base bg-surface p-6 sm:p-8">
      <h2 class="text-xl font-bold text-base mb-5">HSN Digit Requirement — Quick Reference</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-subtle text-[13px] uppercase tracking-wider text-muted">
              <th class="p-3 border-b border-base font-semibold">Annual Turnover</th>
              <th class="p-3 border-b border-base font-semibold">Invoice Type</th>
              <th class="p-3 border-b border-base font-semibold">Required Digits</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            <tr>
              <td class="p-3 border-b border-base">Up to ₹5 Crore</td>
              <td class="p-3 border-b border-base">B2B (Business to Business)</td>
              <td class="p-3 border-b border-base font-semibold text-accent">4-digit HSN</td>
            </tr>
            <tr>
              <td class="p-3 border-b border-base">Up to ₹5 Crore</td>
              <td class="p-3 border-b border-base">B2C (Business to Consumer)</td>
              <td class="p-3 border-b border-base text-muted">Optional</td>
            </tr>
            <tr>
              <td class="p-3 border-b border-base">Above ₹5 Crore</td>
              <td class="p-3 border-b border-base">All Invoices</td>
              <td class="p-3 border-b border-base font-semibold text-accent">6-digit HSN</td>
            </tr>
            <tr>
              <td class="p-3 border-b border-base">All Exporters</td>
              <td class="p-3 border-b border-base">Export Invoice & Shipping Bill</td>
              <td class="p-3 border-b border-base font-semibold text-accent">8-digit HSN</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Core Guides -->
    <div class="mb-16">
      <div class="flex items-center gap-3 mb-8 border-b border-base pb-4">
        <ToolIcon name="book" class="w-6 h-6 text-accent" />
        <h2 class="text-2xl font-bold text-base">In-Depth Guides</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
        <a href="/blog/4-digit-vs-6-digit-hsn-codes" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">4-Digit vs 6-Digit HSN Codes</h3>
          <p class="text-sm text-muted">When is a 6-digit code mandatory? A guide to the ₹5 Crore threshold, B2B vs B2C invoice rules, and penalties for wrong classification.</p>
        </a>
        <a href="/blog/sac-codes-vs-hsn-codes" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">SAC vs HSN: What's the Difference?</h3>
          <p class="text-sm text-muted">Understanding how goods (HSN) and services (SAC) are classified differently under the Indian GST system.</p>
        </a>
        <a href="/blog/hsn-code-importance" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">Why HSN Codes Matter for Invoicing</h3>
          <p class="text-sm text-muted">How invoice classification differences can trigger reconciliation queries, reporting mismatches, and potential scrutiny under statutory provisions.</p>
        </a>
        <a href="/blog/finding-hsn-codes-for-exports" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">HSN Codes for Exports</h3>
          <p class="text-sm text-muted">Special rules for declaring 8-digit HSN codes on export invoices, shipping bills, and claiming IGST refunds.</p>
        </a>
        <a href="/blog/how-to-find-hsn-code-2026" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">How to Find Your HSN Code (2026)</h3>
          <p class="text-sm text-muted">A step-by-step guide to finding the correct HSN code using the GST portal, tariff schedule, or product name search.</p>
        </a>
        <a href="/blog/hsn-code-mobile-phones-2025" class="group block">
          <h3 class="text-lg font-medium text-base group-hover:text-accent transition-colors mb-1">HSN Code for Mobile Phones</h3>
          <p class="text-sm text-muted">Complete guide to HSN 8517 — the correct code for smartphones, feature phones, and accessories with 18% GST.</p>
        </a>
      </div>

      <!-- Contextual Classification Tools -->
      <div class="mt-10 rounded-2xl border border-base bg-subtle p-6">
        <h3 class="text-lg font-semibold text-base mb-2">Explore Classification &amp; Rate Tools</h3>
        <p class="text-sm text-muted leading-relaxed mb-4">
          To search individual 4, 6, or 8-digit codes directly, use our <a href="/hsn-code-lookup/" class="text-accent hover:underline font-medium">HSN code lookup tool</a>. If you only know the commercial name of an item or service, search notified slabs with our <a href="/gst-rate-finder/" class="text-accent hover:underline font-medium">GST rate finder by product name</a> or check notified rates on commodities like <a href="/gst-rate-on-iron-and-steel/" class="text-accent hover:underline font-medium">iron and steel</a> and <a href="/gst-rate-on-textiles/" class="text-accent hover:underline font-medium">textiles</a>.
        </p>

        <LegalSources
          sources={[
            { title: "Notification No. 78/2020-Central Tax", url: "https://www.cbic.gov.in", description: "statutory 4-digit and 6-digit HSN invoice mandates" },
            { title: "Customs Tariff Act, 1975 (First Schedule)", url: "https://www.cbic.gov.in", description: "primary statutory classification framework adopted under GST" },
            { title: "General Rules for Interpretation (GRI)", description: "statutory principles governing priority of specific vs general descriptions" }
          ]}
          reviewedDate="19 September 2026"
        />

        <div class="mt-4">
          <TaxDisclaimer />
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="border-t border-base pt-12">
      <h2 class="text-2xl font-bold text-base mb-8">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {hsnHubFaqs.map((faq, index) => (
          <details class="group rounded-[8px] border border-base bg-surface overflow-hidden" open={index === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span class="text-[15px]">{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

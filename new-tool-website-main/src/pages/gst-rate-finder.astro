---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'GST Rate Finder — Search by Product Name';
const description = 'Find the GST rate for any product by name. Search for laptops, cement, restaurant food, cars, and more. Instant HSN code lookup with GST rate.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/gst-rate-finder`;

const faqs = [
  {
    q: 'How to find the GST rate for any product by name?',
    a: 'Simply type the common product or commodity name (e.g., "laptop", "cement", "restaurant food", "shoes") in our search box. The tool searches over 3,800+ HSN and SAC codes to display the exact GST rate along with the CGST and SGST breakdown.',
  },
  {
    q: 'What are the primary GST tax rate slabs in India?',
    a: 'India operates under a four-tier GST structure with primary slabs of 5%, 12%, 18%, and 28%, along with an exempt (0%) category. Special concessional rates exist for precious metals like gold/silver (3%) and rough precious stones (0.25% - 1.5%).',
  },
  {
    q: 'What is the difference between an HSN code and a SAC code?',
    a: 'HSN (Harmonized System of Nomenclature) is an internationally standardized coding system used for classifying physical goods. SAC (Services Accounting Code) is a 6-digit classification system created by CBIC exclusively for services.',
  },
  {
    q: 'How many digits of HSN code are mandatory on a GST tax invoice?',
    a: 'Under Notification No. 78/2020-Central Tax, businesses with annual aggregate turnover up to ₹5 Crores must mention at least 4 digits of HSN on B2B invoices. Businesses with turnover exceeding ₹5 Crores must mention 6 digits on all B2B and B2C invoices.',
  },
  {
    q: 'What is the GST rate on smartphones, computers, and IT hardware?',
    a: 'Smartphones and cellular phones attract 18% GST under HSN code 8517. Laptop computers, tablets, data processing machines, and IT accessories also attract 18% GST under HSN code 8471.',
  },
  {
    q: 'Are essential grocery items and unbranded grains exempt from GST?',
    a: 'Yes. Fresh fruits, fresh vegetables, unpasteurized milk, eggs, and loose unbranded foodgrains attract 0% GST. However, pre-packaged and labelled retail pulses, rice, flour, and curd attract 5% GST.',
  },
  {
    q: 'How is GST divided between CGST, SGST, and IGST?',
    a: 'For intra-state transactions (within the same state), GST is split equally: 50% CGST to the Centre and 50% SGST to the State. For inter-state supplies (across state borders), the full tax is collected as Integrated GST (IGST).',
  },
  {
    q: 'Can I look up GST rates for services like software, legal, and consulting?',
    a: 'Yes. Type service keywords like "software development", "legal fees", "management consulting", "freelancing", or "hotel accommodation" to find the applicable 6-digit SAC code (e.g. SAC 998314 for IT software) and rate.',
  },
  {
    q: 'What should I do if a product has multiple matching HSN classifications?',
    a: 'In GST law, specific classification takes precedence over general descriptions under the General Rules for Interpretation (GRI). If significant ambiguity remains regarding composition or end-use, taxpayers can apply for Authority for Advance Ruling (AAR).',
  },
  {
    q: 'Does this rate finder store or monitor my search queries?',
    a: 'No. The search engine queries a local client-side JSON catalog in your web browser. No search queries, user data, or IP addresses are transmitted or logged on any external server.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'GST Rate Finder by Product Name',
    url: canonical,
    description: 'Find the GST rate for any product or service by name. Instant fuzzy search over 3,800+ HSN/SAC codes.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];

const lastUpdated = '2026-09-15';
const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Lookups & Tools', href: '/#tools-heading' },
  { name: 'GST Rate Finder', href: '/gst-rate-finder' },
];
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Page header -->
    <div class="mb-10 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-base mb-3 tracking-[-1.28px]">
        GST Rate Finder — Search by Product Name
      </h1>
      <p class="text-[16px] text-muted max-w-2xl mx-auto leading-relaxed">
        Don't know the HSN code? Just type a product name like <strong>"laptop"</strong>, <strong>"cement"</strong>, or <strong>"restaurant food"</strong> and instantly find the GST rate.
      </p>
      <p class="text-[13px] text-muted mt-2">Last updated: July 2026 · Reflects GST 2.0 rates</p>
    </div>

    <!-- Search box -->
    <div class="mx-auto max-w-2xl mb-8">
      <div class="relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        <input
          id="product-search"
          type="text"
          placeholder="Type a product name: laptop, cement, rice, car, shoes..."
          class="w-full rounded-xl border border-base bg-surface pl-12 pr-4 py-4 text-[16px] font-medium focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-all shadow-sm"
          autocomplete="off"
        />
      </div>
      <p class="mt-2 text-xs text-muted">
        Try: mobile phone, gold jewellery, restaurant, cement, car, medicine, petrol, insurance
      </p>
    </div>

    <!-- Results -->
    <div id="results-container" class="space-y-3">
      <div id="results-placeholder" class="text-center py-16">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-accent/10 mb-4">
          <svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        </div>
        <p class="text-muted text-[16px] font-medium">Start typing to search 3,800+ products</p>
        <p class="text-muted text-[13px] mt-1">Results appear instantly as you type</p>
      </div>
      <div id="results-list" class="hidden"></div>
      <div id="results-count" class="hidden text-sm text-muted text-center pt-2"></div>
    </div>

    <!-- SEO Content -->
    <div class="mt-16 border-t border-base pt-12">
      <h2 class="text-[24px] font-semibold text-base mb-6 tracking-[-0.6px]">How to Find GST Rate for Any Product</h2>
      <div class="prose prose-neutral dark:prose-invert max-w-none text-[15px] leading-[1.7]">
        <p>
          Every product and service in India is classified under a specific <strong>HSN code</strong> (Harmonized System of Nomenclature) for goods or <strong>SAC code</strong> (Services Accounting Code) for services. These codes determine the applicable GST rate.
        </p>
        <p>
          Most GST lookup tools require you to already know the HSN/SAC code number. Our <strong>GST Rate Finder</strong> takes a different approach: just type what the product is in plain English (or Hindi transliteration), and we fuzzy-match it against our database of 3,800+ classified items to show you the correct code and rate instantly.
        </p>

        <h3 class="text-[18px] font-semibold text-base mt-8 mb-3">Popular GST Rates (Quick Reference)</h3>
        <div class="not-prose grid grid-cols-1 sm:grid-cols-2 gap-3 my-6">
          {[
            { product: 'Mobile Phones', rate: '18%', hsn: '8517' },
            { product: 'Laptops & Computers', rate: '18%', hsn: '8471' },
            { product: 'Cement', rate: '18%', hsn: '2523' },
            { product: 'Restaurant Food (non-AC)', rate: '5%', hsn: '9963' },
            { product: 'Gold & Jewellery', rate: '3%', hsn: '7113' },
            { product: 'Cars (small, petrol)', rate: '18%', hsn: '8703' },
            { product: 'Milk & Curd', rate: '0%', hsn: '0401' },
            { product: 'Medicines', rate: '5% / 18%', hsn: '3004' },
          ].map((item) => (
            <div class="flex items-center justify-between rounded-lg border border-base bg-surface px-4 py-3 text-sm">
              <div>
                <span class="font-medium text-base">{item.product}</span>
                <span class="text-muted ml-2">HSN {item.hsn}</span>
              </div>
              <span class="font-bold text-accent">{item.rate}</span>
            </div>
          ))}
        </div>

        <p>
          Need the full HSN code database? Use our <a href="/hsn-code-lookup" class="text-accent hover:underline">HSN Code Lookup</a> tool for detailed code-level search. Want to calculate the GST amount on a specific price? Try our <a href="/gst-calculator" class="text-accent hover:underline">GST Calculator</a>.
        </p>
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-12 border-t border-base pt-10">
      <h2 class="text-[24px] font-semibold text-base mb-6 tracking-[-0.6px]">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq, i) => (
          <details class="group rounded-[8px] border border-base bg-surface overflow-hidden" id={`faq-rate-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span class="text-[15px]">{faq.q}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[14px] text-muted leading-relaxed border-t border-base pt-4">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>

    <!-- Related tools -->
    <div class="mt-12 border-t border-base pt-10">
      <h3 class="text-[18px] font-semibold text-base mb-4">Related Tools</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {[
          { href: '/hsn-code-lookup', title: 'HSN Code Lookup', desc: 'Search by exact HSN/SAC code number' },
          { href: '/gst-calculator', title: 'GST Calculator', desc: 'Calculate GST amount on any price' },
          { href: '/gst-rate-comparison', title: 'Rate Comparison', desc: 'Old vs new GST 2.0 rate impact' },
        ].map((tool) => (
          <a href={tool.href} class="group rounded-lg border border-base bg-surface p-4 hover:border-accent transition-all">
            <div class="font-semibold text-[14px] text-base group-hover:text-accent transition-colors">{tool.title}</div>
            <div class="text-[12px] text-muted mt-1">{tool.desc}</div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Load HSN data and perform fuzzy search
  let hsnData = [];
  let searchTimeout;

  async function loadData() {
    try {
      const res = await fetch('/data/hsn_full.json');
      hsnData = await res.json();
    } catch (e) {
      console.error('Failed to load HSN data:', e);
    }
  }

  function fuzzyMatch(text, query) {
    const t = text.toLowerCase();
    const q = query.toLowerCase().trim();
    const words = q.split(/\s+/);
    return words.every(word => t.includes(word));
  }

  function getRateBadgeClass(rate) {
    const r = parseFloat(rate);
    if (r === 0) return 'badge-rate-0';
    if (r <= 5) return 'badge-rate-5';
    if (r <= 12) return 'badge-rate-12';
    if (r <= 18) return 'badge-rate-18';
    return 'badge-rate-28';
  }

  function search(query) {
    if (!query || query.length < 2) {
      document.getElementById('results-list').classList.add('hidden');
      document.getElementById('results-placeholder').classList.remove('hidden');
      document.getElementById('results-count').classList.add('hidden');
      return;
    }

    const matches = hsnData
      .filter(item => {
        const searchText = `${item.description || ''} ${item.hsn || item.code || ''} ${item.chapter || ''}`;
        return fuzzyMatch(searchText, query);
      })
      .slice(0, 20);

    const resultsList = document.getElementById('results-list');
    const resultsCount = document.getElementById('results-count');
    document.getElementById('results-placeholder').classList.add('hidden');

    if (matches.length === 0) {
      resultsList.innerHTML = `
        <div class="text-center py-12">
          <p class="text-muted text-[16px] font-medium">No results found for "${query}"</p>
          <p class="text-muted text-[13px] mt-1">Try different keywords or check our <a href="/hsn-code-lookup" class="text-accent hover:underline">HSN Code Lookup</a></p>
        </div>
      `;
    } else {
      resultsList.innerHTML = matches.map(item => {
        const code = item.hsn || item.code || 'N/A';
        const desc = item.description || 'No description';
        const rate = item.gst_rate || item.rate || 'N/A';
        const rateNum = parseFloat(rate) || 0;
        const cgst = (rateNum / 2).toFixed(1);
        const type = code.startsWith('99') ? 'SAC' : 'HSN';

        return `
          <div class="rounded-lg border border-base bg-surface p-4 hover:border-accent/30 transition-colors">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                  <span class="inline-flex px-2 py-0.5 rounded text-[11px] font-mono font-bold ${type === 'SAC' ? 'badge-sac' : 'badge-hsn'}">${type} ${code}</span>
                  <span class="inline-flex px-2 py-0.5 rounded text-[11px] font-mono font-bold ${getRateBadgeClass(rate)}">${rate}% GST</span>
                </div>
                <p class="text-[14px] text-base leading-snug">${desc}</p>
                ${rateNum > 0 ? `<p class="text-[12px] text-muted mt-1">CGST: ${cgst}% + SGST: ${cgst}%</p>` : ''}
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    resultsList.classList.remove('hidden');
    resultsCount.classList.remove('hidden');
    const total = hsnData.filter(item => {
      const searchText = `${item.description || ''} ${item.hsn || item.code || ''}`;
      return fuzzyMatch(searchText, query);
    }).length;
    resultsCount.textContent = `Showing ${matches.length} of ${total} results`;
  }

  // Initialize
  loadData();
  const input = document.getElementById('product-search');
  input?.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => search(input.value), 150);
  });
  input?.focus();
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { faqs } from '../data/faqs';

const title = 'Taxzentic — Free GST & Tax Tools Online';
const description = 'Taxzentic is the ultimate free tax and GST platform for India. Use our tools online or offline to calculate taxes, validate GSTINs, and manage compliance.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';

// JSON-LD: WebSite + Organization + FAQPage
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Taxzentic',
    url: siteUrl,
    description: 'Taxzentic — Free Tax & GST tools for India',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/hsn-code-lookup?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Taxzentic',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/taxzentic-logo.png`,
      width: 320,
      height: 80,
    },
    description: 'Free, instant GST tools for Indian businesses and taxpayers. Calculate GST, look up HSN/SAC codes, validate GSTIN numbers — all offline, no login required.',
    sameAs: [],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `<p>${faq.answerText}</p>`,
      },
    })),
  },
];

const tools = [
  { href: '/ecommerce-seller-toolkit', icon: 'chart-pie', title: 'E-commerce Seller Toolkit', description: 'Calculate net payout for Amazon/Flipkart sellers. Deducts commission, shipping, GST on fees, and 1% TCS.', badge: 'New' },
  { href: '/msme-registration-checker', icon: 'building-office', title: 'MSME/Udyam Checker', description: 'Check your business eligibility for MSME registration (Micro, Small, Medium) based on revised investment and turnover limits.', badge: 'New' },
  { href: '/gst-rate-finder', icon: 'search', title: 'GST Rate Finder', description: 'Find the GST rate for any product by name. Just type "laptop", "cement", or "gold" — no HSN code needed.', badge: 'New' },
  { href: '/credit-debit-note-generator', icon: 'file', title: 'Credit/Debit Note', description: 'Generate GST-compliant credit notes and debit notes. Auto-calculates CGST/SGST/IGST adjustments.', badge: 'New' },
  { href: '/msme-delayed-payment-calculator', icon: 'dollar', title: 'MSME Payment Interest', description: 'Calculate compound interest on delayed payments to MSMEs under Section 16 of the MSMED Act.', badge: 'New' },
  { href: '/qrmp-eligibility-checker', icon: 'check', title: 'QRMP Eligibility', description: 'Check if your business qualifies for quarterly GST return filing under the QRMP scheme.', badge: 'New' },
  { href: '/gst-notice-deadline-calculator', icon: 'hourglass', title: 'Notice Reply Deadline', description: 'Calculate the exact deadline to file your reply for ASMT-10, DRC-01, Section 73, and Section 74 notices.', badge: 'New' },
  { href: '/gst-margin-scheme-calculator', icon: 'refresh', title: 'Margin Scheme (Second Hand)', description: 'Calculate your tax savings on second-hand goods. Pay GST only on your profit margin, not the full sale value.', badge: 'New' },
  { href: '/gst-on-rent-calculator', icon: 'home', title: 'GST on Rent', description: 'Instantly check GST applicability, Reverse Charge Mechanism (RCM) rules, and tax liability for commercial or residential rent.', badge: 'New' },
  { href: '/gst-on-freight-calculator', icon: 'truck', title: 'GST on Freight', description: 'Determine GST liability, RCM applicability, and ITC eligibility for transport of goods (GTA vs Courier) in India.', badge: 'New' },
  { href: '/aggregate-turnover-calculator', icon: 'chart', title: 'Aggregate Turnover', description: 'Calculate your exact GST turnover. Instantly check if you cross the ₹20L/₹40L mandatory registration limit or Composition Scheme thresholds.', badge: 'New' },
  { href: '/gst-rate-comparison', icon: 'scale', title: 'Rate Comparison', description: 'Compare old GST slabs vs new GST 2.0 rates. Calculate the exact ₹ price impact for your end consumers.', badge: 'New' },
  { href: '/mrp-revision-calculator', icon: 'tag', title: 'MRP Revision Calculator', description: 'Reverse calculate your base price and generate a new MRP after a GST rate change to preserve your margins exactly.', badge: 'New' },
  { href: '/itc-reversal-checker', icon: 'traffic', title: 'ITC Reversal Checker', description: 'A simple yes/no decision tree to determine if a GST rate drop legally requires you to surrender your Input Tax Credit.', badge: 'New' },
  { href: '/gst-calculator', icon: 'calculator', title: 'GST Calculator', description: 'Add or remove GST instantly. Supports 5%, 18%, 40% (GST 2.0) and custom rates. Old slabs (12%, 28%) available for historical context. Shows CGST/SGST split.', badge: 'Most Popular' },
  { href: '/hsn-code-lookup', icon: 'search', title: 'HSN / SAC Code Lookup', description: 'Search HSN codes for goods and SAC codes for services. Instant client-side filtering with GST rate display.', badge: null },
  { href: '/gstin-validator', icon: 'check', title: 'GSTIN Validator', description: 'Validate any 15-digit GST number offline. Verifies format, checksum, decodes state name and embedded PAN.', badge: null },
  { href: '/invoice-generator', icon: 'file', title: 'GST Invoice Generator', description: 'Create perfect tax invoices instantly. Auto-calculates CGST/SGST/IGST. Download as PDF. 100% Free & Offline.', badge: 'Most Popular' },
  { href: '/eway-bill-limit-checker', icon: 'truck', title: 'E-Way Bill Limit Checker', description: 'Instantly check mandatory E-Way Bill threshold limits (₹50k vs ₹1 Lakh) for inter-state and intra-state goods movement.', badge: 'Trending' },
  { href: '/late-fee-calculator', icon: 'clock', title: 'Late Fee Calculator', description: 'Calculate GST late fees and interest for delayed filing of GSTR-1, GSTR-3B, or GSTR-9. Accurate client-side calculation.', badge: 'New' },
  { href: '/rcm-calculator', icon: 'refresh', title: 'RCM Calculator', description: 'Calculate Reverse Charge Mechanism (RCM) liability instantly.', badge: 'New' },
  { href: '/composition-scheme-calculator', icon: 'store', title: 'Composition Scheme', description: 'Check eligibility and calculate flat composition tax rates.', badge: 'New' },
  { href: '/eway-bill-validity', icon: 'road', title: 'E-Way Bill Validity', description: 'Calculate exactly how many days an E-way bill is valid.', badge: 'New' },
  { href: '/itc-calculator', icon: 'dollar', title: 'ITC Calculator', description: 'Calculate Input Tax Credit set-off and net GST payable.', badge: 'New' },
  { href: '/gst-interest-calculator', icon: 'dollar', title: 'Interest Calculator', description: 'Calculate interest on delayed GST payments at 18% p.a.', badge: 'New' },
  { href: '/tds-gst-calculator', icon: 'scissors', title: 'TDS Calculator', description: 'Calculate 2% TDS under GST for contracts over ₹2.5 Lakhs.', badge: 'New' },
  { href: '/tcs-gst-calculator', icon: 'cart', title: 'TCS Calculator', description: 'Calculate 1% TCS under GST for e-commerce operators and sellers.', badge: 'New' },
  { href: '/gst-penalty-calculator', icon: 'scale', title: 'Penalty Calculator', description: 'Calculate statutory GST penalties for fraud, late payment, and fake invoices.', badge: 'New' },
  { href: '/gst-due-dates', icon: 'calendar', title: 'GST Due Dates Calendar', description: 'Track all important GST return filing due dates. Never miss a deadline and avoid late fees and penalties.', badge: 'New' },
  { href: '/gstr-9-annual-return-checklist', icon: 'report', title: 'GSTR-9 Checklist', description: 'Interactive checklist for filing GSTR-9 Annual Return and avoiding notices.', badge: 'New' },
  { href: '/lut-renewal-reminder', icon: 'bell', title: 'LUT Renewal Reminder', description: 'Calculate your exact deadline to renew LUT for zero-rated GST exports.', badge: 'New' },
  { href: '/gst-director-remuneration-calculator', icon: 'tie', title: 'Director RCM Calculator', description: 'Determine GST applicability (18% RCM vs Salary) on director remuneration.', badge: 'New' },
  { href: '/supply-type-classifier', icon: 'box', title: 'Supply Type Classifier', description: 'Classify bundled goods into Composite vs Mixed Supply for accurate tax rates.', badge: 'New' },
  { href: '/multi-gstin-invoice-splitter', icon: 'building', title: 'Multi-GSTIN Splitter', description: 'Allocate values and determine IGST/CGST across multiple state branches.', badge: 'New' },
];
---

<BaseLayout {title} {description} {structuredData}>
  <!-- ── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden border-b border-base bg-surface hero-section">
    <!-- Animated Mesh Gradient Backdrop -->
    <div class="absolute inset-0 z-0 pointer-events-none hero-gradient"></div>
    
    <!-- Floating decoration shapes -->
    <div class="absolute top-20 left-[10%] w-72 h-72 bg-blue-500/10 rounded-full blur-3xl animate-float-slow pointer-events-none"></div>
    <div class="absolute bottom-10 right-[10%] w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl animate-float-delayed pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-violet-500/5 rounded-full blur-3xl pointer-events-none"></div>
    
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 z-0 pointer-events-none opacity-[0.03] dark:opacity-[0.05]" style="background-image: url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 viewBox=%220 0 60 60%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cg fill=%22none%22 fill-rule=%22evenodd%22%3E%3Cg fill=%22%23000%22 fill-opacity=%221%22%3E%3Cpath d=%22M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    
    <div class="relative z-10 mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8 py-28 sm:py-36 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-base/50 bg-white/60 dark:bg-white/5 backdrop-blur-sm px-5 py-2 text-[12px] font-mono uppercase tracking-wider text-muted mb-8 shadow-sm hero-badge">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Free · Offline · No Login Required
      </div>
      <h1 class="text-4xl sm:text-6xl lg:text-[72px] font-extrabold tracking-[-2px] leading-[1.08] mb-6">
        <span class="text-base">The Ultimate Free</span><br />
        <span class="hero-gradient-text">Tax Platform</span>
        <span class="text-base"> for India</span>
      </h1>
      <p class="mt-6 text-[18px] text-muted max-w-2xl mx-auto leading-relaxed">
        Use <strong class="text-base">Taxzentic</strong> to instantly compute taxes. Whether you need a <strong class="text-base">GST tool for e-commerce</strong>, a quick <strong class="text-base">GST number search</strong>, or an <strong class="text-base">offline tax tool</strong> alternative to the portal—we have you covered.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/gst-calculator"
          class="group inline-flex items-center justify-center rounded-full bg-gradient-to-r from-blue-600 to-cyan-500 px-8 py-3.5 text-[16px] font-semibold text-white shadow-lg shadow-blue-500/25 hover:shadow-xl hover:shadow-blue-500/30 hover:-translate-y-0.5 active:scale-95 transition-all w-full sm:w-auto"
        >
          Open GST Calculator
          <svg class="ml-2 h-4 w-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a
          href="/hsn-code-lookup"
          class="inline-flex items-center justify-center rounded-full border border-base bg-white/70 dark:bg-white/5 backdrop-blur-sm px-8 py-3.5 text-[16px] font-semibold text-base hover:bg-white dark:hover:bg-white/10 active:scale-95 transition-all w-full sm:w-auto shadow-sm"
        >
          Search HSN Codes
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="mt-14 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-[13px] text-muted">
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <span>35+ Free Tools</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <span>GST 2.0 Ready</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <span>100% Offline</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <span>No Sign-up</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Tool Cards ─────────────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8 py-24" aria-labelledby="tools-heading">
    <div class="text-center mb-16">
      <span class="inline-block text-[13px] font-semibold uppercase tracking-widest text-accent mb-3">All-in-One Platform</span>
      <h2 id="tools-heading" class="text-[36px] sm:text-[42px] tracking-[-1.5px] font-bold text-base mb-4">
        The complete GST toolkit.
      </h2>
      <p class="text-[18px] text-muted max-w-2xl mx-auto leading-relaxed">
        Everything you need for GST compliance — fast, offline, and completely free.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {tools.map((tool, index) => (
        <a
          href={tool.href}
          class={`tool-card group relative flex flex-col rounded-2xl border bg-surface p-6 transition-all duration-300 hover:shadow-xl hover:-translate-y-1.5 ${
            tool.badge === 'Most Popular' ? 'border-accent/30 ring-1 ring-accent/10' :
            tool.badge === 'Trending' ? 'border-amber-300/40 dark:border-amber-700/40' :
            'border-base hover:border-accent/40'
          }`}
          style={`animation-delay: ${Math.min(index * 50, 500)}ms`}
        >
          {/* Hover gradient overlay */}
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-accent/[0.03] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
          
          {tool.badge && (
            <span class={`absolute top-5 right-5 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide ${
              tool.badge === 'Most Popular' ? 'bg-gradient-to-r from-blue-600 to-cyan-500 text-white shadow-sm' :
              tool.badge === 'Trending' ? 'bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-sm' :
              'bg-accent/8 text-accent border border-accent/15'
            }`}>
              {tool.badge === 'Most Popular' ? '★ Popular' : tool.badge === 'Trending' ? '🔥 Trending' : tool.badge}
            </span>
          )}
          <div class="mb-5 relative">
            <div class="tool-icon-wrap">
              <ToolIcon name={tool.icon} size={44} />
            </div>
          </div>
          <h3 class="relative text-[18px] tracking-[-0.4px] font-bold text-base mb-2 group-hover:text-accent transition-colors duration-200">
            {tool.title}
          </h3>
          <p class="relative text-[13px] text-muted leading-relaxed flex-1">{tool.description}</p>
          <div class="relative mt-5 flex items-center gap-1.5 text-[13px] font-semibold text-accent opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-200">
            Open tool
            <svg class="h-3.5 w-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Hubs & Guides ─────────────────────────────────────────────── -->
  <section class="border-t border-base" aria-labelledby="hubs-heading">
    <div class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center mb-12">
        <span class="inline-block text-[13px] font-semibold uppercase tracking-widest text-accent mb-3">Deep Dives</span>
        <h2 id="hubs-heading" class="text-[32px] sm:text-[36px] tracking-[-1.28px] font-bold text-base mb-3">
          Hubs & Expert Guides
        </h2>
        <p class="text-muted text-[16px] max-w-xl mx-auto">
          In-depth resources to master GST compliance — tools, rate charts, code guides, and more.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <a href="/gst-2-0" class="group relative overflow-hidden rounded-2xl border border-base bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-950/30 dark:to-cyan-950/30 p-8 hover:border-accent hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 inline-flex items-center justify-center w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/50">
            <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
          </div>
          <span class="inline-block text-[11px] font-bold uppercase tracking-wide text-blue-600 dark:text-blue-400 mb-2">New Rates Live</span>
          <h3 class="text-[20px] font-bold text-base group-hover:text-accent transition-colors mb-2">GST 2.0 Hub</h3>
          <p class="text-[14px] text-muted leading-relaxed">Complete guide to the new 3-slab GST structure (5%, 18%, 40%) effective 22 September 2025. Rate comparison tools, product-wise impact, and compliance checklists.</p>
          <div class="mt-5 flex items-center gap-1.5 text-[13px] font-semibold text-accent">
            Explore GST 2.0 <svg class="h-3.5 w-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </div>
        </a>
        <a href="/hsn-codes" class="group relative overflow-hidden rounded-2xl border border-base bg-gradient-to-br from-violet-50 to-indigo-50 dark:from-violet-950/30 dark:to-indigo-950/30 p-8 hover:border-accent hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 inline-flex items-center justify-center w-12 h-12 rounded-xl bg-violet-100 dark:bg-violet-900/50">
            <svg class="w-6 h-6 text-violet-600 dark:text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </div>
          <span class="inline-block text-[11px] font-bold uppercase tracking-wide text-violet-600 dark:text-violet-400 mb-2">3,800+ Codes</span>
          <h3 class="text-[20px] font-bold text-base group-hover:text-accent transition-colors mb-2">HSN & SAC Codes</h3>
          <p class="text-[14px] text-muted leading-relaxed">Search HSN codes for goods and SAC codes for services. Includes 4-digit vs 6-digit requirements, common product pages, and a full lookup tool — all offline.</p>
          <div class="mt-5 flex items-center gap-1.5 text-[13px] font-semibold text-accent">
            Browse HSN Codes <svg class="h-3.5 w-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </div>
        </a>
        <a href="/blog" class="group relative overflow-hidden rounded-2xl border border-base bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-emerald-950/30 dark:to-teal-950/30 p-8 hover:border-accent hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 inline-flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/50">
            <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <span class="inline-block text-[11px] font-bold uppercase tracking-wide text-emerald-600 dark:text-emerald-400 mb-2">57+ Articles</span>
          <h3 class="text-[20px] font-bold text-base group-hover:text-accent transition-colors mb-2">Expert Blog</h3>
          <p class="text-[14px] text-muted leading-relaxed">In-depth guides on GST registration, return filing, GSTR-2B mismatches, ITC claims, e-way bills, and more — written by CAs and verified by tax professionals.</p>
          <div class="mt-5 flex items-center gap-1.5 text-[13px] font-semibold text-accent">
            Read the Blog <svg class="h-3.5 w-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ── SEO Content Section (~600 words) ────────────────────────────── -->
  <section class="border-t border-base bg-subtle" aria-labelledby="about-gst-heading">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-24">
      <div class="text-center mb-12">
        <span class="inline-block text-[13px] font-semibold uppercase tracking-widest text-accent mb-3">Learn GST</span>
        <h2 id="about-gst-heading" class="text-[32px] sm:text-[36px] tracking-[-1.28px] font-bold text-base">
          Understanding GST in India
        </h2>
      </div>

      <div class="prose prose-neutral dark:prose-invert max-w-none space-y-6 text-[16px] leading-[24px] pl-6 border-l-4 border-l-transparent bg-gradient-to-r from-accent/5 to-transparent py-4 pr-4 rounded-r-2xl">
        <p>
          <strong>GST (Goods and Services Tax)</strong> — the full form of GST — is India's most significant indirect tax reform. Implemented on 1 July 2017, GST replaced a fragmented system of central and state taxes. Today, every business with annual turnover above the threshold must complete their <strong>GST registration</strong> on the official <strong>GST portal</strong>. Once registered, a business receives a unique 15-character <strong>GST number</strong>. You can do a quick <strong>GST number check</strong> or <strong>GST number search</strong> to verify details of any supplier before transacting, ensuring they are active on the <strong>GST portal login</strong>.
        </p>

        <p>
          Whether you're a small trader or a seasoned CA, having a reliable <strong>GST tool</strong> is essential. India uses a four-tier GST rate structure. To figure out tax on a bill, you can use our free <strong>GST calculator</strong>. It allows you to add GST to a base price or remove GST from an inclusive price in seconds. You can also generate beautiful bills using our <strong>free online GST invoice generator</strong>. For logistics and transport, knowing the <strong>E-Way bill limits 2026</strong> is critical to avoid massive penalties. Understanding <strong>new GST rates</strong> and applying them correctly ensures correct <strong>GST payment</strong> when filing returns.
        </p>

        <h3 class="text-[20px] font-semibold text-base mt-10 mb-4 tracking-[-0.6px]">What is a GST Number?</h3>
        <p>
          A GST number (also known as GSTIN) is an alphanumeric identifier assigned after successful <strong>gst registration</strong>. Knowing how to do a <strong>GST no check</strong> or <strong>GST no search</strong> is critical before entering a business transaction. Our <strong>GST verification</strong> tool lets you validate the checksum and PAN immediately without any external API call. You don't need a separate <strong>gst login</strong> to use our offline tools.
        </p>

        <h3 class="text-[20px] font-semibold text-base mt-10 mb-4 tracking-[-0.6px]">HSN Codes and GST Search</h3>
        <p>
          Every good traded in India is classified under an HSN code, and services under a SAC. These codes determine the applicable <strong>new gst rates list 2025</strong>. Doing a quick <strong>GST search</strong> through our HSN Lookup tool lets you find the exact code and its associated tax rate. This avoids errors during <strong>gst portal login</strong> and invoice generation. Our <strong>GST status</strong> tool can also assist in tracking the correct rates and filing requirements.
        </p>

        <h3 class="text-[20px] font-semibold text-base mt-10 mb-4 tracking-[-0.6px]">GST Portal Login and Payments</h3>
        <p>
          The official website is where you perform your <strong>gst login portal</strong> activities. This is your destination for filing returns, tracking your <strong>gst status</strong>, and making a secure <strong>gst payment</strong>. You can also download your certificate or perform a real-time <strong>gst check</strong>. While the official portal is essential for compliance, our fast, offline tools save you time during day-to-day operations like preparing invoices or performing a quick <strong>gst verification</strong> before paying vendors.
        </p>

        <p class="text-[14px] text-muted border-t border-base pt-6 mt-8">
          <strong>Note:</strong> All tools on this website are for informational and calculation purposes only. GST rates and rules are subject to change. Always refer to the official GST portal and CBIC notifications for authoritative information. The <strong>Taxzentic</strong> suite is completely free and requires no <strong>gst login</strong>.
        </p>

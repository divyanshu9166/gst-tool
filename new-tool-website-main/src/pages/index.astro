  <script type="application/json" id="home-tool-search-index" set:html={JSON.stringify(homeToolSearchIndex).replace(/</g, '\\u003c')}></script>

  <script>
    type ToolSearchEntry = { href: string; title: string; description: string };
    const searchInput = document.querySelector<HTMLInputElement>('[data-home-tool-search]');
    const searchResults = document.querySelector<HTMLUListElement>('[data-home-search-results]');
    const searchSubmit = document.querySelector<HTMLButtonElement>('[data-home-search-submit]');
    const searchIndexNode = document.getElementById('home-tool-search-index');
    const catalog = document.querySelector<HTMLDetailsElement>('[data-tool-catalog]');
    let searchIndex: ToolSearchEntry[] = [];
    try {
      searchIndex = JSON.parse(searchIndexNode?.textContent ?? '[]') as ToolSearchEntry[];
    } catch {
      searchIndex = [];
    }

    const closeSearchResults = () => {
      searchResults?.classList.add('hidden');
      searchInput?.setAttribute('aria-expanded', 'false');
    };
    const showToolCatalog = () => {
      if (!catalog) return;
      catalog.open = true;
      catalog.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    const renderSearchResults = () => {
      if (!searchInput || !searchResults) return [] as ToolSearchEntry[];
      const query = searchInput.value.trim().toLocaleLowerCase();
      searchResults.replaceChildren();
      if (!query) {
        closeSearchResults();
        return [];
      }

      const matches = searchIndex
        .filter((tool) => `${tool.title} ${tool.description}`.toLocaleLowerCase().includes(query))
        .slice(0, 6);
      if (matches.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'px-3 py-3 text-[13px] text-muted';
        empty.textContent = 'No matching tools. Try “GST”, “income tax” or “HSN”.';
        searchResults.append(empty);
      } else {
        matches.forEach((tool) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = tool.href;
          link.className = 'block rounded-lg px-3 py-2.5 hover:bg-[#f2f7ff] focus-visible:bg-[#f2f7ff] dark:hover:bg-slate-800 dark:focus-visible:bg-slate-800';
          const title = document.createElement('span');
          title.className = 'block text-[13px] font-semibold text-[#10264a] dark:text-slate-100';
          title.textContent = tool.title;
          const description = document.createElement('span');
          description.className = 'mt-0.5 block text-[11px] leading-[16px] text-muted';
          description.textContent = tool.description;
          link.append(title, description);
          item.append(link);
          searchResults.append(item);
        });
      }
      searchResults.classList.remove('hidden');
      searchInput.setAttribute('aria-expanded', 'true');
      return matches;
    };

    searchInput?.addEventListener('input', renderSearchResults);
    searchInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeSearchResults();
      if (event.key === 'Enter') {
        const firstResult = searchResults?.querySelector<HTMLAnchorElement>('a');
        if (firstResult) {
          event.preventDefault();
          window.location.assign(firstResult.href);
        }
      }
    });
    searchSubmit?.addEventListener('click', () => {
      const matches = renderSearchResults();
      const firstResult = searchResults?.querySelector<HTMLAnchorElement>('a');
      if (firstResult) window.location.assign(firstResult.href);
      else if (!searchInput?.value.trim()) showToolCatalog();
      else if (matches.length === 0) searchInput?.focus();
    });
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !searchResults?.contains(event.target) && !searchInput?.contains(event.target)) {
        closeSearchResults();
      }
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-open-tool-catalog]').forEach((link) => {
      link.addEventListener('click', () => {
        if (catalog) catalog.open = true;
      });
    });
  </script>


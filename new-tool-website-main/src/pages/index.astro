---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { faqs } from '../data/faqs';

const title = 'Taxzentic — Free GST & Tax Tools Online';
const description = 'Taxzentic is the ultimate free tax and GST platform for India. Use our tools online or offline to calculate taxes, validate GSTINs, and manage compliance.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';

// JSON-LD: WebSite + Organization + FAQPage
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Taxzentic',
    url: siteUrl,
    description: 'Taxzentic — Free Tax & GST tools for India',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/hsn-code-lookup?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Taxzentic',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/taxzentic-logo.png`,
      width: 320,
      height: 80,
    },
    description: 'Free, instant GST tools for Indian businesses and taxpayers. Calculate GST, look up HSN/SAC codes, validate GSTIN numbers — all offline, no login required.',
    sameAs: [],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `<p>${faq.answerText}</p>`,
      },
    })),
  },
];

const tools = [
  { href: '/income-tax-calculator', icon: 'dollar', title: 'New vs Old Regime Calculator', description: 'Compare Section 115BAC vs Old Regime with ₹75,000 standard deduction, Sec 87A zero tax up to ₹7.75L, and 80C/80D/HRA deductions.', badge: 'Most Popular' },
  { href: '/gst-notice-reply-generator', icon: 'file', title: 'AI GST Notice Reply Generator', description: 'Draft legally cited replies for ASMT-10, DRC-01, and Section 73/74 demand notices with CBIC circulars and Sec 75(4) hearing prayers.', badge: 'AI Powered' },
  { href: '/gst-health-score', icon: 'scale', title: 'GST Health Score Quiz', description: '10-question compliance audit quiz ending in score/100. Pinpoint notice risks, 180-day vendor payment rules, and get instant remedies.', badge: 'Trending' },
  { href: '/bulk-gstin-validator', icon: 'check', title: 'Bulk GSTIN Validator', description: 'Validate up to 50 GST numbers at once offline. Verifies format, Luhn checksum, decodes state names, and exports results to CSV.', badge: 'Pro Tool' },
  { href: '/income-tax-tools', icon: 'calculator', title: 'Income Tax Tools Hub', description: 'Complete direct tax suite: New vs Old Regime, HRA exemption calculator, TDS section finder, Section 44AD presumptive tax, and advance tax.', badge: 'New Hub' },
  { href: '/restaurant-gst-calculator', icon: 'store', title: 'Restaurant GST Calculator', description: 'Calculate tax for standalone cafes (5% no ITC), hotels with room tariff >₹7,500 (18% with ITC), cloud kitchens, and Swiggy/Zomato.', badge: 'New' },
  { href: '/real-estate-gst-calculator', icon: 'home', title: 'Real Estate GST Calculator', description: 'Determine GST on under-construction flats (1% affordable, 5% standard), commercial units (12%), and 0% for ready flats with CC.', badge: 'New' },
  { href: '/freelancer-invoice-generator', icon: 'receipt', title: 'Freelancer Invoice Generator', description: 'Specialized for developers and designers. Supports USD/EUR currencies, 0% zero-rated export under LUT, and SAC 9983.', badge: 'New' },
  { href: '/gstr-mismatch-checker', icon: 'traffic', title: 'GSTR Mismatch Checker', description: 'Compare GSTR-1 vs 3B liability and GSTR-2B vs 3B ITC. Alerts you if differences cross the statutory 20% / ₹25 Lakh notice trigger.', badge: 'New' },
  { href: '/gst-refund-calculator', icon: 'refresh', title: 'GST Refund Calculator', description: 'Compute maximum eligible refunds under Rule 89(5) for Inverted Duty Structure and Rule 89(4) for Zero-Rated Exports under LUT.', badge: 'New' },
  { href: '/e-invoice-eligibility-checker', icon: 'building', title: 'E-Invoice Eligibility Checker', description: 'Check if your business must generate IRN based on the ₹5 Crore turnover threshold and Rule 48(4) statutory sector exemptions.', badge: 'New' },
  { href: '/tds-section-finder', icon: 'search', title: 'TDS Section & Rate Finder', description: 'Searchable directory of 194C, 194J, 194I, 194H, 194Q with interactive deduction calculator and non-PAN penal rates.', badge: 'New' },
  { href: '/section-44ad-calculator', icon: 'chart', title: 'Section 44AD Presumptive Tax', description: 'Calculate 6% digital vs 8% cash deemed profits for GST traders and small businesses up to ₹3 Crores turnover without CA audit.', badge: 'New' },
  { href: '/gst-amnesty-tracker', icon: 'hourglass', title: 'Section 128A Amnesty Tracker', description: 'Check eligibility for 100% statutory waiver of interest and penalties for FY 2017-18 to 2019-20 demand notices.', badge: 'New' },
  { href: '/saas-export-lut-calculator', icon: 'box', title: 'SaaS & Export LUT Calculator', description: 'Evaluate the 5 statutory tests under Section 2(6) of IGST Act for Export of Services and track annual LUT renewals.', badge: 'New' },
  { href: '/hra-exemption-calculator', icon: 'dollar', title: 'HRA Exemption Calculator', description: 'Calculate exact tax-free House Rent Allowance under Section 10(13A) Rule 2A across Metro (50%) and Non-Metro (40%) cities.', badge: 'New' },
  { href: '/ecommerce-seller-toolkit', icon: 'chart-pie', title: 'E-commerce Seller Toolkit', description: 'Calculate net payout for Amazon/Flipkart sellers. Deducts commission, shipping, GST on fees, and 1% TCS.', badge: null },
  { href: '/msme-registration-checker', icon: 'building-office', title: 'MSME/Udyam Checker', description: 'Check your business eligibility for MSME registration (Micro, Small, Medium) based on revised investment and turnover limits.', badge: null },
  { href: '/gst-rate-finder', icon: 'search', title: 'GST Rate Finder', description: 'Find the GST rate for any product by name. Just type "laptop", "cement", or "gold" — no HSN code needed.', badge: null },
  { href: '/credit-debit-note-generator', icon: 'file', title: 'Credit/Debit Note', description: 'Generate GST-compliant credit notes and debit notes. Auto-calculates CGST/SGST/IGST adjustments.', badge: null },
  { href: '/msme-delayed-payment-calculator', icon: 'dollar', title: 'MSME Payment Interest', description: 'Calculate compound interest on delayed payments to MSMEs under Section 16 of the MSMED Act.', badge: null },
  { href: '/qrmp-eligibility-checker', icon: 'check', title: 'QRMP Eligibility', description: 'Check if your business qualifies for quarterly GST return filing under the QRMP scheme.', badge: null },
  { href: '/gst-notice-deadline-calculator', icon: 'hourglass', title: 'Notice Reply Deadline', description: 'Calculate the exact deadline to file your reply for ASMT-10, DRC-01, Section 73, and Section 74 notices.', badge: null },
  { href: '/gst-margin-scheme-calculator', icon: 'refresh', title: 'Margin Scheme (Second Hand)', description: 'Calculate your tax savings on second-hand goods. Pay GST only on your profit margin, not the full sale value.', badge: null },
  { href: '/gst-on-rent-calculator', icon: 'home', title: 'GST on Rent', description: 'Instantly check GST applicability, Reverse Charge Mechanism (RCM) rules, and tax liability for commercial or residential rent.', badge: null },
  { href: '/gst-on-freight-calculator', icon: 'truck', title: 'GST on Freight', description: 'Determine GST liability, RCM applicability, and ITC eligibility for transport of goods (GTA vs Courier) in India.', badge: null },
  { href: '/aggregate-turnover-calculator', icon: 'chart', title: 'Aggregate Turnover', description: 'Calculate your exact GST turnover. Instantly check if you cross the ₹20L/₹40L mandatory registration limit or Composition Scheme thresholds.', badge: null },
  { href: '/gst-rate-comparison', icon: 'scale', title: 'Rate Comparison', description: 'Compare old GST slabs vs new GST 2.0 rates. Calculate the exact ₹ price impact for your end consumers.', badge: null },
  { href: '/mrp-revision-calculator/', icon: 'tag', title: 'MRP Revision Calculator', description: 'Reverse calculate your base price and generate a new MRP after a GST rate change to preserve your margins exactly.', badge: null },
  { href: '/itc-reversal-checker', icon: 'traffic', title: 'ITC Reversal Checker', description: 'A simple yes/no decision tree to determine if a GST rate drop legally requires you to surrender your Input Tax Credit.', badge: null },
  { href: '/gst-calculator', icon: 'calculator', title: 'GST Calculator', description: 'Add or remove GST instantly. Supports 5%, 18%, 40% (GST 2.0) and custom rates. Shows CGST/SGST split.', badge: 'Most Popular' },
  { href: '/hsn-code-lookup', icon: 'search', title: 'HSN / SAC Code Lookup', description: 'Search HSN codes for goods and SAC codes for services. Instant client-side filtering with GST rate display.', badge: null },
  { href: '/gstin-validator', icon: 'check', title: 'GSTIN Validator', description: 'Validate any 15-digit GST number offline. Verifies format, checksum, decodes state name and embedded PAN.', badge: null },
  { href: '/invoice-generator', icon: 'file', title: 'GST Invoice Generator', description: 'Create perfect tax invoices instantly. Auto-calculates CGST/SGST/IGST. Download as PDF. 100% Free & Offline.', badge: 'Most Popular' },
  { href: '/eway-bill-limit-checker', icon: 'truck', title: 'E-Way Bill Limit Checker', description: 'Instantly check mandatory E-Way Bill threshold limits (₹50k vs ₹1 Lakh) for inter-state and intra-state goods movement.', badge: 'Trending' },
  { href: '/late-fee-calculator', icon: 'clock', title: 'Late Fee Calculator', description: 'Calculate GST late fees and interest for delayed filing of GSTR-1, GSTR-3B, or GSTR-9. Accurate client-side calculation.', badge: null },
  { href: '/rcm-calculator', icon: 'refresh', title: 'RCM Calculator', description: 'Calculate Reverse Charge Mechanism (RCM) liability instantly.', badge: null },
  { href: '/composition-scheme-calculator', icon: 'store', title: 'Composition Scheme', description: 'Check eligibility and calculate flat composition tax rates.', badge: null },
  { href: '/eway-bill-validity', icon: 'road', title: 'E-Way Bill Validity', description: 'Calculate exactly how many days an E-way bill is valid.', badge: null },
  { href: '/itc-calculator', icon: 'dollar', title: 'ITC Calculator', description: 'Calculate Input Tax Credit set-off and net GST payable.', badge: null },
  { href: '/gst-interest-calculator', icon: 'dollar', title: 'Interest Calculator', description: 'Calculate interest on delayed GST payments at 18% p.a.', badge: null },
  { href: '/tds-gst-calculator', icon: 'scissors', title: 'TDS Calculator', description: 'Calculate 2% TDS under GST for contracts over ₹2.5 Lakhs.', badge: null },
  { href: '/tcs-gst-calculator', icon: 'cart', title: 'TCS Calculator', description: 'Calculate 1% TCS under GST for e-commerce operators and sellers.', badge: null },
  { href: '/gst-penalty-calculator', icon: 'scale', title: 'Penalty Calculator', description: 'Calculate statutory GST penalties for fraud, late payment, and fake invoices.', badge: null },
  { href: '/gst-due-dates', icon: 'calendar', title: 'GST Due Dates Calendar', description: 'Track all important GST return filing due dates. Never miss a deadline and avoid late fees and penalties.', badge: null },
  { href: '/gstr-9-annual-return-checklist', icon: 'report', title: 'GSTR-9 Checklist', description: 'Interactive checklist for filing GSTR-9 Annual Return and avoiding notices.', badge: null },
  { href: '/lut-renewal-reminder', icon: 'bell', title: 'LUT Renewal Reminder', description: 'Calculate your exact deadline to renew LUT for zero-rated GST exports.', badge: null },
  { href: '/gst-director-remuneration-calculator', icon: 'tie', title: 'Director RCM Calculator', description: 'Determine GST applicability (18% RCM vs Salary) on director remuneration.', badge: null },
  { href: '/supply-type-classifier', icon: 'box', title: 'Supply Type Classifier', description: 'Classify bundled goods into Composite vs Mixed Supply for accurate tax rates.', badge: null },
  { href: '/multi-gstin-invoice-splitter', icon: 'building', title: 'Multi-GSTIN Splitter', description: 'Allocate values and determine IGST/CGST across multiple state branches.', badge: null },
  { href: '/pin-to-pin-distance-calculator', icon: 'road', title: 'Pin to Pin Distance Calculator', description: 'Check transport distance between source and delivery pincodes for E-way bill generation.', badge: null },
];
---

<BaseLayout {title} {description} {structuredData}>
  <!-- ── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden border-b border-base bg-surface hero-section">
    <!-- Animated Mesh Gradient Backdrop -->
    <div class="absolute inset-0 z-0 pointer-events-none hero-gradient"></div>
    
    <!-- Floating decoration shapes -->
    <div class="absolute top-20 left-[10%] w-72 h-72 bg-blue-500/10 rounded-full blur-3xl animate-float-slow pointer-events-none"></div>
    <div class="absolute bottom-10 right-[10%] w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl animate-float-delayed pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-violet-500/5 rounded-full blur-3xl pointer-events-none"></div>
    
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 z-0 pointer-events-none opacity-[0.03] dark:opacity-[0.05]" style="background-image: url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 viewBox=%220 0 60 60%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cg fill=%22none%22 fill-rule=%22evenodd%22%3E%3Cg fill=%22%23000%22 fill-opacity=%221%22%3E%3Cpath d=%22M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    
    <div class="relative z-10 mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8 py-28 sm:py-36 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-base/50 bg-white/60 dark:bg-white/5 backdrop-blur-sm px-5 py-2 text-[12px] font-mono uppercase tracking-wider text-muted mb-8 shadow-sm hero-badge">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Free · Client-Side Tools · No Login Required
      </div>
      <h1 class="text-4xl sm:text-6xl lg:text-[72px] font-extrabold tracking-[-2px] leading-[1.08] mb-6">
        <span class="text-base">The Ultimate Free</span><br />
        <span class="hero-gradient-text">Tax Platform</span>
        <span class="text-base"> for India</span>
      </h1>
      <p class="mt-6 text-[18px] text-muted max-w-2xl mx-auto leading-relaxed">
        Use <strong class="text-base">Taxzentic</strong> to instantly compute taxes. Whether you need a <strong class="text-base">GST tool for e-commerce</strong>, a quick <strong class="text-base">GST number search</strong>, or a fast <strong class="text-base">client-side tax tool</strong> alternative to the portal—we have you covered.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/gst-calculator"
          class="group inline-flex items-center justify-center rounded-full bg-gradient-to-r from-blue-600 to-cyan-500 px-8 py-3.5 text-[16px] font-semibold text-white shadow-lg shadow-blue-500/25 hover:shadow-xl hover:shadow-blue-500/30 hover:-translate-y-0.5 active:scale-95 transition-all w-full sm:w-auto"
        >
          Open GST Calculator
          <svg class="ml-2 h-4 w-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a
          href="/hsn-code-lookup"
          class="inline-flex items-center justify-center rounded-full border border-base bg-white/70 dark:bg-white/5 backdrop-blur-sm px-8 py-3.5 text-[16px] font-semibold text-base hover:bg-white dark:hover:bg-white/10 active:scale-95 transition-all w-full sm:w-auto shadow-sm"
        >
          Search HSN Codes
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="mt-14 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-[13px] text-muted">
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <span>35+ Free Tools</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <span>GST 2.0 Ready</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <span>Client-Side Privacy</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          <span>No Sign-up</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Tool Cards ─────────────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8 py-24" aria-labelledby="tools-heading">
    <div class="text-center mb-16">
      <span class="inline-block text-[13px] font-semibold uppercase tracking-widest text-accent mb-3">All-in-One Platform</span>
      <h2 id="tools-heading" class="text-[36px] sm:text-[42px] tracking-[-1.5px] font-bold text-base mb-4">
        The complete GST toolkit.
      </h2>
      <p class="text-[18px] text-muted max-w-2xl mx-auto leading-relaxed">
        Everything you need for GST compliance — fast, offline, and completely free.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {tools.map((tool, index) => (
        <a
          href={tool.href}
          class={`tool-card group relative flex flex-col rounded-2xl border bg-surface p-6 transition-all duration-300 hover:shadow-xl hover:-translate-y-1.5 ${
            tool.badge === 'Most Popular' ? 'border-accent/30 ring-1 ring-accent/10' :
            tool.badge === 'Trending' ? 'border-amber-300/40 dark:border-amber-700/40' :
            'border-base hover:border-accent/40'
          }`}
          style={`animation-delay: ${Math.min(index * 50, 500)}ms`}
        >
          {/* Hover gradient overlay */}
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-accent/[0.03] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
          
          {tool.badge && (
            <span class={`absolute top-5 right-5 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide ${
              tool.badge === 'Most Popular' ? 'bg-gradient-to-r from-blue-600 to-cyan-500 text-white shadow-sm' :
              tool.badge === 'Trending' ? 'bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-sm' :
              'bg-accent/8 text-accent border border-accent/15'
            }`}>
              {tool.badge === 'Most Popular' ? '★ Popular' : tool.badge === 'Trending' ? '🔥 Trending' : tool.badge}
            </span>
          )}
          <div class="mb-5 relative">
            <div class="tool-icon-wrap">
              <ToolIcon name={tool.icon} size={44} />
            </div>
          </div>
          <h3 class="relative text-[18px] tracking-[-0.4px] font-bold text-base mb-2 group-hover:text-accent transition-colors duration-200">
            {tool.title}
          </h3>
          <p class="relative text-[13px] text-muted leading-relaxed flex-1">{tool.description}</p>
          <div class="relative mt-5 flex items-center gap-1.5 text-[13px] font-semibold text-accent opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-200">
            Open tool
            <svg class="h-3.5 w-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Hubs & Guides ─────────────────────────────────────────────── -->
  <section class="border-t border-base" aria-labelledby="hubs-heading">
    <div class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center mb-12">
        <span class="inline-block text-[13px] font-semibold uppercase tracking-widest text-accent mb-3">Deep Dives</span>
        <h2 id="hubs-heading" class="text-[32px] sm:text-[36px] tracking-[-1.28px] font-bold text-base mb-3">
          Hubs & Expert Guides
        </h2>
        <p class="text-muted text-[16px] max-w-xl mx-auto">
          In-depth resources to master GST compliance — tools, rate charts, code guides, and more.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Income Tax Hub -->
        <a href="/income-tax-tools" class="group relative overflow-hidden rounded-2xl border border-base bg-gradient-to-br from-amber-50 to-orange-50 dark:from-amber-950/30 dark:to-orange-950/30 p-7 hover:border-accent hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 inline-flex items-center justify-center w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <span class="inline-block text-[11px] font-bold uppercase tracking-wide text-amber-700 dark:text-amber-400 mb-2">FY 2025-26 / 2026-27</span>
          <h3 class="text-[19px] font-bold text-base group-hover:text-accent transition-colors mb-2">Income Tax Hub</h3>
          <p class="text-[13px] text-muted leading-relaxed">New vs Old Regime comparison (₹75k std deduction), HRA exemption calculator, TDS section finder, and 44AD presumptive tax.</p>
          <div class="mt-4 flex items-center gap-1.5 text-[13px] font-semibold text-accent">
            Explore Income Tax <svg class="h-3.5 w-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </div>
        </a>

        <!-- GST Notices Hub -->
        <a href="/gst-notices" class="group relative overflow-hidden rounded-2xl border border-base bg-gradient-to-br from-rose-50 to-pink-50 dark:from-rose-950/30 dark:to-pink-950/30 p-7 hover:border-accent hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 inline-flex items-center justify-center w-12 h-12 rounded-xl bg-rose-100 dark:bg-rose-900/50 text-rose-700 dark:text-rose-400">

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';
import QuickGstCalculator from '../components/QuickGstCalculator.astro';

const title = 'Free GST & Income Tax Tools for India | Taxzentic';
const description = 'Explore free GST and income-tax calculators, GST rate and HSN/SAC lookups, GSTIN validation and practical tax guides for India. Review methods and sources.';

const homeFaqs = [
  {
    question: 'Are Taxzentic tools free to use?',
    answer: 'Yes. Taxzentic provides free GST and income-tax calculators, lookups and guides that you can open directly from the site.',
  },
  {
    question: 'Can I use a calculator result to file a return?',
    answer: 'Treat a calculator result as an estimate based on the details you enter. Review the tool’s method and sources, confirm the rule applies to your facts and tax period, and verify filing details through the official portal or a qualified tax professional.',
  },
  {
    question: 'Where do formulas and tax references come from?',
    answer: 'Relevant tool pages show the calculation method and source references where available. Check the cited official material for the tax period, classification and facts that apply to your case.',
  },
  {
    question: 'What can I find on Taxzentic?',
    answer: 'Explore GST and income-tax calculators, GST rate and HSN/SAC lookups, GSTIN checks, and explainers on common tax tasks. Use the search box or browse the tool catalogue to find a page for your question.',
  },
  {
    question: 'Does the GST calculator choose the correct rate for my product?',
    answer: 'No. The GST calculator applies the rate you select. A rate finder or code lookup can help with research, but confirm the product or service classification and current rate using applicable official schedules and notifications.',
  },
  {
    question: 'Which financial year or tax year does a calculator cover?',
    answer: 'Check the period, assumptions, and last-updated information on the individual tool page. Tax rules can differ by period, so match the calculator to the year and facts involved and confirm them with current official guidance.',
  },
  {
    question: 'Are my details always processed only in my browser?',
    answer: 'Data handling depends on the tool. Some calculations run in your browser, while optional AI features may send the fields you submit to a server and AI provider. Read the tool’s privacy note and the Privacy Policy before entering sensitive information.',
  },
  {
    question: 'Do Taxzentic tools submit returns or payments for me?',
    answer: 'No. The calculators and lookups provide estimates or reference information; they do not submit a GST or income-tax return or make a payment on your behalf.',
  },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';

// JSON-LD: WebSite + Organization + visible FAQPage
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Taxzentic',
    url: siteUrl,
    description: 'Free GST and income-tax calculators, rate and code lookups, and practical tax guides for India.',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/hsn-code-lookup?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Taxzentic',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/taxzentic-logo.png`,
    },
    description: 'Tax calculators, reference tools, and educational content for Indian taxpayers and businesses.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];

const tools = [
  { href: '/income-tax-calculator', icon: 'dollar', title: 'New vs Old Regime Calculator', description: 'Compare estimated tax under the available new and old regime inputs. Confirm current year rules, deductions, and eligibility before filing.', badge: 'Most Popular' },
  { href: '/gst-notice-reply-generator', icon: 'file', title: 'AI GST Notice Reply Generator', description: 'Create a starting draft from the notice details you enter. Verify every fact and legal reference, and have a qualified professional review it before use.', badge: 'AI Powered' },
  { href: '/gst-health-score', icon: 'scale', title: 'GST Health Score Quiz', description: 'Answer a short set of GST compliance questions and review general areas that may need closer attention.', badge: 'Trending' },
  { href: '/bulk-gstin-validator', icon: 'check', title: 'Bulk GSTIN Validator', description: 'Validate up to 50 GST numbers at once offline. Verifies format, Luhn checksum, decodes state names, and exports results to CSV.', badge: 'Pro Tool' },
  { href: '/income-tax-tools', icon: 'calculator', title: 'Income Tax Tools Hub', description: 'Complete direct tax suite: New vs Old Regime, HRA exemption calculator, TDS section finder, Section 44AD presumptive tax, and advance tax.', badge: 'New Hub' },
  { href: '/restaurant-gst-calculator', icon: 'store', title: 'Restaurant GST Calculator', description: 'Estimate tax for restaurant and hospitality scenarios using the assumptions shown in the tool. Verify the rate and input tax credit treatment for your case.', badge: 'New' },
  { href: '/real-estate-gst-calculator', icon: 'home', title: 'Real Estate GST Calculator', description: 'Explore an estimated GST calculation for property scenarios. Confirm project classification, dates, and applicable notifications before relying on a result.', badge: 'New' },
  { href: '/freelancer-invoice-generator', icon: 'receipt', title: 'Freelancer Invoice Generator', description: 'Specialized for developers and designers. Supports USD/EUR currencies, 0% zero-rated export under LUT, and SAC 9983.', badge: 'New' },
  { href: '/gstr-mismatch-checker', icon: 'traffic', title: 'GSTR Mismatch Checker', description: 'Compare selected return and ITC figures to identify differences for further review. A difference alone does not determine notice risk or liability.', badge: 'New' },
  { href: '/gst-refund-calculator', icon: 'refresh', title: 'GST Refund Calculator', description: 'Estimate a refund using the scenario and formula described in the tool. Verify eligibility, current rules, and supporting figures against official sources.', badge: 'New' },
  { href: '/e-invoice-eligibility-checker', icon: 'building', title: 'E-Invoice Eligibility Checker', description: 'Review common e-invoice applicability inputs and exceptions. Confirm the current threshold and notified exclusions for your business.', badge: 'New' },
  { href: '/tds-section-finder', icon: 'search', title: 'TDS Section & Rate Finder', description: 'Searchable directory of 194C, 194J, 194I, 194H, 194Q with interactive deduction calculator and non-PAN penal rates.', badge: 'New' },
  { href: '/section-44ad-calculator', icon: 'chart', title: 'Section 44AD Presumptive Tax', description: 'Estimate presumptive income using the amounts and rates entered. Confirm current eligibility, limits, and exclusions before filing.', badge: 'New' },
  { href: '/gst-amnesty-tracker', icon: 'hourglass', title: 'Section 128A Amnesty Tracker', description: 'Review information about the statutory waiver scheme and its conditions. Confirm current deadlines and eligibility from official sources.', badge: 'New' },
  { href: '/saas-export-lut-calculator', icon: 'box', title: 'SaaS & Export LUT Calculator', description: 'Evaluate the 5 statutory tests under Section 2(6) of IGST Act for Export of Services and track annual LUT renewals.', badge: 'New' },
  { href: '/hra-exemption-calculator', icon: 'dollar', title: 'HRA Exemption Calculator', description: 'Calculate exact tax-free House Rent Allowance under Section 10(13A) Rule 2A across Metro (50%) and Non-Metro (40%) cities.', badge: 'New' },
  { href: '/ecommerce-seller-toolkit', icon: 'chart-pie', title: 'E-commerce Seller Toolkit', description: 'Calculate net payout for Amazon/Flipkart sellers. Deducts commission, shipping, GST on fees, and 1% TCS.', badge: null },
  { href: '/msme-registration-checker', icon: 'building-office', title: 'MSME/Udyam Checker', description: 'Check your business eligibility for MSME registration (Micro, Small, Medium) based on revised investment and turnover limits.', badge: null },
  { href: '/gst-rate-finder', icon: 'search', title: 'GST Rate Finder', description: 'Find the GST rate for any product by name. Just type "laptop", "cement", or "gold" — no HSN code needed.', badge: null },
  { href: '/credit-debit-note-generator', icon: 'file', title: 'Credit/Debit Note', description: 'Generate GST-compliant credit notes and debit notes. Auto-calculates CGST/SGST/IGST adjustments.', badge: null },
  { href: '/msme-delayed-payment-calculator', icon: 'dollar', title: 'MSME Payment Interest', description: 'Calculate compound interest on delayed payments to MSMEs under Section 16 of the MSMED Act.', badge: null },
  { href: '/qrmp-eligibility-checker', icon: 'check', title: 'QRMP Eligibility', description: 'Check if your business qualifies for quarterly GST return filing under the QRMP scheme.', badge: null },
  { href: '/gst-notice-deadline-calculator', icon: 'hourglass', title: 'Notice Reply Deadline', description: 'Calculate the exact deadline to file your reply for ASMT-10, DRC-01, Section 73, and Section 74 notices.', badge: null },
  { href: '/gst-margin-scheme-calculator', icon: 'refresh', title: 'Margin Scheme (Second Hand)', description: 'Calculate your tax savings on second-hand goods. Pay GST only on your profit margin, not the full sale value.', badge: null },
  { href: '/gst-on-rent-calculator', icon: 'home', title: 'GST on Rent', description: 'Instantly check GST applicability, Reverse Charge Mechanism (RCM) rules, and tax liability for commercial or residential rent.', badge: null },
  { href: '/gst-on-freight-calculator', icon: 'truck', title: 'GST on Freight', description: 'Determine GST liability, RCM applicability, and ITC eligibility for transport of goods (GTA vs Courier) in India.', badge: null },
  { href: '/aggregate-turnover-calculator', icon: 'chart', title: 'Aggregate Turnover', description: 'Calculate your exact GST turnover. Instantly check if you cross the ₹20L/₹40L mandatory registration limit or Composition Scheme thresholds.', badge: null },
  { href: '/gst-rate-comparison', icon: 'scale', title: 'Rate Comparison', description: 'Compare old GST slabs vs new GST 2.0 rates. Calculate the exact ₹ price impact for your end consumers.', badge: null },
  { href: '/mrp-revision-calculator/', icon: 'tag', title: 'MRP Revision Calculator', description: 'Reverse calculate your base price and generate a new MRP after a GST rate change to preserve your margins exactly.', badge: null },
  { href: '/itc-reversal-checker', icon: 'traffic', title: 'ITC Reversal Checker', description: 'A simple yes/no decision tree to determine if a GST rate drop legally requires you to surrender your Input Tax Credit.', badge: null },
  { href: '/gst-calculator', icon: 'calculator', title: 'GST Calculator', description: 'Add or remove GST instantly. Supports 5%, 18%, 40% (GST 2.0) and custom rates. Shows CGST/SGST split.', badge: 'Most Popular' },
  { href: '/hsn-code-lookup', icon: 'search', title: 'HSN / SAC Code Lookup', description: 'Search HSN codes for goods and SAC codes for services. Instant client-side filtering with GST rate display.', badge: null },
  { href: '/gstin-validator', icon: 'check', title: 'GSTIN Validator', description: 'Validate any 15-digit GST number offline. Verifies format, checksum, decodes state name and embedded PAN.', badge: null },
  { href: '/invoice-generator', icon: 'file', title: 'GST Invoice Generator', description: 'Create perfect tax invoices instantly. Auto-calculates CGST/SGST/IGST. Download as PDF. 100% Free & Offline.', badge: 'Most Popular' },
  { href: '/eway-bill-limit-checker', icon: 'truck', title: 'E-Way Bill Limit Checker', description: 'Instantly check mandatory E-Way Bill threshold limits (₹50k vs ₹1 Lakh) for inter-state and intra-state goods movement.', badge: 'Trending' },
  { href: '/late-fee-calculator', icon: 'clock', title: 'Late Fee Calculator', description: 'Calculate GST late fees and interest for delayed filing of GSTR-1, GSTR-3B, or GSTR-9. Accurate client-side calculation.', badge: null },
  { href: '/rcm-calculator', icon: 'refresh', title: 'RCM Calculator', description: 'Calculate Reverse Charge Mechanism (RCM) liability instantly.', badge: null },
  { href: '/composition-scheme-calculator', icon: 'store', title: 'Composition Scheme', description: 'Check eligibility and calculate flat composition tax rates.', badge: null },
  { href: '/eway-bill-validity', icon: 'road', title: 'E-Way Bill Validity', description: 'Calculate exactly how many days an E-way bill is valid.', badge: null },
  { href: '/itc-calculator', icon: 'dollar', title: 'ITC Calculator', description: 'Calculate Input Tax Credit set-off and net GST payable.', badge: null },
  { href: '/gst-interest-calculator', icon: 'dollar', title: 'Interest Calculator', description: 'Calculate interest on delayed GST payments at 18% p.a.', badge: null },
  { href: '/tds-gst-calculator', icon: 'scissors', title: 'TDS Calculator', description: 'Calculate 2% TDS under GST for contracts over ₹2.5 Lakhs.', badge: null },
  { href: '/tcs-gst-calculator', icon: 'cart', title: 'TCS Calculator', description: 'Calculate 1% TCS under GST for e-commerce operators and sellers.', badge: null },
  { href: '/gst-penalty-calculator', icon: 'scale', title: 'Penalty Calculator', description: 'Calculate statutory GST penalties for fraud, late payment, and fake invoices.', badge: null },
  { href: '/gst-due-dates', icon: 'calendar', title: 'GST Due Dates Calendar', description: 'Track all important GST return filing due dates. Never miss a deadline and avoid late fees and penalties.', badge: null },
  { href: '/gstr-9-annual-return-checklist', icon: 'report', title: 'GSTR-9 Checklist', description: 'Interactive checklist for filing GSTR-9 Annual Return and avoiding notices.', badge: null },
  { href: '/lut-renewal-reminder', icon: 'bell', title: 'LUT Renewal Reminder', description: 'Calculate your exact deadline to renew LUT for zero-rated GST exports.', badge: null },
  { href: '/gst-director-remuneration-calculator', icon: 'tie', title: 'Director RCM Calculator', description: 'Determine GST applicability (18% RCM vs Salary) on director remuneration.', badge: null },
  { href: '/supply-type-classifier', icon: 'box', title: 'Supply Type Classifier', description: 'Classify bundled goods into Composite vs Mixed Supply for accurate tax rates.', badge: null },
  { href: '/multi-gstin-invoice-splitter', icon: 'building', title: 'Multi-GSTIN Splitter', description: 'Allocate values and determine IGST/CGST across multiple state branches.', badge: null },
  { href: '/pin-to-pin-distance-calculator', icon: 'road', title: 'Pin to Pin Distance Calculator', description: 'Check transport distance between source and delivery pincodes for E-way bill generation.', badge: null },
];

const featuredTools = [
  { href: '/gst-calculator/', monogram: 'GST', title: 'GST Calculator', description: 'Add or remove GST and see the breakdown.', detail: 'ADD · REMOVE GST' },
  { href: '/income-tax-calculator/', monogram: 'IT', title: 'Income Tax Calculator', description: 'Compare an estimated tax by regime.', detail: 'TAX ESTIMATE' },
  { href: '/hsn-code-lookup/', monogram: 'HSN', title: 'HSN Code Finder', description: 'Search product and service codes.', detail: 'PRODUCT LOOKUP' },
  { href: '/gst-rate-finder/', monogram: '%', title: 'GST Rate Finder', description: 'Explore common rates by category.', detail: 'RATE LOOKUP' },
];

const homeToolSearchIndex = tools.map(({ href, title, description }) => ({ href, title, description }));
---

<BaseLayout {title} {description} {structuredData}>
  <!-- Figma home hero and live GST estimate -->
  <section class="taxzentic-hero relative overflow-hidden border-b border-base" aria-labelledby="home-title">
    <div class="hero-orb hero-orb-blue" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-teal" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-[1200px] items-center gap-5 px-4 py-7 sm:px-6 lg:grid-cols-[1fr_550px] lg:gap-10 lg:px-0 lg:py-[52px]">
      <div class="min-w-0">
        <p class="inline-flex rounded-full bg-white/80 px-3 py-2 text-[10px] font-bold tracking-[0.08em] text-accent shadow-sm dark:bg-slate-900/80">TAX CLARITY, MADE SIMPLER</p>
        <h1 id="home-title" class="mt-4 max-w-[610px] text-[36px] font-bold leading-[1.05] tracking-[-1.4px] text-[#10264a] dark:text-slate-100 sm:text-[44px] lg:text-[54px] lg:leading-[1.14]">Free GST &amp; tax tools<br />for India</h1>
        <p class="mt-4 max-w-[530px] text-[15px] leading-[22px] text-muted lg:mt-5 lg:text-[18px] lg:leading-[29px]">Explore GST and income-tax calculators, GST rate and HSN/SAC lookups, GSTIN checks, and practical guides for India.</p>
        <div class="relative mt-5 lg:mt-7">
          <label class="flex h-[56px] max-w-[584px] items-center gap-3 rounded-[14px] border border-[#e3eaf3] bg-white px-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <span class="text-[27px] leading-none text-accent" aria-hidden="true">⌕</span>
            <span class="sr-only">Search tax tools and guides</span>
            <input type="search" class="min-w-0 flex-1 bg-transparent text-[14px] text-[#10264a] outline-none placeholder:text-[#8795a8] dark:text-slate-100" placeholder="Search 50+ tax tools and guides" autocomplete="off" aria-controls="home-search-results" aria-expanded="false" data-home-tool-search />
            <button type="button" class="flex h-10 w-11 shrink-0 items-center justify-center rounded-[10px] bg-accent text-[22px] text-white transition-colors hover:bg-blue-700" aria-label="Show matching tools" data-home-search-submit>→</button>
          </label>
          <ul id="home-search-results" class="absolute left-0 right-0 top-[62px] z-20 hidden max-w-[584px] overflow-hidden rounded-xl border border-[#e3eaf3] bg-white p-2 shadow-xl dark:border-slate-700 dark:bg-slate-900" aria-label="Matching tools" data-home-search-results></ul>
        </div>
        <div class="mt-3 flex flex-wrap gap-2 text-[11px] font-medium text-accent">
          <span class="self-center text-muted">Popular:</span>
          <a class="rounded-full bg-white/75 px-2.5 py-1.5 hover:bg-white dark:bg-slate-900/70" href="/gst-calculator/">GST calculator</a>
          <a class="rounded-full bg-white/75 px-2.5 py-1.5 hover:bg-white dark:bg-slate-900/70" href="/hsn-code-lookup/">HSN lookup</a>
          <a class="rounded-full bg-white/75 px-2.5 py-1.5 hover:bg-white dark:bg-slate-900/70" href="/income-tax-calculator/">Income tax</a>
        </div>
        <p class="mt-3 text-[11px] font-medium text-muted">Free to use · See the method and sources</p>
      </div>
      <QuickGstCalculator />
    </div>
  </section>

  <section class="border-b border-[#e3eaf3] bg-white dark:border-slate-700 dark:bg-slate-900" aria-label="How Taxzentic tools are built">
    <div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-2 px-4 py-3 sm:grid-cols-3 sm:px-6 lg:px-0 lg:py-0">
      {[
        { icon: '✓', title: 'Clear formulas', description: 'See how each estimate is worked out.' },
        { icon: '↗', title: 'Official references', description: 'Follow links to primary sources.' },
        { icon: '₹', title: 'Made for India', description: 'Built around Indian tax questions.' },
      ].map((item) => (
        <div class="flex min-h-[46px] items-center gap-3 py-1.5 sm:min-h-[102px] lg:py-0">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#eaf8f3] text-[17px] font-bold text-[#0f9f8c]" aria-hidden="true">{item.icon}</span>
          <span>
            <span class="block text-[13px] font-semibold text-[#10264a] dark:text-slate-100">{item.title}</span>
            <span class="mt-0.5 block text-[11px] leading-[16px] text-muted">{item.description}</span>
          </span>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 py-8 sm:px-6 lg:px-0 lg:py-10" aria-labelledby="tools-heading">
    <div class="mb-5 flex items-end justify-between gap-4 lg:mb-6">
      <div>
        <h2 id="tools-heading" class="text-[24px] font-bold tracking-[-0.7px] text-[#10264a] dark:text-slate-100 lg:text-[27px]">Popular tools</h2>
        <p class="mt-1 text-[13px] text-muted">Everyday starting points, all in one place.</p>
      </div>
      <a href="#all-tools" class="hidden shrink-0 text-[12px] font-semibold text-accent hover:underline sm:inline-flex" data-open-tool-catalog>Browse all tools →</a>
    </div>
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
      {featuredTools.map((tool) => (
        <a href={tool.href} class="group flex min-h-[190px] flex-col rounded-[14px] border border-[#e3eaf3] bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-[#c6dcff] hover:shadow-[0_12px_24px_rgba(10,41,87,0.08)] dark:border-slate-700 dark:bg-slate-900 dark:hover:border-blue-800 lg:p-5">
          <span class="flex h-8 min-w-9 items-center justify-center self-start rounded-lg bg-[#eef4ff] px-2 text-[10px] font-bold text-accent">{tool.monogram}</span>
          <h3 class="mt-4 text-[15px] font-semibold leading-[20px] tracking-[-0.2px] text-[#10264a] group-hover:text-accent dark:text-slate-100">{tool.title}</h3>
          <p class="mt-1.5 text-[11px] leading-[16px] text-muted">{tool.description}</p>
          <span class="mt-auto flex items-center justify-between pt-4 text-[9px] font-bold tracking-[0.06em] text-[#0f9f8c]">{tool.detail}<span class="text-[16px] text-accent" aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>

    <details id="all-tools" class="mt-5 rounded-2xl border border-[#e3eaf3] bg-white dark:border-slate-700 dark:bg-slate-900" data-tool-catalog>
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 rounded-2xl px-5 py-4 text-[14px] font-semibold text-[#10264a] hover:bg-subtle dark:text-slate-100">
        <span>Browse all 50+ tax tools and calculators</span>
        <svg class="h-4 w-4 shrink-0 text-muted transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
      </summary>
      <div class="border-t border-[#e3eaf3] p-4 dark:border-slate-700 sm:p-5">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
          {tools.map((tool) => (
            <a href={tool.href} class="tool-card group relative flex flex-col rounded-2xl border border-base bg-surface p-6 transition-all duration-300 hover:-translate-y-1.5 hover:border-accent/40 hover:shadow-xl">
              {tool.badge && <span class="absolute right-5 top-5 rounded-full border border-accent/15 bg-accent/8 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-accent">{tool.badge}</span>}
              <div class="relative mb-5"><div class="tool-icon-wrap"><ToolIcon name={tool.icon} size={44} /></div></div>
              <h3 class="relative mb-2 text-[18px] font-bold tracking-[-0.4px] text-base group-hover:text-accent">{tool.title}</h3>
              <p class="relative flex-1 text-[13px] leading-relaxed text-muted">{tool.description}</p>
              <span class="relative mt-5 text-[13px] font-semibold text-accent">Open tool →</span>
            </a>
          ))}
        </div>
      </div>
    </details>
  </section>

  <section class="border-y border-base bg-[#f7f9fc] dark:bg-slate-950" aria-labelledby="next-step-heading">
    <div class="mx-auto max-w-[1200px] px-4 py-8 sm:px-6 lg:px-0 lg:py-10">
      <h2 id="next-step-heading" class="text-[24px] font-bold tracking-[-0.6px] text-[#10264a] dark:text-slate-100 lg:text-[27px]">Explore tax tools by task</h2>
      <p class="mt-1 max-w-[760px] text-[13px] leading-[20px] text-muted">Start with the question you need to answer: estimate GST, look up a rate or code, check a GSTIN, compare income-tax options, or read a practical guide. The right result depends on the period and details you enter.</p>
      <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3 lg:gap-4">
        {[
          { number: '01', title: 'Calculate GST', description: 'Add GST to a base amount or remove it from an inclusive price, then review the tax split using your selected rate.', label: 'Open GST calculator', href: '/gst-calculator/' },
          { number: '02', title: 'Find rates and HSN/SAC codes', description: 'Search rate and product or service code references. Confirm classification and current treatment with the applicable official source.', label: 'Search rates and codes', href: '/gst-rate-finder/' },
          { number: '03', title: 'Check a GSTIN', description: 'Review a GSTIN’s structure and checksum as a first step; confirm live registration status through the official GST portal.', label: 'Open GSTIN validator', href: '/gstin-validator/' },
          { number: '04', title: 'Explore income-tax tools', description: 'Compare regime estimates, review HRA inputs, find TDS sections, and explore advance-tax calculations for the period shown.', label: 'Browse income-tax tools', href: '/income-tax-tools/' },
          { number: '05', title: 'Explore GST notice tools', description: 'Find tools for organizing notice details, reviewing selected return mismatches, and preparing a draft outline. Confirm deadlines and filing steps against the notice and official guidance.', label: 'Browse notice tools', href: '/gst-notices/' },
          { number: '06', title: 'Read practical tax guides', description: 'Explore explainers on GST rates, returns, identifiers, and common business tax questions, with period and source context.', label: 'Browse tax guides', href: '/blog/' },
        ].map((item) => (

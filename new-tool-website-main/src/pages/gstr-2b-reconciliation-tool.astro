---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalSources from '../components/LegalSources.astro';
import CalculatorMethodology from '../components/CalculatorMethodology.astro';
import TaxDisclaimer from '../components/TaxDisclaimer.astro';

const title = 'GSTR-2B Reconciliation Tool — Free Excel';
const description = 'Download a free CSV layout for manually comparing purchase register invoices with GSTR-2B. Includes sample rows and fields to review; matching is not automated.';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'DigitalDocument',
    name: 'GSTR 2B Reconciliation Tool',
    url: Astro.site?.toString() ? `${Astro.site}gstr-2b-reconciliation-tool` : 'https://example.com/gstr-2b-reconciliation-tool',
    description: 'Downloadable CSV layout with example invoice rows for manual comparison with GSTR-2B.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: "What is GSTR-2B reconciliation in 2026?", acceptedAnswer: { '@type': 'Answer', text: "GSTR-2B reconciliation involves matching your purchase register (books) against the auto-drafted GSTR-2B statement from the GST portal to claim accurate Input Tax Credit (ITC)." } },
      { '@type': 'Question', name: "What does this download do?", acceptedAnswer: { '@type': 'Answer', text: "It provides a sample CSV layout with invoice fields and example rows. It does not import GSTR-2B or automatically match invoices." } },
      { '@type': 'Question', name: "How should I compare invoices?", acceptedAnswer: { '@type': 'Answer', text: "Open your purchase register and official GSTR-2B export in spreadsheet software. Compare supplier GSTIN, invoice number, date and tax amounts, then review any differences manually." } },
      { '@type': 'Question', name: "What if an invoice is missing from GSTR-2B?", acceptedAnswer: { '@type': 'Answer', text: "Check the supplier filing status and applicable ITC conditions for the period. Follow up with the supplier and consult current official guidance before claiming credit." } },
      { '@type': 'Question', name: "Does the CSV include live GSTR-2B data?", acceptedAnswer: { '@type': 'Answer', text: "No. The CSV contains illustrative rows only. Download your actual GSTR-2B statement from the official GST portal." } },
      { '@type': 'Question', name: "Can the template process large datasets?", acceptedAnswer: { '@type': 'Answer', text: "The file is a CSV layout. Any sorting, formulas or matching must be done in your spreadsheet software, whose limits depend on the program and device." } },
      { '@type': 'Question', name: "Is the CSV free to download?", acceptedAnswer: { '@type': 'Answer', text: "Yes. You can download the sample CSV without an account or payment." } },
      { '@type': 'Question', name: "Does the download generate a mismatch report?", acceptedAnswer: { '@type': 'Answer', text: "No. It does not generate a report. Use your spreadsheet software to compare your records, document differences and follow up with suppliers." } },
      {
        '@type': 'Question',
        name: 'Is there a GSTR 2B reconciliation tool in excel format free download?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'You can download a CSV sample that opens in Excel or similar software. It is a layout for manual comparison, not an Excel workbook with formulas or macros.',
        }
      },
      {
        '@type': 'Question',
        name: 'Why is GSTR-2B reconciliation necessary?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Comparing your purchase register with GSTR-2B helps identify invoices and tax amounts that need review before filing. ITC entitlement and any interest depend on the applicable law and facts.',
        }
      }
    ]
  }
];

const lastUpdated = '2026-07-25';
const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Lookups \x26 Tools', href: '/#tools-heading' },
  { name: 'GSTR 2b Reconciliation Tool', href: '/gstr-2b-reconciliation-tool' },
];
---

<BaseLayout {title} {description} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-12 lg:py-24">
    <!-- Header -->
    <div class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-base bg-surface px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-muted mb-4 shadow-[0_1px_1px_#00000005]">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        Free CSV sample for manual review
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-base mb-4">
        GSTR 2B Reconciliation Tool
      </h1>
      <p class="text-[16px] text-muted max-w-2xl mx-auto leading-relaxed">
        Download a sample invoice layout, then compare your own purchase register with your official GSTR-2B export in spreadsheet software.
      </p>
    </div>

    <!-- Main Tool Container -->
    <div class="rounded-[12px] border border-base bg-surface p-6 sm:p-10 shadow-[0_8px_30px_rgb(0,0,0,0.04)] mb-12 text-center">
      
      <div class="bg-subtle border border-base rounded-xl p-8 max-w-2xl mx-auto">
        <svg class="h-16 w-16 mx-auto text-accent mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h2 class="text-2xl font-bold text-base mb-2">Download Free Excel Template</h2>
        <p class="text-[15px] text-muted mb-6">
          This CSV contains column headings and illustrative rows. It has no macros, formulas, or automatic matching. Replace the examples with your own records and use your spreadsheet software to review differences.
        </p>

        <a
          href="/GSTR2B_Reconciliation_Template_2026.csv"
          download="GSTR2B_Reconciliation_Template_2026.csv"
          id="download-btn"
          class="inline-flex items-center justify-center gap-2 rounded-[8px] bg-accent px-8 py-4 text-[16px] font-semibold text-white hover:opacity-90 transition-opacity"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download CSV Template (.csv)
        </a>
        
        <p class="text-xs text-muted mt-4">CSV sample only · opens in common spreadsheet apps</p>
      </div>

    </div>

    <!-- SEO Content -->
    <article class="prose prose-neutral dark:prose-invert max-w-none text-[15px] leading-relaxed">
      <h2 class="text-3xl font-bold mb-6">How to compare purchase records with GSTR-2B</h2>
      
      <p>
        GSTR-2B is a reference for reviewing input tax credit against supplier-reported invoices. Compare it with your purchase register to spot missing invoices, incorrect GSTINs, and differences in tax amounts. A match alone does not establish ITC eligibility; check the statutory conditions for your period and facts.
      </p>

      <p>
        This download is a starting layout for manual review. It does not connect to the GST portal, read your exports, or reconcile records automatically. For a large invoice set, use a spreadsheet or a dedicated reconciliation system that supports your actual file formats.
      </p>

      <h3 class="text-2xl font-semibold mt-8 mb-4">GSTR-2A vs GSTR-2B: Understanding the Difference</h3>

      <p>
        To grasp the importance of reconciliation, one must understand the difference between GSTR-2A and GSTR-2B. 
      </p>

      <p>
        <strong>GSTR-2A</strong> is a dynamic statement. If a supplier files their January return in July, the invoice will appear in your January GSTR-2A. It constantly changes based on supplier actions. Because of this dynamic nature, claiming ITC based on GSTR-2A became a logistical nightmare for businesses and tax auditors alike.
      </p>

      <p>
        <strong>GSTR-2B</strong> is a static statement for a tax period. Supplier reporting dates can affect when an invoice appears. Check the statement for the relevant period and verify the current ITC rules before making a claim.
      </p>

      <h3 class="text-2xl font-semibold mt-8 mb-4">The Dangers of Mismatched ITC</h3>

      <p>
        Unreviewed differences can lead to incorrect return figures. Investigate them before filing rather than assuming every book entry is eligible credit.
      </p>

      <ul class="list-disc pl-6 space-y-3 mt-4">
        <li><strong>Book entry missing from GSTR-2B:</strong> Check the supplier, invoice details and relevant filing period. Determine the appropriate treatment under current rules before claiming credit.</li>
        <li><strong>GSTR-2B entry missing from books:</strong> Confirm the invoice belongs to your business and that the underlying supply meets the applicable ITC conditions before recording it.</li>
      </ul>

      <h3 class="text-2xl font-semibold mt-8 mb-4">How to Use the Free CSV Reconciliation Tool</h3>

      <p>
        The downloadable CSV shows useful columns for a comparison sheet. It is an example file, so remove its illustrative rows before entering actual data. Your comparison work takes place in the spreadsheet program you choose.
      </p>

      <ol class="list-decimal pl-6 space-y-3 mt-4">
        <li><strong>Download the Template:</strong> Click the download button above to get the standard CSV template.</li>
        <li><strong>Export Your Books:</strong> Export your monthly purchase register from your accounting software. Ensure you have the GSTIN of the supplier, Invoice Number, Invoice Date, Taxable Value, and Tax Amounts.</li>
        <li><strong>Download GSTR-2B:</strong> Log into the official GST Portal. Navigate to Returns Dashboard -> Select Financial Year and Month -> Download GSTR-2B. (We recommend downloading the Excel/CSV version).</li>
        <li><strong>Compare and document:</strong> Use your spreadsheet software to compare supplier GSTIN, invoice number, date and tax amounts. Document any difference and verify the source records before deciding what to file.</li>
      </ol>

      <h3 class="text-2xl font-semibold mt-8 mb-4">Handling Mismatches: The 3 Action Buckets</h3>

      <p>During a manual comparison, you may find these common situations:</p>

      <p><strong>1. Matching details:</strong> The invoice appears in both sources with consistent figures. Actual ITC entitlement remains subject to the applicable statutory conditions and documentation requirements.</p>

      <p><strong>2. Missing in GSTR-2B:</strong> An invoice in your books is absent from the statement. Check its period, supplier reporting and current ITC conditions; follow up with the supplier as needed.</p>

      <p><strong>3. Value mismatch:</strong> Both sources show the invoice but the amounts differ. Review the original invoice, amendments and credit notes, then verify the correct treatment for your return.</p>

      <p class="text-sm text-muted mt-4">
        <em>Template scope:</em> The CSV is illustrative and performs no calculation or matching. It does not determine legal ITC eligibility, whether interest is payable, or whether a notice will be issued.
      </p>

      <div class="mt-8 rounded-[12px] bg-subtle border border-base p-6 text-[15px] text-muted">
        <h4 class="text-lg font-semibold text-base mb-2">Next Steps in Your ITC Workflow</h4>
        <p>
          After reviewing your invoice differences, explore our <a href="/itc-calculator/" class="text-accent hover:underline font-medium">ITC calculator</a> and <a href="/itc-reversal-checker/" class="text-accent hover:underline font-medium">ITC reversal checker</a>. Verify any filing decision against current official guidance.
        </p>
      </div>

      <!-- Methodology & Legal Sources -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 not-prose">
        <CalculatorMethodology
          calculates="Nothing automatically. The download provides example columns for a manual invoice comparison."
          doesNotDetermine="Statutory eligibility to claim ITC under Section 16, payment of tax to the government under Section 16(2)(c), or blocked credits under Section 17(5)."
          inputs="Your own purchase register and official GSTR-2B export, reviewed in your spreadsheet software"
          formula="No formula is included in the CSV sample"
          applicablePeriod="FY 2025-26 &amp; FY 2026-27"
          primarySource="Section 16(2)(aa) of CGST Act, 2017 &amp; Rule 36(4) of CGST Rules, 2017"
          formulaLastReviewed="19 September 2026"
        />

        <LegalSources
          sources={[
            { title: "Section 16(2)(aa), CGST Act, 2017", description: "statutory condition that ITC is available only if invoice details are communicated in GSTR-2B" },
            { title: "Rule 36(4), CGST Rules, 2017", description: "restriction on availment of ITC for invoices not uploaded by suppliers" },
            { title: "CBIC Circular No. 170/02/2022-GST", url: "https://www.cbic.gov.in", description: "mandatory reporting of ITC availment, reversal, and ineligible ITC in GSTR-3B" },
            { title: "Section 16(4), CGST Act, 2017", description: "statutory time limit for availing input tax credit" }
          ]}
          reviewedDate="19 September 2026"
        />
      </div>

      <div class="mt-6 not-prose">
        <TaxDisclaimer />
      </div>
    </article>

    <!-- FAQ Section -->
    <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-20 mt-16 pt-12 border-t border-base" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-base mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {structuredData[1].mainEntity.map((faq, i) => (
          <details class="group rounded-xl border border-base bg-surface overflow-hidden" id={`faq-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
              <span>{faq.name}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-[15px] text-muted leading-relaxed border-t border-base pt-4">{faq.acceptedAnswer.text}</div>
          </details>
        ))}
      </div>
    </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'GSTR-1 JSON to Excel Converter — Free';
const description = 'Convert GSTR 1 JSON files into Excel format quickly. Free tool to parse and view B2B, B2C, EXP, and CDNR invoice details in an Excel spreadsheet.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/gstr1-json-to-excel`;

const faqs = [
  { q: "How do I convert GSTR-1 JSON to Excel offline?", a: "Simply drag and drop your GSTR-1 JSON file downloaded from the GST portal or generated by your ERP into our tool. It will instantly convert it to a structured Excel (.xlsx) file completely offline within your browser." },
  { q: "Is it safe to convert GSTR-1 JSON online?", a: "With our tool, yes. The conversion from GSTR-1 JSON to Excel happens entirely within your web browser using local JavaScript memory. Your confidential financial data is never uploaded to any remote server." },
  { q: "Why should I convert GSTR-1 JSON to Excel?", a: "Converting GSTR-1 JSON to Excel allows finance teams and tax auditors to easily read, filter, pivot, and reconcile outward tax liabilities and invoice-level GSTIN details before monthly filing." },
  { q: "Which GSTR-1 return tables does the converter export into sheets?", a: "The generated Excel workbook includes dedicated worksheets for B2B (large & small registered), B2CL (large consumer supplies), B2CS (small consumer supplies), CDNR (credit/debit notes for registered recipients), HSN (item summaries), EXP (export supplies), and NIL (nil-rated, exempted & non-GST supplies)." },
  { q: "Can this tool handle large GSTR-1 JSON files?", a: "Yes. Because data parsing executes client-side using SheetJS in browser memory, it processes large JSON files with thousands of line items rapidly without cloud bandwidth or upload bottlenecks." },
  { q: "Which GST return schemas and versions are supported?", a: "The converter supports standard GSTN return structures including B2B, B2CL, B2CS, CDNR, HSN, EXP, and NIL sections tested against official GST offline utility payloads." },
  { q: "Do I need Microsoft Excel installed to use this tool?", a: "No. You do not need Excel installed to convert the file. Once downloaded, the standard .xlsx file can be opened in Microsoft Excel, Google Sheets, Apple Numbers, or LibreOffice Calc." },
  { q: "Can I edit the GSTR-1 data after converting to Excel?", a: "Yes, you can edit the downloaded Excel workbook for internal review and reconciliation. To upload amendments to the GST portal, use the official GST Offline Utility to generate an updated JSON payload." },
  { q: "Are there any file size limits?", a: "There are no server-imposed file size limits since no upload occurs. Your local browser and system RAM determine capacity; typical files up to 50MB with tens of thousands of invoices process seamlessly." },
  { q: "Is the GSTR-1 JSON to Excel tool free?", a: "Yes. It is completely free, runs locally in your browser, and requires no account creation, license keys, or API subscriptions." }
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'GSTR 1 JSON to Excel',
    url: `${Astro.site?.toString() ?? 'https://taxzentic.com'}/gstr1-json-to-excel`,
    description: 'Easily convert GSTR 1 JSON files downloaded from GST portal to Excel sheets.',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a
      }
    }))
  }
];

const lastUpdated = '2026-09-16';
const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'Lookups & Tools', href: '/#tools-heading' },
  { name: 'GSTR-1 JSON to Excel', href: '/gstr1-json-to-excel' },
];
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-12">
    <div class="text-center mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-base mb-3">GSTR-1 JSON to Excel Converter</h1>
      <p class="text-muted text-lg max-w-2xl mx-auto">
        Convert your complicated GSTR-1 JSON files directly into readable Excel spreadsheets. 100% Free and works completely inside your browser. No data is uploaded to our servers.
      </p>
    </div>

    <div class="bg-surface border border-base rounded-2xl p-8 shadow-sm">
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-base mb-2">Upload GSTR-1 JSON File</label>
          <input 
            type="file" 
            id="jsonFileInput" 
            accept="application/json"
            class="block w-full text-sm text-muted file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-accent file:text-white hover:file:bg-accent/90"
          />
        </div>
        <div>
          <button id="convertBtn" class="w-full bg-accent hover:bg-accent/90 text-white font-semibold py-3 px-4 rounded-xl transition-colors">
            Convert to Excel
          </button>
        </div>
        <div id="output" class="hidden text-sm text-center p-4 bg-green-50 text-green-700 rounded-lg border border-green-200">
          Success! Your Excel file has been generated and should download automatically.
        </div>
        <div id="error" class="hidden text-sm text-center p-4 bg-red-50 text-red-700 rounded-lg border border-red-200">
          Error parsing JSON. Please ensure it is a valid GSTR-1 JSON file.
        </div>
      </div>
    </div>
    
    <!-- Educational & Workflow Guide -->
    <div class="mt-16 prose prose-slate dark:prose-invert max-w-none text-muted">
      <h2 class="text-2xl font-bold text-base mb-4">Complete Guide: How to Convert GSTR-1 JSON to Excel Without Uploading</h2>
      <p>
        The Goods and Services Tax Network (GSTN) generates return backup files and ERP exports exclusively in JSON format. While JSON is ideal for automated server communication, human reviewers, tax auditors, and accounting teams cannot easily inspect invoice line items, tax heads, or customer GSTINs in raw JSON code.
      </p>
      <p>
        Our <strong>GSTR-1 JSON to Excel Converter</strong> solves this problem by parsing all nested JSON return arrays directly inside your web browser and compiling them into structured, multi-sheet Excel (.xlsx) workbooks matching the official GST portal return tables.
      </p>

      <h3 class="text-xl font-semibold text-base mt-8 mb-3">Step-by-Step: How to Download &amp; Convert GSTR-1 JSON</h3>
      <ol class="list-decimal pl-6 space-y-2">
        <li><strong>Log in to the GST Portal:</strong> Navigate to <a href="https://www.gst.gov.in" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">gst.gov.in</a> &gt; <em>Services</em> &gt; <em>Returns</em> &gt; <em>Returns Dashboard</em>.</li>
        <li><strong>Select Financial Year and Return Period:</strong> Choose the applicable quarter/month and open <strong>GSTR-1</strong>.</li>
        <li><strong>Download JSON:</strong> Under the <em>Download</em> tab, click <em>Generate JSON File to Download</em>. When ready, click the generated link to save the <code>.json</code> file to your computer.</li>
        <li><strong>Upload to Taxzentic:</strong> Select or drag-and-drop the downloaded JSON file into the converter box above.</li>
        <li><strong>Instant Excel Download:</strong> Click <em>Convert to Excel</em>. Your structured <code>.xlsx</code> workbook downloads immediately with separate sheets for B2B, B2CL, B2CS, CDNR, EXP, and HSN summary.</li>
      </ol>

      <h3 class="text-xl font-semibold text-base mt-8 mb-3">100% Client-Side Privacy Guarantee</h3>
      <p>
        Invoice numbers, buyer GSTINs, and commercial transaction totals contain strictly confidential financial data. Unlike cloud converters that upload your financial files to third-party servers, Taxzentic processes your GSTR-1 file <strong>entirely inside your local browser runtime</strong> using the JavaScript <code>FileReader</code> API and SheetJS library. <strong>Zero bytes of invoice data leave your computer.</strong>
      </p>

      <!-- Contextual Toolkit Links -->
      <div class="mt-10 rounded-2xl border border-base bg-surface p-6 not-prose">
        <h3 class="text-lg font-bold text-base mb-3 flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-accent"></span>
          Related GSTR Data Tools &amp; Return Resources
        </h3>
        <div class="grid sm:grid-cols-2 gap-3">
          <a href="/gstr1-json-validator/" class="p-3.5 rounded-xl border border-base bg-subtle hover:border-accent hover:shadow-sm transition-all group block">
            <span class="font-semibold text-base group-hover:text-accent block">GSTR-1 JSON Validator →</span>
            <span class="text-xs text-muted mt-0.5 block">Validate JSON schema, check missing mandatory fields, and verify GSTIN structures before filing.</span>
          </a>
          <a href="/gst-error-report/" class="p-3.5 rounded-xl border border-base bg-subtle hover:border-accent hover:shadow-sm transition-all group block">
            <span class="font-semibold text-base group-hover:text-accent block">GST Error Report Decoder →</span>
            <span class="text-xs text-muted mt-0.5 block">Decode GST portal JSON error files with plain-English explanations and fix instructions.</span>
          </a>
          <a href="/gstr-2b-reconciliation-tool/" class="p-3.5 rounded-xl border border-base bg-subtle hover:border-accent hover:shadow-sm transition-all group block">
            <span class="font-semibold text-base group-hover:text-accent block">GSTR-2B Reconciliation Tool →</span>
            <span class="text-xs text-muted mt-0.5 block">Reconcile purchase register books with GSTR-2B ITC download to eliminate missing claims.</span>
          </a>
          <a href="/gst-due-dates/" class="p-3.5 rounded-xl border border-base bg-subtle hover:border-accent hover:shadow-sm transition-all group block">
            <span class="font-semibold text-base group-hover:text-accent block">GST Return Due Dates Calendar →</span>
            <span class="text-xs text-muted mt-0.5 block">Statutory monthly and quarterly deadlines for GSTR-1, GSTR-3B, CMP-08, and QRMP.</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script is:inline>
    document.getElementById('convertBtn').addEventListener('click', () => {
      const fileInput = document.getElementById('jsonFileInput');
      const output = document.getElementById('output');
      const errorMsg = document.getElementById('error');
      
      output.classList.add('hidden');
      errorMsg.classList.add('hidden');

      if (!fileInput.files.length) {
        alert('Please select a JSON file first.');
        return;
      }

      const file = fileInput.files[0];
      const reader = new FileReader();

      reader.onload = (e) => {
        try {
          const data = JSON.parse(e.target.result);
          const wb = XLSX.utils.book_new();

          // 1. Helper parsing functions for each standard GSTR-1 table
          function parseB2B(data) {
            const rows = [];
            if (!data.b2b || !Array.isArray(data.b2b)) return rows;
            data.b2b.forEach(supplier => {
              const ctin = supplier.ctin || '';
              const cfs = supplier.cfs || '';
              (supplier.inv || []).forEach(inv => {
                const inum = inv.inum || '';
                const idt = inv.idt || '';
                const val = Number(inv.val) || 0;
                const pos = inv.pos || '';
                const rchrg = inv.rchrg || 'N';
                const inv_typ = inv.inv_typ || 'R';
                const etin = inv.etin || '';

                if (Array.isArray(inv.itms) && inv.itms.length > 0) {
                  inv.itms.forEach(itm => {
                    const d = itm.itm_det || itm;
                    rows.push({
                      'GSTIN/UIN of Recipient': ctin,
                      'Receiver Name': '',
                      'Invoice Number': inum,
                      'Invoice Date': idt,
                      'Invoice Value (₹)': val,
                      'Place of Supply': pos,
                      'Reverse Charge': rchrg,
                      'Applicable % of Tax Rate': '',
                      'Invoice Type': inv_typ,
                      'E-Commerce GSTIN': etin,
                      'Rate (%)': Number(d.rt) || 0,
                      'Taxable Value (₹)': Number(d.txval) || 0,
                      'Integrated Tax (₹)': Number(d.iamt) || 0,
                      'Central Tax (₹)': Number(d.camt) || 0,
                      'State/UT Tax (₹)': Number(d.samt) || 0,
                      'Cess (₹)': Number(d.csamt) || 0
                    });
                  });
                } else {
                  rows.push({
                    'GSTIN/UIN of Recipient': ctin,
                    'Receiver Name': '',
                    'Invoice Number': inum,
                    'Invoice Date': idt,
                    'Invoice Value (₹)': val,
                    'Place of Supply': pos,
                    'Reverse Charge': rchrg,
                    'Applicable % of Tax Rate': '',
                    'Invoice Type': inv_typ,
                    'E-Commerce GSTIN': etin,
                    'Rate (%)': 0,
                    'Taxable Value (₹)': 0,
                    'Integrated Tax (₹)': 0,
                    'Central Tax (₹)': 0,
                    'State/UT Tax (₹)': 0,
                    'Cess (₹)': 0
                  });
                }
              });
            });
            return rows;
          }

          function parseB2CL(data) {
            const rows = [];
            if (!data.b2cl || !Array.isArray(data.b2cl)) return rows;
            data.b2cl.forEach(group => {
              const pos = group.pos || '';
              (group.inv || []).forEach(inv => {
                const inum = inv.inum || '';
                const idt = inv.idt || '';
                const val = Number(inv.val) || 0;
                const etin = inv.etin || '';
                (inv.itms || []).forEach(itm => {
                  const d = itm.itm_det || itm;
                  rows.push({
                    'Invoice Number': inum,
                    'Invoice Date': idt,
                    'Invoice Value (₹)': val,
                    'Place of Supply': pos,
                    'Applicable % of Tax Rate': '',
                    'Rate (%)': Number(d.rt) || 0,
                    'Taxable Value (₹)': Number(d.txval) || 0,
                    'Integrated Tax (₹)': Number(d.iamt) || 0,
                    'Cess (₹)': Number(d.csamt) || 0,
                    'E-Commerce GSTIN': etin
                  });
                });
              });
            });
            return rows;
          }

          function parseB2CS(data) {
            const rows = [];
            if (!data.b2cs || !Array.isArray(data.b2cs)) return rows;
            data.b2cs.forEach(item => {
              rows.push({
                'Type': item.sply_ty || item.typ || 'OE',
                'Place of Supply': item.pos || '',
                'Applicable % of Tax Rate': '',
                'Rate (%)': Number(item.rt) || 0,
                'Taxable Value (₹)': Number(item.txval) || 0,
                'Integrated Tax (₹)': Number(item.iamt) || 0,
                'Central Tax (₹)': Number(item.camt) || 0,
                'State/UT Tax (₹)': Number(item.samt) || 0,
                'Cess (₹)': Number(item.csamt) || 0,
                'E-Commerce GSTIN': item.etin || ''
              });
            });
            return rows;
          }

          function parseCDNR(data) {
            const rows = [];
            if (!data.cdnr || !Array.isArray(data.cdnr)) return rows;
            data.cdnr.forEach(supplier => {
              const ctin = supplier.ctin || '';
              (supplier.nt || []).forEach(nt => {
                const nt_num = nt.nt_num || '';
                const nt_dt = nt.nt_dt || '';
                const ntty = nt.ntty === 'C' ? 'Credit' : nt.ntty === 'D' ? 'Debit' : (nt.ntty || '');
                const inum = nt.inum || '';
                const idt = nt.idt || '';
                const val = Number(nt.val) || 0;
                const pos = nt.pos || '';
                const rchrg = nt.rchrg || 'N';
                (nt.itms || []).forEach(itm => {
                  const d = itm.itm_det || itm;
                  rows.push({
                    'GSTIN/UIN of Recipient': ctin,
                    'Receiver Name': '',
                    'Note Number': nt_num,
                    'Note Date': nt_dt,
                    'Note Type': ntty,
                    'Place of Supply': pos,
                    'Reverse Charge': rchrg,
                    'Original Invoice No': inum,
                    'Original Invoice Date': idt,
                    'Note Value (₹)': val,
                    'Rate (%)': Number(d.rt) || 0,
                    'Taxable Value (₹)': Number(d.txval) || 0,
                    'Integrated Tax (₹)': Number(d.iamt) || 0,
                    'Central Tax (₹)': Number(d.camt) || 0,
                    'State/UT Tax (₹)': Number(d.samt) || 0,
                    'Cess (₹)': Number(d.csamt) || 0
                  });
                });
              });
            });
            return rows;
          }

          function parseHSN(data) {
            const rows = [];
            const hsnList = Array.isArray(data.hsn) ? data.hsn : (data.hsn?.data && Array.isArray(data.hsn.data) ? data.hsn.data : []);
            hsnList.forEach(item => {
              rows.push({
                'HSN / SAC': item.hsn_sc || '',
                'Description': item.desc || '',
                'UQC': item.uqc || '',
                'Total Quantity': Number(item.qty) || 0,
                'Total Value (₹)': Number(item.val) || 0,
                'Taxable Value (₹)': Number(item.txval) || 0,
                'Integrated Tax (₹)': Number(item.iamt) || 0,
                'Central Tax (₹)': Number(item.camt) || 0,
                'State/UT Tax (₹)': Number(item.samt) || 0,
                'Cess (₹)': Number(item.csamt) || 0
              });
            });
            return rows;
          }

          function parseEXP(data) {
            const rows = [];
            if (!data.exp || !Array.isArray(data.exp)) return rows;
            data.exp.forEach(group => {
              const exp_typ = group.exp_typ || '';
              (group.inv || []).forEach(inv => {
                const inum = inv.inum || '';
                const idt = inv.idt || '';
                const val = Number(inv.val) || 0;
                const sbnum = inv.sbnum || '';
                const sbdt = inv.sbdt || '';
                (inv.itms || []).forEach(itm => {
                  const d = itm.itm_det || itm;
                  rows.push({
                    'Export Type': exp_typ,
                    'Invoice Number': inum,
                    'Invoice Date': idt,
                    'Invoice Value (₹)': val,
                    'Shipping Bill No': sbnum,
                    'Shipping Bill Date': sbdt,
                    'Rate (%)': Number(d.rt) || 0,
                    'Taxable Value (₹)': Number(d.txval) || 0,
                    'Integrated Tax (₹)': Number(d.iamt) || 0,
                    'Cess (₹)': Number(d.csamt) || 0
                  });
                });
              });
            });
            return rows;
          }

          function parseNIL(data) {
            const rows = [];
            if (!data.nil?.inv || !Array.isArray(data.nil.inv)) return rows;
            data.nil.inv.forEach(item => {
              rows.push({
                'Supply Description': item.sply_ty || '',
                'Nil Rated Supplies (₹)': Number(item.nil_amt) || 0,
                'Exempted Supplies (₹)': Number(item.expt_amt) || 0,
                'Non-GST Supplies (₹)': Number(item.ngsup_amt) || 0
              });
            });
            return rows;
          }

          // 2. Extract and append sheets
          const b2bRows = parseB2B(data);
          const b2clRows = parseB2CL(data);
          const b2csRows = parseB2CS(data);
          const cdnrRows = parseCDNR(data);
          const hsnRows = parseHSN(data);
          const expRows = parseEXP(data);
          const nilRows = parseNIL(data);

          let totalSheetsAdded = 0;

          // Summary sheet
          const summaryRows = [
            { 'GSTR-1 Return Parameter': 'Filer GSTIN', 'Value': data.gstin || 'Not specified' },
            { 'GSTR-1 Return Parameter': 'Return Period (FP)', 'Value': data.fp || 'Not specified' },
            { 'GSTR-1 Return Parameter': 'Gross Turnover Prior FY (GT)', 'Value': data.gt || 0 },
            { 'GSTR-1 Return Parameter': 'Total B2B Item Rows', 'Value': b2bRows.length },
            { 'GSTR-1 Return Parameter': 'Total B2CL Item Rows', 'Value': b2clRows.length },
            { 'GSTR-1 Return Parameter': 'Total B2CS Rows', 'Value': b2csRows.length },
            { 'GSTR-1 Return Parameter': 'Total CDNR Rows', 'Value': cdnrRows.length },
            { 'GSTR-1 Return Parameter': 'Total HSN Item Rows', 'Value': hsnRows.length },
            { 'GSTR-1 Return Parameter': 'Total Export Rows', 'Value': expRows.length },
            { 'GSTR-1 Return Parameter': 'Exported via Taxzentic', 'Value': 'https://taxzentic.com/gstr1-json-to-excel' }
          ];

          const wsSummary = XLSX.utils.json_to_sheet(summaryRows);
          XLSX.utils.book_append_sheet(wb, wsSummary, 'Summary');

          if (b2bRows.length) {
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(b2bRows), 'B2B');
            totalSheetsAdded++;
          }
          if (b2clRows.length) {
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(b2clRows), 'B2CL');
            totalSheetsAdded++;
          }
          if (b2csRows.length) {
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(b2csRows), 'B2CS');
            totalSheetsAdded++;
          }
          if (cdnrRows.length) {
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(cdnrRows), 'CDNR');
            totalSheetsAdded++;
          }
          if (hsnRows.length) {
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(hsnRows), 'HSN');
            totalSheetsAdded++;
          }
          if (expRows.length) {
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(expRows), 'EXP');
            totalSheetsAdded++;
          }
          if (nilRows.length) {
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(nilRows), 'NIL');
            totalSheetsAdded++;
          }

          if (totalSheetsAdded === 0) {
            // Fallback for non-standard or partial payloads
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet([data]), 'RawPayload');
          }

          const filename = `GSTR1_${data.gstin || 'Return'}_${data.fp || 'Converted'}.xlsx`;
          XLSX.writeFile(wb, filename);

          const totalRecords = b2bRows.length + b2clRows.length + b2csRows.length + cdnrRows.length + hsnRows.length + expRows.length + nilRows.length;
          output.textContent = `✓ Successfully converted ${totalRecords} records into "${filename}"!`;
          output.classList.remove('hidden');

        } catch (err) {
          console.error('GSTR-1 JSON parse error:', err);
          errorMsg.textContent = `Conversion Error: ${err.message || 'Invalid GSTR-1 JSON format'}. Please ensure the file is an official GSTN GSTR-1 JSON file.`;
          errorMsg.classList.remove('hidden');
        }
      };

      reader.readAsText(file);
    });
  </script>

  <!-- FAQ Section -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-20 mt-16 pt-12 border-t border-base" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-base mb-8">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {faqs.map((faq, i) => (
        <details class="group rounded-xl border border-base bg-surface overflow-hidden" id={`faq-${i}`}>
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-medium text-base hover:bg-subtle transition-colors list-none">
            <span>{faq.q}</span>
            <svg class="h-5 w-5 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-5 text-[15px] text-muted leading-relaxed border-t border-base pt-4">{faq.a}</div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
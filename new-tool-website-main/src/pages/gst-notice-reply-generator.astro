---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';

const title = 'GST Notice Reply Drafting Tool | Taxzentic';
const description = 'Prepare an editable starting outline for a GST notice response. Review every fact, legal reference, applicable deadline, and filing route before use.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/gst-notice-reply-generator`;

const faqs = [
  {
    q: 'What does this tool create?',
    a: 'It creates an editable starting draft from the notice details you enter. It does not verify the notice, determine the correct legal position, or submit a response for you.',
  },
  {
    q: 'Is the generated response legal or tax advice?',
    a: 'No. AI output and local templates may be incomplete or wrong. Verify all facts and citations against the notice and current primary sources, and ask a qualified professional to review the response before filing.',
  },
  {
    q: 'Does this tool check deadlines or file the response?',
    a: 'No. Check the notice, applicable rules, and the official GST portal for the response deadline, required form, and filing route. You remain responsible for reviewing and submitting any response.',
  },
  {
    q: 'What happens to the information entered for AI drafting?',
    a: 'When you choose AI generation, the notice fields you enter are sent to our server and Groq to produce a draft. Review the Privacy Policy and Groq data-use documentation before submitting sensitive information.',
  },
  {
    q: 'Which GST notice types can I select?',
    a: 'The form lists ASMT-10, DRC-01 options for sections 73, 74 and 74A, and DRC-01A, DRC-01B and DRC-01C. A form appearing in the list does not mean it applies to your case; match it to the notice and current official requirements.',
  },
  {
    q: 'What details should I enter for a draft?',
    a: 'Use only relevant details you have checked against the notice and your records, such as the notice reference, date, financial year, issue and response facts. Avoid passwords, full bank details, and information that is not needed. AI generation sends entered fields to our server and AI provider.',
  },
  {
    q: 'Does the tool verify GST law or legal citations in a draft?',
    a: 'No. It does not check whether a section, rule, notification, case, or argument is current or relevant. Verify every authority against primary sources and get qualified review before relying on a draft.',
  },
  {
    q: 'Can I upload invoices or supporting documents?',
    a: 'No files are uploaded by this tool. The supporting-record checkboxes are prompts for your own review; they do not attach, read, or send documents.',
  },
  {
    q: 'Can I edit and download the generated draft?',
    a: 'Yes. Review and edit the draft in the page, then download it as a Word-compatible .doc file or plain-text .txt file, or print it. The downloaded document is still only a draft for your review.',
  },
  {
    q: 'What if the notice type is not listed or I am unsure which one to choose?',
    a: 'Do not choose the closest-looking option. Check the form and section stated on the notice, consult official GST material, or ask a qualified tax professional. This tool does not classify notices or confirm that a listed option fits your facts.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': ['SoftwareApplication', 'WebApplication'],
    name: 'GST Notice Reply Generator — AI-Assisted Drafting',
    url: canonical,
    description: 'An AI-assisted and template-driven starting point for drafting a response to a GST notice. It does not verify law, facts, deadlines, or filing requirements.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'INR',
    },
    featureList: [
      'Editable starting draft based on user-entered details',
      'Optional AI-assisted generation and a local template',
      'User review required for facts, authorities, deadlines, and filing requirements',
      'One-click Download in Word (.doc) and Text (.txt) formats',
      'Print or download an editable draft outline',
      'In-place editing with word and character counters',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to Draft and Submit a GST Notice Reply Online',
    description: 'General steps for reviewing a notice and preparing a draft response; confirm all requirements from the notice and official sources.',
    step: [
      {
        '@type': 'HowToStep',
        name: 'Read the Notice',
        text: 'Identify the issuing authority, notice reference, period, allegations, response deadline, and any required filing route stated in the notice.',
      },
      {
        '@type': 'HowToStep',
        name: 'Reconcile Tax Returns and Gather Accounting Evidence',
        text: 'Perform an invoice-level reconciliation between GSTR-1, GSTR-2B, GSTR-3B, and financial ledgers. Collect bank payment advice, transport proofs, and CA certificates.',
      },
      {
        '@type': 'HowToStep',
        name: 'Prepare a Draft for Review',
        text: 'Organize verified facts, supporting records, and proposed responses. Add legal arguments only after checking that the law and authorities apply to the case.',
      },
      {
        '@type': 'HowToStep',
        name: 'Confirm Filing Requirements',
        text: 'Check the notice and official GST portal for the applicable deadline, response form, and submission route before filing.',
      },
    ],
  },
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'GST Notices Hub', href: '/gst-notices' },
  { name: 'Notice Reply Generator', href: '/gst-notice-reply-generator' },
];
const lastUpdated = '2026-09-24';
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <!-- Dedicated Global Print Styles: Ensures ONLY the Legal Reply Document Prints -->
  <style is:global>
    @media print {
      /* Hide all website chrome, navigation, headers, footers, form widgets, FAQs, and guides */
      header,
      footer,
      nav,
      .print-hidden,
      #hero-section,
      #form-section,
      #draft-toolbar,
      #draft-footer,
      #disclaimer-section,
      #guide-section,
      #comparison-section,
      #faq-section,
      .fixed.inset-0,
      [aria-label="Breadcrumb"] {
        display: none !important;
      }

      /* Page Setup for Standard Legal A4 Sheet */
      @page {
        size: A4 portrait;
        margin: 20mm 15mm 20mm 15mm;
      }

      html, body {
        background: #ffffff !important;
        color: #000000 !important;
        font-family: "Times New Roman", Times, Georgia, serif !important;
        font-size: 11pt !important;
        line-height: 1.55 !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        height: auto !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      /* Unset grid / flex constraints so the document flows across standard pages */
      main, .mx-auto, .max-w-5xl, .grid, .lg\:col-span-7, .lg\:col-span-12 {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        box-shadow: none !important;
      }

      #printable-document {
        display: block !important;
        width: 100% !important;
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      #draft-output {
        display: block !important;
        font-family: "Times New Roman", Times, Georgia, serif !important;
        font-size: 11pt !important;
        line-height: 1.6 !important;
        color: #000000 !important;
        white-space: pre-wrap !important;
        word-wrap: break-word !important;
        overflow: visible !important;
        height: auto !important;
        max-height: none !important;
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;
        background: transparent !important;
        box-shadow: none !important;
      }
    }
  </style>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Hero Section -->
    <div id="hero-section" class="print-hidden text-center mb-12">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-50/50 dark:bg-blue-950/40 px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-accent mb-4">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        AI-assisted draft · Review before filing
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-base mb-4">
        GST Notice Reply Generator
      </h1>
      <p class="text-[16px] sm:text-[17px] text-muted max-w-2xl mx-auto leading-relaxed">
        Prepare an editable starting outline from the details you provide. This tool does not verify facts, legal authorities, deadlines, or filing requirements.
      </p>
    </div>

    <!-- Generator Interface: 2 Columns on desktop -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 items-start">
      <!-- Left Column: Form Parameters -->
      <div id="form-section" class="print-hidden lg:col-span-5 space-y-6">
        <div class="rounded-2xl border border-base bg-surface p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-base pb-3">
            <h2 class="text-base font-bold text-base flex items-center gap-2">
              <ToolIcon name="file" class="w-5 h-5 text-accent" />
              1. Notice Particulars
            </h2>
            <span class="text-[11px] font-mono text-muted bg-subtle px-2 py-0.5 rounded">Form Input</span>
          </div>

          <!-- Notice Type -->
          <div>
            <label for="notice-type" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Notice Type</label>
            <select id="notice-type" class="w-full rounded-xl border border-base bg-subtle px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none transition-colors">
              <option value="" selected>Select notice type</option>
              <option value="ASMT-10">Form GST ASMT-10 (Scrutiny Notice u/s 61)</option>
              <option value="DRC-01-74A">Form GST DRC-01 — 74A, if stated</option>
              <option value="DRC-01-73">Form GST DRC-01 — 73, if stated</option>
              <option value="DRC-01-74">Form GST DRC-01 — 74, if stated</option>
              <option value="DRC-01A">Form GST DRC-01A</option>
              <option value="DRC-01B">Form GST DRC-01B</option>
              <option value="DRC-01C">Form GST DRC-01C</option>
            </select>
          </div>

          <!-- Financial Year & Demand Amount -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="financial-year" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Financial Year</label>
              <select id="financial-year" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm focus:border-accent focus:outline-none transition-colors">
              <option value="" selected>Select financial year</option>
                <option value="FY 2026-27">FY 2026-27</option>
                <option value="FY 2025-26">FY 2025-26</option>
                <option value="FY 2024-25">FY 2024-25</option>
                <option value="FY 2023-24">FY 2023-24</option>
                <option value="FY 2022-23">FY 2022-23</option>
                <option value="FY 2021-22">FY 2021-22</option>
                <option value="FY 2020-21">FY 2020-21</option>
                <option value="FY 2019-20">FY 2019-20</option>
                <option value="FY 2018-19">FY 2018-19</option>
                <option value="FY 2017-18">FY 2017-18</option>
              </select>
            </div>
            <div>
              <label for="demand-amount" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Disputed Tax (₹)</label>
              <input type="text" id="demand-amount" placeholder="Enter only if stated in the notice" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm font-mono focus:border-accent focus:outline-none transition-colors" />
            </div>
          </div>

          <!-- Notice Ref & Notice Date -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="notice-ref" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Notice Ref No.</label>
              <input type="text" id="notice-ref" placeholder="Enter the reference shown on your notice" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm font-mono focus:border-accent focus:outline-none transition-colors" />
            </div>
            <div>
              <label for="notice-date" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Notice Date</label>
              <input type="date" id="notice-date" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm font-mono focus:border-accent focus:outline-none transition-colors" />
            </div>
          </div>

          <!-- DIN No -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="din-no" class="text-xs font-semibold uppercase tracking-wider text-muted">DIN (Document Identification No.)</label>
            <span class="text-[10px] text-muted">Optional</span>
            </div>
            <input type="text" id="din-no" placeholder="Leave blank if not mentioned on notice" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm font-mono focus:border-accent focus:outline-none transition-colors" />
            <p class="text-[11px] text-muted/80 mt-1">If you leave this blank, the draft will leave a placeholder. A missing DIN does not by itself establish a legal conclusion.</p>
          </div>

          <!-- Proper Officer / Jurisdiction -->
          <div>
            <label for="jurisdiction-office" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Proper Officer / Ward / Range</label>
            <input type="text" id="jurisdiction-office" placeholder="Enter the office named in the notice, if needed" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm focus:border-accent focus:outline-none transition-colors" />
          </div>

          <!-- Alleged Discrepancy -->
          <div>
              <label for="discrepancy-type" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Topic to address (optional)</label>
            <select id="discrepancy-type" class="w-full rounded-xl border border-base bg-subtle px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none transition-colors">
              <option value="" selected>Select a topic</option>
              <option value="itc-2b-3b">ITC figures differ between records</option>
              <option value="sec-16-4-delayed-itc">ITC time limit raised in notice</option>
              <option value="sec-128a-amnesty">Waiver or relief mentioned in notice</option>
              <option value="supplier-cancelled">Supplier registration issue</option>
              <option value="turnover-1-3b">Turnover figures differ</option>
              <option value="delayed-interest">Interest calculation</option>
              <option value="rule-37">Supplier payment timing</option>
              <option value="eway-mismatch">E-way bill and return figures differ</option>
              <option value="rcm-liability">Reverse charge question</option>
              <option value="drc-01b-rule-88c">DRC-01B intimation</option>
              <option value="drc-01c-rule-88d">DRC-01C intimation</option>
              <option value="general-denial">Other or general response</option>
            </select>
          </div>

          <!-- Taxpayer Details -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="taxpayer-name" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Taxpayer Legal Name</label>
              <input type="text" id="taxpayer-name" placeholder="Enter the name exactly as shown on the notice" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm focus:border-accent focus:outline-none transition-colors" />
            </div>
            <div>
              <label for="taxpayer-gstin" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Taxpayer GSTIN</label>
              <input type="text" id="taxpayer-gstin" placeholder="Enter only if needed" maxlength="15" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm font-mono uppercase focus:border-accent focus:outline-none transition-colors" />
            </div>
          </div>

          <!-- Supporting Documents Attached -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-muted mb-2">Potential supporting records (no files are uploaded)</label>
            <div class="grid grid-cols-1 gap-2 text-xs text-muted">
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" id="doc-recon" class="accent-blue-600 rounded" />
                <span>Monthly GSTR-2B vs 3B Reconciliation Statement</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" id="doc-bank" class="accent-blue-600 rounded" />
                <span>Bank Statement showing payments via banking channels</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" id="doc-inv" class="accent-blue-600 rounded" />
                <span>Sample Tax Invoices, Delivery Proofs & E-Way Bills</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" id="doc-ca" class="accent-blue-600 rounded" />
                <span>Chartered Accountant Certification (Circular 183/193)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" id="doc-drc03" class="accent-blue-600 rounded" />
                <span>Challan / DRC-03 of voluntary tax payment</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Custom Context for AI -->
        <div class="rounded-2xl border border-emerald-500/20 bg-emerald-50/30 dark:bg-emerald-950/10 p-6 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-base flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" /></svg>
              2. AI Context <span class="text-xs font-normal text-muted">(Optional)</span>
            </h2>
            <span class="text-[11px] font-mono text-emerald-700 dark:text-emerald-300">Groq LLM</span>
          </div>
          <p class="text-xs text-muted">Add only facts needed for the draft. Avoid passwords, full bank details, or information you do not want sent to our AI provider.</p>
          <textarea
            id="custom-context"
            rows="3"
            placeholder="Add concise facts from the notice or your records. Do not include sensitive details unless necessary."
            class="w-full rounded-xl border border-emerald-300/50 dark:border-emerald-800/50 bg-white dark:bg-gray-900 px-3.5 py-2.5 text-xs focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 resize-y transition-colors"
          ></textarea>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col gap-3">
          <button
            id="ai-generate-btn"
            type="button"
            class="w-full rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white px-6 py-3.5 text-sm font-bold shadow-md hover:shadow-lg transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" /></svg>
            Generate with AI
          </button>
          
          <div class="rounded-lg border border-base bg-subtle/80 px-3 py-2 text-[11px] text-muted leading-relaxed">
            <div class="flex items-center gap-1.5 font-semibold text-base mb-0.5">
              <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
              <span>AI Privacy &amp; Data Transparency</span>
            </div>
            <span>AI generation sends entered notice fields to our server and Groq to produce a draft. Our function does not save the fields to a database; provider logs may be retained temporarily. The local template does not send your entries to the AI provider. See our <a href="/privacy-policy" class="text-accent underline">Privacy Policy</a> and <a href="https://console.groq.com/docs/your-data" target="_blank" rel="noopener noreferrer" class="text-accent underline">Groq data policy</a>.</span>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <button
              id="template-btn"
              type="button"
              class="w-full rounded-xl border border-base bg-surface hover:bg-subtle text-base px-4 py-2.5 text-xs font-semibold transition-colors cursor-pointer"
            >
              Update Template
            </button>
            <button
              id="reset-btn"
              type="button"
              class="w-full rounded-xl border border-base bg-surface hover:bg-subtle text-muted hover:text-base px-4 py-2.5 text-xs font-medium transition-colors cursor-pointer"
            >
              Reset to Defaults
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Generated Legal Draft & Print Wrapper -->
      <div class="lg:col-span-7 flex flex-col">
        <div id="printable-document" class="rounded-2xl border border-base bg-surface flex-1 flex flex-col overflow-hidden shadow-sm">
          <!-- Draft Toolbar -->
          <div id="draft-toolbar" class="print-hidden p-4 border-b border-base bg-subtle flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-500" id="status-dot"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-base" id="status-label">Draft outline</span>
              <span class="hidden sm:inline-flex text-[10px] bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 font-mono px-2 py-0.5 rounded-full">
                ✏️ Click text to edit
              </span>
            </div>

            <div class="flex items-center gap-1.5 flex-wrap">
              <span id="ai-badge" class="hidden items-center gap-1 rounded-full bg-emerald-100 dark:bg-emerald-900/40 px-2 py-0.5 text-[10px] font-bold text-emerald-700 dark:text-emerald-300">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" /></svg>
                AI Generated
              </span>

              <button
                id="copy-btn"
                type="button"
                title="Copy full text to clipboard"
                class="inline-flex items-center gap-1 rounded-lg border border-base bg-surface hover:bg-subtle text-base px-2.5 py-1.5 text-xs font-medium transition-colors cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                <span>Copy</span>
              </button>

              <button
                id="download-doc-btn"
                type="button"
                title="Download formatted Microsoft Word document (.doc)"
                class="inline-flex items-center gap-1 rounded-lg border border-base bg-surface hover:bg-subtle text-base px-2.5 py-1.5 text-xs font-medium transition-colors cursor-pointer"
              >
                <svg class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                <span>Word (.doc)</span>
              </button>

              <button
                id="download-txt-btn"
                type="button"
                title="Download plain text file (.txt)"
                class="inline-flex items-center gap-1 rounded-lg border border-base bg-surface hover:bg-subtle text-base px-2.5 py-1.5 text-xs font-medium transition-colors cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                <span>Text</span>
              </button>

              <button
                id="print-btn"
                type="button"
                title="Print or Save as PDF (Document only)"
                class="inline-flex items-center gap-1 rounded-lg bg-accent text-white px-3 py-1.5 text-xs font-semibold hover:opacity-90 transition-opacity cursor-pointer shadow-sm"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
                <span>Print / Save PDF</span>
              </button>
            </div>
          </div>

          <!-- Document Output Body (In-place editable) -->
          <div
            id="draft-output"
            contenteditable="true"
            spellcheck="true"
            class="p-6 flex-1 overflow-y-auto font-mono text-xs leading-relaxed text-base bg-subtle/30 whitespace-pre-wrap outline-none focus:ring-2 focus:ring-accent/20 transition-shadow"
            title="Click directly in this document to edit or add custom details"
          >
            <!-- Dynamically populated draft -->
          </div>

          <!-- Draft Footer Info Bar -->
          <div id="draft-footer" class="print-hidden p-3.5 border-t border-base bg-subtle flex flex-wrap items-center justify-between gap-3 text-xs text-muted">
            <div class="flex items-center gap-3">
              <span id="word-count" class="font-mono text-[11px]">0 words</span>
              <span>•</span>
              <span id="char-count" class="font-mono text-[11px]">0 chars</span>
              <span>•</span>
              <span class="text-accent font-medium" id="reply-form-indicator">Confirm the response form from your notice</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[11px] text-muted">💡 Print or save the editable outline as PDF</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Disclaimer Box -->
    <div id="disclaimer-section" class="print-hidden rounded-2xl border border-amber-500/30 bg-amber-50/40 dark:bg-amber-950/20 p-6 mb-16">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-amber-600 dark:text-amber-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
        <div class="text-xs text-muted leading-relaxed">
          <strong class="text-base font-semibold">Drafting tool notice:</strong> The generated text is a starting point, not legal or tax advice. It may contain inaccurate facts, legal references, or omissions. Verify every detail against the notice and current official sources, then obtain qualified professional review before filing.
        </div>
      </div>
    </div>

    <!-- Tool guidance -->
    <div id="guide-section" class="print-hidden mx-auto max-w-5xl space-y-10">
      <section aria-labelledby="drafting-guide-heading">
        <h2 id="drafting-guide-heading" class="text-2xl sm:text-3xl font-bold text-base mb-4">How to use this drafting tool</h2>
        <p class="text-muted text-[15px] leading-relaxed mb-6">Use the outline to organize a response. The right legal position, evidence, filing method, and deadline depend on the notice and the taxpayer’s circumstances.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <article class="rounded-2xl border border-base bg-surface p-5">
            <h3 class="font-semibold text-base mb-2">Read the complete notice</h3>
            <p class="text-sm text-muted">Identify the issuing office, allegations, tax period, requested response, and date by which it must be addressed. Check amendments or attachments too.</p>
          </article>
          <article class="rounded-2xl border border-base bg-surface p-5">
            <h3 class="font-semibold text-base mb-2">Use verified records</h3>
            <p class="text-sm text-muted">Compare each allegation with the relevant returns, invoices, ledgers, and correspondence. Include only facts and records you have checked.</p>
          </article>
          <article class="rounded-2xl border border-base bg-surface p-5">
            <h3 class="font-semibold text-base mb-2">Review before filing</h3>
            <p class="text-sm text-muted">Confirm every legal point, deadline, required form, and portal route from current primary sources and the official GST portal. Get qualified professional review.</p>
          </article>
        </div>
      </section>
      <section class="rounded-2xl border border-amber-500/30 bg-amber-50/40 dark:bg-amber-950/20 p-6" aria-labelledby="tool-limits-heading">
        <h2 id="tool-limits-heading" class="text-lg font-bold text-base mb-2">What the tool does not do</h2>
        <p class="text-sm text-muted leading-relaxed">It does not authenticate a notice, verify tax records, check current law, determine the correct response, or file anything with the GST portal. AI output can be inaccurate. The selected supporting-record labels are reminders only; no files are uploaded.</p>
      </section>
    </div>

    <!-- Frequently Asked Questions -->
    <section id="faq-section" class="print-hidden mx-auto max-w-5xl pb-20 mt-16 pt-12 border-t border-base" aria-labelledby="faq-heading">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-base bg-surface px-3 py-1 text-[11px] font-mono uppercase tracking-wider text-muted mb-2">
          Frequently Asked Questions
        </div>
        <h2 id="faq-heading" class="text-2xl sm:text-4xl font-extrabold text-base">
          GST Notice Reply FAQs
        </h2>
        <p class="text-muted text-sm max-w-xl mx-auto mt-2">
          Answers about the tool, its limitations, data handling, and your review responsibilities.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="group rounded-2xl border border-base bg-surface overflow-hidden shadow-xs" id={`faq-${i}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 font-semibold text-sm sm:text-[15px] text-base hover:bg-subtle transition-colors list-none">
              <span class="flex items-center gap-3">
                <span class="flex-shrink-0 text-xs font-mono text-muted">Q{i + 1}.</span>
                <span>{faq.q}</span>
              </span>
              <svg class="h-4 w-4 flex-shrink-0 text-muted group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-5 text-xs sm:text-[14px] text-muted leading-relaxed border-t border-base pt-4 bg-subtle/20">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>

  <!-- Client-Side JavaScript Logic -->
  <script is:inline>
    // ══════════════════════════════════════════════════════════════════
    // Form data extractor
    // ══════════════════════════════════════════════════════════════════
    function getFormData() {
      return {
        noticeType: document.getElementById('notice-type').value,
        financialYear: document.getElementById('financial-year').value,
        demandAmount: document.getElementById('demand-amount').value.trim(),
        noticeRef: document.getElementById('notice-ref').value.trim(),
        noticeDate: document.getElementById('notice-date').value,
        din: document.getElementById('din-no').value.trim(),
        jurisdiction: document.getElementById('jurisdiction-office').value.trim(),
        discrepancyType: document.getElementById('discrepancy-type').value,
        taxpayerName: document.getElementById('taxpayer-name').value.trim(),
        taxpayerGstin: document.getElementById('taxpayer-gstin').value.trim().toUpperCase(),
        customContext: document.getElementById('custom-context').value.trim(),
        documents: [
          document.getElementById('doc-recon').checked ? 'GSTR-2B / GSTR-3B or return reconciliation, if relevant and available' : null,
          document.getElementById('doc-bank').checked ? 'Relevant bank payment records, if needed and available' : null,
          document.getElementById('doc-inv').checked ? 'Relevant invoices, delivery records, or e-way bills, if applicable' : null,
          document.getElementById('doc-ca').checked ? 'Professional certificate, if applicable and actually obtained' : null,
          document.getElementById('doc-drc03').checked ? 'DRC-03 payment record, if applicable and available' : null,
        ].filter(Boolean),
      };
    }

    // ══════════════════════════════════════════════════════════════════
    // Local fill-in outline; it deliberately avoids factual or legal conclusions.
    function generateDraft() {
      const data = getFormData();
      const promptValue = (value, label) => String(value || '').trim() || '[Add ' + label + ']';
      const records = data.documents.length
        ? data.documents.map((item) => '- ' + item).join('\n')
        : '- [List only records you actually intend to attach]';
      const draftText = [
        'DRAFT RESPONSE OUTLINE — REVIEW BEFORE USE',
        '',
        'Notice type: ' + promptValue(data.noticeType, 'the type shown on the notice'),
        'Notice reference: ' + promptValue(data.noticeRef, 'the reference shown on the notice'),
        'Notice date: ' + promptValue(data.noticeDate, 'the date shown on the notice'),
        'Issuing office: ' + promptValue(data.jurisdiction, 'the issuing office, if needed'),
        'Tax period: ' + promptValue(data.financialYear, 'the applicable tax period'),
        'Taxpayer: ' + promptValue(data.taxpayerName, 'the correct legal name'),
        'GSTIN: ' + promptValue(data.taxpayerGstin, 'the GSTIN, if needed'),
        'Amount in dispute: ' + promptValue(data.demandAmount, 'the amount stated in the notice, if any'),
        '',
        'To: [Confirm the correct officer and address from the notice]',
        'Subject: Response to the notice identified above',
        '',
        '1. Background',
        '[Summarize the notice and relevant facts using the notice and records. Do not include assumptions.]',
        '',
        '2. Point-by-point response',
        '[Respond to each allegation separately. Identify the records supporting each factual statement.]',
        '',
        '3. Legal submissions',
        '[Add only legal provisions and authorities independently checked against current primary sources and confirmed to apply. Remove this section if not applicable.]',
        '',
        '4. Relief requested',
        '[State the specific relief requested after professional review.]',
        '',
        '5. Records to verify before attaching',
        records,
        '',
        '6. Signature and declaration',
        '[Complete only with a declaration and signatory details required for the applicable response.]',
        '',
        'BEFORE FILING: Confirm the required response form, deadline, and submission route from the notice and official GST portal. Verify every fact and citation, remove placeholders, and obtain qualified professional review.',
      ].join('\n');

      const formInd = document.getElementById('reply-form-indicator');
      if (formInd) {
        formInd.textContent = 'Outline prepared. Confirm the required response form and procedure separately.';
      }
      const out = document.getElementById('draft-output');
      if (out) {
        out.textContent = draftText;
        updateCounts();
      }
      showBadge(false);
    }
    // AI Generation Handler
    // ══════════════════════════════════════════════════════════════════
    async function generateWithAI() {
      const formData = getFormData();
      const out = document.getElementById('draft-output');
      const btn = document.getElementById('ai-generate-btn');
      const statusDot = document.getElementById('status-dot');
      const statusLabel = document.getElementById('status-label');

      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Preparing draft...';
      statusDot.className = 'h-2.5 w-2.5 rounded-full bg-amber-500 animate-pulse';
        statusLabel.textContent = 'Preparing an AI-assisted draft...';
      out.textContent = 'Sending the selected notice fields to the AI service and preparing a draft...';

      try {
        const response = await fetch('/api/generate-reply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'AI generation failed');
        }

        if (data.reply) {
          out.textContent = data.reply;
          showBadge(true);
          statusDot.className = 'h-2.5 w-2.5 rounded-full bg-emerald-500';
          statusLabel.textContent = 'AI-Generated Draft';
          updateCounts();
        } else {
          throw new Error('Empty response from AI engine');
        }
      } catch (err) {
        console.warn('AI generation unavailable, falling back to the local outline:', err);
        statusDot.className = 'h-2.5 w-2.5 rounded-full bg-blue-500';
        statusLabel.textContent = 'Preparing local outline';
        out.textContent = 'AI generation did not complete. A local fill-in outline is available below.\n\n';

        setTimeout(() => {
          generateDraft();
          statusDot.className = 'h-2.5 w-2.5 rounded-full bg-emerald-500';
          statusLabel.textContent = 'Local Draft Outline';
        }, 1000);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" /></svg> Generate with AI';
      }
    }

    function showBadge(isAI) {
      const badge = document.getElementById('ai-badge');
      if (badge) badge.style.display = isAI ? 'inline-flex' : 'none';
    }

    // ══════════════════════════════════════════════════════════════════
    // Word and Character Counters
    // ══════════════════════════════════════════════════════════════════
    function updateCounts() {
      const el = document.getElementById('draft-output');
      if (!el) return;
      const text = el.innerText || el.textContent || '';
      const chars = text.length;
      const words = text.trim() ? text.trim().split(/\s+/).length : 0;

      const wc = document.getElementById('word-count');
      const cc = document.getElementById('char-count');
      if (wc) wc.textContent = `${words} words`;
      if (cc) cc.textContent = `${chars} chars`;
    }

    // ══════════════════════════════════════════════════════════════════
    // Word (.doc) and Text (.txt) Download Handlers
    // ══════════════════════════════════════════════════════════════════
    function downloadAsDoc() {
      const el = document.getElementById('draft-output');
      const text = el ? (el.innerText || el.textContent || '') : '';
      const taxpayer = (document.getElementById('taxpayer-name').value || 'Taxpayer').trim().replace(/[^a-zA-Z0-9_-]/g, '_');
      const ref = (document.getElementById('notice-ref').value || 'Notice').trim().replace(/[^a-zA-Z0-9_-]/g, '_');
      const filename = `GST_Reply_${ref}_${taxpayer}.doc`;

      const htmlContent = `<!DOCTYPE html>
<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
  <meta charset='utf-8'>
  <title>GST Notice Reply</title>
  <!--[if gte mso 9]>
  <xml>
    <w:WordDocument>
      <w:View>Print</w:View>
      <w:Zoom>100</w:Zoom>
      <w:DoNotOptimizeForBrowser/>
    </w:WordDocument>
  </xml>
  <![endif]-->
  <style>
    @page Section1 {
      size: 595.3pt 841.9pt; /* A4 */
      margin: 1.0in 1.0in 1.0in 1.0in;
      mso-header-margin: 35.4pt;
      mso-footer-margin: 35.4pt;
      mso-paper-source: 0;
    }
    div.Section1 { page: Section1; }
    body {
      font-family: 'Times New Roman', Times, serif;
      font-size: 12pt;
      line-height: 1.5;
      color: #000000;
    }
    pre {
      font-family: 'Times New Roman', Times, serif;
      font-size: 12pt;
      line-height: 1.5;
      white-space: pre-wrap;
      word-wrap: break-word;
    }
  </style>
</head>
<body>
  <div class="Section1">
    <pre>${text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</pre>
  </div>
</body>
</html>`;

      const blob = new Blob(['\ufeff', htmlContent], { type: 'application/msword' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function downloadAsTxt() {
      const el = document.getElementById('draft-output');
      const text = el ? (el.innerText || el.textContent || '') : '';
      const taxpayer = (document.getElementById('taxpayer-name').value || 'Taxpayer').trim().replace(/[^a-zA-Z0-9_-]/g, '_');
      const ref = (document.getElementById('notice-ref').value || 'Notice').trim().replace(/[^a-zA-Z0-9_-]/g, '_');
      const filename = `GST_Reply_${ref}_${taxpayer}.txt`;

      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    // ══════════════════════════════════════════════════════════════════
    // Event Listeners Setup
    // ══════════════════════════════════════════════════════════════════
    document.getElementById('ai-generate-btn').addEventListener('click', generateWithAI);
    document.getElementById('template-btn').addEventListener('click', () => {
      generateDraft();
      const statusDot = document.getElementById('status-dot');
      const statusLabel = document.getElementById('status-label');
      statusDot.className = 'h-2.5 w-2.5 rounded-full bg-emerald-500';
      statusLabel.textContent = 'Local Draft Outline';
    });

    document.getElementById('reset-btn').addEventListener('click', () => {
      document.getElementById('notice-type').value = '';
      document.getElementById('financial-year').value = '';
      document.getElementById('demand-amount').value = '';
      document.getElementById('notice-ref').value = '';
      document.getElementById('notice-date').value = '';
      document.getElementById('din-no').value = '';
      document.getElementById('jurisdiction-office').value = '';
      document.getElementById('discrepancy-type').value = '';
      document.getElementById('taxpayer-name').value = '';
      document.getElementById('taxpayer-gstin').value = '';
      document.getElementById('custom-context').value = '';
      document.getElementById('doc-recon').checked = false;
      document.getElementById('doc-bank').checked = false;
      document.getElementById('doc-inv').checked = false;
      document.getElementById('doc-ca').checked = false;
      document.getElementById('doc-drc03').checked = false;
      generateDraft();
    });

    document.getElementById('copy-btn').addEventListener('click', () => {
      const el = document.getElementById('draft-output');
      const text = el ? (el.innerText || el.textContent || '') : '';
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById('copy-btn');
        if (btn) {
          const original = btn.innerHTML;
          btn.innerHTML = '<span class="text-emerald-600 dark:text-emerald-400 font-semibold">\u2713 Copied!</span>';
          setTimeout(() => {
            btn.innerHTML = original;
          }, 2000);
        }
      });
    });

    document.getElementById('download-doc-btn').addEventListener('click', downloadAsDoc);
    document.getElementById('download-txt-btn').addEventListener('click', downloadAsTxt);

    document.getElementById('print-btn').addEventListener('click', () => {
      window.print();
    });

    // Live update draft when primary dropdowns or checkboxes change
    const reactiveInputs = [
      'notice-type',
      'financial-year',
      'discrepancy-type',
      'doc-recon',
      'doc-bank',
      'doc-inv',
      'doc-ca',
      'doc-drc03',
    ];
    reactiveInputs.forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('change', () => {
          generateDraft();
        });
      }
    });

    // Uppercase GSTIN on typing
    const gstinInput = document.getElementById('taxpayer-gstin');
    if (gstinInput) {
      gstinInput.addEventListener('input', (e) => {
        e.target.value = e.target.value.toUpperCase();
      });
    }

    // Monitor edits inside contenteditable #draft-output
    const draftOutput = document.getElementById('draft-output');
    if (draftOutput) {
      draftOutput.addEventListener('input', updateCounts);
    }

    // Generate initial template on load
    generateDraft();
  </script>
</BaseLayout>

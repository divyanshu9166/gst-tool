        jurisdiction,
        discrepancyType: discrepancy,
        taxpayerName: name,
        taxpayerGstin: gstin,
        documents,
      } = data;

      // Determine Statutory Form & Sections
      let replyForm = 'Form GST ASMT-11';
      let sectionCited = 'Section 61 of the CGST Act, 2017 read with Rule 99';
      let formPreamble = 'WRITTEN SUBMISSIONS IN FORM GST ASMT-11 TO SCRUTINY NOTICE';

      if (type === 'DRC-01-73') {
        replyForm = 'Form GST DRC-06';
        sectionCited = 'Section 73 of the CGST Act, 2017 read with Rule 142(4)';
        formPreamble = 'WRITTEN SUBMISSIONS IN FORM GST DRC-06 TO SHOW CAUSE NOTICE UNDER SECTION 73';
      } else if (type === 'DRC-01-74') {
        replyForm = 'Form GST DRC-06';
        sectionCited = 'Section 74 of the CGST Act, 2017 read with Rule 142(4)';
        formPreamble = 'WRITTEN SUBMISSIONS IN FORM GST DRC-06 TO SHOW CAUSE NOTICE UNDER SECTION 74';
      } else if (type === 'DRC-01A') {
        replyForm = 'Part B of Form GST DRC-01A';
        sectionCited = 'Rule 142(1A) of the CGST Rules, 2017';
        formPreamble = 'SUBMISSIONS IN PART B OF FORM GST DRC-01A TO INTIMATION OF ASCERTAINED TAX';
      } else if (type === 'DRC-01B') {
        replyForm = 'Part B of Form GST DRC-01B';
        sectionCited = 'Rule 88C of the CGST Rules, 2017';
        formPreamble = 'REPLY IN PART B OF FORM GST DRC-01B FOR OUTWARD LIABILITY DIFFERENCE';
      } else if (type === 'DRC-01C') {
        replyForm = 'Part B of Form GST DRC-01C';
        sectionCited = 'Rule 88D of the CGST Rules, 2017';
        formPreamble = 'REPLY IN PART B OF FORM GST DRC-01C FOR INPUT TAX CREDIT DIFFERENCE';
      }

      // Update Form Indicator UI
      const formInd = document.getElementById('reply-form-indicator');
      if (formInd) formInd.textContent = `Ready for ${replyForm}`;

      // Handle DIN preliminary objection if omitted
      let dinClause = '';
      let dinSubject = din ? `(DIN: ${din})` : '(DIN: NOT SPECIFIED)';
      if (!din || din === 'N/A' || din.trim() === '') {
        dinClause = `1.3 PRELIMINARY OBJECTION ON ABSENCE OF DOCUMENT IDENTIFICATION NUMBER (DIN):
The Noticee respectfully submits that the captioned notice lacks a system-generated Document Identification Number (DIN). As mandated by CBIC Circular No. 122/41/2019-GST dated 05.11.2019 and Circular No. 128/47/2019-GST dated 23.12.2019, any communication or notice issued without a DIN is invalid and deemed to have never been issued (void ab initio). Without prejudice to this threshold defect, the Noticee submits the following on merits.\n\n`;
      }

      // Legal Grounds based on Discrepancy Selection
      let legalGrounds = '';

      if (discrepancy === 'itc-2b-3b') {
        legalGrounds = `2. SUBMISSIONS ON INPUT TAX CREDIT (GSTR-2B VS GSTR-3B DIFFERENCE):
2.1 The Noticee submits that all Input Tax Credit (ITC) amounting to the disputed sum claimed in GSTR-3B strictly satisfies all four cumulative statutory conditions stipulated under Section 16(2) of the CGST Act, 2017:
    (a) The Noticee is in possession of valid original tax invoices issued by suppliers;
    (b) The underlying goods and/or commercial services were physically received;
    (c) The applicable tax charged was paid over to the supplier through account payee banking channels;
    (d) Valid returns under Section 39 have been duly furnished.

2.2 Temporal Variance & CBIC Clarification:
As clarified by the CBIC vide Circular No. 183/15/2022-GST dated 27.12.2022 and Circular No. 193/05/2023-GST dated 17.07.2023, mere temporal mismatch or delayed filing by bona fide suppliers in GSTR-1 does not warrant mechanical denial of legitimate credit to the recipient where the genuineness of supply is substantiated.

2.3 The Noticee has enclosed an invoice-level reconciliation between GSTR-2B and GSTR-3B along with bank proof and Chartered Accountant certification.`;
      } else if (discrepancy === 'sec-16-4-delayed-itc') {
        legalGrounds = `2. STATUTORY RELIEF UNDER RETROSPECTIVE SECTION 16(5) & 16(6) (FINANCE ACT 2024):
2.1 The Noticee respectfully submits that the proposed disallowance of Input Tax Credit on the premise of Section 16(4) time-bar is wholly unsustainable in law in view of the landmark retrospective amendments enacted by the Parliament vide Section 118 of the Finance (No. 2) Act, 2024.

2.2 Sub-section (5) inserted into Section 16 of the CGST Act with retrospective effect from 01.07.2017 stipulates:
    "Notwithstanding anything contained in sub-section (4), in respect of an invoice or debit note for supply of goods or services or both pertaining to the financial years 2017-18, 2018-19, 2019-20 and 2020-21, the registered person shall be entitled to take input tax credit in any return under section 39 which is filed upto the thirtieth day of November, 2021."

2.3 Since the underlying returns for the tax period ${fy} were furnished within the statutory relaxed window ending 30.11.2021, the Noticee is legally entitled to the credit by operation of statute. Consequently, the proposed demand is liable to be dropped forthwith.`;
      } else if (discrepancy === 'sec-128a-amnesty') {
        legalGrounds = `2. STATUTORY IMMUNITY & WAIVER OF INTEREST AND PENALTY UNDER SECTION 128A:
2.1 The Noticee submits that the captioned notice relates to the tax period ${fy} and proposes a demand under Section 73 of the CGST Act, without any element of fraud, willful misstatement, or suppression of facts.

2.2 The Noticee draws reference to Section 128A of the CGST Act (inserted by Finance (No. 2) Act, 2024) read with Rule 164 of the CGST Rules and CBIC Circular No. 238/32/2024-GST dated 15.10.2024, which provides for 100% waiver of interest and penalties for notices/orders issued under Section 73 for FY 2017-18, 2018-19, and 2019-20.

2.3 The Noticee is ready and willing to discharge the eligible admitted tax amount on or before the prescribed cut-off date via Form GST SPL-01 / SPL-02. Hence, no penal action or interest liability under Section 50 can be legally sustained against the Noticee.`;
      } else if (discrepancy === 'supplier-cancelled') {
        legalGrounds = `2. BONA FIDE TRANSACTIONS WITH RETROSPECTIVELY CANCELLED SUPPLIER:
2.1 The Noticee submits that at the time of entering into commercial contracts, receipt of tax invoices, and payment of consideration, the supplier's GSTIN was 'ACTIVE' and valid on the official GST common portal.

2.2 It is settled law that subsequent or retrospective cancellation of a supplier's registration cannot invalidate legitimately availed Input Tax Credit in the hands of a bona fide recipient:
    - Calcutta High Court in Suncraft Energy Pvt. Ltd. v. Assistant Commissioner (MAT 1218 of 2023) held that the department must first initiate recovery proceedings against the supplier before seeking reversal from the recipient.
    - Delhi High Court in Bharti Telemedia Ltd. v. Union of India affirmed that bona fide purchasers cannot be penalized for subsequent default of suppliers.

2.3 The Noticee has demonstrated genuineness through tax invoices, e-way bills, proof of delivery, and electronic banking remittances.`;
      } else if (discrepancy === 'turnover-1-3b') {
        legalGrounds = `2. SUBMISSIONS ON OUTWARD TURNOVER DISCREPANCY (GSTR-1 VS GSTR-3B):
2.1 The difference between outward taxable turnover declared in GSTR-1 and tax discharged in GSTR-3B occurred due to an inadvertent clerical / typographical error in GSTR-1 reporting.
2.2 The actual commercial tax liability for supplies made during ${fy} stands fully discharged via Electronic Cash/Credit Ledger in Form GSTR-3B.
2.3 In terms of CBIC Circular No. 170/02/2022-GST, reporting errors in outward returns do not constitute short payment of tax where actual commercial taxes have been remitted to the exchequer. Complete reconciliation is enclosed.`;
      } else if (discrepancy === 'delayed-interest') {
        legalGrounds = `2. SUBMISSIONS ON INTEREST LEVY UNDER SECTION 50:
2.1 As per the statutory proviso to Section 50(1) of the CGST Act (amended with retrospective effect from 01.07.2017), interest on delayed filing of returns is leviable ONLY on that portion of tax which is discharged by debiting the Electronic Cash Ledger.
2.2 The portion of tax discharged by debiting the Electronic Credit Ledger from eligible available credit does not attract interest under Section 50, as upheld by the Hon'ble Apex Court and codified in law.
2.3 The Noticee has furnished a ledger-wise tax discharge breakdown demonstrating that cash ledger payments have complied with statutory interest, and no further interest is payable.`;
      } else if (discrepancy === 'rule-37') {
        legalGrounds = `2. SUBMISSIONS ON RULE 37 (180-DAY PAYMENT PROVISO TO SECTION 16(2)):
2.1 The second proviso to Section 16(2) read with Rule 37 requires reversal of ITC only where the recipient fails to pay the supplier the value of supply along with tax within 180 days from the date of invoice.
2.2 The Noticee has duly settled consideration along with taxes within the prescribed 180 days via banking channels, as evidenced by the attached bank advice and vendor ledger confirmations.
2.3 In respect of any nominal balances retained, such amounts represent standard contractual retention money / defect liability period holds agreed inter-se, which does not constitute failure to pay under Section 16(2).`;
      } else if (discrepancy === 'eway-mismatch') {
        legalGrounds = `2. SUBMISSIONS ON E-WAY BILL VS TURNOVER DISCREPANCY:
2.1 As clarified by CBIC Circular No. 64/38/2018-GST, generation of an E-Way Bill is an electronic movement tracking mechanism and does not per se represent a completed taxable supply or sales turnover.
2.2 The variance between generated E-Way Bills and reported GSTR-1/3B turnover has arisen on account of cancelled consignments, multiple movements for single tax invoices (e.g. line movement/job-work under Rule 55 delivery challans), or transit returns.
2.3 Complete delivery challan and e-way bill movement reconciliation is enclosed as Annexure A.`;
      } else if (discrepancy === 'rcm-liability') {
        legalGrounds = `2. SUBMISSIONS ON REVERSE CHARGE MECHANISM (RCM) UNDER SECTION 9(3)/9(4):
2.1 The Noticee has reviewed inward procurements covered under Section 9(3) notifications (including Goods Transport Agency services, legal services, and director remuneration).
2.2 For GTA freight services, the underlying transporters discharged tax under forward charge (12%), or consignments fell below threshold limits, accompanied by requisite declarations on consignment notes.
2.3 Where applicable, RCM tax was duly remitted through Electronic Cash Ledger in GSTR-3B and contemporaneous input credit was availed as permitted under Section 16(1).`;
      } else if (discrepancy === 'drc-01b-rule-88c') {
        legalGrounds = `2. SUBMISSIONS UNDER RULE 88C (FORM GST DRC-01B EXPLANATION):
2.1 The variance between outward taxable liability reported in GSTR-1 and tax discharged in GSTR-3B for the tax period ${fy} has been completely reconciled.
2.2 The difference was occasioned on account of:
    (a) Inadvertent duplicate entry of invoices in GSTR-1 which was rectified in subsequent tax periods;
    (b) Credit notes / rate adjustments issued under Section 34 which were adjusted in GSTR-3B;
    (c) Zero net loss of revenue to the Government exchequer.
2.3 The Noticee prays that the explanation be accepted under Rule 88C(2) and no recovery action be initiated.`;
      } else if (discrepancy === 'drc-01c-rule-88d') {
        legalGrounds = `2. SUBMISSIONS UNDER RULE 88D (FORM GST DRC-01C EXPLANATION):
2.1 The variance between Input Tax Credit available in GSTR-2B and credit availed in GSTR-3B for the tax period ${fy} has been examined in detail.
2.2 The difference arose due to legitimate timing differences, including:
    (a) ITC reversed in prior tax periods under Rule 37 / Rule 42 reclaimed upon satisfying statutory conditions;
    (b) Import of goods / IGST paid on bill of entry appearing with a delay on the ICEGATE portal;
    (c) Invoices uploaded by vendors with delayed GSTR-1 filing.
2.3 The Noticee confirms that every single rupee of credit claimed is backed by valid tax invoices satisfying Section 16(2).`;
      } else {
        legalGrounds = `2. SUBMISSIONS ON MERITS & JURISDICTION:
2.1 The Noticee has conducted all commercial business transparently through official banking channels and complied with all statutory requirements under the CGST/SGST Act, 2017.
2.2 The Noticee submits that the proposed tax demand is vague, unsubstantiated, and based on assumptions without providing primary documentary evidence or speaking rationale.
2.3 There has been no suppression of facts, misstatement, or intent to evade tax on the part of the Noticee.`;
      }

      // Build enclosures
      let docsList = '';
      if (documents.length > 0) {
        docsList = documents.map((doc, idx) => `\n   ${idx + 1}. ${doc}`).join('');
      } else {
        docsList = '\n   1. Detailed item-wise reconciliation and primary accounting records.';
      }

      // Legal draft template text
      const draftText = `BEFORE THE SUPERINTENDENT / PROPER OFFICER / ASSISTANT COMMISSIONER
${jurisdiction.toUpperCase()}
DEPARTMENT OF GOODS AND SERVICES TAX

IN THE MATTER OF:
${name}
GSTIN: ${gstin}
TAX PERIOD / FINANCIAL YEAR: ${fy}
... TAXPAYER / NOTICEE

VERSUS

THE PROPER OFFICER / SUPERINTENDENT OF CENTRAL / STATE TAX
... DEPARTMENT / REVENUE

${formPreamble}
IN RESPONSE TO NOTICE REF NO: ${ref} DATED: ${date} ${dinSubject}
UNDER ${sectionCited.toUpperCase()}
DISPUTED DEMAND AMOUNT: INR ${demand || 'AS SPECIFIED IN NOTICE'}

RESPECTED SIR / MADAM,

The Noticee above-named most respectfully submits this written submission in response to the captioned notice:

1. PRELIMINARY SUBMISSIONS:
1.1 The Noticee is a lawfully registered taxpayer under the CGST and SGST Acts bearing GSTIN ${gstin}, engaged in regular commercial operations and maintaining complete, audited books of account in compliance with Section 35 of the CGST Act.

1.2 The Noticee is in receipt of the captioned notice dated ${date} issued under ${sectionCited}, calling upon the Noticee to explain discrepancies and proposing a demand of tax, interest, and penalty amounting to INR ${demand}.

${dinClause}1.4 The Noticee humbly submits that the allegations and proposed demands in the captioned notice are contrary to the statutory provisions of the CGST Act, 2017, binding CBIC Circulars, and established judicial precedents.

${legalGrounds}

3. ABSENCE OF FRAUD, WILLFUL MISSTATEMENT, OR SUPPRESSION (SECTION 74 INAPPLICABLE):
3.1 The Noticee submits that all business transactions, supplies, and tax credits have been transparently recorded in the audited financial statements and reflected in statutory returns.
3.2 It is settled jurisprudence that mere difference between automated portal returns does not constitute willful suppression or intent to evade tax. Therefore, invoking Section 74 or levying penal consequences is wholly without jurisdiction.

4. PRAYER:
In view of the factual and statutory grounds set out hereinabove, the Noticee most respectfully prays that:
a) The written explanations and enclosed reconciliations submitted by the Noticee be accepted on record;
b) The proposed proceedings initiated vide Notice Ref: ${ref} dated ${date} be dropped in full;
c) No demand of tax, interest under Section 50, or penalty under Section 73/74/122 be confirmed against the Noticee;
d) IN THE EVENT THAT ANY ADVERSE DECISION IS CONTEMPLATED, AN OPPORTUNITY OF PERSONAL HEARING BE MANDATORILY GRANTED TO THE NOTICEE UNDER SECTION 75(4) OF THE CGST ACT, 2017.

LIST OF ENCLOSURES:${docsList}

VERIFICATION:
I, the Authorized Signatory of ${name}, do hereby declare and verify that the contents of paragraphs 1 to 4 above are true and correct to the best of my knowledge, information, and official records. No material fact has been concealed.

For ${name}


(Authorized Signatory)
Date: ${new Date().toLocaleDateString('en-IN')}
Place: India`;

      const out = document.getElementById('draft-output');
      if (out) {
        out.textContent = draftText;
        updateCounts();
      }
      showBadge(false);
    }

    // ══════════════════════════════════════════════════════════════════
    // AI Generation Handler
    // ══════════════════════════════════════════════════════════════════
    async function generateWithAI() {
      const formData = getFormData();
      const out = document.getElementById('draft-output');
      const btn = document.getElementById('ai-generate-btn');
      const statusDot = document.getElementById('status-dot');
      const statusLabel = document.getElementById('status-label');

      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> AI Drafting Legal Reply...';
      statusDot.className = 'h-2.5 w-2.5 rounded-full bg-amber-500 animate-pulse';
      statusLabel.textContent = 'AI is drafting legal submission...';
      out.textContent = 'Connecting to AI legal drafting engine...\n\nDrafting statutory reply incorporating CGST Act provisions, CBIC circulars, and Section 75(4) hearing prayers...';

      try {
        const response = await fetch('/api/generate-reply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'AI generation failed');
        }

        if (data.reply) {
          out.textContent = data.reply;
          showBadge(true);
          statusDot.className = 'h-2.5 w-2.5 rounded-full bg-emerald-500';
          statusLabel.textContent = 'AI-Generated Legal Reply Draft';
          updateCounts();
        } else {
          throw new Error('Empty response from AI engine');
        }
      } catch (err) {
        console.warn('AI generation unavailable, falling back to offline template:', err);
        statusDot.className = 'h-2.5 w-2.5 rounded-full bg-blue-500';
        statusLabel.textContent = 'Generated via Legal Template (Offline)';
        out.textContent = '⚠ AI Engine note: ' + err.message + '\n\nLoading complete statutory template draft...\n\n';

        setTimeout(() => {
          generateDraft();
          statusDot.className = 'h-2.5 w-2.5 rounded-full bg-emerald-500';
          statusLabel.textContent = 'Statutory Legal Reply Draft';
        }, 1000);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" /></svg> Generate with AI';
      }
    }

    function showBadge(isAI) {
      const badge = document.getElementById('ai-badge');
      if (badge) badge.style.display = isAI ? 'inline-flex' : 'none';
    }

    // ══════════════════════════════════════════════════════════════════
    // Word and Character Counters
    // ══════════════════════════════════════════════════════════════════
    function updateCounts() {
      const el = document.getElementById('draft-output');
      if (!el) return;
      const text = el.innerText || el.textContent || '';
      const chars = text.length;
      const words = text.trim() ? text.trim().split(/\s+/).length : 0;

      const wc = document.getElementById('word-count');
      const cc = document.getElementById('char-count');
      if (wc) wc.textContent = `${words} words`;
      if (cc) cc.textContent = `${chars} chars`;
    }

    // ══════════════════════════════════════════════════════════════════
    // Word (.doc) and Text (.txt) Download Handlers
    // ══════════════════════════════════════════════════════════════════
    function downloadAsDoc() {
      const el = document.getElementById('draft-output');
      const text = el ? (el.innerText || el.textContent || '') : '';
      const taxpayer = (document.getElementById('taxpayer-name').value || 'Taxpayer').trim().replace(/[^a-zA-Z0-9_-]/g, '_');
      const ref = (document.getElementById('notice-ref').value || 'Notice').trim().replace(/[^a-zA-Z0-9_-]/g, '_');
      const filename = `GST_Reply_${ref}_${taxpayer}.doc`;

      const htmlContent = `<!DOCTYPE html>
<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
  <meta charset='utf-8'>
  <title>GST Notice Reply</title>
  <!--[if gte mso 9]>
  <xml>
    <w:WordDocument>
      <w:View>Print</w:View>
      <w:Zoom>100</w:Zoom>
      <w:DoNotOptimizeForBrowser/>
    </w:WordDocument>
  </xml>
  <![endif]-->
  <style>
    @page Section1 {
      size: 595.3pt 841.9pt; /* A4 */
      margin: 1.0in 1.0in 1.0in 1.0in;
      mso-header-margin: 35.4pt;
      mso-footer-margin: 35.4pt;
      mso-paper-source: 0;
    }
    div.Section1 { page: Section1; }
    body {
      font-family: 'Times New Roman', Times, serif;
      font-size: 12pt;
      line-height: 1.5;
      color: #000000;
    }
    pre {
      font-family: 'Times New Roman', Times, serif;
      font-size: 12pt;
      line-height: 1.5;
      white-space: pre-wrap;
      word-wrap: break-word;
    }
  </style>
</head>
<body>
  <div class="Section1">
    <pre>${text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</pre>
  </div>
</body>
</html>`;

      const blob = new Blob(['\ufeff', htmlContent], { type: 'application/msword' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function downloadAsTxt() {
      const el = document.getElementById('draft-output');
      const text = el ? (el.innerText || el.textContent || '') : '';
      const taxpayer = (document.getElementById('taxpayer-name').value || 'Taxpayer').trim().replace(/[^a-zA-Z0-9_-]/g, '_');
      const ref = (document.getElementById('notice-ref').value || 'Notice').trim().replace(/[^a-zA-Z0-9_-]/g, '_');
      const filename = `GST_Reply_${ref}_${taxpayer}.txt`;

      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    // ══════════════════════════════════════════════════════════════════
    // Event Listeners Setup
    // ══════════════════════════════════════════════════════════════════
    document.getElementById('ai-generate-btn').addEventListener('click', generateWithAI);
    document.getElementById('template-btn').addEventListener('click', () => {
      generateDraft();
      const statusDot = document.getElementById('status-dot');
      const statusLabel = document.getElementById('status-label');
      statusDot.className = 'h-2.5 w-2.5 rounded-full bg-emerald-500';
      statusLabel.textContent = 'Generated via Statutory Template';
    });

    document.getElementById('reset-btn').addEventListener('click', () => {
      document.getElementById('notice-type').value = 'ASMT-10';
      document.getElementById('financial-year').value = 'FY 2023-24';
      document.getElementById('demand-amount').value = '2,45,000';
      document.getElementById('notice-ref').value = 'GST/SCN/2025/1042';
      document.getElementById('notice-date').value = '2026-08-10';
      document.getElementById('din-no').value = '';
      document.getElementById('jurisdiction-office').value = 'Range-II, Division-IV, CGST Commissionerate';
      document.getElementById('discrepancy-type').value = 'itc-2b-3b';
      document.getElementById('taxpayer-name').value = 'M/s Bharat Innovations LLP';
      document.getElementById('taxpayer-gstin').value = '27AAACB1234F1Z5';
      document.getElementById('custom-context').value = '';
      document.getElementById('doc-recon').checked = true;
      document.getElementById('doc-bank').checked = true;
      document.getElementById('doc-inv').checked = true;
      document.getElementById('doc-ca').checked = true;
      document.getElementById('doc-drc03').checked = false;
      generateDraft();
    });

    document.getElementById('copy-btn').addEventListener('click', () => {
      const el = document.getElementById('draft-output');
      const text = el ? (el.innerText || el.textContent || '') : '';
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById('copy-btn');
        if (btn) {
          const original = btn.innerHTML;
          btn.innerHTML = '<span class="text-emerald-600 dark:text-emerald-400 font-semibold">\u2713 Copied!</span>';
          setTimeout(() => {
            btn.innerHTML = original;
          }, 2000);
        }
      });
    });

    document.getElementById('download-doc-btn').addEventListener('click', downloadAsDoc);
    document.getElementById('download-txt-btn').addEventListener('click', downloadAsTxt);

    document.getElementById('print-btn').addEventListener('click', () => {
      window.print();
    });

    // Live update draft when primary dropdowns or checkboxes change
    const reactiveInputs = [
      'notice-type',
      'financial-year',
      'discrepancy-type',
      'doc-recon',
      'doc-bank',
      'doc-inv',
      'doc-ca',
      'doc-drc03',
    ];
    reactiveInputs.forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('change', () => {
          generateDraft();
        });
      }
    });

    // Uppercase GSTIN on typing
    const gstinInput = document.getElementById('taxpayer-gstin');
    if (gstinInput) {
      gstinInput.addEventListener('input', (e) => {
        e.target.value = e.target.value.toUpperCase();
      });
    }

    // Monitor edits inside contenteditable #draft-output
    const draftOutput = document.getElementById('draft-output');
    if (draftOutput) {
      draftOutput.addEventListener('input', updateCounts);
    }

    // Generate initial template on load
    generateDraft();
  </script>
</BaseLayout>

        taxpayerName: document.getElementById('taxpayer-name').value.trim() || 'M/s Bharat Innovations LLP',
        taxpayerGstin: document.getElementById('taxpayer-gstin').value.trim().toUpperCase() || '27AAACB1234F1Z5',
        customContext: document.getElementById('custom-context').value.trim(),
        documents: [
          document.getElementById('doc-recon').checked ? 'Annexure A: Monthly GSTR-2B vs 3B Reconciliation Statement' : null,
          document.getElementById('doc-bank').checked ? 'Annexure B: Bank Statements establishing payments through account payee banking channels' : null,

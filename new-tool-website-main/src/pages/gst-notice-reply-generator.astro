---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ToolIcon.astro';

const title = 'Free GST Notice Reply Generator (AI & Offline) — ASMT-10, DRC-01 & Section 73/74 Formats';
const description = 'Generate legally grounded replies to GST notices (ASMT-10, DRC-01, DRC-01A/B/C) with statutory citations, CBIC circulars, Section 75(4) hearing prayers & instant PDF/Word export.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const canonical = `${siteUrl}/gst-notice-reply-generator`;

const faqs = [
  {
    q: 'In which form and within what time limit must I reply to a Form GST ASMT-10 notice?',
    a: 'Replies to scrutiny discrepancy notices in Form GST ASMT-10 must be filed online in Form GST ASMT-11 on the GST portal within 30 days of receipt (or within an extended period if permitted by the proper officer under Rule 99(2) of CGST Rules). If the explanation is accepted, the officer drops proceedings by issuing an order in Form GST ASMT-12. If not accepted, the officer may initiate audit under Section 65, inspection under Section 67, or issue a demand notice under Section 73 or 74.',
  },
  {
    q: 'What is the statutory difference between Form ASMT-10, DRC-01A, and DRC-01?',
    a: 'Form ASMT-10 is a scrutiny notice under Section 61 pointing out return discrepancies without determining final liability. Form DRC-01A is an informal pre-show-cause intimation under Rule 142(1A) enabling voluntary settlement before formal proceedings. Form DRC-01 is a formal Show Cause Notice (SCN) issued under Section 73 (non-fraud) or Section 74 (fraud/willful suppression) detailing tax, interest, and penalty demands, which requires a formal legal response in Form GST DRC-06.',
  },
  {
    q: 'Is an opportunity of Personal Hearing mandatory under Section 75(4) before passing a demand order?',
    a: 'Yes. Under Section 75(4) of the CGST Act, granting an opportunity of personal hearing is mandatory if an adverse decision or tax demand is contemplated against the taxpayer, or whenever specifically requested in writing by the noticee. Multiple High Courts (including Allahabad, Gujarat, and Bombay High Courts) have repeatedly quashed ex-parte GST demand orders where personal hearing was refused or not granted, citing violation of the principles of natural justice.',
  },
  {
    q: 'Can a GST notice be legally challenged if it lacks a computer-generated Document Identification Number (DIN)?',
    a: 'Yes. In accordance with CBIC Circular No. 122/41/2019-GST dated 05.11.2019 and Circular No. 128/47/2019-GST dated 23.12.2019, any search authorization, summons, arrest memo, inspection notice, or demand communication issued without a valid computer-generated DIN is invalid and deemed to have never been issued (void ab initio). Taxpayers should verify the DIN on cbic.gov.in and raise a preliminary legal objection in their reply if the notice lacks a valid DIN.',
  },
  {
    q: 'How should a taxpayer reply if ITC is denied because the supplier failed to pay tax or was retrospectively cancelled?',
    a: 'The recipient should establish that all four conditions of Section 16(2) of the CGST Act were satisfied at the time of supply: (1) possession of genuine tax invoice, (2) physical receipt of goods/services, (3) tax paid to supplier via banking channels, and (4) timely return filing under Section 39. Cite CBIC Circular No. 183/15/2022-GST, Circular No. 193/05/2023-GST, and binding High Court rulings (e.g., Calcutta High Court in Suncraft Energy and Delhi High Court in Bharti Telemedia), holding that the department must first proceed against the defaulting supplier before demanding reversal from a bona fide purchasing recipient.',
  },
  {
    q: 'What is the relief under newly inserted Section 16(5) and 16(6) of the CGST Act for delayed ITC claims?',
    a: 'The Finance (No. 2) Act, 2024 inserted sub-sections (5) and (6) into Section 16 of the CGST Act with retrospective effect from July 1, 2017. Under Section 16(5), Input Tax Credit for Financial Years 2017-18, 2018-19, 2019-20, and 2020-21 can be availed in any return filed up to November 30, 2021. Section 16(6) further provides relief in cases where registrations were cancelled and subsequently revoked. Any notices or demand orders issued solely on the grounds of Section 16(4) time-bar for these periods are liable to be dropped.',
  },
  {
    q: 'How can taxpayers avail the Section 128A Amnesty Scheme for waiver of interest and penalty?',
    a: 'Section 128A of the CGST Act (introduced by Finance (No. 2) Act, 2024 and operationalized through Rule 164) grants a conditional waiver of 100% interest and penalty for demand notices or orders issued under Section 73 for Financial Years 2017-18, 2018-19, and 2019-20. To claim this waiver, the taxpayer must discharge the entire disputed tax amount on or before March 31, 2025 and submit an online application in Form GST SPL-01 or SPL-02.',
  },
  {
    q: 'Can the department demand interest under Section 50 on gross tax liability or only on net cash liability?',
    a: 'As per the statutory proviso to Section 50(1) inserted with retrospective effect from July 1, 2017, interest on delayed return filing is chargeable ONLY on that portion of the tax which is discharged by debiting the Electronic Cash Ledger. Tax paid by utilizing admissible Electronic Credit Ledger balances does not attract any interest liability whatsoever, as confirmed by the CBIC and the Hon’ble Supreme Court.',
  },
  {
    q: 'What happens if a taxpayer fails to reply to a Show Cause Notice (DRC-01) within 30 days?',
    a: 'If no reply or extension request is filed within 30 days, the proper officer will proceed to pass an ex-parte summary demand order in Form GST DRC-07 under Section 73(9) or Section 74(9). Once DRC-07 is passed, the tax, interest, and penalty become a crystallized Government debt subject to recovery proceedings under Section 79 (including bank account attachment and debtor garnishee orders) unless an appeal is filed before the Appellate Authority in Form GST APL-01 within 3 months under Section 107.',
  },
  {
    q: 'Where and how do I submit the notice reply online on the official GST Portal?',
    a: 'Log in to the GST Portal (gst.gov.in) > go to Services > User Services > View Additional Notices and Orders. Locate the relevant Case Reference Number or Notice Ref. For Form ASMT-10, click "View" > "Replies" > "Add Reply" to file Form GST ASMT-11. For Form DRC-01, click "View" > "Replies" > "Add Reply" to file Form GST DRC-06. You can upload written submissions in PDF format along with up to 4 supporting annexures (maximum 5MB per file). For Rule 88C/88D intimations, navigate to Services > Returns > Return Compliance to submit Part B of DRC-01B or DRC-01C.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': ['SoftwareApplication', 'WebApplication'],
    name: 'GST Notice Reply Generator (AI & Offline)',
    url: canonical,
    description: 'AI and template-driven legal reply generator for GST scrutiny notices (ASMT-10), show cause notices (DRC-01 u/s 73/74), and intimation notices (DRC-01A/B/C). Drafts professional submissions with statutory citations, CBIC circulars, and Section 75(4) personal hearing prayers.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'INR',
    },
    featureList: [
      'Statutory citations for Section 16(2), Section 16(5), Section 50, Section 73, and Section 74',
      'Mandatory Section 75(4) personal hearing prayer inclusion',
      'CBIC Circular 122/41/2019 DIN verification and non-est objection',
      'One-click Download in Word (.doc) and Text (.txt) formats',
      'Clean A4 legal document print stylesheet for Save-as-PDF without website headers or forms',
      'Real-time in-place editable legal draft with word and character counters',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to Draft and Submit a GST Notice Reply Online',
    description: 'Step-by-step procedure to analyze a GST notice, draft a legally defensible written submission, and submit it on the GST portal.',
    step: [
      {
        '@type': 'HowToStep',
        name: 'Analyze the Notice & Verify Computer-Generated DIN',
        text: 'Identify the notice type (ASMT-10, DRC-01, DRC-01A/B/C), section invoked, tax period, and verify the Document Identification Number (DIN) on cbic.gov.in.',
      },
      {
        '@type': 'HowToStep',
        name: 'Reconcile Tax Returns and Gather Accounting Evidence',
        text: 'Perform an invoice-level reconciliation between GSTR-1, GSTR-2B, GSTR-3B, and financial ledgers. Collect bank payment advice, transport proofs, and CA certificates.',
      },
      {
        '@type': 'HowToStep',
        name: 'Draft Legal Submissions with Statutory Grounds and Hearing Prayer',
        text: 'Prepare a structured reply with preliminary objections, ground-by-ground factual submissions citing CBIC circulars and court rulings, and a mandatory prayer for personal hearing under Section 75(4).',
      },
      {
        '@type': 'HowToStep',
        name: 'File Reply on the GST Portal within the Statutory Time Limit',
        text: 'Upload the written reply in Form GST ASMT-11 (for ASMT-10) or Form GST DRC-06 (for DRC-01) under Services > User Services > View Additional Notices and Orders within 30 days.',
      },
    ],
  },
];

const breadcrumb = [
  { name: 'Home', href: '/' },
  { name: 'GST Notices Hub', href: '/gst-notices' },
  { name: 'Notice Reply Generator', href: '/gst-notice-reply-generator' },
];
const lastUpdated = '2026-09-15';
---

<BaseLayout {title} {description} {canonical} {structuredData} {breadcrumb} {lastUpdated}>
  <!-- Dedicated Global Print Styles: Ensures ONLY the Legal Reply Document Prints -->
  <style is:global>
    @media print {
      /* Hide all website chrome, navigation, headers, footers, form widgets, FAQs, and guides */
      header,
      footer,
      nav,
      .print-hidden,
      #hero-section,
      #form-section,
      #draft-toolbar,
      #draft-footer,
      #disclaimer-section,
      #guide-section,
      #comparison-section,
      #faq-section,
      .fixed.inset-0,
      [aria-label="Breadcrumb"] {
        display: none !important;
      }

      /* Page Setup for Standard Legal A4 Sheet */
      @page {
        size: A4 portrait;
        margin: 20mm 15mm 20mm 15mm;
      }

      html, body {
        background: #ffffff !important;
        color: #000000 !important;
        font-family: "Times New Roman", Times, Georgia, serif !important;
        font-size: 11pt !important;
        line-height: 1.55 !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        height: auto !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      /* Unset grid / flex constraints so the document flows across standard pages */
      main, .mx-auto, .max-w-5xl, .grid, .lg\:col-span-7, .lg\:col-span-12 {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        box-shadow: none !important;
      }

      #printable-document {
        display: block !important;
        width: 100% !important;
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      #draft-output {
        display: block !important;
        font-family: "Times New Roman", Times, Georgia, serif !important;
        font-size: 11pt !important;
        line-height: 1.6 !important;
        color: #000000 !important;
        white-space: pre-wrap !important;
        word-wrap: break-word !important;
        overflow: visible !important;
        height: auto !important;
        max-height: none !important;
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;
        background: transparent !important;
        box-shadow: none !important;
      }
    }
  </style>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Hero Section -->
    <div id="hero-section" class="print-hidden text-center mb-12">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-50/50 dark:bg-blue-950/40 px-4 py-1.5 text-[12px] font-mono uppercase tracking-wider text-accent mb-4">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        AI & Template Legal Drafter · Updated for 2026 GST Provisions
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-base mb-4">
        GST Notice Reply Generator
      </h1>
      <p class="text-[16px] sm:text-[17px] text-muted max-w-2xl mx-auto leading-relaxed">
        Draft structured, legally grounded responses to ASMT-10, DRC-01 (Section 73/74), and DRC-01A/B/C notices. Includes statutory citations, CBIC circulars, Section 75(4) personal hearing prayers, and instant PDF/Word download.
      </p>
    </div>

    <!-- Generator Interface: 2 Columns on desktop -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 items-start">
      <!-- Left Column: Form Parameters -->
      <div id="form-section" class="print-hidden lg:col-span-5 space-y-6">
        <div class="rounded-2xl border border-base bg-surface p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-base pb-3">
            <h2 class="text-base font-bold text-base flex items-center gap-2">
              <ToolIcon name="file" class="w-5 h-5 text-accent" />
              1. Notice Particulars
            </h2>
            <span class="text-[11px] font-mono text-muted bg-subtle px-2 py-0.5 rounded">Form Input</span>
          </div>

          <!-- Notice Type -->
          <div>
            <label for="notice-type" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Notice Type</label>
            <select id="notice-type" class="w-full rounded-xl border border-base bg-subtle px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none transition-colors">
              <option value="ASMT-10">Form GST ASMT-10 (Scrutiny Notice u/s 61)</option>
              <option value="DRC-01-73">Form GST DRC-01 (Show Cause Notice u/s 73 - Non-fraud)</option>
              <option value="DRC-01-74">Form GST DRC-01 (Show Cause Notice u/s 74 - Fraud/Suppression)</option>
              <option value="DRC-01A">Form GST DRC-01A (Intimation of Tax Ascertained u/r 142(1A))</option>
              <option value="DRC-01B">Form GST DRC-01B (Rule 88C - Outward Liability Mismatch)</option>
              <option value="DRC-01C">Form GST DRC-01C (Rule 88D - ITC Mismatch GSTR-2B vs 3B)</option>
            </select>
          </div>

          <!-- Financial Year & Demand Amount -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="financial-year" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Financial Year</label>
              <select id="financial-year" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm focus:border-accent focus:outline-none transition-colors">
                <option value="FY 2024-25">FY 2024-25</option>
                <option value="FY 2023-24" selected>FY 2023-24</option>
                <option value="FY 2022-23">FY 2022-23</option>
                <option value="FY 2021-22">FY 2021-22</option>
                <option value="FY 2020-21">FY 2020-21</option>
                <option value="FY 2019-20">FY 2019-20</option>
                <option value="FY 2018-19">FY 2018-19</option>
                <option value="FY 2017-18">FY 2017-18</option>
              </select>
            </div>
            <div>
              <label for="demand-amount" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Disputed Tax (₹)</label>
              <input type="text" id="demand-amount" placeholder="e.g. 2,45,000" value="2,45,000" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm font-mono focus:border-accent focus:outline-none transition-colors" />
            </div>
          </div>

          <!-- Notice Ref & Notice Date -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="notice-ref" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Notice Ref No.</label>
              <input type="text" id="notice-ref" value="GST/SCN/2025/1042" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm font-mono focus:border-accent focus:outline-none transition-colors" />
            </div>
            <div>
              <label for="notice-date" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Notice Date</label>
              <input type="date" id="notice-date" value="2026-08-10" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm font-mono focus:border-accent focus:outline-none transition-colors" />
            </div>
          </div>

          <!-- DIN No -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="din-no" class="text-xs font-semibold uppercase tracking-wider text-muted">DIN (Document Identification No.)</label>
              <span class="text-[10px] text-accent">CBIC Circular 122/41/2019</span>
            </div>
            <input type="text" id="din-no" placeholder="Leave blank if not mentioned on notice" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm font-mono focus:border-accent focus:outline-none transition-colors" />
            <p class="text-[11px] text-muted/80 mt-1">If blank, the draft automatically raises a preliminary objection under Circular 122/41/2019.</p>
          </div>

          <!-- Proper Officer / Jurisdiction -->
          <div>
            <label for="jurisdiction-office" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Proper Officer / Ward / Range</label>
            <input type="text" id="jurisdiction-office" value="Range-II, Division-IV, CGST Commissionerate" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm focus:border-accent focus:outline-none transition-colors" />
          </div>

          <!-- Alleged Discrepancy -->
          <div>
            <label for="discrepancy-type" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Alleged Discrepancy / Legal Ground</label>
            <select id="discrepancy-type" class="w-full rounded-xl border border-base bg-subtle px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none transition-colors">
              <option value="itc-2b-3b">ITC Mismatch: GSTR-2B vs GSTR-3B excess credit claimed</option>
              <option value="sec-16-4-delayed-itc">Section 16(4) Delayed ITC: Retrospective relief u/s 16(5) & 16(6)</option>
              <option value="sec-128a-amnesty">Section 128A Amnesty: Waiver of Interest & Penalty (FY 2017-20)</option>
              <option value="supplier-cancelled">Cancelled Supplier: Supplier GSTIN cancelled retrospectively</option>
              <option value="turnover-1-3b">Turnover Mismatch: GSTR-1 outward liability exceeds GSTR-3B</option>
              <option value="delayed-interest">Delayed Return Filing: Section 50 interest on cash vs credit</option>
              <option value="rule-37">Rule 37: 180-Day vendor payment reversal / Retention money</option>
              <option value="eway-mismatch">E-Way Bill discrepancy with reported turnover (Circular 64/38)</option>
              <option value="rcm-liability">Reverse Charge (RCM): Unpaid liability on GTA / Legal / Director fees</option>
              <option value="drc-01b-rule-88c">Form DRC-01B: Intimation under Rule 88C (GSTR-1 vs 3B variance)</option>
              <option value="drc-01c-rule-88d">Form DRC-01C: Intimation under Rule 88D (ITC difference)</option>
              <option value="general-denial">General Denial: SCN lacking speaking order or quantification</option>
            </select>
          </div>

          <!-- Taxpayer Details -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="taxpayer-name" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Taxpayer Legal Name</label>
              <input type="text" id="taxpayer-name" value="M/s Bharat Innovations LLP" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm focus:border-accent focus:outline-none transition-colors" />
            </div>
            <div>
              <label for="taxpayer-gstin" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">Taxpayer GSTIN</label>
              <input type="text" id="taxpayer-gstin" value="27AAACB1234F1Z5" maxlength="15" class="w-full rounded-xl border border-base bg-subtle px-3 py-2 text-sm font-mono uppercase focus:border-accent focus:outline-none transition-colors" />
            </div>
          </div>

          <!-- Supporting Documents Attached -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-muted mb-2">Supporting Documents Attached (Annexures)</label>
            <div class="grid grid-cols-1 gap-2 text-xs text-muted">
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" id="doc-recon" checked class="accent-blue-600 rounded" />
                <span>Monthly GSTR-2B vs 3B Reconciliation Statement</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" id="doc-bank" checked class="accent-blue-600 rounded" />
                <span>Bank Statement showing payments via banking channels</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" id="doc-inv" checked class="accent-blue-600 rounded" />
                <span>Sample Tax Invoices, Delivery Proofs & E-Way Bills</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" id="doc-ca" checked class="accent-blue-600 rounded" />
                <span>Chartered Accountant Certification (Circular 183/193)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <input type="checkbox" id="doc-drc03" class="accent-blue-600 rounded" />
                <span>Challan / DRC-03 of voluntary tax payment</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Custom Context for AI -->
        <div class="rounded-2xl border border-emerald-500/20 bg-emerald-50/30 dark:bg-emerald-950/10 p-6 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-base flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" /></svg>
              2. AI Context <span class="text-xs font-normal text-muted">(Optional)</span>
            </h2>
            <span class="text-[11px] font-mono text-emerald-700 dark:text-emerald-300">Groq LLM</span>
          </div>
          <p class="text-xs text-muted">Add transaction specifics, DRC-03 ARN, vendor GSTIN, or specific dates to tailor the AI draft.</p>
          <textarea
            id="custom-context"
            rows="3"
            placeholder="e.g. We have already deposited ₹1,20,000 via DRC-03 (ARN: AD270826001234A) on 12-Jul-2026. The remaining difference pertains to supplier M/s Zenith Ltd who filed late..."
            class="w-full rounded-xl border border-emerald-300/50 dark:border-emerald-800/50 bg-white dark:bg-gray-900 px-3.5 py-2.5 text-xs focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 resize-y transition-colors"
          ></textarea>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col gap-3">
          <button
            id="ai-generate-btn"
            type="button"
            class="w-full rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white px-6 py-3.5 text-sm font-bold shadow-md hover:shadow-lg transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" /></svg>
            Generate with AI
          </button>
          <div class="grid grid-cols-2 gap-3">
            <button
              id="template-btn"
              type="button"

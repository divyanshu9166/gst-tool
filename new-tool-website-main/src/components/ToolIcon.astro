---

<div
  class:list={[
    'flex items-center justify-center rounded-xl bg-accent/10 text-accent transition-colors group-hover:bg-accent/20',
    className
  ]}
  style={`width: ${size}px; height: ${size}px;`}
  aria-hidden="true"
>
  <svg
    class="text-accent"
    style={`width: ${Math.round(size * 0.55)}px; height: ${Math.round(size * 0.55)}px;`}
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d={iconData.path} />
  </svg>
</div>

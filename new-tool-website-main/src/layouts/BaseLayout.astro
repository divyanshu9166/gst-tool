---
/**
 * BaseLayout — shared shell for every page.
 *
 * Props:
 *   title          — <title> tag content (include primary keyword)
 *   description    — meta description, keep under 160 chars
 *   canonical      — canonical URL (defaults to current page URL)
 *   ogImage        — absolute URL to OG image (optional)
 *   structuredData — JSON-LD object or array (optional)
 *   noindex        — set true to add noindex meta (e.g. 404)
 *   breadcrumb     — array of {name, href} for BreadcrumbList schema + visible nav
 *   lastUpdated    — ISO date string to display "Last updated" on evergreen pages
 */

import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-mono/400.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  structuredData?: object | object[];
  noindex?: boolean;
  breadcrumb?: BreadcrumbItem[];
  lastUpdated?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/og-default.png',
  structuredData,
  noindex = false,
  breadcrumb,
  lastUpdated,
} = Astro.props;

const siteName = 'Taxzentic';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://taxzentic.com';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

// Build BreadcrumbList JSON-LD from breadcrumb prop
const breadcrumbJsonLd = breadcrumb && breadcrumb.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.href.startsWith('http') ? item.href : `${siteUrl}${item.href}`,
  })),
} : null;

// Merge all structured data into a single array
const allStructuredData: object[] = [];
if (structuredData) {
  if (Array.isArray(structuredData)) {
    allStructuredData.push(...structuredData);
  } else {
    allStructuredData.push(structuredData);
  }
}
if (breadcrumbJsonLd) {
  allStructuredData.push(breadcrumbJsonLd);
}

// Serialise JSON-LD safely
const jsonLd = allStructuredData.length > 0 ? JSON.stringify(allStructuredData) : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts are now imported in BaseLayout setup script via @fontsource -->

    <!-- JSON-LD Structured Data -->
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <!-- Google tag (gtag.js) — deferred to reduce LCP impact -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SNQHLMNL4M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-SNQHLMNL4M');
    </script>

    <!-- Dark mode: read preference before paint to avoid flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col bg-surface text-base antialiased relative">
    <!-- Premium Global Background for all pages -->
    <div class="fixed inset-0 z-[-1] pointer-events-none opacity-[0.4] dark:opacity-[0.15]">
      <!-- Mesh gradient -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.15),rgba(255,255,255,0))]"></div>
      <!-- Grid overlay -->
      <div class="absolute inset-0 opacity-[0.05] dark:opacity-[0.08]" style="background-image: url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 viewBox=%220 0 60 60%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cg fill=%22none%22 fill-rule=%22evenodd%22%3E%3Cg fill=%22%23000%22 fill-opacity=%221%22%3E%3Cpath d=%22M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    </div>
    
    <Header />

    <main class="flex-1">
      {/* Visible breadcrumb navigation */}
      {breadcrumb && breadcrumb.length > 1 && (
        <nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4 pb-0">
          <ol class="flex flex-wrap items-center gap-1.5 text-[13px] text-muted">
            {breadcrumb.map((item, i) => (
              <>
                {i > 0 && (
                  <li aria-hidden="true" class="text-muted/50">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </li>
                )}
                <li>
                  {i === breadcrumb.length - 1 ? (
                    <span class="font-medium text-base" aria-current="page">{item.name}</span>
                  ) : (
                    <a href={item.href} class="hover:text-accent transition-colors">{item.name}</a>
                  )}
                </li>
              </>
            ))}
          </ol>
        </nav>
      )}

      <slot />
    </main>

    <Footer />
  </body>
</html>
